@namespace AntDesign
@using Microsoft.AspNetCore.Components.Rendering
@inherits AntDomComponentBase

<CascadingValue Value="this" IsFixed>
    @if (ShowTooltip)
    {
        <Tooltip @ref="_tooltip" TitleTemplate="@content" Placement="@Placement.Right" Disabled="TooltipDisabled">
            <Unbound Context="tooltip">
                @MenuItemContent(tooltip)
            </Unbound>
        </Tooltip>
    }
    else
    {
        @MenuItemContent(RefBack);
    }
</CascadingValue>

@code {

    RenderFragment MenuItemContent(ForwardRef refBack)
    {
        return@<li class="@RootMenu.GetSemanticClass(SemanticSlot("item"), ClassMapper.Class)" role="menuitem" style="@RootMenu.GetSemanticStyle(SemanticSlot("item"), $"{PaddingStyle} {Style}")" @onclick="HandleOnClick" @key="Key" @ref="refBack.Current">
            @icon
            <span class="@RootMenu.GetSemanticClass(SemanticSlot("itemContent"), $"{RootMenu?.PrefixCls ?? "ant-menu"}-title-content")" style="@RootMenu.GetSemanticStyle(SemanticSlot("itemContent"))">
                @if (RouterLink == null)
                {
                    @content
                }
                else
                {
                    <MenuLink Href="@RouterLink" Match="@RouterMatch" Target="Target">@content</MenuLink>
                }
                @if (Extra != null)
                {
                    <span class="@(RootMenu?.PrefixCls ?? "ant-menu")-item-extra">@Extra</span>
                }
            </span>
        </li>;
    }

    void content(RenderTreeBuilder __builder)
    {
        @if (Title != null)
        {
            @Title
        }
        else
        {
            @ChildContent
        }
    }


    void icon(RenderTreeBuilder __builder)
    {
        if (IconTemplate != null)
        {
            <span role="img" class="anticon anticon-container @MenuItemIconClass" style="@MenuItemIconStyle">
                @IconTemplate
            </span>
        }
        else if (Icon != null)
        {
            <Icon Type="@Icon" Class="@MenuItemIconClass" Style="@MenuItemIconStyle" />
        }
    }

    void TitleContent(RenderTreeBuilder __builder)
    {
        icon(__builder);
        content(__builder);
    }

    internal RenderFragment GetTitleContent()
    {
        return b => TitleContent(b);
    }
}
