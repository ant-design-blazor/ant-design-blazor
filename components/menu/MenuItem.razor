@namespace AntDesign
@using Microsoft.AspNetCore.Components.Rendering
@inherits AntDomComponentBase

<CascadingValue Value="this" IsFixed>
    @if (ShowTooltip)
    {
        <Tooltip @ref="_tooltip" TitleTemplate="@content" Placement="@RootMenu.CollapsedTooltipPlacement" Disabled="TooltipDisabled">
            <Unbound Context="tooltip">
                @MenuItemContent(tooltip)
            </Unbound>
        </Tooltip>
    }
    else
    {
        @MenuItemContent(RefBack);
    }
</CascadingValue>

@code {
    private readonly ForwardRef _overflowRef = new();
    private RenderFragment OverflowContent => @<CascadingValue Value="this" IsFixed>@MenuItemContent(_overflowRef, true)</CascadingValue>;

    RenderFragment MenuItemContent(ForwardRef refBack, bool overflow = false)
    {
        var slot = overflow ? "subMenu.item" : SemanticSlot("item");
        return@<li class="@RootMenu.GetSemanticClass(slot, ClassMapper.Class)" role="menuitem" style="@(overflow ? RootMenu.GetSemanticStyle(slot, Style) : RootMenu.OverflowItemStyle(Id, RootMenu.GetSemanticStyle(slot, $"{PaddingStyle} {Style}")))" data-menu-overflow-item="@(!overflow ? RootMenu.OverflowItemId(Id, IsOverflowRoot) : null)" aria-hidden="@(!overflow && RootMenu.IsOverflowed(Id) ? "true" : null)" inert="@(!overflow && RootMenu.IsOverflowed(Id))" @onclick="HandleOnClick" @key="Key" @ref="refBack.Current">
            @if (overflow) { @OverflowIcon } else { @icon }
            <span class="@RootMenu.GetSemanticClass(overflow ? "subMenu.itemContent" : SemanticSlot("itemContent"), $"{RootMenu?.PrefixCls ?? "ant-menu"}-title-content")" style="@RootMenu.GetSemanticStyle(overflow ? "subMenu.itemContent" : SemanticSlot("itemContent"))">
                @if (RouterLink == null)
                {
                    @content
                }
                else
                {
                    <MenuLink Href="@RouterLink" Match="@RouterMatch" Target="Target">@content</MenuLink>
                }
                @if (Extra != null)
                {
                    <span class="@(RootMenu?.PrefixCls ?? "ant-menu")-item-extra">@Extra</span>
                }
            </span>
        </li>;
    }

    void content(RenderTreeBuilder __builder)
    {
        @if (Title != null)
        {
            @Title
        }
        else
        {
            @ChildContent
        }
    }


    void icon(RenderTreeBuilder __builder)
    {
        if (IconTemplate != null)
        {
            <span role="img" class="anticon anticon-container @MenuItemIconClass" style="@MenuItemIconStyle">
                @IconTemplate
            </span>
        }
        else if (Icon != null)
        {
            <Icon Type="@Icon" Class="@MenuItemIconClass" Style="@MenuItemIconStyle" />
        }
    }

    void TitleContent(RenderTreeBuilder __builder)
    {
        icon(__builder);
        content(__builder);
    }

    private RenderFragment OverflowIcon => @<text>
        @if (IconTemplate != null)
        {
            <span role="img" class="anticon anticon-container @RootMenu.GetSemanticClass("subMenu.itemIcon", $"{RootMenu.PrefixCls}-item-icon")" style="@RootMenu.GetSemanticStyle("subMenu.itemIcon")">@IconTemplate</span>
        }
        else if (Icon != null)
        {
            <Icon Type="@Icon" Class="@RootMenu.GetSemanticClass("subMenu.itemIcon", $"{RootMenu.PrefixCls}-item-icon")" Style="@RootMenu.GetSemanticStyle("subMenu.itemIcon")" />
        }
    </text>;

    internal RenderFragment GetTitleContent()
    {
        return b => TitleContent(b);
    }
}
