@namespace AntDesign
@using Microsoft.AspNetCore.Components.Rendering
@inherits AntDomComponentBase

<CascadingValue Value="this" IsFixed>
    @if (ShowTooltip)
    {
        <Tooltip @ref="_tooltip" TitleTemplate="@content" Placement="@RootMenu.CollapsedTooltipPlacement" Disabled="TooltipDisabled">
            <Unbound Context="tooltip">
                @MenuItemContent(tooltip)
            </Unbound>
        </Tooltip>
    }
    else
    {
        @MenuItemContent(RefBack);
    }
</CascadingValue>

@code {
    private readonly ForwardRef _overflowRef = new();
    private RenderFragment OverflowContent => @<CascadingValue Value="this" IsFixed>@MenuItemContent(_overflowRef, true)</CascadingValue>;

    RenderFragment MenuItemContent(ForwardRef refBack, bool overflow = false)
    {
        var slot = overflow ? "subMenu.item" : SemanticSlot("item");
        var itemStyle = overflow ? RootMenu.GetSemanticStyle(slot, Style) : RootMenu.OverflowItemStyle(Id, RootMenu.GetSemanticStyle(slot, $"{PaddingStyle} {Style}"));
        return@<li class="@RootMenu.GetSemanticClass(slot, ClassMapper.Class)" role="menuitem" style="@(string.IsNullOrWhiteSpace(itemStyle) ? null : itemStyle)" data-menu-id="@RootMenu.GetMenuDataId(Key)" data-menu-overflow-item="@(!overflow ? RootMenu.OverflowItemId(Id, IsOverflowRoot) : null)" aria-disabled="@(Disabled ? "true" : null)" aria-hidden="@(!overflow && RootMenu.IsOverflowed(Id) ? "true" : null)" tabindex="@(!Disabled ? "-1" : null)" @onclick="HandleOnClick" @key="Key" @ref="refBack.Current">
            @if (overflow) { @OverflowIcon } else { @icon }@ItemContent(overflow)
        </li>;
    }

    private RenderFragment ItemContent(bool overflow) => builder =>
    {
        var sequence = 0;
        var contentSlot = overflow ? "subMenu.itemContent" : SemanticSlot("itemContent");
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", RootMenu.GetSemanticClass(contentSlot, $"{RootMenu?.PrefixCls ?? "ant-menu"}-title-content"));
        builder.AddAttribute(sequence++, "style", RootMenu.GetSemanticStyle(contentSlot));

        RenderFragment title = titleBuilder =>
        {
            if (Title != null)
                titleBuilder.AddContent(0, Title);
            else
                titleBuilder.AddContent(1, ChildContent);
        };

        if (RouterLink == null)
            builder.AddContent(sequence++, title);
        else
        {
            builder.OpenComponent<MenuLink>(sequence++);
            builder.AddAttribute(sequence++, nameof(MenuLink.Href), RouterLink);
            builder.AddAttribute(sequence++, nameof(MenuLink.Match), RouterMatch);
            builder.AddAttribute(sequence++, nameof(MenuLink.Target), Target);
            builder.AddAttribute(sequence++, nameof(MenuLink.ChildContent), title);
            builder.CloseComponent();
        }

        if (Extra != null)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", $"{RootMenu?.PrefixCls ?? "ant-menu"}-item-extra");
            builder.AddContent(sequence++, Extra);
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private void content(RenderTreeBuilder builder)
    {
        if (Title != null)
            builder.AddContent(0, Title);
        else
            builder.AddContent(1, ChildContent);
    }


    void icon(RenderTreeBuilder __builder)
    {
        if (IconTemplate != null)
        {
            __builder.OpenElement(0, "span");
            __builder.AddAttribute(1, "role", "img");
            __builder.AddAttribute(2, "class", $"anticon anticon-container {MenuItemIconClass}");
            if (!string.IsNullOrWhiteSpace(MenuItemIconStyle)) __builder.AddAttribute(3, "style", MenuItemIconStyle);
            __builder.AddContent(4, IconTemplate);
            __builder.CloseElement();
        }
        else if (Icon != null)
        {
            __builder.OpenComponent<AntDesign.Icon>(0);
            __builder.AddAttribute(1, "Type", Icon);
            __builder.AddAttribute(2, "Class", MenuItemIconClass);
            if (!string.IsNullOrWhiteSpace(MenuItemIconStyle)) __builder.AddAttribute(3, "Style", MenuItemIconStyle);
            __builder.CloseComponent();
        }
    }

    void TitleContent(RenderTreeBuilder __builder)
    {
        icon(__builder);
        content(__builder);
    }

    private RenderFragment OverflowIcon => @<text>
        @if (IconTemplate != null)
        {
            <span role="img" class="anticon anticon-container @RootMenu.GetSemanticClass("subMenu.itemIcon", $"{RootMenu.PrefixCls}-item-icon")" style="@RootMenu.GetSemanticStyle("subMenu.itemIcon")">@IconTemplate</span>
        }
        else if (Icon != null)
        {
            <Icon Type="@Icon" Class="@RootMenu.GetSemanticClass("subMenu.itemIcon", $"{RootMenu.PrefixCls}-item-icon")" Style="@RootMenu.GetSemanticStyle("subMenu.itemIcon")" />
        }
    </text>;

    internal RenderFragment GetTitleContent()
    {
        return b => TitleContent(b);
    }
}
