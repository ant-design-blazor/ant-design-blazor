@namespace AntDesign
@inherits AntDomComponentBase
@using AntDesign.Internal

@{
    string prefixCls = $"{RootMenu.PrefixCls}-submenu";
}

@if (RootMenu.InternalMode == MenuMode.Inline)
{
    <li class="@ClassMapper.Class" role="menuitem" @key="Key" style="@($"position:relative;{Style}")" @ref="Ref">
        <div class="@(prefixCls)-title" style="@PaddingStyle" role="button" aria-label="@(TitleTemplate != null ? Title : null)" @onclick="HandleOnTitleClick" aria-haspopup="true">
            @SubMenuTitleContent
            <i class="@(prefixCls)-arrow"></i>
        </div>
        <ul direction="ltr" class="@SubMenuMapper.Class" style="@_warpperStyle" @ref="@_warpperRef" role="menu" aria-expanded="@IsOpen">
            <CascadingValue Value="this" IsFixed="@true">
                @ChildContent
            </CascadingValue>
        </ul>
    </li>
}
else if (RootMenu.InlineCollapsed || RootMenu.InternalMode == MenuMode.Horizontal || Level == 0)
{
    if (Placement == null)
    {
        Placement = (RootMenu.Mode == MenuMode.Horizontal && Parent == null) ? AntDesign.Placement.BottomLeft : AntDesign.Placement.RightTop;
    }
    <CascadingValue Value="this" Name="SubMenu" IsFixed>
        <CascadingValue Value="@prefixCls" Name="PrefixCls" IsFixed>
            <SubMenuTrigger @ref="_overlayTrigger"
                            TriggerClass="@ClassMapper.Class"
                            Visible="IsOpen"
                            ComplexAutoCloseAndVisible="true"
						    BoundaryAdjustMode="@TriggerBoundaryAdjustMode.InView"
                            Disabled="@(Disabled || OverflowHidden)"
                            Placement="Placement.Value"
                            OnVisibleChange="OnOverlayVisibleChange"
                            OnOverlayHiding="OnOverlayHiding"
                            Trigger="new Trigger[] { RootMenu?.TriggerSubMenuAction ?? AntDesign.Trigger.Hover }"
                            OverlayClassName="@RootMenu.GetSemanticClass("popup.root", PopupClassName)"
                            OverlayStyle="@RootMenu.GetSemanticStyle("popup.root", "max-width:calc(100vw - 16px);")"
                            PlacementCls="@($"{prefixCls}-popup {RootMenu.PrefixCls} {RootMenu.PrefixCls}-{EffectiveTheme.ToString().ToLowerInvariant()} {prefixCls}-placement-{_placement.Name}")">
                <ChildContent>
                    <div class="@(prefixCls)-title" role="button" aria-label="@(TitleTemplate != null ? Title : null)" aria-haspopup="true" aria-expanded="@(_overlayVisible ? "true" : "false")">
                        @SubMenuTitleContent
                        @GetArrow()
                    </div>
                </ChildContent>
                <Overlay>
                    @RenderPopup()
                </Overlay>
            </SubMenuTrigger>
        </CascadingValue>
    </CascadingValue>
}

@code
{
    private RenderFragment DefaultPopup => @<ul direction="ltr" class="@SubMenuMapper.Class" style="@($"max-width:100%;{_popupMinWidthStyle}")" role="menu"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></ul>;

    private RenderFragment OverflowContent => @<SubMenu Key="@Key" Title="@Title" TitleTemplate="@TitleTemplate" Icon="@Icon" IconTemplate="@IconTemplate" Disabled="@Disabled" Class="@Class" Style="@Style" Theme="@Theme" PopupRender="@PopupRender" PopupClassName="@PopupClassName" OnTitleClick="@OnTitleClick" IsOpen="@IsOpen" Placement="AntDesign.Placement.RightTop">@ChildContent</SubMenu>;

    private string SubMenuIconClass => RootMenu.GetSemanticClass("itemIcon", $"{RootMenu.PrefixCls}-item-icon");

    private string SubMenuIconStyle => RootMenu.GetSemanticStyle("itemIcon");

    private RenderFragment SubMenuTitleContent => builder =>
    {
        if (IconTemplate != null)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "role", "img");
            builder.AddAttribute(2, "class", $"anticon anticon-container {SubMenuIconClass}");
            builder.AddAttribute(3, "style", SubMenuIconStyle);
            builder.AddContent(4, IconTemplate);
            builder.CloseElement();
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            builder.OpenComponent<AntDesign.Icon>(5);
            builder.AddAttribute(6, "Type", Icon);
            builder.AddAttribute(7, "Class", SubMenuIconClass);
            builder.AddAttribute(8, "Style", SubMenuIconStyle);
            builder.CloseComponent();
        }

        builder.OpenElement(9, "span");
        builder.AddAttribute(10, "class", "ant-menu-title-content");
        if (TitleTemplate != null)
        {
            builder.AddContent(11, TitleTemplate);
        }
        else if (Title != null)
        {
            builder.AddContent(12, Title);
        }
        builder.CloseElement();
    };

    private RenderFragment GetArrow()
    {
        string prefixCls = $"{RootMenu.PrefixCls}-submenu";
        if (RootMenu.PrefixCls.Contains("dropdown"))
        {
            return @<span class="@(prefixCls)-expand-icon">
                <span role="img" aria-label="right" class="anticon anticon-right @(prefixCls)-arrow-icon">
                    <svg viewBox="64 64 896 896" focusable="false" class="" data-icon="right" width="1em" height="1em" fill="currentColor" aria-hidden="true">
                        <path d="M765.7 486.8L314.9 134.7A7.97 7.97 0 00302 141v77.3c0 4.9 2.3 9.6 6.1 12.6l360 281.1-360 281.1c-3.9 3-6.1 7.7-6.1 12.6V883c0 6.7 7.7 10.4 12.9 6.3l450.8-352.1a31.96 31.96 0 000-50.4z"></path>
                    </svg>
                </span>
            </span>;
        }
        else if (Parent is AntDesign.SubMenu || RootMenu.Mode == MenuMode.Vertical)
        {
            return @<i class="@(prefixCls)-arrow"></i>;
        }
        return default;
    }
}
