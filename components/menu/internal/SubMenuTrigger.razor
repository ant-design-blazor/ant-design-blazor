@namespace AntDesign.Internal
@inherits OverlayTrigger

@{
    string prefixCls = $"{SubMenuComponent.RootMenu.PrefixCls}-submenu";
}
<li class="@TriggerClass"
    role="menuitem"
    style="@SubMenuComponent.OverflowStyle(SubMenuComponent.RootMenu.GetSemanticStyle("subMenu.item", $"position:relative;{SubMenuComponent.Style}"))"
    data-menu-overflow-item="@SubMenuComponent.RootMenu.OverflowItemId(SubMenuComponent.Id, SubMenuComponent.IsOverflowRoot)"
    data-menu-overflow-rest="@(SubMenuComponent.IsOverflowIndicator ? "true" : null)"
    aria-hidden="@(SubMenuComponent.OverflowHidden ? "true" : null)"
    inert="@SubMenuComponent.OverflowHidden"
    @key="SubMenuComponent.Key"
    @ref="@Ref"
    @onclick="OnClickDiv"
    @onmouseenter="OnTriggerMouseEnter"
    @onmouseleave="OnTriggerMouseLeave">
        @ChildContent
</li>

<CascadingValue Value="this" Name="Trigger">
    <Overlay @ref="_overlay"
             OverlayChildPrefixCls="@SubMenuComponent.RootMenu.PrefixCls"
             CssVarClass="@($"{SubMenuComponent.RootMenu.PrefixCls}-css-var")"
             OnOverlayMouseEnter="OnOverlayMouseEnter"
             OnOverlayMouseLeave="OnOverlayMouseLeave"
             OnOverlayMouseUp="OnOverlayMouseUp" />
</CascadingValue>
