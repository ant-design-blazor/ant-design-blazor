@namespace AntDesign
@using Microsoft.AspNetCore.Components.Rendering
@inherits AntDomComponentBase

<div class="@ClassMapper.Class" style="@Style" id="@Id" @ref="Ref">
    <div class="ant-steps-item-container ant-steps-item-wrapper" @onclick="@HandleClick" tabindex="@GetTabIndex()" @attributes="@_containerAttributes">
        <div class="ant-steps-item-icon">
            @if (!ShowProcessDot)
            {
                @if (Percent != null && Parent.Current == Index && Status == StepsStatus.Process)
                {
                    <svg class="ant-steps-item-progress-icon-svg"
                         viewBox="0 0 100 100"
                         width="100%"
                         height="100%"
                         xmlns="http://www.w3.org/2000/svg"
                         role="progressbar"
                         aria-valuemax="100"
                         aria-valuemin="0"
                         aria-valuenow="@Percent">
                        <circle class="ant-steps-item-progress-icon-circle ant-steps-item-progress-icon-circle-rail"></circle>
                        <circle class="ant-steps-item-progress-icon-circle ant-steps-item-progress-icon-circle-ptg"
                                stroke-dasharray="@GetProgressDashArray()"
                                transform="rotate(-90 50 50)"></circle>
                    </svg>
                    <span class="ant-steps-item-icon-number">@(Index + 1)</span>
                }
                else
                {
                    @IconFragment
                }
            }
            else
            {
                <span class="ant-steps-icon">
                    <span class="ant-steps-icon-dot"></span>
                </span>
            }
        </div>
        <div class="ant-steps-item-section">
            <div class="ant-steps-item-header">
                <div class="ant-steps-item-title">
                    @if (TitleTemplate != null)@TitleTemplate else @Title
                    @if (SubtitleTemplate != null || Subtitle != null)
                    {
                        <div class="ant-steps-item-subtitle">
                            @if (SubtitleTemplate != null)@SubtitleTemplate else @Subtitle
                        </div>
                    }
                </div>
                @if (!Last) { <div class="ant-steps-item-rail ant-steps-item-rail-@_statusMap[RailStatus]"></div> }
            </div>
            <div class="ant-steps-item-content">
                @if (DescriptionTemplate != null || Description != null)
                {
                    @if (DescriptionTemplate != null)@DescriptionTemplate else @Description
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string GetProgressDashArray()
    {
        var percentage = ((double) Percent.Value / 100d * Math.PI).ToString("0.################", System.Globalization.CultureInfo.InvariantCulture);
        return $"calc(var(--ant-cmp-steps-progress-radius) * 2 * {percentage}) 9999";
    }

    private void IconFragment(RenderTreeBuilder __builder)
    {
        <span class="ant-steps-icon">
            @if (IconTemplate != null)
            {
                @IconTemplate(Status)
            }
            else if (string.IsNullOrEmpty(Icon))
            {
                if (Status == StepsStatus.Finish)
                {
                    <Icon Type="check" Class="ant-steps-item-icon-finish"></Icon>
                }
                else if (Status == StepsStatus.Error)
                {
                    <Icon Type="close" Class="ant-steps-item-icon-error"></Icon>
                }
                else if (Status == StepsStatus.Process || Status == StepsStatus.Wait)
                {
                    <span class="ant-steps-item-icon-number">@(Index + 1)</span>
                }
            }
            else
            {
                if (Status == StepsStatus.Error)
                {
                    <Icon Type="close" Class="ant-steps-item-icon-error"></Icon>
                }
                else
                {
                    <Icon Type="@Icon"></Icon>
                }
            }
        </span>
    }
}
