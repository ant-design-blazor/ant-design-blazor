@namespace AntDesign
@inherits AntDomComponentBase

<div class="@(GetSemanticClass("root", ClassMapper.Class))" style="@(GetSemanticStyle("root", Style))" id="@Id" @ref="Ref">
    @if (!string.IsNullOrWhiteSpace(Avatar) || AvatarTemplate != null)
    {
        <div class="@(GetSemanticClass("avatar", "ant-card-meta-avatar"))" style="@(GetSemanticStyle("avatar"))">
            @if (AvatarTemplate != null)
            {
                @AvatarTemplate
            }
            else
            {
                <Avatar Src="@Avatar" />
            }
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Title) || TitleTemplate != null
            || !string.IsNullOrWhiteSpace(Description) || DescriptionTemplate != null)
    {
        <div class="@(GetSemanticClass("section", "ant-card-meta-section"))" style="@(GetSemanticStyle("section"))">
            @if (!string.IsNullOrWhiteSpace(Title) || TitleTemplate != null)
            {
                <div class="@(GetSemanticClass("title", "ant-card-meta-title"))" style="@(GetSemanticStyle("title"))">
                    @if (TitleTemplate != null)
                    {
                        @TitleTemplate
                    }
                    else
                    {
                        @Title
                    }
                </div>
            }
            <div class="@(GetSemanticClass("description", "ant-card-meta-description"))" style="@(GetSemanticStyle("description"))">
                @if (DescriptionTemplate != null)
                {
                    @DescriptionTemplate
                }
                else
                {
                    @Description
                }
            </div>
        </div>
    }
</div>

@code{

    /// <summary>
    /// Title string
    /// </summary>
    [Parameter]
    public string Title { get; set; }

    /// <summary>
    /// Title content. Takes priority over <see cref="Title"/>
    /// </summary>
    [Parameter]
    public RenderFragment TitleTemplate { get; set; }

    /// <summary>
    /// Description string
    /// </summary>
    [Parameter]
    public string Description { get; set; }

    /// <summary>
    /// Description content. Takes priority over <see cref="Description"/>
    /// </summary>
    [Parameter]
    public RenderFragment DescriptionTemplate { get; set; }

    /// <summary>
    /// Avatar string. Will be passed to <see cref="AntDesign.Avatar"/> component's <see cref="AntDesign.Avatar.Src"/>
    /// </summary>
    [Parameter]
    public string Avatar { get; set; }

    /// <summary>
    /// Avatar content. Takes priority over <see cref="Avatar"/>
    /// </summary>
    [Parameter]
    public RenderFragment AvatarTemplate { get; set; }

    /// <summary>
    /// Semantic classes keyed by root, section, avatar, title, and description.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> ClassNames { get; set; }

    /// <summary>
    /// Semantic inline styles keyed by root, section, avatar, title, and description.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, string> Styles { get; set; }

    private string GetSemanticClass(string slot, string baseClass)
    {
        if (ClassNames == null || !ClassNames.TryGetValue(slot, out var semanticClass) || string.IsNullOrWhiteSpace(semanticClass))
            return baseClass;

        return $"{baseClass} {semanticClass}";
    }

    private string GetSemanticStyle(string slot, string baseStyle = null)
    {
        if (Styles == null || !Styles.TryGetValue(slot, out var semanticStyle) || string.IsNullOrWhiteSpace(semanticStyle))
            return baseStyle;

        if (string.IsNullOrWhiteSpace(baseStyle))
            return semanticStyle;

        return $"{baseStyle.Trim().TrimEnd(';')}; {semanticStyle}";
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ClassMapper.Add("ant-card-meta");
    }

}
