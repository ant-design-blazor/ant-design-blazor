@namespace AntDesign
@inherits AntDomComponentBase

<CascadingValue Value="this" IsFixed="@true">
    <div class="@ClassMapper.Class" style="@(GetSemanticStyle("root", Style))" id="@Id" @ref="Ref">
        @if (TitleTemplate != null || Title != null || Extra != null || _cardTabs != null)
        {
            <div class="@(GetSemanticClass("header", "ant-card-head"))" style="@(GetSemanticStyle("header", HeadStyle))">

                <div class="ant-card-head-wrapper">
                    @if (TitleTemplate != null || Title != null)
                    {
                        <div class="@(GetSemanticClass("title", "ant-card-head-title"))" style="@(GetSemanticStyle("title"))">
                            @if (TitleTemplate != null)
                            {
                                @TitleTemplate
                            }
                            else
                            {
                                @Title
                            }
                        </div>
                        @if (Extra != null)
                        {
                            <div class="@(GetSemanticClass("extra", "ant-card-extra"))" style="@(GetSemanticStyle("extra"))">
                                @Extra
                            </div>
                        }
                    }
                </div>

                @if (_cardTabs != null)
                {
                    @_cardTabs
                }
            </div>
        }

        @if (Cover != null)
        {
            <div class="@(GetSemanticClass("cover", "ant-card-cover"))" style="@(GetSemanticStyle("cover"))">
                @Cover
            </div>
        }

        @if (Body != null || ChildContent != null || _cardTabPanels != null)
        {
            <div class="@(GetSemanticClass("body", "ant-card-body"))" style="@(GetSemanticStyle("body", BodyStyle))">
                @if (!Loading)
                {
                    @_cardTabPanels
                    @Body
                    @ChildContent
                }
                else
                {
                   <Skeleton Loading Active ParagraphRows="4" Title="false"></Skeleton>
                }
            </div>
        }
        @if (ActionTemplate != null)
        {
            <ul class="@(GetSemanticClass("actions", "ant-card-actions"))" style="@(GetSemanticStyle("actions"))">
                @ActionTemplate
            </ul>
        }
        else if (Actions.Count > 0)
        {
            <ul class="@(GetSemanticClass("actions", "ant-card-actions"))" style="@(GetSemanticStyle("actions"))">
                @foreach (var action in Actions)
                {
                    <li style="@($"width:{100 / Actions.Count}%") ">
                        <span>@action</span>
                    </li>
                }
            </ul>
        }
        @Decoration
    </div>
</CascadingValue>
