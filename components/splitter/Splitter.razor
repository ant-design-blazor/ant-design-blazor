@namespace AntDesign
@inherits AntDomComponentBase

<CascadingValue Value="this" IsFixed>
    @ChildContent
</CascadingValue>

<div id="@Id" class="@SemanticClass("root", $"{ClassMapper.Class} ant-splitter-css-var")"
    style="@GetComponentStyle("Splitter", SemanticStyle("root", Style))" @ref="@Ref">
    @for (var paneIndex = 0; paneIndex < _panes.Count; paneIndex++)
    {
        var pane = _panes[paneIndex];
        <div class="@GetPanelClass(pane)"
            style="@SemanticStyle("panel", GetPaneStyle(pane))">
            @pane.ChildContent
        </div>

        @if (paneIndex < _panes.Count - 1)
        {
            var nextPane = _panes[paneIndex + 1];
            <div class="ant-splitter-bar">
                @if (Lazy)
                {
                    <div class="ant-splitter-bar-preview" style="--ant-splitter-bar-preview-offset: 0px"></div>
                }
                <div class="@GetDraggerClass(paneIndex)" style="@GetDraggerStyle(paneIndex)"
                    role="separator" aria-disabled="@IsDraggerDisabled(paneIndex).ToString().ToLowerInvariant()" aria-orientation="@(Vertical ? "vertical" : "horizontal")">
                    @if (DraggerIcon != null)
                    {
                        <span class="ant-splitter-bar-dragger-icon">@DraggerIcon</span>
                    }
                </div>
                @if (pane.Collapsible)
                {
                    <div class="ant-splitter-bar-collapse-bar ant-splitter-bar-collapse-bar-start @GetCollapseVisibilityClass(pane) @(CollapseIconStart != null ? "ant-splitter-bar-collapse-bar-customize" : null)" @onclick="pane.ToggleCollapse">
                        @if (CollapseIconStart != null)
                        {
                            <span class="ant-splitter-bar-collapse-icon ant-splitter-bar-collapse-start">@CollapseIconStart</span>
                        }
                        else
                        {
                            <Icon Class="ant-splitter-bar-collapse-icon ant-splitter-bar-collapse-start" Type="@GetCollapseIconType(pane, true)"></Icon>
                        }
                    </div>
                }
                @if (nextPane.Collapsible)
                {
                    <div class="ant-splitter-bar-collapse-bar ant-splitter-bar-collapse-bar-end @GetCollapseVisibilityClass(nextPane) @(CollapseIconEnd != null ? "ant-splitter-bar-collapse-bar-customize" : null)" @onclick="nextPane.ToggleCollapse">
                        @if (CollapseIconEnd != null)
                        {
                            <span class="ant-splitter-bar-collapse-icon ant-splitter-bar-collapse-end">@CollapseIconEnd</span>
                        }
                        else
                        {
                            <Icon Class="ant-splitter-bar-collapse-icon ant-splitter-bar-collapse-end" Type="@GetCollapseIconType(nextPane, false)"></Icon>
                        }
                    </div>
                }
            </div>
        }
    }

</div>
