@namespace AntDesign.Internal
@inherits AntDomComponentBase

<div class="@Upload?.SemanticClass("trigger", ClassMapper.Class)" style="@(Upload?.SemanticStyle("trigger", !ShowButton ? "display:none;" : null))">
    <span class="@(Upload?.Drag == true ? "ant-upload ant-upload-btn" : "ant-upload")"
          role="@(Upload?.Drag == true ? "button" : null)"
          tabindex="@(Upload?.Drag == true ? "0" : null)"
          @ref="_btn">
        @if (!string.IsNullOrEmpty(Upload?.Action))
        {
            <input type="file"
                   name="@Name"
                   webkitdirectory="@Directory"
                   multiple="@(Multiple || Directory)"
                   @ref="_file"
                   @onchange="FileNameChanged"
                   accept="@(Accept ?? string.Empty)"
                   style="display:none;"
                   />
        }
        @if (Upload?.Trigger == UploadTrigger.Click && Upload?.Drag == true)
        {
            <div class="ant-upload-drag-container">
                @ChildContent
            </div>
        }
        else
        {
            @ChildContent
        }
    </span>
</div>
