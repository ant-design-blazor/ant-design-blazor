@namespace AntDesign
@typeparam TValue
@inherits AntInputComponentBase<TValue>


<div class="@ClassMapper.Class" style="@WidthStyle @Style" id="@Id">
    @if (Prefix.Value != null)
    {
        <span class="ant-input-number-prefix">
            @if (Prefix.IsT0)
            {
                @Prefix.AsT0
            }
            else
            {
                @Prefix.AsT1
            }
        </span>
    }
    <input id="@(Id)_input" @ref="Ref" role="spinbutton" aria-valuemin="@Min" aria-valuemax="@Max" autocomplete="off" max="@Max" min="@Min" step="@Step" inputmode="@_inputNumberMode" placeholder="@PlaceHolder"
           aria-valuenow="@CurrentValue" class="ant-input-number-input" @bind="@CurrentValueAsString" @oninput="OnInput" @onkeydown="OnKeyDown" @onwheel="OnWheel" @onwheel:preventDefault="ChangeOnWheel && _focused" @onfocus="@OnFocusAsync" @onblur="@OnBlurAsync" disabled="@Disabled"
           maxlength="@MaxLength" name="@NameAttributeValue" />
    @if (FormItem?.FeedbackIcon != null)
    {
        <span class="ant-input-number-suffix">@FormItem.FeedbackIcon</span>
    }
    @if (Suffix.Value != null)
    {
        <span class="ant-input-number-suffix">
            @if (Suffix.IsT0)
            {
                @Suffix.AsT0
            }
            else
            {
                @Suffix.AsT1
            }
        </span>
    }
    @if (Controls)
    {
        <div class="ant-input-number-actions">
            <span unselectable="on" role="button" aria-label="Increase Value" aria-disabled="@IsIncreaseDisabled" class="@GetIconClass("up")" @onmousedown="IncreaseDown" @onmouseup="IncreaseUp" @onmouseout="IncreaseUp">
                @if (ControlsUpIcon is not null) { @ControlsUpIcon } else { <Icon Type="up" /> }
            </span>
            <span unselectable="on" role="button" aria-label="Decrease Value" aria-disabled="@IsDecreaseDisabled" class="@GetIconClass("down")" @onmousedown="DecreaseDown" @onmouseup="DecreaseUp" @onmouseout="DecreaseUp">
                @if (ControlsDownIcon is not null) { @ControlsDownIcon } else { <Icon Type="down" /> }
            </span>
        </div>
    }
</div>
