@namespace AntDesign.Internal.ModalDialog

@if (Config.TitleTemplate != null)
{

        <div id="@TitleId" class=@($"{Config.PrefixCls}-title")>
            @Config.TitleTemplate
        </div>
  
}
else if (!string.IsNullOrWhiteSpace(Config.Title))
{
  
        <div id="@TitleId" class=@($"{Config.PrefixCls}-title")>
            @Config.Title
        </div>
  
}
