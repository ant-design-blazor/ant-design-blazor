@namespace AntDesign
@using AntDesign.Icons
@inherits AntDomComponentBase

<div class="@ClassMapper.Class" style="@Style" id="@Id" @ref="Ref" data-collapse-key="@(Collapse.Animation ? Key : null)">
    <div class="@HeaderClass" style="@Collapse.SemanticStyle("header")" data-collapse-trigger="@(Collapse.Animation && HeaderOwnsInteraction ? "" : null)" @onclick="OnHeaderClick" @onkeydown="OnHeaderKeyDown" role="@(HeaderOwnsInteraction ? TriggerRole : null)" aria-disabled="@(HeaderOwnsInteraction ? IsInteractionDisabled.ToString().ToLowerInvariant() : null)" aria-expanded="@(HeaderOwnsInteraction ? Active.ToString().ToLowerInvariant() : null)" tabindex="@(HeaderOwnsInteraction ? (IsInteractionDisabled ? -1 : 0) : null)">
        @if (ShowArrow)
        {
            <div class="@Collapse.SemanticClass("icon", "ant-collapse-expand-icon")" style="@Collapse.SemanticStyle("icon")" data-collapse-trigger="@(Collapse.Animation && IconOwnsInteraction ? "" : null)" @onclick="OnExpandIconClick" @onclick:stopPropagation="@IconOwnsInteraction" role="@(IconOwnsInteraction ? TriggerRole : null)" aria-expanded="@(IconOwnsInteraction ? Active.ToString().ToLowerInvariant() : null)" aria-disabled="@(IconOwnsInteraction ? "false" : null)" tabindex="@(IconOwnsInteraction ? 0 : null)" @onkeydown="OnExpandIconKeyDown">
                @if (Collapse.ExpandIconTemplate != null)
                {
                    @Collapse.ExpandIconTemplate(Active)
                }
                else if (Collapse.ExpandIcon == IconType.Outline.Right)
                {
                    <RightOutlined Class="ant-collapse-arrow" Rotate="@(Active ? (RTL ? -90 : 90) : 0)" AriaLabel="@(IconOwnsInteraction ? (Active ? "expanded" : "collapsed") : null)" aria-hidden="@(IconOwnsInteraction ? null : "true")" />
                }
                else
                {
                    <Icon Type="@Collapse.ExpandIcon" Class="ant-collapse-arrow" Rotate="@(Active ? 90 : 0)" />
                }
            </div>
        }

        <span class="@Collapse.SemanticClass("title", "ant-collapse-title")" style="@Collapse.SemanticStyle("title")" data-collapse-trigger="@(Collapse.Animation && TitleOwnsInteraction ? "" : null)" @onclick="OnTitleClick" @onclick:stopPropagation="@TitleOwnsInteraction" @onkeydown="OnTitleKeyDown" role="@(TitleOwnsInteraction ? TriggerRole : null)" aria-expanded="@(TitleOwnsInteraction ? Active.ToString().ToLowerInvariant() : null)" aria-disabled="@(TitleOwnsInteraction ? "false" : null)" tabindex="@(TitleOwnsInteraction ? 0 : null)">
            @if (HeaderTemplate != null)@HeaderTemplate else @Header
        </span>

        @if (Extra != null || ExtraTemplate != null)
        {
            <div class="ant-collapse-extra">
                @if (ExtraTemplate != null)@ExtraTemplate else @Extra
            </div>
        }
    </div>
    @if (_hasRendered)
    {
        <div class="@_contentClassMapper.Class" @ref="@_warpperRef" style="@(string.IsNullOrWhiteSpace(_warpperStyle) ? null : _warpperStyle)" hidden="@_isHidden" inert="@(!_isActive)" role="@(Collapse.Accordion ? "tabpanel" : null)">
            <div class="@Collapse.SemanticClass("body", "ant-collapse-body")" style="@Collapse.SemanticStyle("body")">@ChildContent</div>
        </div>
    }
</div>
