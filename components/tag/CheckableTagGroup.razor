@namespace AntDesign
@inherits AntDomComponentBase

<div @attributes="AdditionalAttributes" class="@SemanticClass("root", "ant-tag-checkable-group")" style="@SemanticStyle("root", Style)" id="@Id" @ref="Ref">
    @if (Options != null)
    {
        @foreach (var option in Options)
        {
            var selected = Multiple ? (CurrentValues?.Contains(option.Value) ?? false) : CurrentValue == option.Value;
            <Tag Checkable="true"
                 Checked="@selected"
                 CheckedChanged="@(isChecked => HandleChange(option.Value, isChecked))"
                 Disabled="@Disabled"
                 Class="@GetItemClass(option)"
                 Style="@GetItemStyle(option)"
                 @key="option.Value">
                @option.Label
            </Tag>
        }
    }
</div>
