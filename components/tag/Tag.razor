@namespace AntDesign
@inherits AntDomComponentBase

@if (!string.IsNullOrEmpty(Href))
{
    <a @attributes="AdditionalAttributes" class="@ClassMapper.Class" style="@_style" id="@Id" @ref="Ref"
       href="@(Disabled ? null : Href)" target="@Target" aria-disabled="@(Disabled ? "true" : null)"
       @onclick="ClickTag" @onmousedown:preventDefault="PreventMouseDownDefault" @onmousedown:stopPropagation="StopMouseDownPropagation"
       role="@(Checkable ? "checkbox" : null)" aria-checked="@(Checkable ? Checked.ToString().ToLowerInvariant() : null)"
       tabindex="@(Checkable && !Disabled ? "0" : null)" @onkeydown="HandleKeyDown">
        @TagBody
    </a>
}
else
{
    <span @attributes="AdditionalAttributes" class="@ClassMapper.Class" style="@_style" id="@Id" @ref="Ref" @onclick="ClickTag"
          @onmousedown:preventDefault="PreventMouseDownDefault" @onmousedown:stopPropagation="StopMouseDownPropagation"
          role="@(Checkable ? "checkbox" : null)" aria-checked="@(Checkable ? Checked.ToString().ToLowerInvariant() : null)"
          aria-disabled="@(Checkable && Disabled ? "true" : null)" tabindex="@(Checkable && !Disabled ? "0" : null)"
          @onkeydown="HandleKeyDown">
        @TagBody
    </span>
}

@code {
    private RenderFragment TagBody => builder =>
    {
        var sequence = 0;
        if (IconTemplate != null)
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", SemanticClass("icon", "ant-tag-icon"));
            builder.AddAttribute(sequence++, "style", SemanticStyle("icon"));
            builder.AddContent(sequence++, IconTemplate);
            builder.CloseElement();
            if (ChildContent != null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", SemanticClass("content", "ant-tag-content"));
                builder.AddAttribute(sequence++, "style", SemanticStyle("content"));
                builder.AddContent(sequence++, ChildContent);
                builder.CloseElement();
            }
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            builder.OpenElement(sequence++, "span");
            builder.AddAttribute(sequence++, "class", SemanticClass("icon", "ant-tag-icon"));
            builder.AddAttribute(sequence++, "style", SemanticStyle("icon"));
            builder.OpenComponent<AntDesign.Icon>(sequence++);
            builder.AddAttribute(sequence++, nameof(AntDesign.Icon.Type), Icon);
            builder.AddAttribute(sequence++, nameof(AntDesign.Icon.Theme), IconTheme);
            builder.CloseComponent();
            builder.CloseElement();
            if (ChildContent != null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", SemanticClass("content", "ant-tag-content"));
                builder.AddAttribute(sequence++, "style", SemanticStyle("content"));
                builder.AddContent(sequence++, ChildContent);
                builder.CloseElement();
            }
        }
        else
        {
            builder.AddContent(sequence++, ChildContent);
        }

        if (ShowCloseIcon)
        {
            if (CloseIcon != null)
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", SemanticClass("close", "ant-tag-close-icon"));
                builder.AddAttribute(sequence++, "style", SemanticStyle("close"));
                builder.AddAttribute(sequence++, "role", "button");
                builder.AddAttribute(sequence++, "aria-label", "Close");
                if (Disabled)
                {
                    builder.AddAttribute(sequence++, "aria-disabled", "true");
                }
                builder.AddAttribute(sequence++, "tabindex", Disabled ? "-1" : "0");
                builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, CloseTag));
                builder.AddEventStopPropagationAttribute(sequence++, "onclick", true);
                builder.AddEventPreventDefaultAttribute(sequence++, "onclick", !string.IsNullOrEmpty(Href));
                builder.AddAttribute(sequence++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, CloseTagFromKeyboard));
                builder.AddEventStopPropagationAttribute(sequence++, "onkeydown", true);
                builder.AddContent(sequence++, CloseIcon);
                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(sequence++, "span");
                builder.AddAttribute(sequence++, "class", SemanticClass("close", "ant-tag-close-icon"));
                builder.AddAttribute(sequence++, "style", SemanticStyle("close"));
                builder.AddAttribute(sequence++, "role", "button");
                builder.AddAttribute(sequence++, "aria-label", "Close");
                if (Disabled)
                {
                    builder.AddAttribute(sequence++, "aria-disabled", "true");
                }
                builder.AddAttribute(sequence++, "tabindex", Disabled ? "-1" : "0");
                builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create<MouseEventArgs>(this, CloseTag));
                builder.AddEventStopPropagationAttribute(sequence++, "onclick", true);
                builder.AddEventPreventDefaultAttribute(sequence++, "onclick", !string.IsNullOrEmpty(Href));
                builder.AddAttribute(sequence++, "onkeydown", EventCallback.Factory.Create<KeyboardEventArgs>(this, CloseTagFromKeyboard));
                builder.AddEventStopPropagationAttribute(sequence++, "onkeydown", true);
                builder.OpenComponent<AntDesign.Icon>(sequence++);
                builder.AddAttribute(sequence++, nameof(AntDesign.Icon.Type), "close");
                builder.CloseComponent();
                builder.CloseElement();
            }
        }
    };
}
