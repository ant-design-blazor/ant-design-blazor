@namespace AntDesign
@inherits AntDomComponentBase

@if (!_closed)
{
    <span class="@ClassMapper.Class" style="@_style" id="@Id" @ref="Ref" @onclick="ClickTag">
        @if (IconTemplate != null)
        {
            <span class="ant-tag-icon">@IconTemplate</span>
        }
        else if (!string.IsNullOrEmpty(Icon))
        {
            <span class="ant-tag-icon"><Icon Type="@Icon" Theme="@IconTheme"></Icon></span>
        }
        <span class="ant-tag-content">@ChildContent</span>
        @if (Closable)
        {
            <span class="ant-tag-close">
                <Icon Type="close" TabIndex="-1" OnClick="CloseTag" StopPropagation="true" />
            </span>
        }
    </span>
}
