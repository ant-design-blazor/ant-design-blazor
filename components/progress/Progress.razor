@namespace AntDesign
@inherits AntDomComponentBase

<div class="@ClassMapper.Class" style="@GetComponentStyle("Progress", Style)" id="@Id" @ref="Ref" role="progressbar" aria-valuenow="@Percent" aria-valuemin="0" aria-valuemax="100">
    @if (Type == ProgressType.Line)
    {
        @if (Steps == 0)
        {
            <div class="ant-progress-body" style="width:100%">
                <div class="ant-progress-rail" style="height:@(StrokeWidth)px; background-color:@TrailColor">
                    <div class="ant-progress-track" style="@_bgStyle">
                    </div>
                    @if (SuccessPercent != 0)
                    {
                        <div class="ant-progress-success-bg" style="@_bgSuccessStyle">
                        </div>
                    }
                </div>
                @if (ShowInfo)
                {
                    if (Status == ProgressStatus.Success)
                    {
                        <span class="ant-progress-indicator ant-progress-indicator-end ant-progress-indicator-outer">
                            <Icon Type="check-circle" Theme="@IconThemeType.Fill" />
                        </span>
                    }
                    else if (Status == ProgressStatus.Exception)
                    {
                        <span class="ant-progress-indicator ant-progress-indicator-end ant-progress-indicator-outer">
                            <Icon Type="close-circle" Theme="@IconThemeType.Fill" />
                        </span>
                    }
                    else
                    {
                        <span title="@Format(Percent)" class="ant-progress-indicator ant-progress-indicator-end ant-progress-indicator-outer">@Format(Percent)</span>
                    }
                }
            </div>
        }
        else
        {
            <div class="ant-progress-steps-outer">
                @for (int i = 0; i < Steps; i++)
                {
                    int index = i;
                    if (Percent >= 100 / Steps * (index + 1))
                    {
                        <div class="ant-progress-steps-item" style="width: @(Size == ProgressSize.Default?"14":"2")px; height: 8px; background-color: @(ToRGB(StrokeColor.AsT0));"></div>
                    }
                    else
                    {
                        <div class="ant-progress-steps-item" style="width: @(Size == ProgressSize.Default?"14":"2")px; height: 8px;"></div>
                    }
                }
                @if (Status == ProgressStatus.Success)
                {
                    <span class="ant-progress-text">
                        <Icon Type="check-circle" Theme="@IconThemeType.Fill" />
                    </span>
                }
                else if (Status == ProgressStatus.Exception)
                {
                    <span class="ant-progress-text">
                        <Icon Type="close-circle" Theme="@IconThemeType.Fill" />
                    </span>
                }
                else
                {
                    <span title="@Format(Percent)" class="ant-progress-indicator ant-progress-text">@Format(Percent)</span>
                }
            </div>
        }
    }
    else if (Type == ProgressType.Circle)
    {
        <div class="@(StrokeColor.IsT1?"ant-progress-body ant-progress-circle-gradient": "ant-progress-body")" style="@_bgStyle">
            <svg class="ant-progress-circle" viewBox="0 0 100 100" role="presentation">
                @if (StrokeColor.IsT1)
                {
                    <defs>
                        <linearGradient id="ant-progress-gradient-@Id" x1="100%" y1="0%" x2="0%" y2="0%">
                            @foreach (var pair in StrokeColor.AsT1)
                            {
                                <stop stop-color="@ToRGB(pair.Value)" offset="@(pair.Key)" />
                            }
                        </linearGradient>
                    </defs>
                }
                <circle class="ant-progress-circle-rail" r="@CircleRadius" cx="50" cy="50" stroke-linecap="@StrokeLinecap.ToString().ToLowerInvariant()" stroke-width="@StrokeWidth" style="@GetCircleSegmentStyle(100, 0, TrailColor)" />
                <circle class="ant-progress-circle-path" r="@CircleRadius" cx="50" cy="50" stroke-linecap="@StrokeLinecap.ToString().ToLowerInvariant()" stroke-width="@StrokeWidth" opacity="@(Percent > SuccessPercent ? 1 : 0)" stroke="@(StrokeColor.IsT1?$"url(#ant-progress-gradient-{Id})":null)" style="@GetCircleSegmentStyle(Math.Max(0, Percent - SuccessPercent), SuccessPercent, StrokeColor.IsT0 ? StrokeColor.AsT0 : null)" />
                <circle class="ant-progress-circle-path" r="@CircleRadius" cx="50" cy="50" stroke-linecap="@StrokeLinecap.ToString().ToLowerInvariant()" stroke-width="@StrokeWidth" opacity="@(SuccessPercent > 0 ? 1 : 0)" style="@GetCircleSegmentStyle(SuccessPercent, 0, "#52c41a")" />
            </svg>
            @if (ShowInfo && Width > 20)
            {
            @if (Status == ProgressStatus.Success && Format == null)
            {
                <span class="ant-progress-text">
                    <Icon Type="check-circle" Theme="@IconThemeType.Fill" />
                </span>
            }
            else if (Status == ProgressStatus.Exception && Format == null)
            {
                <span class="ant-progress-text">
                    <Icon Type="close-circle" Theme="@IconThemeType.Fill" />
                </span>
            }
            else
            {
                <span title="@Format(Percent)" class="ant-progress-text">@Format(Percent)</span>
            }
            }
        </div>
    }
    else
    {
        <div class="ant-progress-inner" style="width: @(Width)px; height: @(Width)px; font-size: 24px;">
            <svg xmlns="http://www.w3.org/2000/svg" class="ant-progress-circle" viewBox="0 0 100 100">
                <path class="ant-progress-circle-trail" style="@_circleTrailStyle" fill-opacity="0" stroke="@TrailColor" stroke-linecap="@StrokeLinecap.ToString().ToLowerInvariant()" stroke-width="@StrokeWidth" d="M 50 50 m 0 47 a 47 47 0 1 1 0 -94 a 47 47 0 1 1 0 94" />
                @if (SuccessPercent != 0)
                {
                            <path class="ant-progress-circle-path" style="@_circleSuccessStyle" opacity="1" fill-opacity="0" stroke="" stroke-linecap="@StrokeLinecap.ToString().ToLowerInvariant()" stroke-width="@StrokeWidth" d="M 50 50 m 0 47 a 47 47 0 1 1 0 -94 a 47 47 0 1 1 0 94" />
                }
                    <path class="ant-progress-circle-path" style="@_circlePathStyle" opacity="1" fill-opacity="0" stroke="" stroke-linecap="@StrokeLinecap.ToString().ToLowerInvariant()" stroke-width="@StrokeWidth" d="M 50 50 m 0 47 a 47 47 0 1 1 0 -94 a 47 47 0 1 1 0 94" />
            </svg>
            @if (Status == ProgressStatus.Success && Format == null)
            {
                <span class="ant-progress-text">
                    <Icon Type="check-circle" Theme="@IconThemeType.Fill" />
                </span>
            }
            else if (Status == ProgressStatus.Exception && Format == null)
            {
                <span class="ant-progress-text">
                    <Icon Type="close-circle" Theme="@IconThemeType.Fill" />
                </span>
            }
            else
            {
                <span title="@Format(Percent)" class="ant-progress-text">@Format(Percent)</span>
            }
        </div>
    }

</div>
