@namespace AntDesign
@inherits AntDomComponentBase

<span class="@IconClass" style="@(!string.IsNullOrWhiteSpace(Style) ? Style : null)" id="@Id" tabindex="@IconTabIndex" @ref="Ref" @attributes="_attributes" @onclick:stopPropagation="StopPropagation" @onkeydown="OnKeyDown">
    @if (ComponentTemplate != null)
    {
        @ComponentTemplate(ComponentAttributes)
    }
    else if (Component == null)
    {
        @((MarkupString)_svgImg)
    }
    else
    {
        @Component
    }

</span>
