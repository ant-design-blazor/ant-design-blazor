@namespace AntDesign
@inherits DatePickerBase<TValue>
@typeparam TValue
@using AntDesign.Internal;
@using AntDesign.Icons;

<CascadingValue Value='$"{PrefixCls}-dropdown"' Name="PrefixCls">
    <OverlayTrigger @ref="@_dropDown"
                    Visible="Open"
                    IsButton="@true"
                    BoundaryAdjustMode="@BoundaryAdjustMode"
                    Disabled="IsDisabled(0)"
                    PopupContainerSelector="@PopupContainerSelector"
                    PopupWidthMode="content"
                    OnVisibleChange="OverlayVisibleChange"
                    OverlayAnimation="@(new OverlayAnimationOptions { Animation = "slide", Direction = "up" })"
                    Placement="Placement"
                    OverlayClassName="@SemanticPopupClass("popup.root", "ant-picker-css-var")"
                    OverlayDisplayStyle="block"
                    UseCssZIndex
                    Trigger="new[] { Trigger.Click }">
        <Overlay>
            <div class="@SemanticPopupClass("popup.container", $"{PrefixCls}-panel-container {(Picker == DatePickerType.Time ? $"{PrefixCls}-time-panel-container" : $"{PrefixCls}-date-panel-container")}")" style="@SemanticPopupStyle("popup.container")" tabindex="-1" @onclick="@PickerClicked">
                <div class="@(PrefixCls)-panel-layout">
                    <div>
                        <DatePickerPanelChooser TValue="TValue" DatePicker="@this" OnSelect="async (date, index) => await OnSelect(date, index)" />
                    </div>
                        @if (NeedConfirm && !HasTimeInput)
                        {
                            <div class="@SemanticClass("popup.footer", $"{PrefixCls}-footer")" style="@SemanticStyle("popup.footer")">
                                <ul class="@(PrefixCls)-ranges">
                                    <li class="@(PrefixCls)-ok">
                                        <Button Type="@ButtonType.Primary" Size="@ButtonSize.Small" OnClick="OnOkClick">
                                            @Locale.Lang.Ok
                                        </Button>
                                    </li>
                                </ul>
                            </div>
                        }
                </div>
            </div>
        </Overlay>
        <Unbound>
            <div class="@SemanticClass("root", ClassMapper.Class)"
                 @ref="@context.Current"
                 style="@SemanticStyle("root", Style)"
                 Id="@Id">
                @if (Prefix != null)
                {
                    <span class="@SemanticClass("prefix", $"{PrefixCls}-prefix")" style="@SemanticStyle("prefix")">@Prefix</span>
                }
                @if (Multiple)
                {
                    <div class="@($"{PrefixCls}-selector")" @onclick="async () => await OnInputClick()">
                        <div @ref="_selectionOverflow" class="@($"{PrefixCls}-selection-overflow")">
                            @{
                                var selectedDates = GetSelectedDates();
                                var visibleCount = IsResponsiveTagCount ? Math.Min(_responsiveTagCount, selectedDates.Count) : Math.Min(FixedMaxTagCount, selectedDates.Count);
                                EnsureSelectionTagReferences(selectedDates.Count);
                            }
                            @for (var i = 0; i < selectedDates.Count; i++)
                            {
                                var index = i;
                                var date = selectedDates[index];
                                var formatted = GetFormatValue(date, 0);
                                var visible = index < visibleCount;
                                <div @ref="_selectionTagRefs[index]" class="@($"{PrefixCls}-selection-overflow-item")" style="@GetSelectionTagStyle(index, visibleCount)" aria-hidden="@(visible ? null : "true")">
                                    <span class="@($"{PrefixCls}-selection-item")" title="@formatted">
                                        <span class="@($"{PrefixCls}-selection-item-content")">@formatted</span>
                                        <span class="@($"{PrefixCls}-selection-item-remove")" @onclick="() => RemoveSelectedDate(index)" @onclick:stopPropagation="true">
                                            <CloseOutlined AriaLabel="close" />
                                        </span>
                                    </span>
                                </div>
                            }
                            @if (selectedDates.Count > visibleCount || (IsResponsiveTagCount && selectedDates.Count > 0))
                            {
                                var hasOverflow = selectedDates.Count > visibleCount;
                                var overflowCount = hasOverflow ? selectedDates.Count - visibleCount : selectedDates.Count;
                                <div @ref="_aggregateTagMeasure"
                                      class="@($"{PrefixCls}-selection-overflow-item {PrefixCls}-selection-overflow-item-rest")"
                                      style="@GetAggregateTagStyle(visibleCount, selectedDates.Count, hasOverflow)"
                                      aria-hidden="@(hasOverflow ? null : "true")">
                                    <span class="@($"{PrefixCls}-selection-item")" title="@($"+ {overflowCount} ...")">
                                        <span class="@($"{PrefixCls}-selection-item-content")">+ @overflowCount ...</span>
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                        <input class="@($"{PrefixCls}-multiple-input")"
                               readonly="@string.Empty"
                               value="@GetInputValue(0)" />
                    @if (SuffixIcon != null)
                    {
                        <span class="@($"{PrefixCls}-suffix")" @onclick="OnSuffixIconClick">@SuffixIcon</span>
                    }
                    else
                    {
                        <span class="@($"{PrefixCls}-suffix")" @onclick="OnSuffixIconClick"><CalendarOutlined AriaLabel="calendar" aria-hidden="true" /></span>
                    }
                    @if (AllowClear && GetSelectedDates().Count > 0 && !IsDisabled())
                    {
                        <button type="button" aria-label="Clear" class="@($"{PrefixCls}-clear")" @onclick="() => ClearValue(0)" @onclick:stopPropagation="true"><Icon Type="@IconType.Fill.CloseCircle" Theme="IconThemeType.Fill" /></button>
                    }
                }
                else
                {
                <DatePickerInput @ref="_inputStart"
                                 PrefixCls="@PrefixCls"
                                 Size="@Size"
                                 Disabled="IsDisabled(0)"
                                 Value="@GetInputValue(0)"
                                 PreviewValue="@_previewValues[0]"
                                 Placeholder="@_placeholders[0]"
                                 AriaInvalid="@IsInvalid"
                                 ReadOnly="@InputReadOnly"
                                 AutoFocus="@AutoFocus"
                                 OnClick="async e => { await OnInputClick(); }"
                                 OnSuffixIconClick="OnSuffixIconClick"
                                 OnKeyDown="@OnKeyDown"
                                 OnInput="e => OnInput(e, 0)"
                                 OnBlur="e => OnBlur(0)"
                                 Mask="@Mask"
                                 Onfocus="e => AutoFocus = true"
                                 ShowTime="@(Picker == DatePickerType.Time)"
                                 OnClickClear="e => ClearValue(0)"
                                 HtmlInputSize="@HtmlInputSize"
                                 SuffixIcon="@SuffixIcon"
                                 ClassNames="@ClassNames"
                                 Styles="@Styles"
                                 FeedbackIcon="@FormItem?.FeedbackIcon"
                                 AllowClear="@AllowClear" />
                }
            </div>
        </Unbound>
    </OverlayTrigger>
</CascadingValue>
