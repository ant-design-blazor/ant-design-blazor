@namespace AntDesign.Internal
@typeparam TValue
@inherits DatePickerPanelBase<TValue>
@using System.Globalization;

@{
    var calendar = Calendar;

    int startYear = calendar.GetYear(PickerValue) / 10 * 10 - 1;
    DateTime startDate;
    if (startYear > 0)
        startDate = DateHelper.CreateDate(calendar, startYear, 1, 1, PickerValue);
    else
        startDate = DateTime.MinValue;

    int yearIndex = 0;
}
<div class='@($"{PrefixCls}-panel")' @ref="Ref">
    <DatePickerTemplate @attributes="GetAttributes()"
                        TValue="TValue"
                        MaxRow="MAX_ROW"
                        MaxCol="MAX_COL"
                        ViewStartDate="startDate"
                        IsInView="date => IsInView(date, startDate)"
                        IsToday="date => calendar.GetYear(date) == calendar.GetYear(DatePicker.CurrentDate)"
                        IsSelected="date => Value.HasValue && calendar.GetYear(date) == calendar.GetYear(Value.Value)"
                        GetColTitle="date => FormatYear(date, Locale.Lang.YearFormat)"
                        OnValueSelect="date => OnSelectYear(date)"
                        GetNextColValue="date => calendar.AddYears(date, 1)">
        <RenderPickerHeader>
            <DatePickerHeader @attributes="GetAttributes()"
                              TValue="TValue"
                              SuperChangeDateInterval="10"
                              ShowPreChange="@false"
                              ShowNextChange="@false"
                              ShowSuperPreChange="@(!(IsRange && PickerIndex == 1))"
                              ShowSuperNextChange="@(!(IsRange && PickerIndex == 0))" />
        </RenderPickerHeader>
        <RenderColValue Context="currentColDate">
            @{yearIndex++;}
            @FormatYear(currentColDate, Locale.Lang.YearFormat)
        </RenderColValue>
    </DatePickerTemplate>
</div>

@code {
    private const int MAX_ROW = 4;
    private const int MAX_COL = 3;
    private const int FIRST_YEAR_INDEX = 0;
    private const int LAST_YEAR_INDEX = MAX_ROW * MAX_COL - 1;

    private bool IsInView(DateTime date, DateTime startDate)
    {
        return Calendar.GetYear(date) != Calendar.GetYear(Calendar.AddYears(startDate, FIRST_YEAR_INDEX))
        && Calendar.GetYear(date) != Calendar.GetYear(Calendar.AddYears(startDate, LAST_YEAR_INDEX));
    }
}
