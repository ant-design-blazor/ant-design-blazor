@namespace AntDesign.Internal
@typeparam TValue
@inherits DatePickerPanelBase<TValue>
@using System.Globalization;

@{
    var calendar = Calendar;

    int year = calendar.GetYear(PickerValue) / 100 * 100;

    if (year < calendar.GetYear(calendar.MinSupportedDateTime))
    {
        year = calendar.GetYear(calendar.MinSupportedDateTime);
    }

    DateTime startDate = calendar.AddYears(DateHelper.CreateDate(calendar, year, 1, 1, PickerValue), -10);

    int yearIndex = 0;
    const int MAX_ROW = 4;
    const int MAX_COL = 3;
    const int FIRST_YEAR_INDEX = 0;
    const int LAST_YEAR_INDEX = MAX_ROW * MAX_COL - 1;
}
<div class='@($"{PrefixCls}-panel")' @ref="Ref">
    <DatePickerTemplate @attributes="GetAttributes()"
                        TValue="TValue"
                        MaxRow="MAX_ROW"
                        MaxCol="MAX_COL"
                        ViewStartDate="startDate"
                        IsInView="date => yearIndex != FIRST_YEAR_INDEX && yearIndex != LAST_YEAR_INDEX"
                        IsToday="date => calendar.GetYear(date) == calendar.GetYear(DatePicker.CurrentDate)"
                        IsSelected="date => Value.HasValue && calendar.GetYear(date) == calendar.GetYear(Value.Value)"
                        OnValueSelect="date => OnSelectYear(date)"
                        GetNextColValue="date => calendar.AddYears(date, 10)">
        <RenderPickerHeader>
            <DatePickerHeader @attributes="GetAttributes()"
                              TValue="TValue"
                              Picker="@Picker"
                              SuperChangeDateInterval="100"
                              ShowPreChange="@false"
                              ShowNextChange="@false"
                              ShowSuperPreChange="@(!(IsRange && PickerIndex == 1))"
                              ShowSuperNextChange="@(!(IsRange && PickerIndex == 0))" />
        </RenderPickerHeader>
        <RenderColValue Context="currentColDate">
            @{yearIndex++;}
            @(calendar.GetYear(currentColDate))-@(calendar.GetYear(currentColDate) + 9)
        </RenderColValue>
    </DatePickerTemplate>
</div>
