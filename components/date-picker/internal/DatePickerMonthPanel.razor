@namespace AntDesign.Internal
@typeparam TValue
@inherits DatePickerPanelBase<TValue>
@using System.Globalization;

@{
    var calendar = Calendar;

    DateTime startDate = DateHelper.CreateDate(calendar, calendar.GetYear(PickerValue), 1, 1, PickerValue);

    const int MAX_ROW = 4;
    const int MAX_COL = 3;

    string inViewClass = $"{PrefixCls}-cell-in-view";
}

<div class="@ClassMapper.Class" @ref="Ref">
    <DatePickerTemplate @attributes="GetAttributes()"
                        TValue="TValue"
                        MaxRow="MAX_ROW"
                        MaxCol="MAX_COL"
                        ViewStartDate="startDate"
                        IsInView="date => true"
                        IsToday="date => calendar.GetYear(date) == calendar.GetYear(DatePicker.CurrentDate) && calendar.GetMonth(date) == calendar.GetMonth(DatePicker.CurrentDate)"
                        IsSelected="date => Value.HasValue && calendar.GetYear(date) == calendar.GetYear(Value.Value) && calendar.GetMonth(date) == calendar.GetMonth(Value.Value)"
                        GetColTitle='date => FormatMonth(date, Locale.Lang.MonthFormat)'
                        OnValueSelect="date => OnSelectMonth(date)"
                        GetNextColValue="date => calendar.AddMonths(date, 1)">
        <RenderPickerHeader>
            <DatePickerHeader @attributes="GetAttributes()"
                              TValue="TValue"
                              ShowNextChange="@false"
                              ShowPreChange="@false"
                              ShowSuperPreChange="@(!(IsRange && PickerIndex == 1))"
                              ShowSuperNextChange="@(!(IsRange && PickerIndex == 0))" />
        </RenderPickerHeader>
        <RenderColValue Context="currentColDate">
            @FormatMonth(currentColDate, Locale.Lang.MonthFormat)
        </RenderColValue>
    </DatePickerTemplate>
</div>

@if (RenderExtraFooter != null && !IsRange)
{
    <div class="@(PrefixCls)-footer">
        <div class="@(PrefixCls)-footer-extra">
            @RenderExtraFooter
        </div>
    </div>
}
