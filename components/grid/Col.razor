@namespace AntDesign
@inherits AntDomComponentBase

<div class="@HostClass" style="@HostStyle" id="@Id" @ref="Ref">@ChildContent</div>

@code {
    private string HostStyle
    {
        get
        {
            var styles = new[] { GutterStyle, _hostFlexStyle, Style, _responsiveFlexStyle };
            var style = string.Join(" ", styles.Where(value => !string.IsNullOrWhiteSpace(value)));
            return style.Length == 0 ? null : style;
        }
    }
}
