@namespace AntDesign
@inherits AntDomComponentBase
@typeparam TItem

<div class="@ClassMapper.Class" style="@Style" Id="@Id" @ref="Ref">
    @if (ShowPaginationAtTop)
    {
        <div class="@PrefixName-pagination">
            <Pagination Total="@(DataSource?.Count() ?? 0)" Current="@GetCurrentPage(DataSource?.Count() ?? 0, GetPageSize())" PageSize="@GetPageSize()" Align="@Pagination.Align" OnChange="OnPaginationChanged" HideOnSinglePage="false" ShowSizeChanger="false" />
        </div>
    }
    @if (Header != null)
    {
        <div class="@PrefixName-header">
            @Header
        </div>
    }

    <Spin Spinning="Loading">
        @if (DataSource?.Any() == true)
        {
            @if (Grid != null)
            {
				  <Row Gutter="Grid.Gutter" Class="ant-list-container" OnBreakpoint="OnBreakpoint">
				      @foreach (var item in GetItems())
				      {
				          <CascadingValue Value="this" IsFixed>
				              @ChildContent(item)
				          </CascadingValue>
				      }
				  </Row>
            }
            else
            {
                <ul class="ant-list-items ant-list-container">
                    @foreach (var item in GetItems())
                    {
                        <CascadingValue Value="this" IsFixed>
							@ChildContent(item)
                        </CascadingValue>
                    }
                </ul>
            }
        }
        else
        {
            <div class="@PrefixName-empty-text"><Empty /></div>
        }
    </Spin>

    @if (Footer != null)
    {
        <div class="@PrefixName-footer">
            @Footer
        </div>
    }
    @if (LoadMore != null)
    {
        @LoadMore
    }
    @if (ShowPaginationAtBottom)
    {
        <div class="@PrefixName-pagination">
            <Pagination Total="@(DataSource?.Count() ?? 0)" Current="@GetCurrentPage(DataSource?.Count() ?? 0, GetPageSize())" PageSize="@GetPageSize()" Align="@Pagination.Align" OnChange="OnPaginationChanged" HideOnSinglePage="false" ShowSizeChanger="false" />
        </div>
    }

</div>
