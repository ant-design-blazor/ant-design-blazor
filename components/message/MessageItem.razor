@namespace AntDesign
@inherits AntDomComponentBase

<div class="@GetNoticeClassName() @Config.AnimationClass" @onmouseenter="HandleMouseEnter" @onmouseleave="HandleMouseLeave" role="alert">
    <div class="@PrefixCls-notice-wrapper" @ref="Ref">
        <div class="@GetIconClassName()">
            @{
                switch (Config.Type)
                {
                    case MessageType.Success:
                        {
                            <Icon Type="@IconType.Fill.CheckCircle" />

                            break;
                        }
                    case MessageType.Warning:
                        {
                            <Icon Type="@IconType.Fill.ExclamationCircle" />
                            break;
                        }
                    case MessageType.Error:
                        {
                            <Icon Type="@IconType.Fill.CloseCircle" />
                            break;
                        }
                    case MessageType.Info:
                        {
                            <Icon Type="@IconType.Fill.InfoCircle" />
                            break;
                        }
                    default:
                        {
                            <Icon Type="@IconType.Outline.Loading" />
                            break;
                        }
                }
            }
        </div>
        <div class="@PrefixCls-notice-title">
            @if (Config.Content.IsT0)
            {
                @Config.Content.AsT0;
            }
            else
            {
                @Config.Content.AsT1;
            }
        </div>
    </div>
</div>
