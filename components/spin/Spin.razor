@namespace AntDesign
@inherits AntDomComponentBase

@if (Simple)
{
    @simpleTemplate(this)
}
else
{
    <div class="@WrapperClassMapper.Class" @ref="Ref">
        <div>
            @simpleTemplate(this)
        </div>
    </div>
}

@code{
    RenderFragment defaultTemplate =
        @<span class="ant-spin-dot ant-spin-dot-spin">
            <i class="ant-spin-dot-item"></i>
            <i class="ant-spin-dot-item"></i>
            <i class="ant-spin-dot-item"></i>
            <i class="ant-spin-dot-item"></i>
        </span>;

    RenderFragment<Spin> simpleTemplate = spin=>
        @<Template>
            @if (spin._isLoading)
            {
                <div class="@spin.SemanticClass("root", $"{spin.ClassMapper.Class} {(spin.Simple ? "ant-spin-section" : string.Empty)}", spin.Simple ? "section" : null)" id="@spin.Id" style="@spin.SemanticStyle("root", spin.Style, spin.Simple ? "section" : null)" aria-live="polite" aria-busy="@spin._isLoading.ToString().ToLowerInvariant()" @ref="spin.Ref">
                    @if (!spin.Simple)
                    {
                        <div class="@spin.SemanticClass("section", "ant-spin-section")" style="@spin.SemanticStyle("section")">
                            <span class="@spin.SemanticClass("indicator", "ant-spin-dot-holder")" style="@spin.SemanticStyle("indicator")">
                                @if (spin.Indicator != null) { @spin.Indicator } else { @spin.defaultTemplate }
                            </span>
                            @if (spin.EffectiveDescription != null) { <div class="@spin.SemanticClass("description", "ant-spin-description ant-spin-text", "tip")" style="@spin.SemanticStyle("description", legacySlot: "tip")">@spin.EffectiveDescription</div> }
                        </div>
                    }
                    else
                    {
                        <span class="@spin.SemanticClass("indicator", "ant-spin-dot-holder")" style="@spin.SemanticStyle("indicator")">
                            @if (spin.Indicator != null) { @spin.Indicator } else { @spin.defaultTemplate }
                        </span>
                        @if (spin.EffectiveDescription != null) { <div class="@spin.SemanticClass("description", "ant-spin-description ant-spin-text", "tip")" style="@spin.SemanticStyle("description", legacySlot: "tip")">@spin.EffectiveDescription</div> }
                    }
                </div>
            }

            @if (!spin.Simple)
            {
                <div class="@spin.SemanticClass("container", $"ant-spin-container {spin.ContainerClass}")" style="@spin.SemanticStyle("container")">
                    @spin.ChildContent
                </div>
            }
        </Template>;
}
