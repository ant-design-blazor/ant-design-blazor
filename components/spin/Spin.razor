@namespace AntDesign
@inherits AntDomComponentBase

<div class="@RootClass" id="@Id" style="@RootStyle" aria-live="polite" aria-busy="@_isLoading.ToString().ToLowerInvariant()" @ref="Ref">
    @if (_isLoading)
    {
        @if (Simple)
        {
            <span class="@SemanticClass("indicator", "ant-spin-dot-holder")" style="@SemanticStyle("indicator")">
                @if (Indicator != null) { @Indicator } else { @defaultTemplate }
            </span>
            @if (EffectiveDescription != null)
            {
                <div class="@SemanticClass("description", "ant-spin-description ant-spin-text", "tip")" style="@SemanticStyle("description", legacySlot: "tip")">@EffectiveDescription</div>
            }
        }
        else
        {
            <div class="@SemanticClass("section", "ant-spin-section")" style="@SemanticStyle("section")">
                <span class="@SemanticClass("indicator", "ant-spin-dot-holder")" style="@SemanticStyle("indicator")">
                    @if (Indicator != null) { @Indicator } else { @defaultTemplate }
                </span>
                @if (EffectiveDescription != null)
                {
                    <div class="@SemanticClass("description", "ant-spin-description ant-spin-text", "tip")" style="@SemanticStyle("description", legacySlot: "tip")">@EffectiveDescription</div>
                }
            </div>
        }
    }
    @if (!Simple)
    {
        <div class="@SemanticClass("container", $"ant-spin-container {ContainerClass}")" style="@SemanticStyle("container")">
            @ChildContent
        </div>
    }
</div>

@code{
    RenderFragment defaultTemplate =
        @<span class="ant-spin-dot ant-spin-dot-spin">
            <i class="ant-spin-dot-item"></i>
            <i class="ant-spin-dot-item"></i>
            <i class="ant-spin-dot-item"></i>
            <i class="ant-spin-dot-item"></i>
        </span>;

    private string RootClass => SemanticClass("root", $"{ClassMapper.Class} {WrapperClassMapper.Class} {(Simple ? "ant-spin-section" : _isLoading ? "ant-spin-nested-loading" : string.Empty)}", Simple ? "section" : null);
    private string RootStyle => SemanticStyle("root", Style, Simple ? "section" : null);
}
