@namespace AntDesign
@inherits AntInputBoolComponentBase

<button type="button" role="switch"
        aria-checked="@(CurrentValue?"true":"false")"
        disabled="@(Disabled||Loading)"
        class="@ClassMapper.Class"
        style="@Style"
		autofocus=@AutoFocus
        @onclick="HandleClick"
        @ref="Ref">
    <div class="@($"{_prefixCls}-handle")">
        @if (Loading)
        {
            <Icon Type="loading" Class="@($"{_prefixCls}-loading-icon")" />
        }
    </div>
    <span class="@($"{_prefixCls}-inner")">
        <span class="@($"{_prefixCls}-inner-checked")">
            @if (CheckedChildrenTemplate != null)
            {
                @CheckedChildrenTemplate
            }
            else
            {
                @CheckedChildren
            }
        </span>
        <span class="@($"{_prefixCls}-inner-unchecked")">
            @if (UnCheckedChildrenTemplate != null)
            {
                @UnCheckedChildrenTemplate
            }
            else
            {
                @UnCheckedChildren
            }
        </span>
    </span>
</button>
