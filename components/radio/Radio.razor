@namespace AntDesign
@typeparam TValue
@inherits AntDomComponentBase

<label @onclick="OnClick" class="@SemanticClass("root", ClassMapper.Class)" style="@SemanticStyle("root", Style)" title="@Title" @ref="Ref">
    <span class="@SemanticClass("icon", _radioClassMapper.Class)" style="@SemanticStyle("icon")">
        <input type="radio"
               autofocus="@AutoFocus"
               class="@_inputClassMapper.Class"
               disabled="@Disabled"
               checked="@Checked"
               name="@_name"
               value="@Value"
               id="@Id"
               required="@Required"
               @ref="_inputRef"/>
        <span class="@_innerClassMapper.Class"></span>
    </span>
    @if (ChildContent != null)
    {
        <span class="@SemanticClass("label", RadioButton ? "ant-radio-button-label" : "ant-radio-label")" style="@SemanticStyle("label")">@ChildContent</span>
    }
</label>
