@namespace AntDesign
@typeparam TValue
@inherits AntInputComponentBase<TValue>

<CascadingValue Value="this" IsFixed="@true">
	<CascadingValue Value="Block" Name="GroupBlock" IsFixed="@true">
	<CascadingValue Value="true" Name="InGroup" IsFixed>
        <div class="@ClassMapper.Class" style="@Style" id="@Id" role="radiogroup" @ref="Ref">
			@if (Options.Value != null)
			{
				if (Options.IsT0)
				{
					foreach (var item in Options.AsT0)
					{
                        <Radio Value="@item" RadioButton="IsButton">@item</Radio>
					}
				}
				else
				{
					@foreach (var radio in Options.AsT1)
					{
                        <Radio Value="radio.Value" RadioButton="IsButton" Disabled="radio.Disabled || Disabled"
                               Class="@radio.ClassName" Style="@radio.Style" Title="@radio.Title"
                               Id="@radio.Id" Required="@radio.Required">@radio.Label</Radio>
					}
				}
			}
			else
			{
				@ChildContent
			}
		</div>
	</CascadingValue>
	</CascadingValue>
</CascadingValue>
