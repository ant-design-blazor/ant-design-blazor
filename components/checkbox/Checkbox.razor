@namespace AntDesign
@inherits AntInputBoolComponentBase

<label class="@SemanticClass("root", ClassMapperLabel.Class)" style="@SemanticStyle("root", Style)" @ref="Ref" @onclick:stopPropagation>
    <span class="@ClassMapper.Class">
        <input id="@Id"
               value="@(CheckboxGroup == null ? null : ItemValue?.ToString() ?? Label)"
               checked="@Checked"
               disabled="@IsDisabled"
               autofocus=@AutoFocus
               @onchange="@InputCheckedChange"
               type="checkbox"
               class="ant-checkbox-input"
               @attributes="_attributes" />
        <span class="@SemanticClass("icon", "ant-checkbox-inner")" style="@SemanticStyle("icon")"></span>
    </span>

    @if (ChildContent != null)
    {
        <span class="@SemanticClass("label", "ant-checkbox-label")" style="@SemanticStyle("label")">
            @ChildContent
        </span>
    }
    else if (!HideEmptyLabel || !string.IsNullOrEmpty(Label))
    {
        <span class="@SemanticClass("label", "ant-checkbox-label")" style="@SemanticStyle("label")">@Label</span>
    }

</label>
