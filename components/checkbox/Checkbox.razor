@namespace AntDesign
@inherits AntInputBoolComponentBase

<label class="@ClassMapperLabel.Class" style="@(string.IsNullOrEmpty(Style) ? null : Style)" @ref="Ref" @onclick:stopPropagation>
    <span class="@ClassMapper.Class">
        <input id="@Id"
               value="@(CheckboxGroup == null ? null : ItemValue?.ToString() ?? Label)"
               checked="@Checked"
               disabled="@IsDisabled"
               autofocus=@AutoFocus
               @onchange="@InputCheckedChange"
               type="checkbox"
               class="ant-checkbox-input"
               @attributes="_attributes" />
    </span>

    @if (ChildContent != null)
    {
        <span class="ant-checkbox-label">
            @ChildContent
        </span>
    }
    else if (!HideEmptyLabel || !string.IsNullOrEmpty(Label))
    {
        <span class="ant-checkbox-label">@Label</span>
    }

</label>
