@namespace AntDesign
@inherits AntInputBoolComponentBase
@using Microsoft.AspNetCore.Components.Rendering

@if (HasLabel)
{
    <label class="@ClassMapperLabel.Class" style="@Style" for="@Id" @ref="Ref" @onclick:stopPropagation>
       @RenderCheckboxControl

        @if (ChildContent != null)
        {
            <span>
                @ChildContent
            </span>
        }
        else
        {
            <span>@Label</span>
        }
    </label>
}
else
{
    @RenderCheckboxControl
}

@code {
    private void RenderCheckboxControl(RenderTreeBuilder __builder)
    {
        <span class="@ClassMapper.Class" @ref="Ref" @onclick:stopPropagation>
            <input id="@Id"
               value="@(CheckboxGroup == null ? "true" : Label)"
               checked="@Checked"
               disabled="@IsDisabled"
               autofocus="@AutoFocus"
               @onchange="@InputCheckedChange"
               type="checkbox"
               class="@($"{PrefixCls}-input")"
               @attributes="_attributes" />
            <span class="@($"{PrefixCls}-inner")"></span>
        </span>
    }
}
