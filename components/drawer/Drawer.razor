@namespace AntDesign
@inherits AntDomComponentBase
<CascadingValue Value="@($"#ant-drawer-wrap_{Id} .ant-drawer-section")" Name="PopupContainerSelector">
    <div class="@ClassMapper.Class" @ref="@Ref" style="@_drawerStyle @InnerZIndexStyle @Style" id="@Id" tabindex="-1">
        @if (Mask && _isOpen)
        {
            <div class="ant-drawer-mask" @onclick="MaskClick" style="@MaskStyle"></div>
        }
        <div class="ant-drawer-content-wrapper @WrapClassName " style="@WrapperStyle" id="@($"ant-drawer-wrap_{Id}")">
            <section class="ant-drawer-section" role="dialog" aria-modal="true" aria-labelledby="@(_title.Value != null ? $"{Id}-title" : null)">
                @if (_title.Value != null || Closable || Extra != null)
                {
                    <div class="@TitleClassMapper.Class" style="@HeaderStyle">
                        <div class="ant-drawer-header-title">
                            @if (Closable)
                            {
                                <button @onclick="_=>CloseClick()" type="button" aria-label="Close" class="ant-drawer-close">
                                    <Icon Type="close" />
                                </button>
                            }
                            @if (_title.Value != null)
                            {
                                <div class="ant-drawer-title" id="@($"{Id}-title")">
                                    @if (TitleTemplate != null)
                                    {
                                        @TitleTemplate
                                    }
                                    @if (!string.IsNullOrEmpty(TitleString))
                                    {
                                        @((MarkupString)TitleString)
                                    }
                                </div>
                            }
                        </div>
                        @if (Extra != null)
                        {
                            <div class="ant-drawer-extra">@Extra</div>
                        }
                    </div>
                }
                <div class="ant-drawer-body" style="@BodyStyle">
                    @if (ContentTemplate != null)
                    {
                        @ContentTemplate
                    }
                    @if (!string.IsNullOrEmpty(ContentString))
                    {
                        @((MarkupString)ContentString)
                    }
                    @ChildContent
                </div>
                @if (Footer != null)
                {
                    <div class="ant-drawer-footer">@Footer</div>
                }
            </section>
            @if (Handler != null)
            {
                @Handler
            }
        </div>
    </div>
</CascadingValue>
