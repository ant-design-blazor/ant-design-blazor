@namespace AntDesign
@inherits AntDomComponentBase
<CascadingValue Value="@($"#ant-drawer-wrap_{Id} .ant-drawer-section")" Name="PopupContainerSelector">
    <div class="@GetSemanticClass("root", ClassMapper.Class)" @ref="@Ref" style="@GetSemanticStyle("root", _drawerStyle, $"{InnerZIndexStyle} {Style}")" id="@Id" tabindex="-1">
        @if (Mask && _isOpen)
        {
            <div class="@GetSemanticClass("mask", $"ant-drawer-mask {(MaskBlur ? "ant-drawer-mask-blur" : null)}")" @onclick="MaskClick" style="@GetSemanticStyle("mask", null, MaskStyle)"></div>
        }
        <div class="@GetSemanticClass("wrapper", $"ant-drawer-content-wrapper {(_isResizing ? "ant-drawer-content-wrapper-dragging" : null)} {WrapClassName}")" style="@GetSemanticStyle("wrapper", null, WrapperStyle)" id="@($"ant-drawer-wrap_{Id}")" @ref="_wrapperRef">
            @if (Resizable)
            {
                <div class="@GetSemanticClass("dragger", $"ant-drawer-resizable-dragger ant-drawer-resizable-dragger-{Placement.ToString().ToLowerInvariant()} ant-drawer-resizable-dragger-{(IsLeftOrRight ? "horizontal" : "vertical")} {(_isResizing ? "ant-drawer-resizable-dragger-dragging" : null)}")" style="@GetSemanticStyle("dragger")" @ref="_draggerRef"></div>
            }
            <section class="@GetSemanticClass("section", "ant-drawer-section")" style="@GetSemanticStyle("section")" role="dialog" aria-modal="true" aria-labelledby="@(_title.Value != null ? $"{Id}-title" : null)">
                @if (_title.Value != null || Closable || Extra != null)
                {
                    <div class="@GetSemanticClass("header", TitleClassMapper.Class)" style="@GetSemanticStyle("header", null, HeaderStyle)">
                        <div class="ant-drawer-header-title">
                            @if (Closable)
                            {
                                <button @onclick="_=>CloseClick()" type="button" aria-label="Close" class="@GetSemanticClass("close", "ant-drawer-close")" style="@GetSemanticStyle("close")">
                                    <Icon Type="close" />
                                </button>
                            }
                            @if (_title.Value != null)
                            {
                                <div class="@GetSemanticClass("title", "ant-drawer-title")" style="@GetSemanticStyle("title")" id="@($"{Id}-title")">
                                    @if (TitleTemplate != null)
                                    {
                                        @TitleTemplate
                                    }
                                    @if (!string.IsNullOrEmpty(TitleString))
                                    {
                                        @((MarkupString)TitleString)
                                    }
                                </div>
                            }
                        </div>
                        @if (Extra != null)
                        {
                            <div class="@GetSemanticClass("extra", "ant-drawer-extra")" style="@GetSemanticStyle("extra")">@Extra</div>
                        }
                    </div>
                }
                <div class="@GetSemanticClass("body", "ant-drawer-body")" style="@GetSemanticStyle("body", null, BodyStyle)">
                    @if (Loading)
                    {
                        <Skeleton Active Title="false" ParagraphRows="5" Class="ant-drawer-body-skeleton" />
                    }
                    else
                    {
                        @if (ContentTemplate != null)
                        {
                            @ContentTemplate
                        }
                        @if (!string.IsNullOrEmpty(ContentString))
                        {
                            @((MarkupString)ContentString)
                        }
                        @ChildContent
                    }
                </div>
                @if (Footer != null)
                {
                    <div class="@GetSemanticClass("footer", "ant-drawer-footer")" style="@GetSemanticStyle("footer")">@Footer</div>
                }
            </section>
            @if (Handler != null)
            {
                @Handler
            }
        </div>
    </div>
</CascadingValue>
