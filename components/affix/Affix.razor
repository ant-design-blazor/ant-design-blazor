@namespace AntDesign
@inherits AntDomComponentBase

<div @attributes="AdditionalAttributes" @ref="Ref">
    @if (_affixed)
    {
        <div aria-hidden="true" style="@_hiddenStyle"></div>
    }
    <div class="@ClassMapper.Class" @ref="_childRef" style="@_affixStyle">
        @ChildContent
    </div>
</div>