@namespace AntDesign
@inherits AntDomComponentBase
@typeparam TValue

<label class="@ClassMapper.Class" style="@Style" id="@(HasGeneratedId ? null : Id)" @ref="Ref">
  <input class="ant-segmented-item-input" type="radio" name="@Parent.InputName" checked="@_selected">
  <div class="ant-segmented-item-label" title="@Label" @onclick="OnClick">
    @if (ChildContent != null)
    {
      @ChildContent
    }
    else if (Icon != null)
    {
      <span class="ant-segmented-item-icon"><Icon Type="@Icon" /></span>
      if (Label != null)
      {
        <span>@Label</span>
      }
    }
    else
    {
      @Label
    }
  </div>
</label>
