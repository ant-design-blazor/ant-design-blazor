@namespace AntDesign
@inherits AntComponentBase

<div class="@ThemeScopeClass @ThemeCssClass" data-theme="@ThemeConfig?.Key" style="@ThemeStyle">
    <link rel="stylesheet" href="_content/AntDesign/css/antd-v6/component-parity.css" />
    @if (IsWireframe)
    {
        <link rel="stylesheet" href="_content/AntDesign/css/antd-v6/pagination-wireframe.css" />
    }
    <CascadingValue Name="AntDesignThemeStyle" Value="ThemeStyle">
        <CascadingValue Name="AntDesignExplicitThemeTokens" Value="ExplicitThemeTokens">
            <CascadingValue Name="AntDesignThemeAlgorithm" Value="ResolvedAlgorithm">
                <CascadingValue Value="this">
                    <CascadingValue Value="ThemeConfig">
                        <CascadingValue Name="AntDesignThemeConfig" Value="ThemeConfig">
                            <CascadingValue Name="AntDesignVariant" Value="ResolvedVariant">
                                <CascadingValue Name="AntDesignThemeComponents" Value="ResolvedComponentValues">
                                    @ChildContent
                                </CascadingValue>
                            </CascadingValue>
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </CascadingValue>
    </CascadingValue>
</div>
