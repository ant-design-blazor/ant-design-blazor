@namespace AntDesign
@inherits AntDomComponentBase

<div class="@SemanticClass("root", ClassMapper.Class)" style="@GetComponentStyle("Divider", SemanticStyle("root", Style))" id="@Id" @ref="Ref" role="separator">@if (Text != null || ChildContent != null)
    {
        <div class="@SemanticClass("rail", "ant-divider-rail ant-divider-rail-start")" style="@SemanticStyle("rail")"></div>
        <span class="@SemanticClass("content", "ant-divider-inner-text")" style="@SemanticStyle("content")">
            @if (Text != null)
            {
                @Text
            }
            else
            {
                @ChildContent
            }
        </span>
        <div class="@SemanticClass("rail", "ant-divider-rail ant-divider-rail-end")" style="@SemanticStyle("rail")"></div>
    }</div>
