@namespace AntDesign
@typeparam TValue
@inherits AntInputComponentBase<TValue>
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization

<div class="@SemanticClass("root", ClassMapper.Class)" style="@SemanticStyle("root", $"user-select:none;{Style}")" id="@Id" @ref="Ref"
     @onmousedown="(e) => OnMouseDown(e)">
    <div class="@SemanticClass("rail", "ant-slider-rail")" style="@SemanticStyle("rail")" @onmousedown="OnTrackMouseDown" @onmousedown:stopPropagation="true">
    </div>
    @if (Included)
    {
        <div class="@SemanticClass("tracks", "ant-slider-tracks")" style="@SemanticStyle("tracks")">
            @if (MultiValue)
            {
                @for (var trackIndex = 0; trackIndex < _multiTrackStyles.Count; trackIndex++)
                {
                    var index = trackIndex;
                    <div class="@SemanticClass("track", $"ant-slider-track ant-slider-track-{index + 1}")" style="@SemanticStyle("track", _multiTrackStyles[index])" @onmousedown="OnTrackMouseDown" @onmousedown:stopPropagation="true"></div>
                }
            }
            else
            {
                <div class="@SemanticClass("track", $"ant-slider-track {(Range ? "ant-slider-track-1" : string.Empty)}")" style="@SemanticStyle("track", _trackStyle)" @onmousedown="OnTrackMouseDown" @onmousedown:stopPropagation="true"></div>
            }
        </div>
    }
    <div class="ant-slider-step">
        @if (Marks != null)
        {
            @foreach (SliderMark mark in Marks)
            {
                <span class="ant-slider-dot @(IsActiveMark(mark.Key) ? "ant-slider-dot-active" : string.Empty)" style=@($"{(Vertical ? "bottom" : "left")}: {SetMarkPosition(mark.Key)};")></span>
            }
        }
    </div>
    @if (Range)
    {
        @if (MultiValue)
        {
            @for (var handleIndex = 0; handleIndex < _multiValues.Count; handleIndex++)
            {
                var index = handleIndex;
                @if (HasTooltip)
                {
                    <Tooltip Title="@TipFormatter(_multiValues[index])" Style="display:inline" ArrowPointAtCenter="true" OverlayClassName="ant-slider-tooltip" Placement="@TooltipPlacement">
                        <Unbound>
                            <div tabindex="@(IsHandleDisabled(index) ? -1 : 0)" class="@GetMultiHandleClass(index)" role="slider" aria-disabled="@IsHandleDisabled(index).ToString().ToLowerInvariant()" aria-valuenow="@Math.Round(_multiValues[index], 2).ToString(CultureInfo.InvariantCulture)" aria-valuemin="@Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)" aria-valuemax="@Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)" style="@SemanticStyle("handle", GetMultiHandleStyle(index))" @ref="@context.Current" @onmousedown="(e) => OnMultiHandleMouseDown(e, index)" @onmousedown:stopPropagation="true" @onkeydown="(e) => OnMultiHandleKeyDown(e, index)"></div>
                        </Unbound>
                    </Tooltip>
                }
                else
                {
                    <div tabindex="@(IsHandleDisabled(index) ? -1 : 0)" class="@GetMultiHandleClass(index)" role="slider" aria-disabled="@IsHandleDisabled(index).ToString().ToLowerInvariant()" aria-valuenow="@Math.Round(_multiValues[index], 2).ToString(CultureInfo.InvariantCulture)" aria-valuemin="@Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)" aria-valuemax="@Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)" style="@SemanticStyle("handle", GetMultiHandleStyle(index))" @onmousedown="(e) => OnMultiHandleMouseDown(e, index)" @onmousedown:stopPropagation="true" @onkeydown="(e) => OnMultiHandleKeyDown(e, index)"></div>
                }
            }
        }
        else
        {
            @if (HasTooltip)
            {
                <Tooltip Title="@TipFormatter(_leftValue)" Style="display: inline;" Visible="_tooltipLeftVisible" ArrowPointAtCenter="true" OverlayClassName="ant-slider-tooltip" Placement="@TooltipPlacement" @ref="_toolTipLeft">
                    <Unbound>
                        <div tabindex="@(IsHandleDisabled(0) ? -1 : 0)" class="@SemanticClass("handle", $"ant-slider-handle ant-slider-handle-1 {(IsHandleDisabled(0) ? "ant-slider-handle-disabled" : string.Empty)}")" role="slider" aria-disabled="@IsHandleDisabled(0).ToString().ToLowerInvariant()" aria-valuenow=@(Math.Round(LeftValue, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemin=@(Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemax=@(Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)) style="@SemanticStyle("handle", _leftHandleStyle)" @ref="@context.Current" @onmousedown="(e) => OnMouseDownEdge(e, false)" @onmousedown:stopPropagation="true"></div>
                    </Unbound>
                </Tooltip>
                <Tooltip Title="@TipFormatter(_rightValue)" Style="display: inline;" Visible="_tooltipRightVisible" ArrowPointAtCenter="true" OverlayClassName="ant-slider-tooltip" Placement="@TooltipPlacement" @ref="_toolTipRight">
                    <Unbound>
                        <div tabindex="@(IsHandleDisabled(1) ? -1 : 0)" class="@SemanticClass("handle", $"ant-slider-handle ant-slider-handle-2 {(IsHandleDisabled(1) ? "ant-slider-handle-disabled" : string.Empty)}")" role="slider" aria-disabled="@IsHandleDisabled(1).ToString().ToLowerInvariant()" aria-valuenow=@(Math.Round(RightValue, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemin=@(Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemax=@(Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)) style="@SemanticStyle("handle", _rightHandleStyle)" @ref="@context.Current" @onmousedown="(e) => OnMouseDownEdge(e, true)" @onmousedown:stopPropagation="true"></div>
                    </Unbound>
                </Tooltip>
            }
            else
            {
                <div tabindex="@(IsHandleDisabled(0) ? -1 : 0)" class="@SemanticClass("handle", $"ant-slider-handle ant-slider-handle-1 {(IsHandleDisabled(0) ? "ant-slider-handle-disabled" : string.Empty)}")" role="slider" aria-disabled="@IsHandleDisabled(0).ToString().ToLowerInvariant()" aria-valuenow=@(Math.Round(LeftValue, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemin=@(Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemax=@(Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)) style="@SemanticStyle("handle", _leftHandleStyle)" @ref="_leftHandle" @onmousedown="(e) => OnMouseDownEdge(e, false)" @onmousedown:stopPropagation="true"></div>
                <div tabindex="@(IsHandleDisabled(1) ? -1 : 0)" class="@SemanticClass("handle", $"ant-slider-handle ant-slider-handle-2 {(IsHandleDisabled(1) ? "ant-slider-handle-disabled" : string.Empty)}")" role="slider" aria-disabled="@IsHandleDisabled(1).ToString().ToLowerInvariant()" aria-valuenow=@(Math.Round(RightValue, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemin=@(Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemax=@(Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)) style="@SemanticStyle("handle", _rightHandleStyle)" @ref="_rightHandle" @onmousedown="(e) => OnMouseDownEdge(e, true)" @onmousedown:stopPropagation="true"></div>
            }
        }
    }
    else
    {
        @if (HasTooltip)
        {
            <Tooltip Title="@TipFormatter(_rightValue)" Style="display: inline;" Visible="_tooltipRightVisible" ArrowPointAtCenter="true" OverlayClassName="ant-slider-tooltip" Placement="@TooltipPlacement" @ref="_toolTipRight">
                <Unbound>
                    <div tabindex="0" class="@SemanticClass("handle", "ant-slider-handle")" role="slider" aria-disabled="@Disabled.ToString()" aria-valuenow=@(Math.Round(RightValue, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemin=@(Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemax=@(Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)) style="@SemanticStyle("handle", _rightHandleStyle)" @ref="@context.Current" @onmousedown="(e)=>OnMouseDownEdge(e,  true)">
                    </div>
                </Unbound>
            </Tooltip>
        }
        else
        {
            <div tabindex="0" class="@SemanticClass("handle", "ant-slider-handle")" role="slider" aria-disabled="@Disabled.ToString()" aria-valuenow=@(Math.Round(RightValue, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemin=@(Math.Round(Min, 2).ToString(CultureInfo.InvariantCulture)) aria-valuemax=@(Math.Round(Max, 2).ToString(CultureInfo.InvariantCulture)) style="@SemanticStyle("handle", _rightHandleStyle)" @ref="_rightHandle" @onmousedown="(e)=>OnMouseDownEdge(e,  true)">
            </div>
        }
    }
    <div class="ant-slider-mark">
        @if (Marks != null)
        {
            @foreach (SliderMark mark in Marks)
            {
                <span class="ant-slider-mark-text @(IsActiveMark(mark.Key) ? "ant-slider-mark-text-active" : string.Empty)" style=@($"{(Vertical ? "bottom" : "left")}: {SetMarkPosition(mark.Key)}; {(Vertical ? "margin-bottom: -50%;" : "transform: translateX(-50%);")}" + mark.Style)>@mark.Value</span>
            }
        }
    </div>
</div>
