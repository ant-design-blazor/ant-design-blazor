@using AntDesign.Internal
@using AntDesign.Select.Internal
@namespace AntDesign
@inherits SelectBase<TItemValue, TItem>
@typeparam TItemValue
@typeparam TItem

@{
    base.BuildRenderTree(__builder);
}

@code
{
        RenderFragment SelectOptionsRender()
        {
            return @<ForeachLoop Items=@SortedSelectOptionItems.Where(option => !option.IsHidden).ToList() ChildContent="optionRender(ItemTemplate)" />;
        }


     Func<RenderFragment<TItem>, RenderFragment<SelectOptionItem<TItemValue, TItem>>> optionRender = 
        itemTemplate => option =>
        @<CascadingValue Value=@itemTemplate Name="ItemTemplate">
            <CascadingValue Value="@option" Name="Model">
            <CascadingValue Value="@option.InternalId" Name="InternalId">
                <SelectOption @key="@option.InternalId"
                    TItemValue="TItemValue"
                    TItem="TItem">
                </SelectOption>
            </CascadingValue>
            </CascadingValue>
        </CascadingValue>;

    private bool IsVirtualOptionSelected(SelectOptionItem<TItemValue, TItem> option)
    {
        return option.IsSelected
            || SelectedOptionItems.Any(item => EqualityComparer<TItemValue>.Default.Equals(item.Key, option.Value))
            || Values?.Contains(option.Value, EqualityComparer<TItemValue>.Default) == true;
    }

    protected override RenderFragment RenderOptionDropdown()
    {
        var empty = AllOptionsHidden();
        return @<Template>
        @if (SelectOptions != null || !empty)
        {
            @if (!empty && UsesVirtualAccessibility)
            {
                var options = SortedSelectOptionItems.Where(option => !option.IsHidden).ToList();
                var activeIndex = options.FindIndex(option => option == ActiveOption);
                <div role="listbox" id="@ListboxId" style="height: 0px; width: 0px; overflow: hidden;">
                    @for (var index = activeIndex - 1; index <= activeIndex + 1; index++)
                    {
                        if (index >= 0 && index < options.Count)
                        {
                            var option = options[index];
                            <div aria-label="@option.Label" role="option" id="@GetOptionId(option.InternalId)"
                                 aria-selected="@(IsVirtualOptionSelected(option) ? "true" : "false")"
                                 aria-disabled="@(option.IsDisabled ? "true" : null)">@option.Value</div>
                        }
                    }
                </div>
            }
            <div class="@GetSemanticClass("popup.list", "ant-select-dropdown-list")" style="@GetSemanticStyle("popup.list", empty ? "position: relative;display:none;" : "position: relative;")">
              <div class="ant-select-dropdown-list-holder" style="max-height: @PopupContainerMaxHeight; overflow-y: @(UsesVirtualAccessibility ? "hidden" : "auto"); overflow-anchor: none;" @ref="_scrollableSelectDiv">
                    @if (UsesVirtualWindow)
                    {
                        <div style="@VirtualListSpacerStyle">
                            <div class="ant-select-dropdown-list-holder-inner" style="@VirtualListInnerStyle">
                                @foreach (var option in GetVirtualWindowOptions())
                                {
                                    @optionRender(ItemTemplate)(option)
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                    <div>
                    <div class="ant-select-dropdown-list-holder-inner" role="@(empty || UsesVirtualAccessibility ? null : "listbox")" id="@(empty || UsesVirtualAccessibility ? null : ListboxId)" style="@ListboxStyle">
                      @if (SelectOptions != null)
                      {
                        @if (CustomTagSelectOptionItem != null)
                        {
                            <CascadingValue Value="@ItemTemplate" Name="ItemTemplate">
                                <CascadingValue Value="@CustomTagSelectOptionItem" Name="Model">
                                    <SelectOption @key="@CustomTagSelectOptionItem.InternalId"
                                                  TItemValue="TItemValue"
                                                  TItem="TItem">
                                    </SelectOption>
                                </CascadingValue>
                            </CascadingValue>
                        }
                        @SelectOptions
                        @if (AddedTags != null)
                        {
                            foreach (var selectOption in AddedTags)
                            {
                                <CascadingValue Value="@ItemTemplate" Name="ItemTemplate">
                                    <CascadingValue Value="@selectOption" Name="Model">
                                        <SelectOption @key="@selectOption.InternalId"
                                                      TItemValue="TItemValue"
                                                      TItem="TItem">
                                        </SelectOption>
                                    </CascadingValue>
                                </CascadingValue>
                            }
                        }
                      }
                      else if (!IsGroupingEnabled)
                      {
                          @SelectOptionsRender()
                      }
                      else
                      {
                          <CascadingValue Value="@ItemTemplate" Name="ItemTemplate">
                              <SelectOptionGroup TItemValue="TItemValue" TItem="TItem" />
                          </CascadingValue>
                      }
                    </div>
                    </div>
                    }
              </div>
              @if (UsesVirtualWindow)
              {
                  <div class="ant-select-dropdown-list-scrollbar ant-select-dropdown-list-scrollbar-vertical" style="position: absolute; width: 8px; top: 0px; bottom: 0px; right: 0px; visibility: hidden;">
                      <div class="ant-select-dropdown-list-scrollbar-thumb" style="position: absolute; border-radius: 99px; background: var(--rc-virtual-list-scrollbar-bg, rgba(0, 0, 0, 0.5)); cursor: pointer; user-select: none; width: 100%; height: 20px; top: 0px;"></div>
                  </div>
              }
            </div>
        }
        @if (empty)
        {
            <div role="listbox" id="@ListboxId" class="@ClassPrefix-item-empty">
                @if (NotFoundContent != null)
                {
                    @NotFoundContent
                }
                else
                {
                    <Empty Simple Small />
                }
            </div>
        }
        </Template>;
    }

}
