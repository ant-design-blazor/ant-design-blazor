@namespace AntDesign.Select.Internal
@using AntDesign.Icons
@typeparam TItemValue
@typeparam TItem

@if (ParentSelect.SuffixIcon != null)
{
    <div class="ant-select-suffix">
        @ParentSelect.SuffixIcon
    </div>
}
else if (Loading)
{
    <div class="ant-select-suffix">
        <LoadingOutlined />
    </div>
}
else if (ShowArrowIcon || ParentSelect.FeedbackIcon != null)
{
    <div class="ant-select-suffix">
        @if (ParentSelect.IsSearchEnabled && IsOverlayShow)
        {
            if (ShowSearchIcon)
            {
                <SearchOutlined />
            }
        }
        else
        {
            <DownOutlined />
        }

        @if (ParentSelect.FeedbackIcon != null)
        {
            @ParentSelect.FeedbackIcon
        }
    </div>
}
else
{
    <div class="ant-select-suffix">
        @if (ParentSelect.IsSearchEnabled && IsOverlayShow)
        {
            if (ShowSearchIcon)
            {
                <SearchOutlined />
            }
        }
    </div>
}

@if (!ParentSelect.Disabled && ParentSelect.AllowClear && ParentSelect.HasValue)
{
    <button class="ant-select-clear"
          type="button"
          aria-label="Clear"
          @ref="@_clearRef">
        <CloseCircleFilled />
    </button>
}
