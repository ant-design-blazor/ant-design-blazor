@namespace AntDesign.Select.Internal
@using AntDesign.Icons
@typeparam TItemValue
@typeparam TItem

@if (ParentSelect.SuffixIcon != null)
{
    <div class="@ParentSelect.GetSemanticClass("suffix", "ant-select-suffix")" style="@ParentSelect.GetSemanticStyle("suffix")">
        @ParentSelect.SuffixIcon
    </div>
}
else if (Loading)
{
    <div class="@ParentSelect.GetSemanticClass("suffix", "ant-select-suffix ant-select-suffix-loading")" style="@ParentSelect.GetSemanticStyle("suffix")">
        <LoadingOutlined Spin />
    </div>
}
else if (ShowArrowIcon || ParentSelect.FeedbackIcon != null)
{
    <div class="@ParentSelect.GetSemanticClass("suffix", "ant-select-suffix")" style="@ParentSelect.GetSemanticStyle("suffix")">
        @if (ParentSelect.IsSearchEnabled && IsOverlayShow)
        {
            if (ShowSearchIcon)
            {
                <SearchOutlined />
            }
        }
        else
        {
            <DownOutlined />
        }

        @if (ParentSelect.FeedbackIcon != null)
        {
            @ParentSelect.FeedbackIcon
        }
    </div>
}
else
{
    <div class="@ParentSelect.GetSemanticClass("suffix", "ant-select-suffix")" style="@ParentSelect.GetSemanticStyle("suffix")">
        @if (ParentSelect.IsSearchEnabled && IsOverlayShow)
        {
            if (ShowSearchIcon)
            {
                <SearchOutlined />
            }
        }
    </div>
}

@if (ShowClearIcon)
{
    <button class="@ParentSelect.GetSemanticClass("clear", "ant-select-clear")"
          style="@ParentSelect.GetSemanticStyle("clear")"
          type="button"
          aria-label="Clear"
          @ref="@_clearRef">
        <CloseCircleFilled />
    </button>
}
