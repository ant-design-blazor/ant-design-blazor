@using AntDesign
@using AntDesign.Icons
@using System.Text.Json
@using AntDesign.JsInterop
@namespace AntDesign.Select.Internal
@typeparam TItemValue
@typeparam TItem
@inherits AntDomComponentBase

@{
    var renderedInputString = IsOverlayShow ? _inputString : string.Empty;
    var canRenderRawValue = ParentSelect.Value is string || ParentSelect.Value is ValueType;
    var hasMatchingOption = ParentSelect.SelectOptionItems.Any(option =>
        EqualityComparer<TItemValue>.Default.Equals(option.Value, ParentSelect.Value));
    var rawValueText = canRenderRawValue && !hasMatchingOption ? Convert.ToString(ParentSelect.Value) : null;
    var selectedItem = ParentSelect.GetOrderedSelectedItems().FirstOrDefault();
    var hasUnmatchedValue = string.IsNullOrEmpty(ParentSelect.SelectionTitle)
        && selectedItem == null
        && !ParentSelect.HasValue
        && !string.IsNullOrEmpty(rawValueText);
    var canShowUnmatchedValue = !IsOverlayShow || string.IsNullOrEmpty(renderedInputString);
    var showPlaceholder = string.IsNullOrEmpty(ParentSelect.SelectionTitle)
        && !ParentSelect.HasValue
        && !hasUnmatchedValue;
    var contentTitle = hasUnmatchedValue && ParentLabelTemplate == null ? rawValueText : selectedItem?.Label;
    contentTitle ??= ParentSelect.SelectionTitle;
    var contentClass = $"{Prefix}-content{(ParentSelect.Mode == SelectMode.Default && (ParentSelect.HasValue || hasUnmatchedValue || !string.IsNullOrEmpty(ParentSelect.SelectionTitle)) ? $" {Prefix}-content-has-value" : string.Empty)}{(ParentSelect.Mode == SelectMode.Default && !string.IsNullOrEmpty(renderedInputString) ? $" {Prefix}-content-has-search-value" : string.Empty)}";
    var placeholderStyle = !string.IsNullOrEmpty(renderedInputString) ? "visibility: hidden;" : null;
}
<div class="@ParentSelect.GetSemanticClass("root", ParentSelect.GetRootClass(ParentSelect.CurrentClassMapper.Class))"
     style="@ParentSelect.GetSemanticStyle("root", ParentSelect.Style)"
     @ref="@Ref"
     @onmousedown="@OnMouseDown"
     @onclick="@OnClick"
     >
    @if (ParentSelect.Mode == SelectMode.Default)
    {
      @if (ParentSelect.PrefixIcon != null)
      {
          <div class="@ParentSelect.GetSemanticClass("prefix", $"{Prefix}-prefix")" style="@ParentSelect.GetSemanticStyle("prefix")">
            @ParentSelect.PrefixIcon
          </div>
      }
      <div class="@ParentSelect.GetSemanticClass("content", contentClass)" title="@contentTitle" style="@ParentSelect.GetSemanticStyle("content")">
        @if (canShowUnmatchedValue && hasUnmatchedValue)
        {
          @if (ParentLabelTemplate != null && selectedItem != null)
          {
            <CascadingValue Value="this" Name="SelectContent">
              <CascadingValue Value="default(SelectOptionItem<TItemValue, TItem>)" Name="SelectOption">
                @ParentLabelTemplate(default)
              </CascadingValue>
            </CascadingValue>
          }
          else
          {
            @rawValueText
          }
        }
        @if (showPlaceholder)
        {
          <div class="@ParentSelect.GetSemanticClass("placeholder", $"{Prefix}-placeholder")" style="@ParentSelect.GetSemanticStyle("placeholder", placeholderStyle)">@Placeholder</div>
        }
        else if (!string.IsNullOrEmpty(ParentSelect.SelectionTitle))
        {
          @contentTitle
        }
        else if (selectedItem != null)
        {
          @if (ParentLabelTemplate != null)
          {
            <CascadingValue Value="this" Name="SelectContent">
              <CascadingValue Value="@selectedItem" Name="SelectOption">
                @ParentLabelTemplate(selectedItem.Item)
              </CascadingValue>
            </CascadingValue>
          }
          else
          {
            @getLabel(selectedItem)
          }
        }
        <input @ref="ParentSelect._inputRef"
               @oninput="@OnInputChange"
               @onkeyup="OnKeyUp"
               @onkeydown="OnKeyDown"
               disabled="@ParentSelect.Disabled"
               value="@(renderedInputString ?? string.Empty)"
               id="@ParentSelect.Id"
               type="text"
               tabindex="@TabIndex"
               maxlength="@MaxLength"
               readonly="@(!ParentSelect.IsSearchEnabled)"
               role="combobox"
               class="@ParentSelect.GetSemanticClass("input", $"{Prefix}-input")"
               autocomplete="@ParentSelect.AutoComplete"
               aria-owns="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
               aria-controls="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
               aria-activedescendant="@(IsOverlayShow ? ParentSelect.ActiveOptionId : null)"
               aria-expanded="@IsOverlayShow.ToString().ToLowerInvariant()"
               aria-label="@ParentSelect.AriaLabel"
               aria-autocomplete="list"
               aria-haspopup="listbox"
               accesskey="@ParentSelect?.AccessKey"
               style="@ParentSelect.GetSemanticStyle("input", string.IsNullOrEmpty(_inputWidth) ? null : _inputWidth)" />
      </div>

        <SelectSuffixIcon 
            TItem="TItem" 
            TItemValue="TItemValue" 
            SuffixIcon="@ParentSelect.SuffixIcon"
            IsOverlayShow="@IsOverlayShow"
            ShowClearIcon="@(!ParentSelect.Disabled && ParentSelect.IsAllowClearEnabled && ParentSelect.HasValueOrUnmatched)"
            OnClearClick="@OnClearClick" 
            ShowArrowIcon="@ShowArrowIcon" 
            ShowSearchIcon="@ShowArrowIcon"
            SearchIcon="@SearchIcon"
            Loading="@Loading"/>
    }
    else //ParentSelect.SelectMode != SelectMode.Default
    {
      @if (ParentSelect.PrefixIcon != null)
      {
        <div @ref="@_prefixRef" class="@ParentSelect.GetSemanticClass("prefix", $"{Prefix}-prefix")" style="@ParentSelect.GetSemanticStyle("prefix")">
          @ParentSelect.PrefixIcon
        </div>
      }
      <div class="@ParentSelect.GetSemanticClass("content", contentClass)" @ref="@_overflow" style="@ParentSelect.GetSemanticStyle("content")">
          @if (showPlaceholder)
          {
              <div class="@Prefix-content-item @Prefix-content-item-prefix" style="@PrefixStyle">
              <div class="@ParentSelect.GetSemanticClass("placeholder", $"{Prefix}-placeholder")" style="@ParentSelect.GetSemanticStyle("placeholder")">@Placeholder</div>
            </div>
          }
          @if (!showPlaceholder)
          {
            var selectedItems = ParentSelect.GetOrderedSelectedItems();
            @if (ParentSelect.HasTagCount)
            {
              @for (int i = 0; i < Math.Min(ParentSelect.MaxTagCount.AsT0, selectedItems.Count); i++)
              {
                var selectedOption = selectedItems[i];
                <div class="@Prefix-content-item" @key="@selectedOption.InternalId" aria-hidden="@(IsOverflowed(i) ? "true" : null)" style="@OverflowStyle(i)">
                  @if (TagRender != null)
                  {
                    <span>@TagRender(CreateTagRenderInfo(selectedOption))</span>
                  }
                  else if (ParentLabelTemplate != null)
                  {
                    <CascadingValue Value="this" Name="SelectContent">
                      <CascadingValue Value="@selectedOption" Name="SelectOption">
                        @ParentLabelTemplate(selectedOption.Item)
                      </CascadingValue>
                    </CascadingValue>
                  }
                  else
                  {
                    <span class="@GetTagClass(selectedOption)" style="@ParentSelect.GetSemanticStyle("item")" title="@selectedOption.Label">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@getTagLabel(this,selectedOption)</span>
                      @if (!ParentSelect.Disabled && !selectedOption.IsDisabled)
                      {
                      <span unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("itemRemove", "user-select: none;")" class="@ParentSelect.GetSemanticClass("itemRemove", $"{Prefix}-selection-item-remove")"
                  @onmousedown:preventDefault="true" @onclick="(e)=> RemoveClicked(e, selectedOption)" @onclick:stopPropagation="true">
                        @if (ParentSelect.RemoveIcon != null)
                        {
                          @ParentSelect.RemoveIcon
                        }
                        else
                        {
                          <CloseOutlined />
                        }
                      </span>
                      }
                    </span>
                  }
                </div>
              }
              @if (selectedItems.Count > ParentSelect.MaxTagCount.AsT0)
              {
                <div class="@Prefix-content-item @Prefix-content-item-rest" style="opacity: 1; order: @(selectedItems.Count-1);">
                  @if (ParentMaxTagPlaceholerTemplate != null)
                  {
                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">
                        <CascadingValue Value="this" Name="SelectContent">
                          @ParentMaxTagPlaceholerTemplate(selectedItems.Skip(ParentSelect.MaxTagCount.AsT0).Select(i => i.Item))
                        </CascadingValue>
                      </span>
                    </span>
                  }
                  else
                  {

                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" title="@($"+ {selectedItems.Count - ParentSelect.MaxTagCount.AsT0} ...")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">+ @(selectedItems.Count - ParentSelect.MaxTagCount.AsT0) ...</span>
                    </span>

                  }
                </div>
              }
            }
            else if (ParentSelect.IsResponsive)
            {
              @for (int i = 0; i < selectedItems.Count; i++)
              {
                var selectedOption = selectedItems[i];
                <div class="@Prefix-content-item" @key="@selectedOption.InternalId" @ref="@selectedOption.SelectedTagRef" aria-hidden="@(IsOverflowed(i) ? "true" : null)" style="@OverflowStyle(i)">
                  @if (TagRender != null)
                  {
                    <span>@TagRender(CreateTagRenderInfo(selectedOption))</span>
                  }
                  else if (ParentLabelTemplate != null)
                  {
                    <CascadingValue Value="this" Name="SelectContent">
                      <CascadingValue Value="@selectedOption" Name="SelectOption">
                        @ParentLabelTemplate(selectedOption.Item)
                      </CascadingValue>
                    </CascadingValue>
                  }
                  else
                  {
                    <span class="@GetTagClass(selectedOption)" style="@ParentSelect.GetSemanticStyle("item")" title="@selectedOption.Label">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@getTagLabel(this,selectedOption)</span>
                      @if (!ParentSelect.Disabled && !selectedOption.IsDisabled)
                      {
                      <span unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("itemRemove", "user-select: none;")" class="@ParentSelect.GetSemanticClass("itemRemove", $"{Prefix}-selection-item-remove")"
                  @onmousedown:preventDefault="true" @onclick="(e)=> RemoveClicked(e, selectedOption)" @onclick:stopPropagation="true">
                        @if (ParentSelect.RemoveIcon != null)
                        {
                          @ParentSelect.RemoveIcon
                        }
                        else
                        {
                          <CloseOutlined />
                        }
                      </span>
                      }
                    </span>
                  }
                </div>
              }
              <div class="@Prefix-content-item @Prefix-content-item-rest" @key="@_internalId" @ref="@_aggregateTag"
                   aria-hidden="@(selectedItems.Count > _calculatedMaxCount ? null : "true")"
                   style="@(selectedItems.Count > _calculatedMaxCount
                       ? $"opacity: 1; order: {_calculatedMaxCount - 1};"
                       : "opacity: 0; height: 0px; overflow-y: hidden; order: 2147483647; pointer-events: none; position: absolute;")">
                  @if (ParentMaxTagPlaceholerTemplate != null)
                  {
                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">
                        <CascadingValue Value="this" Name="SelectContent">
                          @ParentMaxTagPlaceholerTemplate(selectedItems.Skip(_calculatedMaxCount).Select(i => i.Item))
                        </CascadingValue>
                      </span>
                    </span>
                  }
                  else
                  {
                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" title="@($"+ {Math.Max(0, selectedItems.Count - _calculatedMaxCount)} ...")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@($"+ {Math.Max(0, selectedItems.Count - _calculatedMaxCount)} ...")</span>
                    </span>
                  }
                </div>
            }
            else
            {
              @foreach (var selectedOption in selectedItems)
              {
                <div class="@Prefix-content-item" @key="@selectedOption.InternalId" style="opacity: 1;">
                  @if (TagRender != null)
                  {
                    <span>@TagRender(CreateTagRenderInfo(selectedOption))</span>
                  }
                  else if (ParentLabelTemplate != null)
                  {
                    <CascadingValue Value="this" Name="SelectContent">
                      <CascadingValue Value="@selectedOption" Name="SelectOption">
                        @ParentLabelTemplate(selectedOption.Item)
                      </CascadingValue>
                    </CascadingValue>
                  }
                  else
                  {
                    <span class="@GetTagClass(selectedOption)" style="@ParentSelect.GetSemanticStyle("item")" title="@selectedOption.Label">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@getTagLabel(this,selectedOption)</span>
                      @if (!ParentSelect.Disabled && !selectedOption.IsDisabled)
                      {
                      <span unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("itemRemove", "user-select: none;")" class="@ParentSelect.GetSemanticClass("itemRemove", $"{Prefix}-selection-item-remove")"
                  @onmousedown:preventDefault="true" @onclick="(e)=> RemoveClicked(e, selectedOption)" @onclick:stopPropagation="true">
                        @if (ParentSelect.RemoveIcon != null)
                        {
                          @ParentSelect.RemoveIcon
                        }
                        else
                        {
                          <CloseOutlined />
                        }
                      </span>
                      }
                    </span>
                  }
                </div>
              }
            }
          }
          <div class="@Prefix-content-item @Prefix-content-item-suffix" style="@SuffixStyle">
              <input @ref="ParentSelect._inputRef"
                   @oninput="OnInputChange"
                   @onkeyup="OnKeyUp"
                   @onkeydown="OnKeyDown"
                   value="@(renderedInputString ?? string.Empty)"
                   disabled="@ParentSelect.Disabled"
                   id="@ParentSelect.Id"
                   type="text"
                   tabindex="@TabIndex"
                   maxlength="@MaxLength"
                   readonly="@(!ParentSelect.IsSearchEnabled)"
                   role="combobox"
                   class="@ParentSelect.GetSemanticClass("input", $"{Prefix}-input")"
                   autocomplete="@ParentSelect.AutoComplete"
                   aria-owns="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
                   aria-controls="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
                   aria-activedescendant="@(IsOverlayShow ? ParentSelect.ActiveOptionId : null)"
                   aria-expanded="@IsOverlayShow.ToString().ToLowerInvariant()"
                   aria-label="@ParentSelect.AriaLabel"
                   aria-autocomplete="list"
                   aria-haspopup="listbox"
                   style="@ParentSelect.GetSemanticStyle("input", string.IsNullOrEmpty(_inputWidth) ? null : _inputWidth)" />
          </div>
      </div>
        
        <SelectSuffixIcon 
            TItem="TItem" 
            TItemValue="TItemValue" 
            SuffixIcon="@ParentSelect.SuffixIcon"
            IsOverlayShow="@IsOverlayShow"
            ShowClearIcon="@(!ParentSelect.Disabled && ParentSelect.IsAllowClearEnabled && ParentSelect.HasValueOrUnmatched)"
            OnClearClick="@OnClearClick" 
            ShowArrowIcon="@ShowArrowIcon" 
            ShowSearchIcon="@ShowArrowIcon"
            SearchIcon="@SearchIcon"
            Loading="@Loading"/>
    }
</div>

@code {
    string SuffixStyle
    {
        get
        {
            if (ParentSelect.SelectedOptionItems.Count == 0 || (!ParentSelect.IsResponsive && !ParentSelect.HasTagCount))
                return ParentSelect.IsResponsive
                    ? $"opacity: 1; order: {Math.Max(0, _calculatedMaxCount - 1)};"
                    : "opacity: 1;";

            var style = $"opacity: 1; order: {(ParentSelect.IsResponsive ? _calculatedMaxCount - 1 : ParentSelect.SelectedOptionItems.Count)};";
            if (ParentSelect.IsResponsive && _suffixFixedStart.HasValue)
            {
                style += $" position: absolute; top: 0px; inset-inline-start: {_suffixFixedStart.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}px;";
            }

            return style;
        }
    }

    string PrefixStyle => ParentSelect.IsResponsive ? "opacity: 1; order: -1;" : "opacity: 1;";

    RenderFragment getLabel(SelectOptionItem<TItemValue, TItem> option)
    {
        if (option.LabelTemplate != null)
            return builder => builder.AddContent(0, option.LabelTemplate);
        else
            return builder => builder.AddContent(0, ParentSelect.GetSelectedItemLabel(option));
    }

    RenderFragment getTagLabel(SelectContent<TItemValue, TItem> content, SelectOptionItem<TItemValue, TItem> option)
    {
        if (option.LabelTemplate != null)
            return builder => builder.AddContent(0, option.LabelTemplate);
        else
            return builder => builder.AddContent(0, content.FormatLabel(ParentSelect.GetSelectedItemLabel(option)));

    }
}
