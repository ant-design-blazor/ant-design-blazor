@using AntDesign
@using AntDesign.Icons
@using System.Text.Json
@using AntDesign.JsInterop
@namespace AntDesign.Select.Internal
@typeparam TItemValue
@typeparam TItem
@inherits AntDomComponentBase

@{
    _inputString = IsOverlayShow ? _inputString : string.Empty; // ensure _inputString is empty and selected item is shown when overlay is closed
    var canRenderRawValue = ParentSelect.Value is string || ParentSelect.Value is ValueType;
    var hasMatchingOption = ParentSelect.SelectOptionItems.Any(option =>
        EqualityComparer<TItemValue>.Default.Equals(option.Value, ParentSelect.Value));
    var rawValueText = canRenderRawValue && !hasMatchingOption ? Convert.ToString(ParentSelect.Value) : null;
    var hasUnmatchedValue = !ParentSelect.HasValue && !string.IsNullOrEmpty(rawValueText);
    var canShowUnmatchedValue = !IsOverlayShow || string.IsNullOrEmpty(_inputString);
    var showPlaceholder = !ParentSelect.HasValue && !hasUnmatchedValue && string.IsNullOrEmpty(_inputString);
    var selectedItem = ParentSelect.GetOrderedSelectedItems().FirstOrDefault();
    var canShowItem = !IsOverlayShow || string.IsNullOrEmpty(_inputString);
    var contentTitle = hasUnmatchedValue ? rawValueText : selectedItem?.Label;
    var contentClass = $"{Prefix}-content{(ParentSelect.Mode == SelectMode.Default && (ParentSelect.HasValue || hasUnmatchedValue) ? $" {Prefix}-content-has-value" : string.Empty)}";
    var contentStyle = ParentSelect.PrefixIcon is null ? null : "padding-left: 4px;";
}
<div class="@ParentSelect.GetSemanticClass("root", ParentSelect.CurrentClassMapper.Class)"
     style="@ParentSelect.GetSemanticStyle("root", ParentSelect.Style)"
     @ref="@Ref"
     >
    @if (ParentSelect.Mode == SelectMode.Default)
    {
      @if (ParentSelect.PrefixIcon != null)
      {
          <div class="@ParentSelect.GetSemanticClass("prefix", $"{Prefix}-prefix")" style="@ParentSelect.GetSemanticStyle("prefix")">
            @ParentSelect.PrefixIcon
          </div>
      }
      <div class="@ParentSelect.GetSemanticClass("content", contentClass)" title="@contentTitle" style="@ParentSelect.GetSemanticStyle("content")">
        @if (canShowUnmatchedValue && hasUnmatchedValue)
        {
          @rawValueText
        }
        @if (showPlaceholder)
        {
          <div class="@ParentSelect.GetSemanticClass("placeholder", $"{Prefix}-placeholder")" style="@ParentSelect.GetSemanticStyle("placeholder")">@Placeholder</div>
        }
        else if (canShowItem && selectedItem != null)
        {
          @if (ParentLabelTemplate != null)
          {
            <CascadingValue Value="this" Name="SelectContent">
              <CascadingValue Value="@selectedItem" Name="SelectOption">
                @ParentLabelTemplate(selectedItem.Item)
              </CascadingValue>
            </CascadingValue>
          }
          else
          {
            @getLabel(selectedItem)
          }
        }
        <input @ref="ParentSelect._inputRef"
               @oninput="@OnInputChange"
               @onkeyup="OnKeyUp"
               @onkeydown="OnKeyDown"
               disabled="@ParentSelect.Disabled"
               value="@(_inputString ?? string.Empty)"
               id="@ParentSelect.Id"
               type="text"
               readonly="@(!ParentSelect.IsSearchEnabled)"
               role="combobox"
               class="@ParentSelect.GetSemanticClass("input", $"{Prefix}-input")"
               autocomplete="new-password"
               aria-owns="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
               aria-controls="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
               aria-activedescendant="@(IsOverlayShow ? ParentSelect.ActiveOptionId : null)"
               aria-expanded="@IsOverlayShow.ToString().ToLowerInvariant()"
               aria-autocomplete="list"
               aria-haspopup="listbox"
               accesskey="@ParentSelect?.AccessKey"
               style="@ParentSelect.GetSemanticStyle("input", string.IsNullOrEmpty(_inputWidth) ? null : _inputWidth)" />
      </div>

        <SelectSuffixIcon 
            TItem="TItem" 
            TItemValue="TItemValue" 
            IsOverlayShow="@IsOverlayShow"
            ShowClearIcon="@(!ParentSelect.Disabled && ParentSelect.AllowClear && ParentSelect.HasValue)"
            OnClearClick="@OnClearClick" 
            ShowArrowIcon="@ShowArrowIcon" 
            ShowSearchIcon="@ShowArrowIcon"
            Loading="@Loading"/>
    }
    else //ParentSelect.SelectMode != SelectMode.Default
    {
      <div class="@ParentSelect.GetSemanticClass("content", contentClass)" @ref="@_overflow" style="@ParentSelect.GetSemanticStyle("content", contentStyle)">
          @if (ParentSelect.PrefixIcon != null)
          {
            <div class="@Prefix-content-item @Prefix-content-item-prefix" style="opacity: 1;order:-100;">
              <span @ref="@_prefixRef" class="@ParentSelect.GetSemanticClass("prefix", $"{Prefix}-prefix")" unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("prefix", "user-select: none;display:flex;align-items: center;padding-right: 4px;min-height:28px;")">
                @ParentSelect.PrefixIcon
              </span>
            </div>
          }
          @if (showPlaceholder)
          {
              <div class="@Prefix-content-item @Prefix-content-item-prefix" style="opacity: 1;">
              <div class="@ParentSelect.GetSemanticClass("placeholder", $"{Prefix}-placeholder")" style="@ParentSelect.GetSemanticStyle("placeholder")">@Placeholder</div>
            </div>
          }
          @if (!showPlaceholder)
          {
            var selectedItems = ParentSelect.GetOrderedSelectedItems();
            @if (ParentSelect.HasTagCount)
            {
              @for (int i = 0; i < Math.Min(ParentSelect.MaxTagCount.AsT0, selectedItems.Count); i++)
              {
                var selectedOption = selectedItems[i];
                <div class="@Prefix-content-item" style="@OverflowStyle(i)">
                  @if (ParentLabelTemplate != null)
                  {
                    <CascadingValue Value="this" Name="SelectContent">
                      <CascadingValue Value="@selectedOption" Name="SelectOption">
                        @ParentLabelTemplate(selectedOption.Item)
                      </CascadingValue>
                    </CascadingValue>
                  }
                  else
                  {
                    <span class="@GetTagClass(selectedOption)" style="@ParentSelect.GetSemanticStyle("item")" title="@selectedOption.Label">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@getTagLabel(this,selectedOption)</span>
                      @if (!ParentSelect.Disabled && !selectedOption.IsDisabled)
                      {
                      <span unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("itemRemove", "user-select: none;")" class="@ParentSelect.GetSemanticClass("itemRemove", $"{Prefix}-selection-item-remove")"
                  @onmousedown:preventDefault="true" @onclick="(e)=> RemoveClicked(e, selectedOption)" @onclick:stopPropagation="true">
                        <CloseOutlined />
                      </span>
                      }
                    </span>
                  }
                </div>
              }
              @if (selectedItems.Count > ParentSelect.MaxTagCount.AsT0)
              {
                <div class="@Prefix-content-item @Prefix-content-item-rest" style="opacity: 1; order: @(selectedItems.Count-1);">
                  @if (ParentMaxTagPlaceholerTemplate != null)
                  {
                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">
                        <CascadingValue Value="this" Name="SelectContent">
                          @ParentMaxTagPlaceholerTemplate(selectedItems.Skip(ParentSelect.MaxTagCount.AsT0).Select(i => i.Item))
                        </CascadingValue>
                      </span>
                    </span>
                  }
                  else
                  {

                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">+ @(selectedItems.Count - ParentSelect.MaxTagCount.AsT0)@Ellipse</span>
                    </span>

                  }
                </div>
              }
            }
            else if (ParentSelect.IsResponsive)
            {
              @for (int i = 0; i < selectedItems.Count; i++)
              {
                var selectedOption = selectedItems[i];
                <div class="@Prefix-content-item" @key="@selectedOption.InternalId" @ref="@selectedOption.SelectedTagRef" style="@OverflowStyle(i)">
                  @if (ParentLabelTemplate != null)
                  {
                    <CascadingValue Value="this" Name="SelectContent">
                      <CascadingValue Value="@selectedOption" Name="SelectOption">
                        @ParentLabelTemplate(selectedOption.Item)
                      </CascadingValue>
                    </CascadingValue>
                  }
                  else
                  {
                    <span class="@GetTagClass(selectedOption)" style="@ParentSelect.GetSemanticStyle("item")" title="@selectedOption.Label">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@getTagLabel(this,selectedOption)</span>
                      @if (!ParentSelect.Disabled && !selectedOption.IsDisabled)
                      {
                      <span unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("itemRemove", "user-select: none;")" class="@ParentSelect.GetSemanticClass("itemRemove", $"{Prefix}-selection-item-remove")"
                  @onmousedown:preventDefault="true" @onclick="(e)=> RemoveClicked(e, selectedOption)" @onclick:stopPropagation="true">
                        <CloseOutlined />
                      </span>
                      }
                    </span>
                  }
                </div>
              }
              @if (selectedItems.Count > _calculatedMaxCount)
              {
                <div class="@Prefix-content-item @Prefix-content-item-rest" @key="@_internalId" @ref="@_aggregateTag" style="opacity 1; order: @(_calculatedMaxCount-1);">
                  @if (ParentMaxTagPlaceholerTemplate != null)
                  {
                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">
                        <CascadingValue Value="this" Name="SelectContent">
                          @ParentMaxTagPlaceholerTemplate(selectedItems.Skip(_calculatedMaxCount).Select(i => i.Item))
                        </CascadingValue>
                      </span>
                    </span>
                  }
                  else
                  {
                    <span class="@ParentSelect.GetSemanticClass("item", $"{Prefix}-selection-item")" style="@ParentSelect.GetSemanticStyle("item")">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">+ @(selectedItems.Count-_calculatedMaxCount)@Ellipse</span>
                    </span>
                  }
                </div>
              }
            }
            else
            {
              @foreach (var selectedOption in selectedItems)
              {
                <div class="@Prefix-content-item" style="opacity: 1;">
                  @if (ParentLabelTemplate != null)
                  {
                    <CascadingValue Value="this" Name="SelectContent">
                      <CascadingValue Value="@selectedOption" Name="SelectOption">
                        @ParentLabelTemplate(selectedOption.Item)
                      </CascadingValue>
                    </CascadingValue>
                  }
                  else
                  {
                    <span class="@GetTagClass(selectedOption)" style="@ParentSelect.GetSemanticStyle("item")" title="@selectedOption.Label">
                      <span class="@ParentSelect.GetSemanticClass("itemContent", $"{Prefix}-selection-item-content")" style="@ParentSelect.GetSemanticStyle("itemContent")">@getTagLabel(this,selectedOption)</span>
                      @if (!ParentSelect.Disabled && !selectedOption.IsDisabled)
                      {
                      <span unselectable="on" aria-hidden="true" style="@ParentSelect.GetSemanticStyle("itemRemove", "user-select: none;")" class="@ParentSelect.GetSemanticClass("itemRemove", $"{Prefix}-selection-item-remove")"
                  @onmousedown:preventDefault="true" @onclick="(e)=> RemoveClicked(e, selectedOption)" @onclick:stopPropagation="true">
                        <CloseOutlined />
                      </span>
                      }
                    </span>
                  }
                </div>
              }
            }
          }
          <div class="@Prefix-content-item @Prefix-content-item-suffix" style="@SuffixStyle">
              <input @ref="ParentSelect._inputRef"
                   @oninput="OnInputChange"
                   @onkeyup="OnKeyUp"
                   @onkeydown="OnKeyDown"
                   value="@(_inputString ?? string.Empty)"
                   disabled="@ParentSelect.Disabled"
                   id="@ParentSelect.Id"
                   type="text"
                   readonly="@(!ParentSelect.IsSearchEnabled)"
                   role="combobox"
                   class="@ParentSelect.GetSemanticClass("input", $"{Prefix}-input")"
                   autocomplete="new-password"
                   aria-owns="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
                   aria-controls="@(IsOverlayShow ? ParentSelect.ListboxId : null)"
                   aria-activedescendant="@(IsOverlayShow ? ParentSelect.ActiveOptionId : null)"
                   aria-expanded="@IsOverlayShow.ToString().ToLowerInvariant()"
                   aria-autocomplete="list"
                   aria-haspopup="listbox"
                   style="@ParentSelect.GetSemanticStyle("input", string.IsNullOrEmpty(_inputWidth) ? null : _inputWidth)" />
          </div>
      </div>
        
        <SelectSuffixIcon 
            TItem="TItem" 
            TItemValue="TItemValue" 
            IsOverlayShow="@IsOverlayShow"
            ShowClearIcon="@(!ParentSelect.Disabled && ParentSelect.AllowClear && ParentSelect.HasValue)"
            OnClearClick="@OnClearClick" 
            ShowArrowIcon="@ShowArrowIcon" 
            ShowSearchIcon="@ShowArrowIcon"
            Loading="@Loading"/>
    }
</div>

@code {
    string SuffixStyle => ParentSelect.SelectedOptionItems.Count == 0 || (!ParentSelect.IsResponsive && !ParentSelect.HasTagCount)
        ? "opacity: 1;"
        : $"opacity: 1; order: {(ParentSelect.IsResponsive ? _calculatedMaxCount - 1 : ParentSelect.SelectedOptionItems.Count)};";

    RenderFragment getLabel(SelectOptionItem<TItemValue, TItem> option)
    {
        if (option.LabelTemplate != null)
            return builder => builder.AddContent(0, option.LabelTemplate);
        else
            return builder => builder.AddContent(0, ParentSelect.GetSelectedItemLabel(option));
    }

    RenderFragment getTagLabel(SelectContent<TItemValue, TItem> content, SelectOptionItem<TItemValue, TItem> option)
    {
        if (option.LabelTemplate != null)
            return builder => builder.AddContent(0, option.LabelTemplate);
        else
            return builder => builder.AddContent(0, content.FormatLabel(ParentSelect.GetSelectedItemLabel(option)));

    }
}
