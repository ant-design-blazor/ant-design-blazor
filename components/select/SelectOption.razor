@using AntDesign.Select.Internal
@using AntDesign.Icons
@namespace AntDesign
@inherits AntDomComponentBase
@typeparam TItemValue
@typeparam TItem
<div @ref="Ref"
      @key="@this"
      id="@(SelectParent.UsesVirtualAccessibility ? null : SelectParent.GetOptionId(InternalId))"
      class="@SelectParent.GetSemanticClass("popup.listItem", ClassMapper.Class)"
      role="@(SelectParent.UsesVirtualAccessibility ? null : "option")"
      aria-selected="@(SelectParent.UsesVirtualAccessibility ? null : IsSelected.ToString().ToLowerInvariant())"
      aria-disabled="@(IsDisabled || (SelectParent is Select<TItemValue, TItem> select && select.UsesVirtualAccessibility) ? IsDisabled.ToString().ToLowerInvariant() : null)"
      title="@InternalLabel"
      style="@SelectParent.GetSemanticStyle("popup.listItem", InnerStyle)"
      @onmousedown:preventDefault="true"
      @onclick="@OnClick"
      @onclick:stopPropagation
      @onmouseenter="@OnMouseEnter">
    <div class="@ClassPrefix-content">
        @if (ChildContent != null)
        {
            @ChildContent(Model.Item)
        }
        else if (ItemTemplate != null)
        {
            @ItemTemplate(Model.Item)
        }
        else
        {
            @InternalLabel
        }
    </div>
    @switch (SelectParent.Mode)
    {
        case SelectMode.Default:
            <span class="@ClassPrefix-state" unselectable="on" aria-hidden="true" style="user-select: none;"></span>
            break;
        default:
            if (IsSelected)
            {
                <span unselectable="on" aria-hidden="true" style="user-select: none;" class="@ClassPrefix-state">
                    <CheckOutlined />
                </span>
            }
            break;
    }
</div>
