@namespace AntDesign
@inherits AntDomComponentBase
@typeparam TItem
@using Microsoft.AspNetCore.Components.Web.Virtualization

<div class="@ClassMapper.Class" style="@Style" @ref="Ref">
    <div class="ant-tree-list">
        <div class="ant-tree-list-holder-inner">
            <CascadingValue Value="this" Name="Tree" IsFixed="@true">
                @if (DataSource != null)
                {
                    @if (Virtualize)
                    {
                        <Virtualize TItem="TreeNodeRenderContext<TItem>" Items="@VisibleRenderItems" ItemSize="@ItemSize" ItemContent="RenderDataSourceNode" />
                    }
                    else
                    {
                        @VisibleRenderItems.ForeachLoop(RenderDataSourceNode)
                    }
                }
                else if (ChildContent!=null)
				{
					@ChildContent
				}
				else
				{
                    @Nodes
                }

            </CascadingValue>
        </div>
    </div>
</div>

@code {
    private RenderFragment<TreeNodeRenderContext<TItem>> RenderDataSourceNode => context => @<TreeNodeView TItem="TItem" Context="context" />;
}
