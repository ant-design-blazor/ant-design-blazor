@namespace AntDesign
@inherits AntDomComponentBase

<div class="ant-tour ant-tour-pure ant-tour-placement-top @Class" style="@GetComponentStyle("Tour", Style)" id="@Id" @ref="Ref">
    <div class="ant-tour-arrow"></div>
    <div class="ant-tour-container" role="tooltip">
    <div class="ant-tour-panel">
        <div class="ant-tour-section">
            @if (Closable)
            {
                <button type="button" class="ant-tour-close" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"><Icon Type="close" /></button>
            }
            @if (Cover != null)
            {
                <div class="ant-tour-cover">@Cover</div>
            }
            @if (Title != null)
            {
                <div class="ant-tour-header"><div class="ant-tour-title">@Title</div></div>
            }
            @if (Description != null)
            {
                <div class="ant-tour-description">@Description</div>
            }
            <div class="ant-tour-footer">
                @if (Total > 1)
                {
                    <div class="ant-tour-indicators">@for (var i = 0; i < Total; i++) {<span class="ant-tour-indicator @(i == Current ? "ant-tour-indicator-active" : string.Empty)"></span>}</div>
                }
                <div class="ant-tour-actions"><TourActions Current="Current" Total="Total" Type="Type" Previous="PreviousAsync" Next="NextAsync" /></div>
            </div>
        </div>
    </div>
    </div>
</div>

@code {
    /// <summary>
    /// Optional cover content.
    /// </summary>
    [Parameter] public RenderFragment Cover { get; set; }
    /// <summary>
    /// Panel title.
    /// </summary>
    [Parameter] public RenderFragment Title { get; set; }
    /// <summary>
    /// Panel description.
    /// </summary>
    [Parameter] public RenderFragment Description { get; set; }
    /// <summary>
    /// Zero-based current step index.
    /// </summary>
    [Parameter] public int Current { get; set; }
    /// <summary>Raised when the inline panel changes step.</summary>
    [Parameter] public EventCallback<int> CurrentChanged { get; set; }
    /// <summary>Raised when the close button is clicked.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
    /// <summary>Raised when the last step finishes.</summary>
    [Parameter] public EventCallback OnFinish { get; set; }
    /// <summary>
    /// Total number of steps.
    /// </summary>
    [Parameter] public int Total { get; set; } = 1;
    /// <summary>
    /// Visual type of the panel.
    /// </summary>
    [Parameter] public TourType Type { get; set; }
    /// <summary>
    /// Whether the close button is shown.
    /// </summary>
    [Parameter] public bool Closable { get; set; } = true;

    private async Task PreviousAsync() { Current = Math.Max(0, Current - 1); await CurrentChanged.InvokeAsync(Current); }
    private async Task NextAsync()
    {
        if (Current >= Total - 1) { await OnFinish.InvokeAsync(); return; }
        Current++; await CurrentChanged.InvokeAsync(Current);
    }
}
