@namespace AntDesign
@using AntDesign.TableModels
@inherits ColumnBase

@if (IsInitialize)
{
	return;
}
else if (Hidden)
{
    return;
}
else if (IsPlaceholder)
{
	<td style="padding: 0px; border: 0px; height: 0px;"></td>
}
else if (IsMeasure)
{
	<td style="padding: 0px; border: 0px; height: 0px;"><div style="height: 0px; overflow: hidden;">&nbsp;</div></td>
}
else if (IsColGroup)
{
	@if (AppendExpandColumn)
	{
		<col class="ant-table-expand-icon-col">
	}

	if (Width != null)
	{
		<col class="ant-table-selection-col" style="width: @((CssSizeLength)Width);">
	}
	else
	{
		<col class="ant-table-selection-col">
	}
}
else if (IsHeader && HeaderColSpan != 0)
{
	@if (AppendExpandColumn)
	{
		<th class="ant-table-cell ant-table-row-expand-icon-cell"></th>
	}

    <th class="@ClassMapper.Class ant-table-selection-column" scope="@(Table.IsVirtual ? null : "col")" style="@(string.IsNullOrWhiteSpace($"{FixedStyle}{HeaderStyle}") ? null : $"{FixedStyle}{HeaderStyle}")" @key="@Key" colspan="@(HeaderColSpan > 1 ? HeaderColSpan : false)">
		@if (Type == SelectionType.Checkbox)
		{
			<div class="ant-table-selection">
				<Checkbox aria-label="Select all" Checked="Table.AllSelected" CheckedChange="OnCheckedChange" Indeterminate="Indeterminate" Disabled="IsHeaderDisabled" HideEmptyLabel="true" />
			</div>
		}
	</th>
}
else if (!IsHeader && RowSpan != 0 && ColSpan != 0)
{
	@if (AppendExpandColumn)
	{
		<td class="ant-table-cell ant-table-row-expand-icon-cell">
			@if (RowExpandable && !Table.TreeMode)
			{
				<button type="button" @onclick="ToggleTreeNode" @onclick:stopPropagation
						class="ant-table-row-expand-icon @(RowData.Expanded ? "ant-table-row-expand-icon-expanded" : "ant-table-row-expand-icon-collapsed")"
						aria-label="@(RowData.Expanded ? Table.Locale.Collapse : Table.Locale.Expand)"
						aria-expanded="@(RowData.Expanded ? "true" : "false")"></button>
			}
			else if (!Table.TreeMode)
			{
				<button type="button" class="ant-table-row-expand-icon ant-table-row-expand-icon-spaced"
						aria-label="@Table.Locale.Expand" aria-expanded="false"></button>
			}
		</td>
	}

    @if (Table.IsVirtual)
    {
        <div class="@ClassMapper.Class ant-table-selection-column" style="@GetVirtualSelectionStyle()" @key="@Key" rowspan="@(RowSpan > 1 ? RowSpan : false)" colspan="@(ColSpan > 1 ? ColSpan : false)" data-virtual-column="@VirtualColumnIndex">
            @if (CellRender != null)
            {
                var cellData = new CellData(RowData);
                @CellRender(cellData)
            }
            else if (ChildContent != null)
            {
                @ChildContent
            }
            else
            {
                HandleSelected();

                @if (Type == SelectionType.Checkbox)
                {
                    <Checkbox aria-label="@(_selected.Value ? $"Row {RowData.RowIndex} selected" : $"Select row {RowData.RowIndex}")" Checked="_selected.Value" Disabled="Disabled" CheckedChange="OnCheckedChange" HideEmptyLabel="true" @attributes="CheckboxProps" />
                }
                else if (Type == SelectionType.Radio)
                {
                    <Radio AriaLabel="@(_selected.Value ? $"Row {RowData.RowIndex} selected" : $"Select row {RowData.RowIndex}")" Checked="_selected.Value" Disabled="Disabled" CheckedChange="OnCheckedChange" TValue="bool" />
                }
            }
        </div>
    }
    else
    {
    <td class="@ClassMapper.Class ant-table-selection-column" style="@(string.IsNullOrWhiteSpace($"{FixedStyle}{Style}") ? null : $"{FixedStyle}{Style}")" @key="@Key" rowspan="@(RowSpan > 1 ? RowSpan : false)" colspan="@(ColSpan > 1 ? ColSpan : false)">

		@if (CellRender != null)
		{
			var cellData = new CellData(RowData);
            @CellRender(cellData)
		}
		else if (ChildContent != null)
		{
			@ChildContent
		}
		else
		{
            HandleSelected();

			@if (Type == SelectionType.Checkbox)
			{
				<Checkbox aria-label="@(_selected.Value ? $"Row {RowData.RowIndex} selected" : $"Select row {RowData.RowIndex}")" Checked="_selected.Value" Disabled="Disabled" CheckedChange="OnCheckedChange" HideEmptyLabel="true" @attributes="CheckboxProps" />
			}
			else if (Type == SelectionType.Radio)
			{
                <Radio Checked="_selected.Value" Disabled="Disabled" CheckedChange="OnCheckedChange" TValue="bool" />
			}
		}
	</td>
    }
}

@code {
    private string GetVirtualSelectionStyle()
    {
        var width = Width != null ? ((CssSizeLength)Width).ToString() : "32px";
        var baseStyle = $"flex: 0 0 {width}; width: {width}; margin-right: 0px; pointer-events: auto;";
        var customStyle = $"{FixedStyle}{Style}".Trim();
        return string.IsNullOrWhiteSpace(customStyle) ? baseStyle : $"{customStyle.TrimEnd(';')}; {baseStyle}";
    }
}
