@namespace AntDesign
@using AntDesign.TableModels
@inherits ColumnBase

<td class="@ClassMapper.Class" style="@CellStyle" colspan="@(ColSpan == 1 ? null : ColSpan)">
    @if (CellRender != null)
    {
        var cellData = new CellData(RowData);
        @CellRender(cellData)
    }
    else
    {
        @ChildContent
    }
</td>

@code {

    private string CellStyle
    {
        get
        {
            var style = string.Join(" ", new[] { FixedStyle, Style }.Where(value => !string.IsNullOrWhiteSpace(value)));
            return string.IsNullOrWhiteSpace(style) ? null : style;
        }
    }

    /// <summary>
    /// Set the content of the cell.
    /// </summary>
    [Parameter]
    public virtual RenderFragment<CellData> CellRender { get; set; }

}
