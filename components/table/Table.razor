@namespace AntDesign
@inherits AntDomComponentBase
@using AntDesign.TableModels
@using AntDesign.Internal
@using AntDesign.Core.Component.ResizeObserver

@typeparam TItem

<div class="@GetSemanticClass("root", _wrapperClassMapper.Class)" style="@GetComponentStyle("Table", GetSemanticStyle("root", Style))" @ref="Ref">
    <Spin Spinning="Loading">
        @if (ShowTopPagination)
        {
            if (PaginationTemplate == null)
            {
                <Pagination Size="@(Size == TableSize.Default ? PaginationSize.Default : PaginationSize.Small)"
                            Id="@TopPaginationId"
                            Class="@GetSemanticClass("pagination.root", GetPaginationClass(true))"
                            ItemClass="@GetSemanticClass("pagination.item")"
                            ItemStyle="@GetSemanticStyle("pagination.item")"
                            Total="_total"
                            PageSize="_pageSize"
                            Current="_pageIndex"
                            OnChange="HandlePageChange" />
            }
            else
            {
                @PaginationTemplate((_pageSize, _pageIndex, _total, GetSemanticClass("pagination.root", GetPaginationClass(true)), EventCallback.Factory.Create<PaginationEventArgs>(this, HandlePageChange)))
            }
        }

        <CascadingValue Value="@this" TValue="ITable" IsFixed>
            <CascadingValue Name="ResponsiveViewportWidth" Value="@_responsiveViewportWidth">
            <CascadingValue Value=@typeof(TItem) Name="ItemType" IsFixed>
                <CascadingValue Value="@ColumnContext" IsFixed>
                    <CascadingValue Name="RelationCache" Value="@RelationDataCache" IsFixed>
                        <CascadingValue Name="IsInitialize" Value="true" IsFixed>
                            @if (_fieldModel is not null)
                            {
                                @ChildContent(_fieldModel)
                            }
                        </CascadingValue>
                        <div class="@ClassMapper.Class" @ref="_wrapperRef">
                        @if (TitleTemplate != null)
                        {
                            <div class="@GetSemanticClass("title", "ant-table-title")" style="@GetSemanticStyle("title")">@TitleTemplate</div>
                        }
                        else if (Title != null)
                        {
                            <div class="@GetSemanticClass("title", "ant-table-title")" style="@GetSemanticStyle("title")">@Title</div>
                        }
                        <div class="@GetSemanticClass("section", "ant-table-container")" style="@GetSemanticStyle("section")">
                            @if (ScrollY != null)
                            {
                                <div class="ant-table-header @(IsSticky?"ant-table-sticky-holder":"")" style="overflow: hidden;@(string.IsNullOrWhiteSpace(StickyHolderStyle) ? "" : $" {StickyHolderStyle}")" @ref="_tableHeaderRef">
                                    <table style="@(IsVirtualEnabled && ScrollX != null ? $"{TableLayoutStyle} min-width: 100%; width: {(CssSizeLength)ScrollX};" : IsVirtualEnabled && _tableWidth > 0 ? $"{TableLayoutStyle} min-width: 100%; width: {_tableWidth}px;" : ScrollX != null ? $"{TableLayoutStyle} min-width: 100%; width: {(CssSizeLength)ScrollX};" : $"{TableLayoutStyle} min-width: 100%;")">
                                        @colGroup(this, true)
                                        @header()
                                    </table>
                                </div>
                                @if (IsVirtualEnabled)
                                {
                                    <div class="@GetSemanticClass("body.wrapper", "ant-table-tbody-virtual ant-table-tbody")" style="@GetSemanticStyle("body.wrapper", "position: relative;")">
                                        <div class="ant-table-tbody-virtual-holder" @ref="_tableBodyRef" style="@($"max-height: {(CssSizeLength)ScrollY}; overflow: {(UseClientVirtualWindow ? "hidden" : ShouldWindowVirtualItems(_showItems) ? "auto" : "hidden")}; overflow-anchor: none;")">
                                            @if (UseClientVirtualWindow)
                                            {
                                                <div style="@($"height: {ClientVirtualContentHeight}; position: relative; overflow: hidden;")">
                                                    <div class="ant-table-tbody-virtual-holder-inner" style="@($"display: flex; flex-direction: column; transform: translateY({_virtualStartIndex * ClientVirtualItemHeight}px); margin-left: 0px; position: absolute; left: 0px; right: 0px; top: 0px;")">
                                                        @body(_showItems.Skip(_virtualStartIndex).Take(Math.Max(0, _virtualEndIndex - _virtualStartIndex)), null, false, _virtualStartIndex)
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div style="@($"height: {VirtualViewportHeight}; position: relative; overflow: hidden;")">
                                                    <div class="ant-table-tbody-virtual-holder-inner" style="display: flex; flex-direction: column; transform: translateY(0px); margin-left: 0px; position: absolute; left: 0px; right: 0px; top: 0px;">
                                                        @body(_showItems)
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                        @if (UseClientVirtualWindow && _total * ClientVirtualItemHeight > ClientVirtualViewportHeight)
                                        {
                                            <div class="ant-table-tbody-virtual-scrollbar ant-table-tbody-virtual-scrollbar-vertical" style="position: absolute; width: 8px; top: 0px; bottom: 0px; right: 0px;">
                                                <div class="ant-table-tbody-virtual-scrollbar-thumb" style="position: absolute; border-radius: 99px; background: var(--rc-virtual-list-scrollbar-bg, rgba(0, 0, 0, 0.5)); cursor: pointer; user-select: none; width: 100%; height: 20px; top: 0px;"></div>
                                            </div>
                                        }
                                        @if (UseClientVirtualWindow && ScrollX != null)
                                        {
                                            <div class="ant-table-tbody-virtual-scrollbar ant-table-tbody-virtual-scrollbar-horizontal" style="position: absolute; height: 8px; left: 0px; right: 0px; bottom: 0px; visibility: hidden;">
                                                <div class="ant-table-tbody-virtual-scrollbar-thumb" style="position: absolute; border-radius: 99px; background: var(--rc-virtual-list-scrollbar-bg, rgba(0, 0, 0, 0.5)); cursor: pointer; user-select: none; height: 100%; width: 20px; left: 0px;"></div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="ant-table-body" @ref="_tableBodyRef" style="@($"{(ScrollX != null ? "overflow: auto scroll;" : "overflow-y: scroll;")}{(AutoHeight ? "" : $" max-height: {(CssSizeLength)ScrollY};")}{(UseItemsProvider && !AutoHeight ? $" min-height: {(CssSizeLength)ScrollY};" : "")}{(ScrollBarWidth == null ? "" : $" --scrollbar-width: {(CssSizeLength)_scrollBarWidth};")}")">
                                        <table style="@(ScrollX != null ? $"width: {(CssSizeLength)ScrollX}; min-width: 100%; {TableLayoutStyle}" : TableLayoutStyle)" @ref="_tableRef">
                                            @colGroup(this, false)
                                            <tbody class="@GetSemanticClass("body.wrapper", "ant-table-tbody")" style="@GetSemanticStyle("body.wrapper")">
                                                    <tr aria-hidden="true" class="ant-table-measure-row" style="height: 0px;">
                                                    <CascadingValue Name="IsMeasure" Value="true" IsFixed>
                                                        @if (_fieldModel is not null)
                                                        {
                                                            @ChildContent(_fieldModel)
                                                        }
                                                    </CascadingValue>
                                                </tr>
                                                @body(_showItems)
                                            </tbody>
                                            @if (!HasFixedSummary)
                                            {
                                                @tfoot()
                                            }
                                        </table>
                                    </div>
                                }
                                @if (HasFixedSummary)
                                {
                                    <div class="ant-table-summary" style="overflow: hidden;">
                                        <table style="@(ScrollX != null ? $"{TableLayoutStyle} min-width: 100%; width: {(CssSizeLength)ScrollX};" : $"{TableLayoutStyle} min-width: 100%;")">
                                            @colGroup(this, true, false)
                                            @tfoot()
                                        </table>
                                    </div>
                                }
                            }
                            else if (ScrollX != null)
                            {
                                <div class="@GetSemanticClass("content", "ant-table-content")" @ref="_tableBodyRef" style="@GetSemanticStyle("content", $"overflow: auto hidden;{(ScrollBarWidth == null ? "" : $" --scrollbar-width: {(CssSizeLength)_scrollBarWidth};")}")">
                                    <table style="width: @((CssSizeLength)ScrollX); min-width: 100%; @TableLayoutStyle" @ref="_tableRef">
                                        @colGroup(this, true)
                                        @header()
                                        <tbody class="@GetSemanticClass("body.wrapper", "ant-table-tbody")" style="@GetSemanticStyle("body.wrapper")">
                                            <tr aria-hidden="true" class="ant-table-measure-row" style="height: 0px;">
                                                <CascadingValue Name="IsMeasure" Value="true" IsFixed>
                                                    @if (_fieldModel is not null)
                                                    {
                                                        @ChildContent(_fieldModel)
                                                    }
                                                </CascadingValue>
                                            </tr>
                                            @body(_showItems)
                                        </tbody>
                                        @tfoot()
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="@GetSemanticClass("content", "ant-table-content")" @ref="_tableBodyRef" style="@GetSemanticStyle("content", AutoHeight ? "overflow-y: scroll;" : null)">
                                    <table style="@TableLayoutWithScrollbar" @ref="_tableRef">
                                        @colGroup(this, true)
                                        @header()
                                        <tbody class="@GetSemanticClass("body.wrapper", "ant-table-tbody")" style="@GetSemanticStyle("body.wrapper")">
                                            @body(_showItems)
                                        </tbody>
                                        @tfoot()
                                    </table>
                                </div>
                            }
                            @if (IsSticky)
                            {
                                <div class="ant-table-sticky-scroll" style="height: 15px; bottom: 0px;">
                                    <div class="ant-table-sticky-scroll-bar" style="transform: translate3d(0px, 0px, 0px);"></div>
                                </div>
                            }
                        </div>
                        @if (FooterTemplate != null)
                        {
                            <div class="@GetSemanticClass("footer", "ant-table-footer")" style="@GetSemanticStyle("footer")">@FooterTemplate</div>
                        }
                        else if (Footer != null)
                        {
                            <div class="@GetSemanticClass("footer", "ant-table-footer")" style="@GetSemanticStyle("footer")">@Footer</div>
                        }
                    </div>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
            </CascadingValue>
        </CascadingValue>
        @if (ShowBottomPagination)
        {
            if (PaginationTemplate == null)
            {
                <Pagination Size="@(Size == TableSize.Default ? PaginationSize.Default : PaginationSize.Small)"
                            Id="@BottomPaginationId"
                            Class="@GetSemanticClass("pagination.root", GetPaginationClass(false))"
                            ItemClass="@GetSemanticClass("pagination.item")"
                            ItemStyle="@GetSemanticStyle("pagination.item")"
                            Total="_total"
                            PageSize="_pageSize"
                            Current="_pageIndex"
                            OnChange="HandlePageChange" />
            }
            else
            {
                @PaginationTemplate((_pageSize,_pageIndex,_total,GetSemanticClass("pagination.root", GetPaginationClass(false)), EventCallback.Factory.Create<PaginationEventArgs>(this, HandlePageChange)))
            }
        }
    </Spin>
</div>

@code
{
    RenderFragment header()
    {
        if (!ShowHeader)
        {
            return null;
        }

        var headerRowAttributes = OnHeaderRow?.Invoke();
        return @<thead class="@GetSemanticClass("header.wrapper", "ant-table-thead")" style="@GetSemanticStyle("header.wrapper")">
            <CascadingValue Name="IsHeader" Value="true" IsFixed>
             <CascadingValue Value="headerRowAttributes" Name="AntDesign.TableRow.RowAttributes">
                 <CascadingValue Value="_hasFixRight" Name="AntDesign.TableRow.HasFixRight">
                     <CascadingValue Value="HasScrollbarPlaceholder" Name="AntDesign.TableRow.HasScrollbarPlaceholder">
                         @if (_fieldModel is not null)
                            {
                                @if (HeaderTemplate != null)
                                {
                                    @HeaderTemplate(_fieldModel)
                                }
                                else
                                {
                                    <TableRow>
                                        @ChildContent(_fieldModel)
                                    </TableRow>
                                }
                            }
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>
            </CascadingValue>
        </thead>;
    }

    static RenderFragment colGroup(Table<TItem> table, bool header, bool includeScrollbarPlaceholder = true)
    {
        if (!table.ShouldRenderColGroup)
        {
            return builder => { };
        }

        var realSize = (CssSizeLength)((table as ITable).ScrollBarWidth);
        return @<colgroup>
                <CascadingValue Name="IsHeaderColGroup" Value="header" IsFixed>
                <CascadingValue Name="IsColGroup" Value="true" IsFixed>
                @if (_fieldModel is not null)
                {
                    @table.ChildContent(_fieldModel)
                }
                </CascadingValue>
                </CascadingValue>
                @if (includeScrollbarPlaceholder && table.HasScrollbarPlaceholder && header)
                {
                    <col style="width: @realSize; min-width: @realSize;" />
                }
            </colgroup>;
    }
     

    RenderFragment body(IEnumerable<TItem> showItems, RowData<TItem> parentRowData = null, bool allowFrameworkVirtualize = true, int indexOffset = 0)
    {
        var level = (parentRowData?.Level + 1) ?? 0;

        if (!_hasInitialized)
        {
            return builder => { };
        }
#if NET5_0_OR_GREATER 
            if (UseItemsProvider&&!_isVirtualizeEmpty)
            {
                return @<Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize TItem="RowData<TItem>"
                    OverscanCount="0"
                    ItemsProvider="ItemsProvider"
                    ItemContent="bodyRow()">
                        <Placeholder>
                            <tr class="ant-table-row ant-table-row-level-0">
                                @foreach (var item in ColumnContext.HeaderColumns)
                                {
                                    <td class="ant-table-cell" colspan="@item.ColSpan">
                                       <Skeleton Active="true" ParagraphRows="1" Paragraph="false" ParagraphWidth="@item.Width"></Skeleton>
                                    </td>
                                }
                            </tr>
                        </Placeholder> 
                    </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>;
            }
        else
#endif
        if (_total<=0 || showItems == null)
        {
             return @<tr class="ant-table-placeholder">
                 <td colspan="@(ColumnContext.Columns.Count + (ExpandTemplate != null? 1 : 0))" class="ant-table-cell">
                     @if (ScrollX != null)
                     {
                        <ResizeObserver RefBack="RefBack" OnResize="OnResize" />   

                        @if (_tableWidth>0)
                        {
                            <div class="ant-table-expanded-row-fixed" style="width: @(_tableWidth)px; position: sticky; left: 0px; overflow: hidden;">
                               @if (EmptyTemplate!=null) { @EmptyTemplate } else { <Empty Simple /> }
                            </div>
                        }
                     }
                     else
                     {
                          @if (EmptyTemplate!=null) { @EmptyTemplate } else { <Empty Simple /> }
                     }
                 </td>
             </tr>
       ;
            }
            else if (_groupedColumns.Count>0 && level==0)
            {
                return _groups.Select((data, index) => GetGroupRowData(data, index, level, parentRowData?.Children))
                    .ForeachLoop(bodyRow());
            }
            else if (_groupedColumns.Count>0 && parentRowData?.IsGrouping == true)
            {
                 return parentRowData?.Children.Values
                    .ForeachLoop(bodyRow());
            }
#if NET5_0_OR_GREATER
        else if (allowFrameworkVirtualize && IsVirtualEnabled && ShouldWindowVirtualItems(showItems))
        {
                return @<Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize TItem="RowData<TItem>"
                 OverscanCount="0"
                 ItemSize="55"
                 Items="showItems.Select((data, index) => GetRowData(data, index, level, parentRowData?.Children )).ToList()"
                 ItemContent="bodyRow()">
                 </Microsoft.AspNetCore.Components.Web.Virtualization.Virtualize>;
        }
#endif
        else
        {
            { @*Build will fail without this block*@ }
            return showItems.Select((data, index) => GetRowData(data, index + indexOffset, level, parentRowData?.Children))
                .ForeachLoop(bodyRow());
        }
    }

    RenderFragment<RowData<TItem>> bodyRow()
    {
        return currentRowData =>
        {
            return @<TableRowWrapper RowData="currentRowData" @key="currentRowData.Key">
            @{
                var currentDataItem = currentRowData.DataItem;
                var rowAttributes = OnRow?.Invoke(currentRowData);
                if (OnRowClick.HasDelegate)
                {
                    rowAttributes ??= new Dictionary<string, object>();
                    rowAttributes.TryAdd("onclick", ((Action)delegate { OnRowClick.InvokeAsync(currentRowData); }));
                }

                var rowClassName = RowClassName(currentRowData);
                <CascadingValue Value="true" Name="IsBody" IsFixed>
                    <CascadingValue Value="rowAttributes" Name="AntDesign.TableRow.RowAttributes">
                        <CascadingValue Value="rowClassName" Name="AntDesign.TableRow.RowClassName">
                            @if (RowTemplate != null)
                            {
                                @RowTemplate(currentRowData)
                            }
                            else
                            {
                                <TableRow>
                                    @ChildContent(currentDataItem.Data)
                                </TableRow>
                            }
                        </CascadingValue>
                    </CascadingValue>
                </CascadingValue>

                // When expand button was clicked, would trigger here to add one more child level
                @if ((currentDataItem.HasChildren || currentRowData.IsGrouping) && currentRowData.Expanded)
                {
                    currentRowData.Children ??= new();
                    currentDataItem.Children ??= [];
                    @body(SortFilterChildren(currentDataItem.Children), currentRowData);
                }

                if (currentRowData.IsGrouping && currentRowData.Expanded)
                {
                    @groupFooter(currentRowData);
                }
                
                @if (!currentDataItem.HasChildren && ExpandTemplate != null && InternalRowExpandable(currentRowData) && (currentRowData.Expanded || currentRowData.WasExpanded))
                {
                    <tr class="ant-table-expanded-row ant-table-expanded-row-level-1 @ExpandedRowClassName(currentRowData)"
                        style="@(currentRowData.Expanded ? null : "display: none;")">
                        <td colspan="@(ExpandedRowOffset.HasValue ? Math.Max(1, ColumnContext.Columns.Count + 1 - ExpandedRowOffset.Value) : ColumnContext.Columns.Count + 1)" class="ant-table-cell">
                            @ExpandTemplate(currentRowData)
                        </td>
                    </tr>
                }
            }
            </TableRowWrapper>;
        };
    }


    RenderFragment tfoot()
    {
        @if (_summaryRows?.Any() == true)
        {
            return@<CascadingValue Value="true" Name="IsSummary" IsFixed>
                 <tfoot class="ant-table-summary">
                     @foreach (var row in _summaryRows)
                        {
                            <tr>
                                @row.ChildContent
                            </tr>
                        }
                    </tfoot>
                </CascadingValue>;
        }

        return builder => { };
    }

    RenderFragment groupFooter(RowData<TItem> currentRowData)
    {
         @if (GroupFooterTemplate !=null)
        {
            return@<tr class="ant-table-expanded-row ant-table-expanded-row-level-1 ant-table-grouping-footer" >
                <td colspan="@(ColumnContext.Columns.Count+1)" class="ant-table-cell">
                    @GroupFooterTemplate(currentRowData.GroupResult)
                </td>
            </tr>;
        }
        return builder => { };
    }
}
