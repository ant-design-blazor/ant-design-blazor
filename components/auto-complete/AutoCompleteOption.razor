@namespace AntDesign
@inherits AntDomComponentBase

<div class="@(AutoComplete?.GetSemanticClass("popup.listItem", ClassMapper.Class) ?? ClassMapper.Class)" style="@(AutoComplete?.GetSemanticStyle("popup.listItem", Style) ?? Style)" id="@Id" @onclick="@OnClick" @onmouseenter="@OnMouseEnter">
    <div class="ant-select-item-option-content">
        @if (ChildContent != null)
        {
            @ChildContent
        }
        else
        {
            @Label
        }
    </div>
</div>
