@namespace AntDesign
@inherits AntDomComponentBase


@if (IsProgressPlaceholder)
{
    <div class="@SemanticClass("placeholder.progress.root", "ant-image ant-image-progress-wrapper css-var-root ant-image-css-var")" style="@SemanticStyle("placeholder.progress.root", _wrapperStyle)"
         role="@(HasProgressPercent ? "progressbar" : null)"
         aria-valuemin="@(HasProgressPercent ? "0" : null)"
         aria-valuemax="@(HasProgressPercent ? "100" : null)"
         aria-valuenow="@(HasProgressPercent ? ProgressPercentText : null)"
         aria-label="@(HasProgressPercent ? $"{ProgressPercentText}%" : null)"
         aria-busy="@(HasProgressPercent ? null : "true")">
        @if (!HasProgressPercent)
        {
            <span role="status" aria-live="polite" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0, 0, 0, 0);white-space:nowrap;border:0">Loading</span>
        }
        <div class="ant-image-progress-ink-1"></div>
        <div class="ant-image-progress-ink-2"></div>
        <div class="@SemanticClass("placeholder.progress.content", "ant-image-progress-content")" style="@SemanticStyle("placeholder.progress.content")">
            @if (HasProgressPercent)
            {
                @GetProgressContent()
            }
            else if (ProgressRender != null)
            {
                @GetProgressContent()
            }
            else if (Placeholder != null)
            {
                @Placeholder
            }
        </div>
    </div>
}
else
{
    <div class="@SemanticClass("root", ClassMapper.Class)" style="@SemanticStyle("root", _wrapperStyle)" id="@Id"
         role="@(Preview ? "button" : null)" tabindex="@(Preview ? "0" : null)" @ref="Ref">
        <img alt="@Alt" class="@SemanticClass("image", "ant-image-img")" src="@Src" style="@SemanticStyle("image", Style)"
             @onerror="HandleOnError"
             @onloadstart="HandleOnLoadStart"
             @onload="HandleOnLoad"
		     @onclick="OnClick"/>

        @if (!_loaded && Placeholder != null)
        {
            <div aria-hidden="true" class="ant-image-placeholder">
                @Placeholder
            </div>
        }

        @if (Preview)
        {
            <div class="@SemanticClass("cover", $"ant-image-cover {PreviewCoverPlacementClass}")" style="@SemanticStyle("cover")" @onclick="OnMaskClick" @onclick:stopPropagation>
                @if (_loaded && !_isError && PreviewCover != null)
                {
                    @PreviewCover
                }
                else if (_loaded && !_isError)
                {
                    <div class="ant-image-mask-info">
                        <Icon Type="eye" /> @Locale.Preview
                    </div>
                }
            </div>
        }
    </div>
}
