@namespace AntDesign

@if (_visible)
{
    <div class="ant-image-preview css-var-root ant-image-css-var ant-image-preview-movable"
         role="dialog" aria-modal="true" tabindex="-1" @onkeydown="HandleKeyDown">
        <div class="ant-image-preview-mask" @onclick="HandleClose" @onclick:stopPropagation></div>
        <div class="ant-image-preview-body" @onwheel="WeelHandZoom" @onclick:stopPropagation>
            <img id="preview-img" @ref="_previewImg" class="ant-image-preview-img" src="@ImageRef.ImageSrc"
                 style="transform: translate3d(0px, 0px, 0) scale3d(@_zoomOutTimes, @_zoomOutTimes, 1) rotate(@(90 * _rotateTimes)deg) scaleX(@(_flipX ? -1 : 1)) scaleY(@(_flipY ? -1 : 1));">
        </div>
        <button class="ant-image-preview-close" aria-label="close" @onclick="HandleClose" @onclick:stopPropagation>
            <Icon Type="close" />
        </button>
        @if (ImageRef.ImageCount > 1)
        {
            <button class="ant-image-preview-switch ant-image-preview-switch-prev @(ImageRef.CurrentIndex == 0 ? "ant-image-preview-switch-disabled" : string.Empty)"
                    aria-label="previous" disabled="@(ImageRef.CurrentIndex == 0)" @onclick="SwitchPrevious" @onclick:stopPropagation>
                <Icon Type="left" />
            </button>
            <button class="ant-image-preview-switch ant-image-preview-switch-next @(ImageRef.CurrentIndex == ImageRef.ImageCount - 1 ? "ant-image-preview-switch-disabled" : string.Empty)"
                    aria-label="next" disabled="@(ImageRef.CurrentIndex == ImageRef.ImageCount - 1)" @onclick="SwitchNext" @onclick:stopPropagation>
                <Icon Type="right" />
            </button>
        }
        <div class="ant-image-preview-footer">
            @if (ImageRef.ImageCount > 1)
            {
                <div class="ant-image-preview-progress"><bdi>@(ImageRef.CurrentIndex + 1) / @ImageRef.ImageCount</bdi></div>
            }
            <div class="ant-image-preview-actions">
                <button aria-label="flipY" class="ant-image-preview-actions-action ant-image-preview-actions-action-flipY" type="button" @onclick="HandleFlipY" @onclick:stopPropagation>
                    <Icon Type="swap" Style="transform: rotate(90deg);" />
                </button>
                <button aria-label="flipX" class="ant-image-preview-actions-action ant-image-preview-actions-action-flipX" type="button" @onclick="HandleFlipX" @onclick:stopPropagation>
                    <Icon Type="swap" />
                </button>
                <button aria-label="rotateLeft" class="ant-image-preview-actions-action ant-image-preview-actions-action-rotateLeft" type="button" @onclick="HandleRotateLeft" @onclick:stopPropagation>
                    <Icon Type="rotate-left" />
                </button>
                <button aria-label="rotateRight" class="ant-image-preview-actions-action ant-image-preview-actions-action-rotateRight" type="button" @onclick="HandleRotateRight" @onclick:stopPropagation>
                    <Icon Type="rotate-right" />
                </button>
                <button aria-label="zoomOut" class="ant-image-preview-actions-action ant-image-preview-actions-action-zoomOut @(_zoomOutTimes <= 1 ? "ant-image-preview-actions-action-disabled" : string.Empty)" type="button" disabled="@(_zoomOutTimes <= 1)" @onclick="HandleZoomOut" @onclick:stopPropagation>
                    <Icon Type="zoom-out" />
                </button>
                <button aria-label="zoomIn" class="ant-image-preview-actions-action ant-image-preview-actions-action-zoomIn" type="button" @onclick="HandleZoomIn" @onclick:stopPropagation>
                    <Icon Type="zoom-in" />
                </button>
            </div>
        </div>
    </div>
}
