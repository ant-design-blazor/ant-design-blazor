@namespace AntDesign
@inherits AntDomComponentBase

<div class="@SemanticClass("root", ClassMapper.Class)" style="@GetComponentStyle("Anchor", SemanticStyle("root", $"max-height: {(OffsetTop.GetValueOrDefault() > 0 ? $"calc(100vh - {OffsetTop}px)" : "100vh")}; {Style}"))" id="@Id" @ref="Ref">
    <div class="ant-anchor@(IsFixed ? " ant-anchor-fixed" : string.Empty)" @ref="_anchor">
        <span class="@SemanticClass("indicator", _ballClass)" style="@SemanticStyle("indicator", _ballStyle)" @ref="@_ink"></span>
        <CascadingValue Value="this" Name="Root" IsFixed>
            <CascadingValue Value="this" Name="Parent">
                @ChildContent
            </CascadingValue>
        </CascadingValue>
    </div>
</div>
