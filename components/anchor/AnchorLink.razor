@namespace AntDesign
@inherits AntDomComponentBase

<div class="@ItemClass" style="@ItemStyle" @ref="Ref" id="@Id">
    <a href="@Href" target="@Target" title="@Title" class="@ItemTitleClass" style="@ItemTitleStyle" @onclick="(e)=>OnClick(e)" @onclick:preventDefault="true">@Title</a>
    <CascadingValue Value="this" Name="Parent" IsFixed>
        @ChildContent
    </CascadingValue>
</div>
