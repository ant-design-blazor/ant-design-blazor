@namespace AntDesign
@using AntDesign.Icons
@using AntDesign.Internal
@inherits AntDomComponentBase

<div class="@SemanticClass("root", RootClass)" @ref="Ref" style="@SemanticStyle("root", Style)" id="@Id">
    <TransferSidePanel TItem="TransferItem" DataSource="_leftDataSource" Direction="TransferDirection.Left"
                       Title="@(Titles[0] == "" ? null : Titles[0])" SelectedKeys="_sourceSelectedKeys"
                       TargetKeys="_targetKeys" ChildContent="ChildContent"
                       CountText="@_leftCountText"
                       Disabled="Disabled" ShowSelectAll="ShowSelectAll" ShowDropdown ShowSearch="ShowSearch"
                       AllSelectedOverride="_leftCheckAllState" IndeterminateOverride="_leftCheckAllIndeterminate"
                       SearchValue="@_leftFilterValue" SearchPlaceholder="@Locale.SearchPlaceholder" ShowSearchIcon
                       SearchValueChanged="value => HandlePanelSearch(value, TransferDirection.Left)"
                       ItemTitleSelector="item => item.Title" ItemTemplate="RenderTransferItem"
                       IsItemDisabled="item => item.Disabled" KeySelector="item => item.Key"
                       OnItemSelect="HandlePanelItemSelect" OnSelectAll="HandlePanelSelectAll"
                       OnScroll="args => HandleScroll(TransferDirection.Left, args)"
                       PanelClass="@SemanticClass("section", HasFooter ? $"ant-transfer-section {FooterClass}" : "ant-transfer-section", TransferDirection.Left)"
                       PanelStyle="@SemanticStyle("section", ListStyle(TransferDirection.Left), TransferDirection.Left)"
                       ClassResolver="ResolvePanelClass" StyleResolver="ResolvePanelStyle"
                       Footer="@Footer" FooterTemplate="@FooterTemplate" />

    <div class="@SemanticClass("actions", "ant-transfer-actions")" style="@SemanticStyle("actions")">
        @if (String.IsNullOrEmpty(Operations[0]))
        {
            <Button Disabled="@(_rightButtonDisabled||Disabled)" Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="@(e=>MoveItem(e,TransferDirection.Right))">
                <IconContent><RightOutlined /></IconContent>
            </Button>
        }
        else
        {
            <Button Disabled="@(_rightButtonDisabled||Disabled)" Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="@(e=>MoveItem(e,TransferDirection.Right))">
                <IconContent><RightOutlined /></IconContent>
                <ChildContent>@Operations[0]</ChildContent>
            </Button>
        }
        @if (String.IsNullOrEmpty(Operations[1]))
        {
            <Button Disabled="@(_leftButtonDisabled||Disabled)" Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="@(e=>MoveItem(e,TransferDirection.Left))">
                <IconContent><LeftOutlined /></IconContent>
            </Button>
        }
        else
        {
            <Button Disabled="@(_leftButtonDisabled||Disabled)" Size="@ButtonSize.Small" Type="@ButtonType.Primary" OnClick="@(e=>MoveItem(e,TransferDirection.Left))">
                <IconContent><LeftOutlined /></IconContent>
                <ChildContent>@Operations[1]</ChildContent>
            </Button>
        }
    </div>

    <TransferSidePanel TItem="TransferItem" DataSource="_rightDataSource" Direction="TransferDirection.Right"
                       Title="@(Titles[1] == "" ? null : Titles[1])" SelectedKeys="_targetSelectedKeys"
                       TargetKeys="_targetKeys" ChildContent="ChildContent"
                       CountText="@_rightCountText"
                       Disabled="Disabled" ShowSelectAll="ShowSelectAll" ShowDropdown ShowSearch="ShowSearch"
                       AllSelectedOverride="_rightCheckAllState" IndeterminateOverride="_rightCheckAllIndeterminate"
                       SearchValue="@_rightFilterValue" SearchPlaceholder="@Locale.SearchPlaceholder" ShowSearchIcon
                       SearchValueChanged="value => HandlePanelSearch(value, TransferDirection.Right)"
                       ItemTitleSelector="item => item.Title" ItemTemplate="RenderTransferItem"
                       IsItemDisabled="item => item.Disabled" KeySelector="item => item.Key"
                       OnItemSelect="HandlePanelItemSelect" OnSelectAll="HandlePanelSelectAll"
                       OnScroll="args => HandleScroll(TransferDirection.Right, args)"
                       PanelClass="@SemanticClass("section", HasFooter ? $"ant-transfer-section {FooterClass}" : "ant-transfer-section", TransferDirection.Right)"
                       PanelStyle="@SemanticStyle("section", ListStyle(TransferDirection.Right), TransferDirection.Right)"
                       ClassResolver="ResolvePanelClass" StyleResolver="ResolvePanelStyle"
                       Footer="@Footer" FooterTemplate="@FooterTemplate" />
</div>

@code {
    private bool HasFooter => FooterTemplate != null || !string.IsNullOrEmpty(Footer);
    private string RootClass => ChildContent == null ? ClassMapper.Class : $"{ClassMapper.Class} ant-transfer-customize-list";

    private string ResolvePanelClass(string slot, string baseClass, TransferDirection direction) =>
        SemanticClass(slot, baseClass, direction);

    private string ResolvePanelStyle(string slot, string baseStyle, TransferDirection direction) =>
        SemanticStyle(slot, baseStyle, direction);

    private RenderFragment<TransferItem> RenderTransferItem => item => builder =>
    {
        if (Render == null)
        {
            builder.AddContent(0, item.Title);
            return;
        }

        var content = Render(item);
        if (content.IsT0)
        {
            builder.AddContent(1, content.AsT0);
        }
        else
        {
            builder.AddContent(2, content.AsT1);
        }
    };

    private Task HandlePanelItemSelect(TransferSideSelection selection) =>
        SelectItem(selection.Selected, selection.Direction, selection.Key);

    private Task HandlePanelSelectAll(TransferSideSelectAll selection) =>
        SelectAll(selection.Selected, selection.Direction);

    private Task HandlePanelSearch(string value, TransferDirection direction) =>
        HandleSearch(new ChangeEventArgs { Value = value }, direction);
}
