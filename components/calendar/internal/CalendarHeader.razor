@namespace AntDesign
@inherits AntDomComponentBase
@using AntDesign.Internal

<div class="@(PrefixCls)-header"
     style="@Style"
     id="@Id"
     @ref="@Ref">
    @{
        var dateCalendar = Calendar.DateCalendar ?? Calendar.CultureInfo.Calendar;
        int startYear = dateCalendar.GetYear(dateCalendar.AddYears(Calendar.Value, -10));
        int endYear = dateCalendar.GetYear(dateCalendar.AddYears(Calendar.Value, 10));

        if (Calendar.ValidRange != null)
        {
            startYear = dateCalendar.GetYear(Calendar.ValidRange[0]);
            endYear = dateCalendar.GetYear(Calendar.ValidRange[1]);
        }

        string yearFormat = Calendar.Locale.Lang.YearFormat;
    }
    <Select Class=@($"{PrefixCls}-year-select")
            @bind-Value="@_yearValue"
            Size=@(Calendar.FullScreen ? InputSize.Default : InputSize.Small)
            DefaultValue=@dateCalendar.GetYear(Calendar.Value)
            TItemValue="int"
            TItem="string"
            Style="width: unset;"
            SortByLabel="@SortDirection.Ascending"
            OnSelectedItemChanged="@OnSelectYear">
            <SelectOptions>
                @for (int year = startYear; year <= endYear; year++)
                {
                    DateTime yearDate = DateHelper.CreateDate(dateCalendar, year, 1, 1, Calendar.Value);
                    <SelectOption @key="@year" TItemValue="int" TItem="string" Value=@year Label="@(CalendarFormatter.FormatYear(yearDate, yearFormat, Calendar.CultureInfo, dateCalendar))" />
                }
            </SelectOptions>        
    </Select>

    @if (Calendar.Mode == CalendarMode.Month)
    {
        int startMonth = 1;
        int endMonth = 12;

        if (Calendar.ValidRange != null)
        {
            startMonth = dateCalendar.GetYear(Calendar.Value) == dateCalendar.GetYear(Calendar.ValidRange[0]) ? dateCalendar.GetMonth(Calendar.ValidRange[0]) : startMonth;
            endMonth = dateCalendar.GetYear(Calendar.Value) == dateCalendar.GetYear(Calendar.ValidRange[1]) ? dateCalendar.GetMonth(Calendar.ValidRange[1]) : endMonth;
        }

        string monthFormat = Calendar.Locale.Lang.MonthFormat;

        <Select class=@($"{PrefixCls}-month-select")
                @bind-Value="@_monthValue"
                Size=@(Calendar.FullScreen ? InputSize.Default : InputSize.Small)
                DefaultValue=@dateCalendar.GetMonth(Calendar.Value)
                Style="width: unset;"
                TItemValue="int"
                TItem="string"
                OnSelectedItemChanged="@OnSelectMonth">
                <SelectOptions>
                    @for (int month = startMonth; month <= endMonth; month++)
                    {
                        DateTime monthDate = DateHelper.CreateDate(dateCalendar, dateCalendar.GetYear(Calendar.Value), month, 1, Calendar.Value);
                        <SelectOption @key="@month" TItemValue="int" TItem="string" Value=@month Label="@(CalendarFormatter.FormatMonth(monthDate, monthFormat, Calendar.CultureInfo, dateCalendar))" />
                    }
                </SelectOptions>            
        </Select>
    }

    <RadioGroup class=@($"{PrefixCls}-mode-switch")
                Size=@(Calendar.FullScreen ? InputSize.Default : InputSize.Small)
                Value="@Calendar.Mode"
                OnChange="OnModeChange" TValue="CalendarMode">
        <Radio RadioButton Value="@CalendarMode.Month">@(Calendar.Locale.Lang.Month)</Radio>
        <Radio RadioButton Value="@CalendarMode.Year">@(Calendar.Locale.Lang.Year)</Radio>
    </RadioGroup>
</div>

@code
{
    [CascadingParameter(Name = "PrefixCls")]
    public string PrefixCls { get; set; }

    [CascadingParameter(Name = "Calendar")]
    public Calendar Calendar { get; set; }

    private DateTime currentDate;
    private int _yearValue;
    private int _monthValue;

    protected override void OnInitialized()
    {
        base.OnInitialized();

        currentDate = Calendar.Value;
    }

    private void OnModeChange(CalendarMode value)
    {
        Calendar.ChangeMode(value);
    }

    private void OnSelectYear(string value)
    {      
        int year = Convert.ToInt32(value);
        Calendar.ChangeValue(DateHelper.CombineNewDate(Calendar.Value, Calendar.DateCalendar ?? Calendar.CultureInfo.Calendar, year: year));
    }

    private void OnSelectMonth(string value)
    {
        int month = Convert.ToInt32(value);
        Calendar.ChangeValue(DateHelper.CombineNewDate(Calendar.Value, Calendar.DateCalendar ?? Calendar.CultureInfo.Calendar, month: month));
    }
}
