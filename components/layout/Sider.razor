@namespace AntDesign
@inherits AntDomComponentBase

<aside class="@ClassMapper.Class" style="@RootStyle">
    @if ((_showTrigger || _isCollapsed) && CollapsedWidth == 0 && !NoTrigger)
    {
        <button type="button" class="ant-layout-sider-zero-width-trigger ant-layout-sider-zero-width-trigger-left"
              aria-label="Toggle sidebar" aria-expanded="@(!_isCollapsed ? "true" : "false")" style="padding:0;border:0;"
              @onclick="ToggleCollapsed">
            <Icon Type="bars" />
        </button>
    }
    <CascadingValue Value="this" IsFixed="@true">
        <div class="@BodyClass" style="@BodyStyle">
            @ChildContent
        </div>
    </CascadingValue>
    @if (Collapsible && !NoTrigger && !(CollapsedWidth == 0 && _isCollapsed))
    {
        <div class="ant-layout-sider-trigger" style="width: @($"{ComputedWidth}px")" @onclick="ToggleCollapsed">
            @Trigger
        </div>
    }
</aside>
