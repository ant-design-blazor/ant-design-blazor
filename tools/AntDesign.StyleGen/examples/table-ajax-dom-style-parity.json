{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "revision": "599b251da933709d7b25fc9e9018ed7f4c093b96",
    "component": "Table"
  },
  "config": {
    "timeoutMs": 90000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^acss-[a-zA-Z0-9_-]+$", "^css-dev-only-do-not-override-", "^css-var-_[rR]_[a-zA-Z0-9_-]+$", "^css-[a-zA-Z0-9]+$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "normalizeStyleAttributes": true,
        "removeInterTagWhitespace": true
      }
    }
  },
  "groups": [
    {
      "id": "table-ajax",
      "component": "Table",
      "react": {
        "url": "http://127.0.0.1:8000/components/table",
        "scopeSelector": "#table-demo-ajax",
        "rootSelector": ".ant-table-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5011/en-US/components/table",
        "scopeSelector": "#components-table-demo-ajax",
        "rootSelector": ".ant-table-wrapper"
      },
      "styleProperties": ["display", "position", "boxSizing", "width", "height", "fontSize", "fontWeight", "lineHeight", "color", "backgroundColor", "borderRadius", "borderBottomWidth", "overflow", "overflowX"],
      "semanticNodes": [
        { "path": "table", "selector": ".ant-table", "minimumCount": 1 },
        { "path": "header.cell", "selector": ".ant-table-thead th", "minimumCount": 3 },
        { "path": "body.row", "selector": ".ant-table-tbody tr", "minimumCount": 10 },
        { "path": "body.cell", "selector": ".ant-table-tbody td", "minimumCount": 30 },
        {
          "path": "filter.popup",
          "selector": ".ant-table-filter-dropdown",
          "minimumCount": 0,
          "portal": true,
          "portalMatch": "nearest-trigger",
          "portalVisible": true,
          "portalText": "Male"
        }
      ],
      "scenarios": [
        {
          "id": "initial-loaded",
          "actions": [{ "type": "wait", "milliseconds": 2500 }]
        },
        {
          "id": "sort-name",
          "actions": [
            { "type": "click", "reactSelector": "#table-demo-ajax .ant-table-thead th:first-child .ant-table-column-sorters", "blazorSelector": "#components-table-demo-ajax .ant-table-thead th:first-child .ant-table-column-sorters" },
            { "type": "wait", "milliseconds": 2500 }
          ]
        },
        {
          "id": "filter-male",
          "actions": [
            { "type": "click", "reactSelector": "#table-demo-ajax .ant-table-thead th:nth-child(2) .ant-table-filter-trigger", "blazorSelector": "#components-table-demo-ajax .ant-table-thead th:nth-child(2) .ant-table-filter-trigger" },
            { "type": "waitForPortal", "reactTriggerSelector": "#table-demo-ajax .ant-table-thead th:nth-child(2) .ant-table-filter-trigger", "blazorTriggerSelector": "#components-table-demo-ajax .ant-table-thead th:nth-child(2) .ant-table-filter-trigger", "portalSelector": ".ant-table-filter-dropdown", "maxDistance": 100 },
            { "type": "click", "reactSelector": ".ant-table-filter-dropdown .ant-dropdown-menu-item[data-menu-id$='-male']", "blazorSelector": ".ant-table-filter-dropdown .ant-dropdown-menu-item[data-menu-id$='-male']" },
            { "type": "click", "reactSelector": ".ant-table-filter-dropdown .ant-btn-primary", "blazorSelector": ".ant-table-filter-dropdown .ant-btn-primary" },
            { "type": "wait", "milliseconds": 2500 }
          ]
        }
      ]
    }
  ]
}
