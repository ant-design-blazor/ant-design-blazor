{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "revision": "599b251da933709d7b25fc9e9018ed7f4c093b96",
    "component": "Tooltip"
  },
  "config": {
    "timeoutMs": 20000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*"],
        "removeClassPatterns": ["^css-dev-only-do-not-override-", "^css-var-_r_"],
        "removeCommentMarkers": ["<!--!-->"]
      },
      "ignoredSemanticAttributes": { "tooltip": ["style"] }
    }
  },
  "groups": [
    {
      "id": "tooltip-basic-portal",
      "component": "Tooltip",
      "react": {
        "url": "http://127.0.0.1:8000/components/tooltip",
        "scopeSelector": "body",
        "rootSelector": "#tooltip-demo-basic .code-box-demo span:first-of-type",
        "skeletonSelector": ""
      },
      "blazor": {
        "url": "http://127.0.0.1:8186/en-US/components/tooltip",
        "scopeSelector": "body",
        "rootSelector": "#components-tooltip-demo-basic .code-box-demo span:first-of-type",
      "skeletonSelector": ""
      },
      "geometryTolerancePx": 1.5,
      "styleProperties": [
        "display", "position", "zIndex", "transformOrigin",
        "boxSizing", "width", "height", "paddingBlock", "paddingInline", "marginBlock", "gap",
        "alignItems", "lineHeight", "fontFamily", "fontSize", "fontWeight", "color",
        "backgroundColor", "borderRadius", "opacity", "visibility", "transform",
        "--ant-tooltip-arrow-shadow-width", "--ant-tooltip-bg", "--ant-tooltip-color"
      ],
      "pseudoElements": ["::before", "::after"],
      "semanticNodes": [
        { "path": "trigger", "reactSelector": "$root", "blazorSelector": "$root", "minimumCount": 1 },
        { "path": "tooltip", "reactSelector": ".ant-tooltip", "blazorSelector": ".ant-tooltip", "minimumCount": 0, "portal": true, "portalText": "prompt text", "portalVisible": true },
        { "path": "arrow", "reactSelector": ".ant-tooltip-arrow", "blazorSelector": ".ant-tooltip-arrow", "minimumCount": 0, "portal": true, "portalText": "prompt text", "portalVisible": true },
        { "path": "content", "reactSelector": ".ant-tooltip-container", "blazorSelector": ".ant-tooltip-container", "minimumCount": 0, "portal": true, "portalText": "prompt text", "portalVisible": true }
      ],
      "scenarios": [
        { "id": "initial" },
        {
          "id": "hover-and-show-arrow",
          "actions": [
            { "type": "hover", "reactSelector": "#tooltip-demo-basic .code-box-demo span", "blazorSelector": "#components-tooltip-demo-basic .code-box-demo span" },
            { "type": "waitForSelector", "reactSelector": ".ant-tooltip:not(.ant-tooltip-hidden)", "blazorSelector": ".ant-tooltip:not(.ant-tooltip-hidden)" }
          ]
        }
      ]
    }
  ]
