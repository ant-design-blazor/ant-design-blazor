{
  "schemaVersion": 1,
  "upstream": { "repository": "ant-design/ant-design", "component": "Form" },
  "config": {
    "timeoutMs": 30000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id", "style"],
        "removeClassPatterns": ["^css-dev-only-to-override-", "^css-var-root$", "^css-var-_r_", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$", "^acss-[a-zA-Z0-9]+$", "^dynamic-delete-button$", "^ant-col-xs-offset-0$", "^ant-col-sm-offset-4$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "removeEmptyAttributes": ["style"]
      }
    }
  },
  "groups": [
    {
      "id": "form-dynamic-form-item-passengers",
      "component": "Form",
      "captureReactBeforeBlazor": true,
      "react": {
        "url": "http://127.0.0.1:8000/components/form?theme=light",
        "scopeSelector": "#form-demo-dynamic-form-item .code-box-demo",
        "rootSelector": "form.ant-form"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/form?theme=light",
        "scopeSelector": "#components-form-demo-dynamic-form-item .code-box-demo",
        "rootSelector": "form.ant-form"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "minHeight", "maxWidth",
        "marginBottom", "marginTop", "marginInlineStart", "marginInlineEnd", "gap", "alignItems", "flexDirection", "padding", "fontSize", "lineHeight",
        "color", "backgroundColor", "borderRadius", "borderWidth", "top", "cursor", "transitionProperty", "transitionDuration"
      ],
      "semanticNodes": [
        { "path": "form", "selector": "$root", "minimumCount": 1 },
        { "path": "formItem", "selector": ".ant-form-item", "minimumCount": 2 },
        { "path": "input", "selector": ".ant-input", "minimumCount": 0 },
        { "path": "button", "selector": "button.ant-btn", "minimumCount": 2 },
        { "path": "removeIcon", "selector": ".anticon-minus-circle", "minimumCount": 0 }
      ],
      "scenarios": [
        { "id": "initial-empty-list" },
        {
          "id": "add-passenger",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-item button.ant-btn-dashed:first-of-type",
              "blazorSelector": "#components-form-demo-dynamic-form-item button.ant-btn-dashed:first-of-type"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        },
        {
          "id": "add-at-head",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-item button.ant-btn-dashed:nth-of-type(2)",
              "blazorSelector": "#components-form-demo-dynamic-form-item button.ant-btn-dashed:nth-of-type(2)"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        },
        {
          "id": "remove-passenger",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-item .anticon-minus-circle",
              "blazorSelector": "#components-form-demo-dynamic-form-item .anticon-minus-circle"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        }
      ],
      "geometryTolerancePx": 0.02,
      "computedStylePixelToleranceByProperty": { "width": 0.02, "height": 0.02 }
    }
  ]
}
