          "selector": ".ant-select-item-option-content",
          "portal": true,
          "portalParentPath": "popup.root",
          "geometryParentSelector": ".ant-select-dropdown",
          "minimumCount": 4
        },
        {
          "path": "popup.state",
          "selector": ".ant-select-item-option-state",
