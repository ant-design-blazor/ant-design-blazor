              "blazorSelector": "#components-select-demo-option-render .ant-select input[aria-expanded='true']"
            },
            {
              "type": "focus",
              "reactSelector": "#select-demo-option-render .ant-select input",
              "blazorSelector": "#components-select-demo-option-render .ant-select input"
