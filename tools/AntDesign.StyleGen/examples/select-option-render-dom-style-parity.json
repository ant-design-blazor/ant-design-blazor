        "rootSelector": "#components-select-demo-option-render .ant-select",
        "skeletonSelector": ""
      },
      "styleProperties": [
        "display",
        "position",
        "boxSizing",
        "width",
        "height",
        "paddingBlock",
        "paddingInline",
        "fontSize",
        "lineHeight",
        "fontWeight",
        "color",
        "backgroundColor",
        "borderRadius",
        "boxShadow",
        "zIndex"
      ],
      "semanticNodes": [
