{
  "schemaVersion": 1,
  "upstream": { "repository": "ant-design/ant-design", "component": "Table" },
  "config": {
    "timeoutMs": 30000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^css-dev-only-to-override-", "^css-var-root$", "^css-var-_r_", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "removeEmptyAttributes": ["style"]
      }
    }
  },
  "groups": [
    {
      "id": "table-tree-data",
      "component": "Table",
      "captureReactBeforeBlazor": true,
      "react": {
        "url": "http://127.0.0.1:8000/components/table?theme=light",
        "scopeSelector": "#table-demo-tree-data .code-box-demo",
        "rootSelector": ".ant-space, .ant-table-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/table?theme=light",
        "scopeSelector": "#components-table-demo-tree-data .code-box-demo",
        "rootSelector": ".ant-space, .ant-table-wrapper"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "minHeight",
        "marginBottom", "gap", "alignItems", "padding", "fontSize", "lineHeight",
        "color", "backgroundColor", "borderRadius", "borderWidth"
      ],
      "semanticNodes": [
        { "path": "table", "selector": "$root", "minimumCount": 1 },
        { "path": "headerCell", "selector": "thead th", "minimumCount": 3 },
        { "path": "row", "selector": "tbody tr", "minimumCount": 2 },
        { "path": "selection", "selector": ".ant-checkbox", "minimumCount": 1 },
        { "path": "switch", "selector": ".ant-switch", "minimumCount": 1 }
      ],
      "scenarios": [
        { "id": "initial-tree" },
        {
          "id": "check-strictly-enabled",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#table-demo-tree-data .ant-switch",
              "blazorSelector": "#components-table-demo-tree-data .ant-switch"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        },
        {
          "id": "select-parent-strictly",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#table-demo-tree-data tbody tr[data-row-key='1'] .ant-checkbox-input",
              "blazorSelector": "#components-table-demo-tree-data tbody tr[data-row-key='1'] .ant-checkbox-input"
            },
            { "type": "wait", "milliseconds": 400 }
          ]
        }
      ],
      "geometryTolerancePx": 0.02,
      "computedStylePixelToleranceByProperty": { "width": 0.02, "height": 0.02 }
    }
  ]
}
