{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "component": "Table"
  },
  "config": {
    "timeoutMs": 30000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^css-dev-only-to-override-", "^css-var-root$", "^css-var-_r_", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "removeEmptyAttributes": ["style"]
      }
    }
  },
  "groups": [
    {
      "id": "table-expand-sticky",
      "component": "Table",
      "captureReactBeforeBlazor": true,
      "react": {
        "url": "http://127.0.0.1:8000/components/table?theme=light#table-demo-expand-sticky",
        "scopeSelector": "#table-demo-expand-sticky .code-box-demo",
        "rootSelector": ".ant-table-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/table?theme=light#components-table-demo-expand-sticky",
        "scopeSelector": "#components-table-demo-expand-sticky .code-box-demo",
        "rootSelector": ".ant-table-wrapper"
      },
      "styleProperties": ["display", "position", "boxSizing", "width", "height", "padding", "fontSize", "lineHeight", "color", "backgroundColor", "borderRadius", "borderWidth", "borderStyle", "insetInlineStart", "zIndex"],
      "semanticNodes": [
        { "path": "table", "selector": "$root", "minimumCount": 1 },
        { "path": "row", "selector": "tbody tr", "minimumCount": 4 },
        { "path": "fixed-column", "selector": "th.ant-table-cell-fix-start", "minimumCount": 3 },
        { "path": "expand-icon", "selector": ".ant-table-row-expand-icon", "minimumCount": 3 }
      ],
      "scenarios": [
        { "id": "initial" },
        {
          "id": "expand-first-row",
          "actions": [
            { "type": "click", "reactSelector": "#table-demo-expand-sticky tbody tr[data-row-key=\"1\"] .ant-table-row-expand-icon", "blazorSelector": "#components-table-demo-expand-sticky tbody tr[data-row-key=\"1\"] .ant-table-row-expand-icon" },
            { "type": "wait", "milliseconds": 1000 }
          ]
        }
      ],
      "geometryTolerancePx": 0.5,
      "computedStylePixelToleranceByProperty": { "width": 0.5, "height": 0.5 }
    }
  ]
}
