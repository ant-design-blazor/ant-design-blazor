{
  "schemaVersion": 1,
  "upstream": { "repository": "ant-design/ant-design", "component": "Upload" },
  "config": {
    "timeoutMs": 45000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_[rR]_[a-zA-Z0-9_-]+|__runtime-id-\\d+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^css-dev-only-do-not-override-", "^css-var-_[a-zA-Z0-9_]+$", "^css-[a-zA-Z0-9]+$", "^acss-[a-zA-Z0-9_-]+$", "^upload-demo-style-class-root$"],
        "removeCommentMarkers": ["<!--!-->"],
        "normalizeStyleAttributes": true,
        "sortClassTokens": true
      }
    }
  },
  "groups": [{
    "id": "upload-style-class",
    "component": "Upload",
    "geometryTolerancePx": 0.03,
    "computedStylePixelToleranceByProperty": { "width": 0.03 },
    "react": {
      "url": "http://127.0.0.1:8000/components/upload?theme=light#upload-demo-style-class",
      "scopeSelector": "#upload-demo-style-class",
      "rootSelector": ".ant-flex-vertical"
    },
    "blazor": {
      "url": "http://127.0.0.1:5000/en-US/components/upload?theme=light#components-upload-demo-style-class",
      "scopeSelector": "#components-upload-demo-style-class",
      "rootSelector": ".ant-flex-vertical"
    },
    "styleProperties": ["display", "position", "boxSizing", "width", "height", "paddingBlock", "paddingInline", "gap", "alignItems", "fontSize", "lineHeight", "color", "backgroundColor", "borderRadius", "borderWidth", "borderColor"],
    "semanticNodes": [
      { "path": "root", "selector": "$root", "minimumCount": 1 },
      { "path": "upload", "selector": ".ant-upload-wrapper", "minimumCount": 2 },
      { "path": "trigger", "selector": ".ant-upload-select", "minimumCount": 2 },
      { "path": "button", "selector": ".ant-upload-select .ant-btn", "minimumCount": 2 },
      { "path": "list", "selector": ".ant-upload-list.ant-upload-list-text", "minimumCount": 2 },
      { "path": "item", "selector": ".ant-upload-list-item", "minimumCount": 6 },
      { "path": "uploading", "selector": ".ant-upload-list-item-uploading", "minimumCount": 2 },
      { "path": "done", "selector": ".ant-upload-list-item-done", "minimumCount": 2 },
      { "path": "error", "selector": ".ant-upload-list-item-error", "minimumCount": 2 }
    ],
    "scenarios": [{ "id": "default", "minimumRoots": 1 }]
  }]
}
