    "viewport": {
      "width": 1280,
      "height": 900,
      "deviceScaleFactor": 1
    },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": [
          "_bl_*",
          "id",
          "style"
        ],
        "removeClassPatterns": [
          "^css-dev-only-do-not-override-",
          "^css-var-_r_",
          "^css-var-_[rR]_",
          "^css-[a-zA-Z0-9]+$"
        ],
        "removeCommentMarkers": [
          "<!--!-->"
        ]
      }
    }
  },
