{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "component": "Transfer"
  },
  "config": {
    "timeoutMs": 30000,
    "viewport": {
      "width": 1280,
      "height": 900,
      "deviceScaleFactor": 1
    },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": [
          "^css-dev-only-do-not-override-",
          "^css-var-_r_",
          "^css-var-_[rR]_",
          "^css-[a-zA-Z0-9]+$",
          "^ant-checkbox-css-var$"
        ],
        "removeCommentMarkers": ["<!--!-->"]
      }
    }
  },
  "groups": [
    {
      "id": "transfer-basic-demo",
      "component": "Transfer",
      "react": {
        "url": "http://127.0.0.1:8000/components/transfer",
        "scopeSelector": "#transfer-demo-basic .code-box-demo",
        "rootSelector": ".ant-transfer",
        "skeletonSelector": ".ant-skeleton"
      },
      "blazor": {
        "url": "http://127.0.0.1:5524/en-US/components/transfer",
        "scopeSelector": "#components-transfer-demo-basic .code-box-demo",
        "rootSelector": ".ant-transfer",
        "skeletonSelector": ".ant-skeleton"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "minHeight", "maxHeight",
        "flex", "flexDirection", "paddingBlock", "paddingInline", "marginBlock", "marginInline",
        "gap", "alignItems", "lineHeight", "fontSize", "fontWeight", "color", "backgroundColor",
        "borderRadius", "borderTopWidth", "borderRightWidth", "borderBottomWidth", "borderLeftWidth",
        "--ant-transfer-list-width", "--ant-transfer-list-height", "--ant-transfer-header-height", "--ant-transfer-item-height"
      ],
      "semanticNodes": [
        { "path": "root", "reactSelector": "$root", "blazorSelector": "$root", "minimumCount": 1 },
        { "path": "section", "reactSelector": ".ant-transfer-section", "blazorSelector": ".ant-transfer-section", "minimumCount": 2 },
        { "path": "actions", "reactSelector": ".ant-transfer-actions", "blazorSelector": ".ant-transfer-actions", "minimumCount": 1 },
        { "path": "header", "reactSelector": ".ant-transfer-list-header", "blazorSelector": ".ant-transfer-list-header", "minimumCount": 2 },
        { "path": "body", "reactSelector": ".ant-transfer-list-body", "blazorSelector": ".ant-transfer-list-body", "minimumCount": 2 },
        { "path": "list", "reactSelector": ".ant-transfer-list-content", "blazorSelector": ".ant-transfer-list-content", "minimumCount": 2 },
        { "path": "item", "reactSelector": ".ant-transfer-list-content-item", "blazorSelector": ".ant-transfer-list-content-item", "minimumCount": 20 },
        { "path": "itemContent", "reactSelector": ".ant-transfer-list-content-item-text", "blazorSelector": ".ant-transfer-list-content-item-text", "minimumCount": 20 }
      ],
      "scenarios": [
        { "id": "default", "minimumRoots": 1 }
      ]
    }
  ]
}
