{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "component": "Table"
  },
  "config": {
    "timeoutMs": 30000,
    "viewport": {
      "width": 1280,
      "height": 900,
      "deviceScaleFactor": 1
    },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id", "name", "style"],
        "removeClassPatterns": ["^css-dev-only-to-override-", "^css-var-root$", "^css-var-_r_", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$", "^acss-[a-zA-Z0-9_-]+$", "^editable-row$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "removeEmptyAttributes": ["style"]
      }
    }
  },
  "groups": [
    {
      "id": "table-edit-cell",
      "component": "Table",
      "captureReactBeforeBlazor": true,
      "alignRootViewportY": 180,
      "react": {
        "url": "http://127.0.0.1:8000/components/table?theme=light",
        "scopeSelector": "#table-demo-edit-cell .code-box-demo",
        "rootSelector": ".ant-table-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/table?theme=light",
        "scopeSelector": "#components-table-demo-edit-cell .code-box-demo",
        "rootSelector": ".ant-table-wrapper"
      },
      "styleProperties": [
        "display",
        "position",
        "boxSizing",
        "width",
        "height",
        "minHeight",
        "marginBottom",
        "padding",
        "fontSize",
        "lineHeight",
        "color",
        "backgroundColor",
        "borderRadius",
        "borderWidth",
        "borderStyle",
        "transition",
        "cursor"
      ],
      "semanticNodes": [
        {"path": "table", "selector": "$root", "minimumCount": 1},
        {"path": "row", "selector": "tbody tr", "minimumCount": 2},
        {"path": "cell", "selector": "tbody td", "minimumCount": 8}
      ],
      "scenarios": [
        {"id": "initial"},
        {
          "id": "start-edit",
          "actions": [
            {"type": "click", "reactSelector": "#table-demo-edit-cell .editable-cell-value-wrap", "blazorSelector": "#components-table-demo-edit-cell .editable-cell-value-wrap"}
          ]
        },
        {"id": "edit-state", "actions": [{"type": "wait", "milliseconds": 300}]}
      ],
      "geometryTolerancePx": 0.5,
      "computedStylePixelToleranceByProperty": {
        "width": 0.5,
        "height": 0.5
      }
    }
  ]
}
