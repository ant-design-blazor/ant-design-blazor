{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "component": "Form"
  },
  "config": {
    "timeoutMs": 30000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^css-dev-only-to-override-", "^css-var-root$", "^css-var-_r_", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "removeEmptyAttributes": ["style"]
      }
    }
  },
  "groups": [
    {
      "id": "form-dynamic-form-items-complex",
      "component": "Form",
      "captureReactBeforeBlazor": true,
      "react": {
        "url": "http://127.0.0.1:8000/components/form?theme=light",
        "scopeSelector": "#form-demo-dynamic-form-items-complex .code-box-demo",
        "rootSelector": "form.ant-form > div"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/form?theme=light",
        "scopeSelector": "#components-form-demo-dynamic-form-items-complex .code-box-demo",
        "rootSelector": "form.ant-form > div"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "minHeight",
        "marginBottom", "rowGap", "gap", "alignItems", "padding", "fontSize",
        "lineHeight", "color", "backgroundColor", "borderRadius", "borderWidth"
      ],
      "semanticNodes": [
        { "path": "dynamicList", "selector": "$root", "minimumCount": 1 },
        { "path": "card", "selector": ".ant-card", "minimumCount": 1 },
        { "path": "formItem", "selector": ".ant-form-item", "minimumCount": 2 },
        { "path": "input", "selector": ".ant-input", "minimumCount": 1 },
        { "path": "space", "selector": ".ant-space", "minimumCount": 0 },
        { "path": "button", "selector": "button.ant-btn", "minimumCount": 2 }
      ],
      "scenarios": [
        { "id": "initial" },
        {
          "id": "add-sub-item",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-items-complex button.ant-btn-dashed",
              "blazorSelector": "#components-form-demo-dynamic-form-items-complex button.ant-btn-dashed"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        },
        {
          "id": "add-parent-item",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-items-complex .ant-form > div > button.ant-btn-dashed",
              "blazorSelector": "#components-form-demo-dynamic-form-items-complex .ant-form > div > button.ant-btn-dashed"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        },
        {
          "id": "add-and-remove-sub-item",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-items-complex button.ant-btn-dashed",
              "blazorSelector": "#components-form-demo-dynamic-form-items-complex button.ant-btn-dashed"
            },
            { "type": "wait", "milliseconds": 200 },
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-items-complex .ant-space .anticon-close",
              "blazorSelector": "#components-form-demo-dynamic-form-items-complex .ant-space .anticon-close"
            },
            { "type": "wait", "milliseconds": 2500 }
          ]
        }
      ],
      "geometryTolerancePx": 0.02,
      "computedStylePixelToleranceByProperty": { "width": 0.02, "height": 0.02 }
    },
    {
      "id": "form-dynamic-form-items-complex-values-preview",
      "component": "Form",
      "captureReactBeforeBlazor": true,
      "react": {
        "url": "http://127.0.0.1:8000/components/form?theme=light",
        "scopeSelector": "#form-demo-dynamic-form-items-complex .code-box-demo",
        "rootSelector": "pre"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/form?theme=light",
        "scopeSelector": "#components-form-demo-dynamic-form-items-complex .code-box-demo",
        "rootSelector": "pre"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "minHeight",
        "padding", "fontSize", "fontWeight", "lineHeight", "color",
        "backgroundColor", "borderRadius"
      ],
      "semanticNodes": [
        { "path": "valuesPreview", "selector": "$root", "minimumCount": 1 }
      ],
      "scenarios": [
        { "id": "initial-values" },
        {
          "id": "empty-child-is-unregistered",
          "actions": [
            {
              "type": "click",
              "reactSelector": "#form-demo-dynamic-form-items-complex .ant-card button.ant-btn-dashed",
              "blazorSelector": "#components-form-demo-dynamic-form-items-complex .ant-card button.ant-btn-dashed"
            },
            { "type": "wait", "milliseconds": 400 }
          ]
        },
        {
          "id": "registered-child-value",
          "actions": [
            {
              "type": "fill",
              "reactSelector": "#form-demo-dynamic-form-items-complex .ant-space input",
              "blazorSelector": "#components-form-demo-dynamic-form-items-complex .ant-space input",
              "value": "first value"
            },
            { "type": "wait", "milliseconds": 400 }
          ]
        }
      ],
      "geometryTolerancePx": 0.02,
      "computedStylePixelToleranceByProperty": { "width": 0.02, "height": 0.02 }
    }
  ]
}
