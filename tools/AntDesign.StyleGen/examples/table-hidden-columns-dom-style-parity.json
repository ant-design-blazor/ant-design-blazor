{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "revision": "599b251da933709d7b25fc9e9018ed7f4c093b96",
    "component": "Table"
  },
  "config": {
    "timeoutMs": 90000,
    "viewport": {
      "width": 1280,
      "height": 900,
      "deviceScaleFactor": 1
    },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": [
          "_bl_*",
          "id"
        ],
        "removeClassPatterns": [
          "^acss-[a-zA-Z0-9_-]+$",
          "^css-dev-only-do-not-override-",
          "^css-var-_[rR]_",
          "^css-[a-zA-Z0-9]+$"
        ],
        "removeCommentMarkers": [
          "<!--!-->"
        ],
        "normalizeStyleAttributes": true,
        "sortClassTokens": true,
        "removeInterTagWhitespace": true
      }
    }
  },
  "groups": [
    {
      "id": "table-hidden-columns",
      "component": "Table",
      "react": {
        "url": "http://127.0.0.1:8000/components/table",
        "scopeSelector": "#table-demo-hidden-columns",
        "rootSelector": ".ant-table-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/table",
        "scopeSelector": "#components-table-demo-hidden-columns",
        "rootSelector": ".ant-table-wrapper"
      },
      "styleProperties": [
        "display",
        "position",
        "boxSizing",
        "width",
        "height",
        "paddingInline",
        "gap",
        "alignItems",
        "fontSize",
        "fontWeight",
        "color",
        "backgroundColor",
        "borderRadius",
        "borderTopWidth",
        "borderBottomWidth"
      ],
      "semanticNodes": [
        {
          "path": "root",
          "selector": "$root",
          "minimumCount": 1
        },
        {
          "path": "table",
          "selector": ".ant-table",
          "minimumCount": 1
        },
        {
          "path": "header.cell",
          "selector": ".ant-table-thead th",
          "minimumCount": 8
        },
        {
          "path": "body.row",
          "selector": ".ant-table-tbody tr",
          "minimumCount": 2
        },
        {
          "path": "body.cell",
          "selector": ".ant-table-tbody td",
          "minimumCount": 16
        }
      ],
      "scenarios": [
        {
          "id": "all-columns-visible"
        },
        {
          "id": "column-2-hidden",
          "semanticMinimumCounts": {
            "root": 1,
            "table": 1,
            "header.cell": 7,
            "body.row": 2,
            "body.cell": 14
          },
          "actions": [
            {
              "type": "click",
              "reactSelector": "#table-demo-hidden-columns .ant-checkbox-group label:nth-child(2)",
              "blazorSelector": "#components-table-demo-hidden-columns .ant-checkbox-group label:nth-child(2)"
            },
            {
              "type": "wait",
              "milliseconds": 250
            }
          ]
        }
      ]
    }
  ]
}
