        "scopeSelector": "#components-upload-demo-drag",
        "rootSelector": ".ant-upload-wrapper"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "fontSize", "lineHeight",
        "color", "backgroundColor", "borderRadius", "borderWidth", "borderColor"
      ],
      "semanticNodes": [
        { "path": "root", "selector": "$root", "minimumCount": 1 },
        { "path": "trigger", "selector": ".ant-upload-drag", "minimumCount": 1 },
        { "path": "button", "selector": ".ant-upload-btn", "minimumCount": 1 },
        { "path": "icon", "selector": ".ant-upload-drag-icon .anticon-inbox", "minimumCount": 1 }
