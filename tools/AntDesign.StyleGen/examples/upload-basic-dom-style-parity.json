      ],
      "semanticNodes": [
        { "path": "root", "selector": "$root", "minimumCount": 1 },
        { "path": "trigger", "selector": ".ant-upload-select", "minimumCount": 1 },
        { "path": "button", "selector": "button.ant-btn", "minimumCount": 1 },
        { "path": "list", "selector": ".ant-upload-list.ant-upload-list-text", "minimumCount": 1 },
        { "path": "item.uploading", "selector": ".ant-upload-list-item-uploading", "minimumCount": 1 },
        { "path": "item.done", "selector": ".ant-upload-list-item-done", "minimumCount": 1 },
        { "path": "item.error", "selector": ".ant-upload-list-item-error", "minimumCount": 1 }
      ],
      "scenarios": [{ "id": "default", "minimumRoots": 1 }]
