{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "component": "Upload"
  },
  "config": {
    "timeoutMs": 45000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_[rR]_[a-zA-Z0-9_-]+|__runtime-id-\\d+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^css-dev-only-do-not-override-", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$"],
        "removeCommentMarkers": ["<!--!-->"],
        "normalizeStyleAttributes": true,
        "sortClassTokens": true
      }
    }
  },
  "groups": [
    {
      "id": "upload-basic",
      "component": "Upload",
      "react": {
        "url": "http://127.0.0.1:8000/components/upload",
        "scopeSelector": "#upload-demo-basic",
        "rootSelector": ".ant-upload-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/upload",
        "scopeSelector": "#components-upload-demo-basic",
        "rootSelector": ".ant-upload-wrapper"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "fontSize", "lineHeight",
        "color", "backgroundColor", "borderRadius", "borderWidth", "borderColor"
      ],
      "semanticNodes": [
        { "path": "root", "selector": "$root", "minimumCount": 1 },
        { "path": "trigger", "selector": ".ant-upload-select", "minimumCount": 1 },
        { "path": "button", "selector": "button.ant-btn", "minimumCount": 1 },
        { "path": "icon", "selector": ".ant-btn-icon .anticon-upload", "minimumCount": 1 }
      ],
      "scenarios": [{ "id": "default", "minimumRoots": 1 }]
    },
    {
      "id": "upload-default-file-list",
      "component": "Upload",
      "react": {
        "url": "http://127.0.0.1:8000/components/upload",
        "scopeSelector": "#upload-demo-defaultfilelist",
        "rootSelector": ".ant-upload-wrapper"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/upload",
        "scopeSelector": "#components-upload-demo-defaultFileList",
        "rootSelector": ".ant-upload-wrapper"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "height", "fontSize", "lineHeight",
        "color", "backgroundColor", "borderRadius", "borderWidth", "borderColor"
      ],
      "semanticNodes": [
        { "path": "root", "selector": "$root", "minimumCount": 1 },
        { "path": "trigger", "selector": ".ant-upload-select", "minimumCount": 1 },
        { "path": "button", "selector": "button.ant-btn", "minimumCount": 1 },
        { "path": "list", "selector": ".ant-upload-list.ant-upload-list-text", "minimumCount": 1 },
        { "path": "item.uploading", "selector": ".ant-upload-list-item-uploading", "minimumCount": 1 },
        { "path": "item.done", "selector": ".ant-upload-list-item-done", "minimumCount": 1 },
        { "path": "item.error", "selector": ".ant-upload-list-item-error", "minimumCount": 1 }
      ],
      "scenarios": [{ "id": "default", "minimumRoots": 1 }]
    },
    {
      "id": "upload-file-list",
      "component": "Upload",
      "geometryTolerancePx": 0.02,
      "computedStylePixelToleranceByProperty": { "width": 0.02 },
      "react": {
        "url": "http://127.0.0.1:8000/components/upload",
        "scopeSelector": "#upload-demo-filelist",
        "rootSelector": ".ant-upload-wrapper"
      },
