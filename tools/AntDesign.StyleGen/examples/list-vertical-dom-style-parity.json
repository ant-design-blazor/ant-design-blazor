{
  "schemaVersion": 1,
  "upstream": {
    "repository": "ant-design/ant-design",
    "revision": "599b251da933709d7b25fc9e9018ed7f4c093b96",
    "component": "List"
  },
  "config": {
    "timeoutMs": 45000,
    "viewport": { "width": 1280, "height": 900, "deviceScaleFactor": 1 },
    "colorScheme": "light",
    "comparisonPolicy": {
      "normalization": {
        "runtimeIdPattern": "^(?:ant-blazor-[a-zA-Z0-9_-]+|_r_[a-zA-Z0-9_-]+)$",
        "removeAttributes": ["_bl_*", "id"],
        "removeClassPatterns": ["^acss-[a-zA-Z0-9_-]+$", "^css-dev-only-do-not-override-", "^css-var-_[rR]_", "^css-[a-zA-Z0-9]+$"],
        "removeCommentMarkers": ["<!--!-->"],
        "sortClassTokens": true,
        "removeInterTagWhitespace": true
      }
    }
  },
  "groups": [
    {
      "id": "list-vertical",
      "component": "List",
      "react": {
        "url": "http://127.0.0.1:8000/components/list",
        "scopeSelector": "#list-demo-vertical",
        "rootSelector": ".ant-list"
      },
      "blazor": {
        "url": "http://127.0.0.1:5000/en-US/components/list",
        "scopeSelector": "#components-list-demo-vertical",
        "rootSelector": ".ant-list"
      },
      "styleProperties": [
        "display", "position", "boxSizing", "width", "minWidth", "maxWidth", "height",
        "padding", "paddingBlock", "paddingInline", "margin", "marginBlockEnd", "marginInlineStart",
        "flex", "flexBasis", "flexGrow", "flexShrink", "alignItems", "justifyContent", "gap",
        "fontSize", "fontWeight", "lineHeight", "color", "backgroundColor", "borderBottomWidth",
        "borderBottomStyle", "borderBottomColor", "overflow", "maxWidth"
      ],
      "semanticNodes": [
        { "path": "root", "selector": "$root", "minimumCount": 1 },
        { "path": "item", "selector": ".ant-list-item", "minimumCount": 3 },
        { "path": "meta", "selector": ".ant-list-item-meta", "minimumCount": 3 },
        { "path": "meta.title", "selector": ".ant-list-item-meta-title", "minimumCount": 3 },
        { "path": "meta.description", "selector": ".ant-list-item-meta-description", "minimumCount": 3 },
        { "path": "main", "selector": ".ant-list-item-main", "minimumCount": 3 },
        { "path": "action", "selector": ".ant-list-item-action", "minimumCount": 3 },
        { "path": "extra", "selector": ".ant-list-item-extra", "minimumCount": 3 },
        { "path": "extra.image", "selector": ".ant-list-item-extra img", "minimumCount": 3 },
        { "path": "footer", "selector": ".ant-list-footer", "minimumCount": 1 },
        { "path": "pagination", "selector": ".ant-pagination", "minimumCount": 1 }
      ],
      "scenarios": [
        { "id": "desktop" },
        {
          "id": "tablet",
          "actions": [
            { "type": "viewport", "width": 768, "height": 900 },
            { "type": "wait", "milliseconds": 200 }
          ]
        },
        {
          "id": "narrow-screen",
          "actions": [
            { "type": "viewport", "width": 390, "height": 844 },
            { "type": "wait", "milliseconds": 200 }
          ]
        }
      ]
    }
  ]
}
