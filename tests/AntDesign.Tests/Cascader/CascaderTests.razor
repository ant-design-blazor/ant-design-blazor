@using AntDesign.Core.JsInterop.Modules.Components
@inherits AntDesignTestBase

@code{

    [Theory]
    [InlineData(InputSize.Large, "lg")]
    [InlineData(InputSize.Small, "sm")]
    public void Renders_with_each_size(InputSize size, string cls)
    {
        var cut = Context.Render(@<AntDesign.Cascader Size="@size" />);
        var spanNode = cut.Nodes.QuerySelector($".ant-select-{cls}");

        Assert.NotNull(spanNode);
    }

    [Fact]
    public void Renders_with_disabled()
    {
        JSInterop.SetupVoid("AntDesign.interop.styleHelper.addClsToFirstChild", _ => true);
        var cut = Context.Render(@<AntDesign.Cascader Disabled />);
        var spanNode = cut.Nodes.QuerySelector($".ant-select-disabled");

        Assert.NotNull(spanNode);
    }

    [Fact]
    public void Root_exposes_the_v6_select_and_cascader_css_variable_scopes()
    {
        var cut = Context.Render(@<AntDesign.Cascader />);
        var root = cut.Find(".ant-select.ant-cascader");

        Assert.Contains("ant-select-outlined", root.ClassList);
        Assert.Contains("ant-select-css-var", root.ClassList);
        Assert.Contains("ant-cascader-css-var", root.ClassList);
    }

    [Fact]
    public void Trigger_uses_the_v6_select_content_structure()
    {
        var cut = Context.Render(@<AntDesign.Cascader Placeholder="Please select" />);
        var root = cut.Find(".ant-select.ant-cascader");

        Assert.NotNull(root.QuerySelector(".ant-select-content > .ant-select-placeholder"));
        Assert.NotNull(root.QuerySelector(".ant-select-content > input.ant-select-input[role='combobox']"));
        Assert.NotNull(root.QuerySelector(":scope > .ant-select-suffix"));
        Assert.Null(root.QuerySelector(".ant-select-selector"));
    }

    [Fact]
    public void Opens_controlled_overlay_on_first_interactive_render()
    {
        JSInterop.SetupVoid("AntDesign.interop.styleHelper.addClsToFirstChild", _ => true);
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.domInfoHelper.getOverlayPosition", _ => true)
            .SetResult(new OverlayPosition());
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.overlayHelper.addOverlayToContainer", _ => true)
            .SetResult(new OverlayPosition());

        var cut = Render<AntDesign.Cascader>(@<AntDesign.Cascader Open="true" Options="@Options" />);

        cut.WaitForState(() => !cut.Find(".ant-select-dropdown.ant-cascader-dropdown").ClassList.Contains("ant-select-dropdown-hidden"), timeout: TimeSpan.FromSeconds(2));
        var popup = cut.Find(".ant-select-dropdown.ant-cascader-dropdown");
        Assert.NotNull(popup.QuerySelector(".ant-cascader-menu-item"));
        JSInterop.VerifyInvoke("AntDesign.interop.overlayHelper.addOverlayToContainer");
    }

    [Fact]
    public void Applies_semantic_classes_and_styles_to_clear_and_popup_slots()
    {
        JSInterop.SetupVoid("AntDesign.interop.styleHelper.addClsToFirstChild", _ => true);
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.domInfoHelper.getOverlayPosition", _ => true)
            .SetResult(new OverlayPosition());
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.overlayHelper.addOverlayToContainer", _ => true)
            .SetResult(new OverlayPosition());

        var cut = Render<AntDesign.Cascader>(@<AntDesign.Cascader
            Options="@Options"
            DefaultValue="city"
            AllowClear="true"
            Open="true"
            ClassNames="@SemanticClasses"
            Styles="@SemanticStyles" />);

        Assert.Contains("semantic-root", cut.Find(".ant-cascader").ClassList);
        Assert.Equal("border-color:red;", cut.Find(".ant-cascader").GetAttribute("style"));
        Assert.Contains("semantic-clear", cut.Find("button.ant-select-clear").ClassList);
        Assert.Equal("color:red;", cut.Find("button.ant-select-clear").GetAttribute("style"));

        var popup = cut.Find(".ant-select-dropdown.ant-cascader-dropdown");
        Assert.Contains("semantic-popup", popup.ClassList);
        var list = popup.QuerySelector("ul.ant-cascader-menu");
        Assert.Contains("semantic-list", list.ClassList);
        Assert.Equal("background:yellow;", list.GetAttribute("style"));
        var item = popup.QuerySelector("li.ant-cascader-menu-item");
        Assert.Contains("semantic-item", item.ClassList);
        Assert.Equal("padding:0;", item.GetAttribute("style"));
    }

    private static readonly CascaderNode[] Options =
    [
        new CascaderNode { Value = "province", Label = "Province", Children = [new CascaderNode { Value = "city", Label = "City" }] }
    ];

    private static readonly IReadOnlyDictionary<string, string> SemanticClasses = new Dictionary<string, string>
    {
        ["root"] = "semantic-root",
        ["clear"] = "semantic-clear",
        ["popup.root"] = "semantic-popup",
        ["popup.list"] = "semantic-list",
        ["popup.listItem"] = "semantic-item"
    };

    private static readonly IReadOnlyDictionary<string, string> SemanticStyles = new Dictionary<string, string>
    {
        ["root"] = "border-color:red;",
        ["clear"] = "color:red;",
        ["popup.list"] = "background:yellow;",
        ["popup.listItem"] = "padding:0;"
    };

    [Fact]
    public void Selected_value_uses_the_v6_single_select_content_and_clear_button()
    {
        var options = new[]
        {
            new CascaderNode
            {
                Value = "province",
                Label = "Province",
                Children = new[] { new CascaderNode { Value = "city", Label = "City" } }
            }
        };

        var cut = Context.Render(@<AntDesign.Cascader Options="@options" DefaultValue="city" AllowClear />);
        var root = cut.Find(".ant-select.ant-cascader");
        var content = root.QuerySelector(".ant-select-content.ant-select-content-has-value");

        Assert.NotNull(content);
        Assert.Equal("Province / City", content!.TextContent.Trim());
        Assert.Equal("Province / City", content.GetAttribute("title"));
        Assert.Null(content.QuerySelector(".ant-select-selection-item"));
        Assert.NotNull(root.QuerySelector(":scope > button.ant-select-clear[aria-label='Clear']"));
        Assert.Null(root.QuerySelector(":scope > span.ant-select-clear"));
    }

    [Fact]
    public async Task Multiple_mode_checks_a_branch_and_renders_a_parent_tag()
    {
        JSInterop.SetupVoid("AntDesign.interop.styleHelper.addClsToFirstChild", _ => true);
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.domInfoHelper.getOverlayPosition", _ => true).SetResult(new OverlayPosition());
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.overlayHelper.addOverlayToContainer", _ => true).SetResult(new OverlayPosition());

        var options = new[]
        {
            new CascaderNode { Label = "Bamboo", Value = "bamboo", Children = new[]
            {
                new CascaderNode { Label = "Little", Value = "little", Children = new[]
                {
                    new CascaderNode { Label = "Fish", Value = "fish" },
                    new CascaderNode { Label = "Cards", Value = "cards" }
                }}
            }}
        };
        IEnumerable<string> selected = Array.Empty<string>();
        var cut = Render<AntDesign.Cascader>(@<AntDesign.Cascader Options="@options" Multiple Open="true" ValuesChanged="values => selected = values" />);

        await cut.InvokeAsync(() => cut.Find("li[data-path-key='bamboo'] input.ant-checkbox-input")
            .ChangeAsync(new Microsoft.AspNetCore.Components.ChangeEventArgs { Value = true }));

        Assert.Equal(new[] { "fish", "cards" }, selected);
        Assert.NotEmpty(cut.FindAll(".ant-cascader-checkbox-checked"));
        Assert.Equal("Bamboo", cut.Find(".ant-select-selection-item-content").TextContent.Trim());
        Assert.Contains("ant-select-multiple", cut.Find(".ant-select.ant-cascader").ClassList);
    }

    [Fact]
    public async Task Should_Render_Child_Menu_After_Selecting_Parent_Node()
    {
        // This test verifies that selecting a parent node triggers child menu rendering
        // In .NET 10+, this requires RefreshComponentState() to work correctly
        // In .NET 8/9, it works without RefreshComponentState()
        
        // Arrange
        JSInterop.SetupVoid("AntDesign.interop.styleHelper.addClsToFirstChild", _ => true);
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.domInfoHelper.getOverlayPosition", _ => true)
            .SetResult(new OverlayPosition());
        JSInterop.Setup<OverlayPosition>("AntDesign.interop.overlayHelper.addOverlayToContainer", _ => true)
            .SetResult(new OverlayPosition());

        var level2Child = new CascaderNode { Value = "child2", Label = "Child 2" };
        var leafNode = new CascaderNode { Value = "leaf", Label = "Leaf" };
        var level1Child = new CascaderNode 
        { 
            Value = "child1", 
            Label = "Child 1",
            Children = new[] { level2Child, leafNode }
        };
        var parentNode = new CascaderNode
        {
            Value = "parent-value",
            Label = "Parent",
            Children = new[] { level1Child }
        };

        var options = new[] { parentNode };

        var cut = Render<AntDesign.Cascader>(
            @<AntDesign.Cascader Options="@options" Open="true" />
        );

        // Wait for initial render
        cut.WaitForState(() => cut.FindAll(".ant-cascader-menu").Any(), timeout: TimeSpan.FromSeconds(2));
        var popup = cut.Find(".ant-select-dropdown.ant-cascader-dropdown");
        Assert.Contains("ant-select-css-var", popup.ClassList);
        Assert.Contains("ant-cascader-css-var", popup.ClassList);
        
        // Get initial menu count (should be 1 - only root menu)
        var initialMenus = cut.FindAll(".ant-cascader-menu");
        initialMenus.Count.Should().Be(1, "Initially only root menu should be visible");

        // Find the parent menu item from rendered elements
        var parentMenuItem = cut.Find("li[data-path-key='parent-value']");
        parentMenuItem.Should().NotBeNull("Parent menu item should be rendered");

        // Act - Click on the parent node to expand child menu
        await parentMenuItem.ClickAsync(new Microsoft.AspNetCore.Components.Web.MouseEventArgs());

        // Small delay to allow rendering to complete
        await Task.Delay(50);

        // Assert - The second menu column should appear showing child nodes
        var allMenus = cut.FindAll(".ant-cascader-menu");
        allMenus.Count.Should().BeGreaterOrEqualTo(2, 
            "After clicking parent node, child menu should be rendered.");

        cut.FindAll("ul.ant-cascader-menu[role='menu']").Count.Should().Be(allMenus.Count,
            "Each Cascader column should expose the same menu role as React v6.");
        
        // Verify the child menu item is present in DOM
        var childMenuItem = cut.Find("li[data-path-key='parent-value__RC_CASCADER_SPLIT__child1']");
        childMenuItem.Should().NotBeNull("Child 1 menu item should be visible in the second column");
        await childMenuItem.ClickAsync(new Microsoft.AspNetCore.Components.Web.MouseEventArgs());
        await Task.Delay(50);

        var leafMenuItem = cut.Find("li[data-path-key='parent-value__RC_CASCADER_SPLIT__child1__RC_CASCADER_SPLIT__leaf']");
        leafMenuItem.ClassList.Should().NotContain("ant-cascader-menu-item-expand");
        leafMenuItem.QuerySelector(".ant-cascader-menu-item-expand-icon").Should().BeNull();
    }
}
