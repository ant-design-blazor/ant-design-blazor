@inherits AntDesignTestBase
@code {
    [Fact]
    public void DisableCheckKeys_Should_Have_Parameter_Attribute()
    {
        // Arrange & Act & Assert
        typeof(Tree<string>).GetProperty("DisableCheckKeys")
            .GetCustomAttributes(typeof(ParameterAttribute), false)
            .Should().NotBeEmpty("DisableCheckKeys should have [Parameter] attribute");
    }

    [Fact]
    public void DisabledCheckboxExpression_Should_Have_Parameter_Attribute()
    {
        // Arrange & Act & Assert
        typeof(Tree<string>).GetProperty("DisabledCheckboxExpression")
            .GetCustomAttributes(typeof(ParameterAttribute), false)
            .Should().NotBeEmpty("DisabledCheckboxExpression should have [Parameter] attribute");
    }

    [Fact]
    public void DisableCheckKeys_Should_Disable_Checkbox_For_Specified_Keys()
    {
        // Arrange
        var cut = Render(@<Tree TItem="string"
                                Checkable
                                DefaultExpandedKeys="@(new[] { "0-0" })"
                                DisableCheckKeys="@(new[] { "0-0-0" })">
            <TreeNode Title="parent" Key="0-0" TItem="string">
                <TreeNode Title="child" Key="0-0-0" TItem="string"></TreeNode>
                <TreeNode Title="child2" Key="0-0-1" TItem="string"></TreeNode>
            </TreeNode>
        </Tree>);

        // Act
        var disabledCheckboxes = cut.FindAll(".ant-tree-checkbox-disabled");

        // Assert
        disabledCheckboxes.Count.Should().Be(1);
    }

    [Fact]
    public void DisabledCheckboxExpression_Should_Disable_Checkbox_For_Matching_Nodes()
    {
        // Arrange
        Func<TreeNode<string>, bool> expr = node => node.Key == "0-0";

        var cut = Render(@<Tree TItem="string"
                                Checkable
                                DisabledCheckboxExpression="@expr">
            <TreeNode Title="parent" Key="0-0" TItem="string">
                <TreeNode Title="child" Key="0-0-0" TItem="string"></TreeNode>
            </TreeNode>
            <TreeNode Title="other" Key="0-1" TItem="string"></TreeNode>
        </Tree>);

        // Act
        var disabledCheckboxes = cut.FindAll(".ant-tree-checkbox-disabled");

        // Assert
        disabledCheckboxes.Count.Should().Be(1);
    }

    [Fact]
    public void DisabledCheckboxExpression_Should_Work_With_DataSource()
    {
        // Arrange
        var datas = new List<TreeTestData>
        {
            new() { Id = 1, Name = "Node A" },
            new() { Id = 2, Name = "Node B" },
            new() { Id = 3, Name = "Node C" },
        };

        Func<TreeNode<TreeTestData>, bool> expr = node => node.DataItem.Id == 2;

        var cut = Render(@<Tree TItem="TreeTestData"
                                Checkable
                                DataSource="@datas"
                                TitleExpression="x => x.DataItem.Name"
                                DisabledCheckboxExpression="@expr">
        </Tree>);

        // Act
        var disabledCheckboxes = cut.FindAll(".ant-tree-checkbox-disabled");

        // Assert
        disabledCheckboxes.Count.Should().Be(1);
    }

    public class TreeTestData
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
    }
}
