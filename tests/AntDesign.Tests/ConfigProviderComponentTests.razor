@using Microsoft.AspNetCore.Components.Rendering
@inherits AntDesignTestBase

@code {
    [Fact]
    public void Cascades_provider_and_form_configuration_to_descendants()
    {
        var form = new FormConfig();

        var cut = Context.RenderComponent<ConfigProvider>(parameters => parameters
            .Add(p => p.Form, form)
            .AddChildContent<ConfigProviderUsageProbe>());

        var probe = cut.FindComponent<ConfigProviderUsageProbe>();
        probe.Instance.Provider.Should().BeSameAs(cut.Instance);
        probe.Instance.Provider.Form.Should().BeSameAs(form);
        probe.Find(".provider-config").TextContent.Should().Be("configured");
    }

    [Fact]
    public async Task Direction_and_theme_updates_use_the_config_service()
    {
        JSInterop.SetupVoid(JSInteropConstants.SetDomAttribute, _ => true).SetVoidResult();
        JSInterop.SetupVoid("eval", _ => true).SetVoidResult();

        var cut = Context.RenderComponent<ConfigProvider>();

        await cut.Instance.ChangeDirection("rtl");
        cut.Instance.Direction.Should().Be("RTL");
        JSInterop.VerifyInvoke(JSInteropConstants.SetDomAttribute, 1);

        await cut.Instance.ChangeGlobalTheme(GlobalTheme.Compact);
        cut.Instance.Theme.Should().Be(GlobalTheme.Compact);
        JSInterop.VerifyInvoke("eval", 1);
    }

    private sealed class ConfigProviderUsageProbe : ComponentBase
    {
        [CascadingParameter]
        public ConfigProvider Provider { get; set; } = default!;

        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "provider-config");
            builder.AddContent(2, Provider.Form is null ? "missing" : "configured");
            builder.CloseElement();
        }
    }
}