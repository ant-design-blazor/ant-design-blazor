    [Fact]
    public void Select_Multiple_reports_value_when_a_duplicate_option_is_reselected_after_clearing()
    {
        var values = new[] { "1", "2" };
        IEnumerable<string>? changedValues = null;
        var cut = Render<Select<string, PersonNullable>>(
            @<Select TItemValue="string" TItem="PersonNullable" Mode="SelectMode.Multiple"
                     DataSource="@DuplicateValueOptions" Values="@values"
                     LabelName="@nameof(PersonNullable.Name)" ValueName="@nameof(PersonNullable.Id)"
                     ValuesChanged="@(selection => changedValues = selection)" />);
        cut.SetParametersAndRender(parameters => parameters.Add(p => p.Values, null));

        cut.FindAll(".ant-select-item-option").Single(option => option.TextContent.Trim() == "First").Click();

        changedValues.Should().Equal("1");
        cut.Render();
        cut.FindAll(".ant-select-item-option-selected").Select(option => option.TextContent.Trim())
            .Should().Equal("First", "Second");
        cut.FindAll(".ant-select-selection-item-content").Select(tag => tag.TextContent.Trim()).Should().Equal("First");

        cut.FindAll(".ant-select-item-option").Single(option => option.TextContent.Trim() == "Second").Click();

        changedValues.Should().BeEmpty();
        cut.Render();
        cut.FindAll(".ant-select-item-option-selected").Should().BeEmpty();
    }

    [Theory]
    [InlineData(false)]
    [InlineData(true)]
    public void EnumSelect_Multiple_restores_matching_options_when_values_become_null_during_search(bool useCustomFilter)
    {
        JSInterop.Mode = JSRuntimeMode.Loose;
        JSInterop.Setup<OverlayPosition>(JSInteropConstants.OverlayComponentHelper.AddOverlayToContainer, _ => true)
            .SetResult(new OverlayPosition { Placement = Placement.BottomLeft });

        var values = new[] { City.Beijing, City.Zhejiang };
        var cut = Render<EnumSelect<City>>(
            @<EnumSelect TEnum="City" Mode="SelectMode.Multiple" HideSelected EnableSearch
                         AutoClearSearchValue="false" SearchDebounceMilliseconds="0" Values="@values" />);
        if (useCustomFilter)
        {
            cut.SetParametersAndRender(parameters => parameters.Add(p => p.FilterExpression,
                (option, search) => option.Value == City.Beijing && search == "capital"));
        }
        var searchValue = useCustomFilter ? "capital" : "Beij";

        cut.Find("input[type=search]").Input(searchValue);
        cut.WaitForAssertion(() => cut.Instance.SelectOptionItems.Should().OnlyContain(option => option.IsHidden));

        cut.SetParametersAndRender(parameters => parameters.Add(p => p.Values, null));

        cut.FindAll(".ant-select-selection-item-content").Should().BeEmpty();
        cut.FindAll(".ant-select-item-option-selected").Should().BeEmpty();
        cut.WaitForAssertion(() => cut.FindAll(".ant-select-item-option")
            .Where(option => !(option.GetAttribute("style") ?? "").Contains("display:none"))
            .Select(option => option.TextContent.Trim()).Should().Equal("Beijing"));
    }

    [Fact]
    public void AllowClear_button_not_rendered_for_no_data()
    {
        var dataSource = new List<PersonNullable>()
        {
            new PersonNullable("2", "Test 2"),
            new PersonNullable("3", "Test 3"),
            new PersonNullable("4", "Test 4")
        };

        var cut = Render<AntDesign.Select<string?, PersonNullable>>(
            @<AntDesign.Select DataSource="@dataSource"
                LabelName="@nameof(PersonNullable.Name)"
                ValueName="@nameof(PersonNullable.Id)"
                TItem="PersonNullable"
                TItemValue="string"
                Value="null"
                AllowClear>
        </AntDesign.Select>
    );
        //Act

        //normally blazor would rerender and in Select.OnParametersSet() 
        //would load newly set value into the SelectContent, but bUnit does 
        //not rerender, so it has to be forced. This could probably be fixed
        //by forcing StateHasChanged on the Select component, but requires 
        //investigation if it won't cause multiple re-renders.
        cut.Render(); 
        //Assert
        cut.Invoking(c => c.Find("span.ant-select-clear"))
                .Should().Throw<Bunit.ElementNotFoundException>();

    }

