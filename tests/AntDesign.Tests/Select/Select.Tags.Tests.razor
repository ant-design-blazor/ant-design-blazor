    [Fact]
    public void DefaultValues_setter_tracks_has_items_and_supports_clear()
    {
        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Multiple" TItemValue="string" TItem="string"
                SearchDebounceMilliseconds="0">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("A")" Label="A" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("B")" Label="B" />
                </SelectOptions>
            </AntDesign.Select>
        );

        var defaultValuesHasItemsField = cut.Instance.GetType()
            .GetField("_defaultValuesHasItems", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var defaultValuesProperty = cut.Instance.GetType()
            .GetProperty("DefaultValues", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        defaultValuesHasItemsField.Should().NotBeNull();
        defaultValuesProperty.Should().NotBeNull();

        ((bool)defaultValuesHasItemsField!.GetValue(cut.Instance)!).Should().BeFalse();
        cut.Instance.DefaultValues.Should().BeNull();

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.DefaultValues, new List<string> { "A", "B" }));
        ((bool)defaultValuesHasItemsField.GetValue(cut.Instance)!).Should().BeTrue();
        cut.Instance.DefaultValues.Should().BeEquivalentTo(new[] { "A", "B" });

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.DefaultValues, new List<string> { "A", "B" }));
        ((bool)defaultValuesHasItemsField.GetValue(cut.Instance)!).Should().BeTrue();

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.DefaultValues, (IEnumerable<string>)null));
        ((bool)defaultValuesHasItemsField.GetValue(cut.Instance)!).Should().BeFalse();
        cut.Instance.DefaultValues.Should().BeNull();
    }

    [Fact]
    public async Task OnOverlayShow_pushes_parent_search_value_into_select_content_input()
    {
        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Tags" TItemValue="string" TItem="string"
                SearchDebounceMilliseconds="0" EnableSearch>
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("A")" Label="A" />
                </SelectOptions>
            </AntDesign.Select>
        );

        var selectContent = cut.Instance.GetType()
            .GetField("_selectContent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.GetValue(cut.Instance);
        selectContent.Should().NotBeNull();
        var contentType = selectContent!.GetType();

        var onOverlayShowMethod = cut.Instance.GetType()
            .GetMethod("OnOverlayShow", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var searchValueProperty = contentType.GetProperty("SearchValue", System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        var inputStringField = contentType.GetField("_inputString", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        onOverlayShowMethod.Should().NotBeNull();
        searchValueProperty.Should().NotBeNull();
        inputStringField.Should().NotBeNull();

        searchValueProperty!.SetValue(selectContent, "from-overlay");
        inputStringField!.SetValue(selectContent, string.Empty);

        await cut.InvokeAsync(() =>
        {
            onOverlayShowMethod!.Invoke(cut.Instance, null);
            return Task.CompletedTask;
        });

        inputStringField.GetValue(selectContent)!.Should().Be("from-overlay");
    }

