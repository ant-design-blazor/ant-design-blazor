    [Fact]
    public async Task SelectContent_on_overlay_resize_recalculates_responsive_state_from_entry()
    {
        var maxTagCount = AntDesign.Select.ResponsiveTag.Responsive;
        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Tags" TItemValue="string" TItem="string"
                SearchDebounceMilliseconds="0" EnableSearch MaxTagCount="@maxTagCount">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Tag1")" Label="Tag1" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Tag2")" Label="Tag2" />
                </SelectOptions>
            </AntDesign.Select>
        );

        var selectContent = cut.Instance.GetType()
            .GetField("_selectContent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.GetValue(cut.Instance);
        selectContent.Should().NotBeNull();
        var contentType = selectContent!.GetType();

        var calculatedMaxCountField = contentType.GetField("_calculatedMaxCount", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var onOverlayResizeMethod = contentType.GetMethod("OnOveralyResize", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        calculatedMaxCountField.Should().NotBeNull();
        onOverlayResizeMethod.Should().NotBeNull();

        calculatedMaxCountField!.SetValue(selectContent, 5);
        var entries = new List<ResizeObserverEntry>
        {
            new ResizeObserverEntry { ContentRect = new AntDesign.JsInterop.DomRect { Width = 100, Height = 24 } }
        };

        await cut.InvokeAsync(async () =>
        {
            var task = (Task)onOverlayResizeMethod!.Invoke(selectContent, new object[] { entries })!;
            await task;
        });

        ((int)calculatedMaxCountField.GetValue(selectContent)!).Should().Be(0);
    }

