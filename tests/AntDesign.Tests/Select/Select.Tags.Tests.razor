        var selectContentType = selectContent!.GetType();
        var compositionStartMethod = selectContentType.GetMethod("OnCompositionStart", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var compositionEndMethod = selectContentType.GetMethod("OnCompositionEndAsync", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var inputStringField = selectContentType.GetField("_inputString", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
