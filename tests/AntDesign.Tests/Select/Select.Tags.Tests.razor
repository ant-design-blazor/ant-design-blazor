    [Fact]
    public async Task RemoveClicked_only_removes_on_left_button_and_respects_button_filter()
    {
        var values = new List<string> { "Tag1", "Tag2" };

        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Tags" TItemValue="string" TItem="string"
                SearchDebounceMilliseconds="0" EnableSearch Values="@values">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Tag1")" Label="Tag1" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Tag2")" Label="Tag2" />
                </SelectOptions>
            </AntDesign.Select>
        );

        cut.Instance.SelectedOptionItems.Should().HaveCount(2);

        var selectContent = cut.Instance.GetType()
            .GetField("_selectContent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.GetValue(cut.Instance);
        selectContent.Should().NotBeNull();

        var removeClickedMethod = selectContent.GetType()
            .GetMethod("RemoveClicked", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        removeClickedMethod.Should().NotBeNull();

        var selectedOption = cut.Instance.SelectedOptionItems.First().Value;
        var nonLeftButton = new MouseEventArgs { Button = 1 };
        var leftButton = new MouseEventArgs { Button = 0 };

        await cut.InvokeAsync(() =>
        {
            var task = (Task)removeClickedMethod.Invoke(selectContent, new object[] { nonLeftButton, selectedOption });
            return task!;
        });
        cut.Instance.SelectedOptionItems.Should().HaveCount(2);

        await cut.InvokeAsync(() =>
        {
            var task = (Task)removeClickedMethod.Invoke(selectContent, new object[] { leftButton, selectedOption });
            return task!;
        });
        cut.Instance.SelectedOptionItems.Should().HaveCount(1);
    }

    [Fact]
    public async Task SelectContent_focus_and_blur_paths_can_be_invoked_via_internal_methods()
    {
        var values = new List<string> { "Tag1" };

        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Tags" TItemValue="string" TItem="string" EnableSearch
                SearchDebounceMilliseconds="0" Values="@values">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Tag1")" Label="Tag1" />
                </SelectOptions>
            </AntDesign.Select>
        );

        var selectContent = cut.Instance.GetType()
            .GetField("_selectContent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.GetValue(cut.Instance);
        selectContent.Should().NotBeNull();

        var onFocusMethod = selectContent!.GetType()
            .GetMethod("OnFocusInternal", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var onBlurMethod = selectContent.GetType()
            .GetMethod("OnBlurInternal", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var focusedProperty = cut.Instance.GetType()
            .GetProperty("Focused", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        focusedProperty.Should().NotBeNull();
        onFocusMethod.Should().NotBeNull();
        onBlurMethod.Should().NotBeNull();

        await cut.InvokeAsync(() =>
        {
            var focusTask = (Task)onFocusMethod!.Invoke(selectContent, new object[] { JsonDocument.Parse("{}").RootElement });
            return focusTask!;
        });
        cut.WaitForAssertion(() => ((bool)focusedProperty!.GetValue(cut.Instance)!).Should().BeTrue());

        await cut.InvokeAsync(() =>
        {
            var blurTask = (Task)onBlurMethod!.Invoke(selectContent, new object[] { JsonDocument.Parse("{}").RootElement });
            return blurTask!;
        });

        cut.WaitForAssertion(() => ((bool)focusedProperty!.GetValue(cut.Instance)!).Should().BeFalse());
    }

    [Fact]
    public async Task SelectContent_blur_resets_composition_state_when_typing()
    {
        JSInterop.SetupVoid(JSInteropConstants.Blur, _ => true);
        JSInterop.SetupVoid(JSInteropConstants.Focus, _ => true);
        var blurCount = 0;

        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Tags" TItemValue="string" TItem="string" EnableSearch
                SearchDebounceMilliseconds="0">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Tag1")" Label="Tag1" />
                </SelectOptions>
            </AntDesign.Select>
        );

        var selectContent = cut.Instance.GetType()
            .GetField("_selectContent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.GetValue(cut.Instance);
        selectContent.Should().NotBeNull();

        var selectContentType = selectContent!.GetType();
        var blurCallback = EventCallback.Factory.Create<FocusEventArgs>(cut.Instance, (FocusEventArgs _) => blurCount++);
        selectContentType.GetProperty("OnBlur")!.SetValue(selectContent, blurCallback);

        var compositionField = selectContent!.GetType()
            .GetField("_compositionInputting", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var onBlurMethod = selectContent.GetType()
            .GetMethod("OnBlurInternal", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        compositionField.Should().NotBeNull();
        onBlurMethod.Should().NotBeNull();

        compositionField!.SetValue(selectContent, true);
        ((bool)compositionField.GetValue(selectContent)!).Should().BeTrue();

        await cut.InvokeAsync(() =>
        {
            var task = (Task)onBlurMethod!.Invoke(selectContent, new object[] { JsonDocument.Parse("{}").RootElement });
            return task!;
        });

        ((bool)compositionField.GetValue(selectContent)!).Should().BeFalse();
        blurCount.Should().Be(1);
    }

