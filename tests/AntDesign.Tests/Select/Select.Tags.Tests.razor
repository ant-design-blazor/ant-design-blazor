    [Fact]
    public async Task SelectContent_debounce_timer_tick_respects_composition_state()
    {
        var searches = new List<string>();
        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select TItemValue="string" TItem="string" EnableSearch SearchDebounceMilliseconds="50" OnSearch="@(value => searches.Add(value))">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("A")" Label="A" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("B")" Label="B" />
                </SelectOptions>
            </AntDesign.Select>
        );

        var selectContent = cut.Instance.GetType()
            .GetField("_selectContent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance)
            ?.GetValue(cut.Instance);
        selectContent.Should().NotBeNull();
        var contentType = selectContent!.GetType();

        var debounceTickMethod = contentType.GetMethod("DebounceTimerIntervalOnTick", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        var compositionField = contentType.GetField("_compositionInputting", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        debounceTickMethod.Should().NotBeNull();
        compositionField.Should().NotBeNull();

        compositionField!.SetValue(selectContent, true);
        await cut.InvokeAsync(() =>
        {
            debounceTickMethod!.Invoke(selectContent, new object[] { new ChangeEventArgs { Value = "compose" } });
            return Task.CompletedTask;
        });

        for (var i = 0; i < 60; i++)
        {
            if (searches.Count == 0)
            {
                await Task.Delay(10);
            }
            else
            {
                break;
            }
        }
        searches.Should().BeEmpty();

        compositionField.SetValue(selectContent, false);
        await cut.InvokeAsync(() =>
        {
            debounceTickMethod!.Invoke(selectContent, new object[] { new ChangeEventArgs { Value = "search-now" } });
            return Task.CompletedTask;
        });

        for (var i = 0; i < 100; i++)
        {
            if (!searches.Contains("search-now"))
            {
                await Task.Delay(10);
            }
            else
            {
                break;
            }
        }
        searches.Should().Contain("search-now");
    }

