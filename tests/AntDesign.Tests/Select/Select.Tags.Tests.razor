    [Fact]
    public async Task Values_setter_only_notifies_when_changed()
    {
        var initialValues = new List<string> { "A" };
        var valuesChangedCallbacks = new List<IEnumerable<string>?>();
        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Multiple" TItemValue="string" TItem="string"
                EnableSearch SearchDebounceMilliseconds="0"
                Values="@initialValues"
                ValuesChanged="@((IEnumerable<string> values) => valuesChangedCallbacks.Add(values?.ToList()))">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("A")" Label="A" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("B")" Label="B" />
                </SelectOptions>
            </AntDesign.Select>
        );

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.Values, new List<string> { "A" }));
        valuesChangedCallbacks.Should().HaveCount(0);

        await cut.InvokeAsync(() =>
        {
            cut.SetParametersAndRender(parameters => parameters.Add(component => component.Values, new List<string> { "A", "B" }));
            return Task.CompletedTask;
        });
        valuesChangedCallbacks.Should().HaveCount(1);
        valuesChangedCallbacks.Last().Should().Contain(new[] { "A", "B" });

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.Values, new List<string> { "A", "B" }));
        valuesChangedCallbacks.Should().HaveCount(1);

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.Values, (IEnumerable<string>)null));
        valuesChangedCallbacks.Should().HaveCount(2);
        valuesChangedCallbacks.Last().Should().BeNull();

        cut.SetParametersAndRender(parameters => parameters.Add(component => component.Values, (IEnumerable<string>)null));
        valuesChangedCallbacks.Should().HaveCount(2);
