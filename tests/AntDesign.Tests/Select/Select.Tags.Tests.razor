    [Fact]
    public async Task AddedTags_are_removed_when_selected_values_are_replaced_with_known_options()
    {
        var datasource = new List<string> { "TagA", "TagB" };

        var cut = Render<AntDesign.Select<string, string>>(
            @<AntDesign.Select Mode="SelectMode.Tags" TItemValue="string" TItem="string" SearchDebounceMilliseconds="0"
                EnableSearch>
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("TagA")" Label="TagA" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("TagB")" Label="TagB" />
                </SelectOptions>
            </AntDesign.Select>
        );

        cut.Render();

        var currentType = cut.Instance.GetType();
        System.Reflection.MethodInfo evaluateValuesChanged = null;
        while (currentType != null)
        {
            evaluateValuesChanged = currentType.GetMethod("EvaluateValuesChangedOutsideComponent", System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (evaluateValuesChanged != null)
            {
                break;
            }
            currentType = currentType.BaseType;
        }
        evaluateValuesChanged.Should().NotBeNull();

        await cut.InvokeAsync(() =>
        {
            evaluateValuesChanged!.Invoke(cut.Instance, new object[] { new List<string> { "ExternalTag" } });
            return Task.CompletedTask;
        });

        cut.WaitForAssertion(() => cut.Instance.AddedTags.Should().ContainSingle());
        cut.Instance.AddedTags.First().Label.Should().Be("ExternalTag");

        await cut.InvokeAsync(() =>
        {
            evaluateValuesChanged!.Invoke(cut.Instance, new object[] { new List<string> { "TagB" } });
            return Task.CompletedTask;
        });

        cut.WaitForAssertion(() => cut.Instance.AddedTags.Should().BeEmpty());
        cut.WaitForAssertion(() => cut.Instance.SelectedOptionItems.Should().ContainSingle());
        cut.Instance.SelectedOptionItems.First().Value.Label.Should().Be("TagB");
    }

