@using System.ComponentModel.DataAnnotations
@inherits AntDesignTestBase
@code {
	class Persons
    {
        [MinLength(1, ErrorMessage = "At least 1 is required")]
        public IEnumerable<string> Name { get; set; } = Array.Empty<string>();

        [Required(ErrorMessage = "At least 1 is required")]
        public IEnumerable<string> Selection { get; set; }
    }
    Persons _model = new();
    IEnumerable<string> _datasource = new List<string>{ "Lucy", "John", "Jack", "Emily" };	

#if NET6_0_OR_GREATER
    [Fact]
	public async Task Select_Revalidates_When_Selection_Changes()
    {
        //Arrange
        JSInterop.Setup<AntDesign.JsInterop.DomRect>(JSInteropConstants.GetBoundingClientRect, _ => true)
            .SetResult(new AntDesign.JsInterop.DomRect());        

		JSInterop.Setup<AntDesign.JsInterop.Window>(JSInteropConstants.GetWindow)
			.SetResult(new AntDesign.JsInterop.Window());
		var cut = Render<AntDesign.Form<Persons>>(
			@<Form Model="@_model" ValidateOnChange="@true">       
				<FormItem Label="Allowed Email Domains">
						<Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
								@bind-Values=@context.Selection>
							<SelectOptions>
								@foreach (var item in _datasource)
								{
									<SelectOption TItem="string" TItemValue="string" Value="@item" Label="@item" />
								}
							</SelectOptions>
						</Select>
				</FormItem>
			</Form>
		);

        await cut.InvokeAsync(() => cut.Instance.Validate());
        const string errorSelector = "div.ant-form-item-explain-error";
        cut.Find(errorSelector).Text().Trim().Should().Be("At least 1 is required");

        await cut.InvokeAsync(() => cut.Find(".ant-select-item-option").Click());
        cut.WaitForAssertion(() =>
        {
            _model.Selection.Should().Equal("Lucy");
            cut.FindAll(errorSelector).Should().BeEmpty();
        });

        await cut.InvokeAsync(() => cut.Find(".ant-select-selection-item-remove").MouseDown());
        cut.WaitForAssertion(() =>
        {
            _model.Selection.Should().BeEmpty();
            cut.FindAll(errorSelector).Should().ContainSingle()
                .Which.Text().Trim().Should().Be("At least 1 is required");
        });
	}

    [Fact]
	public void Select_Validation_Not_Shown() 
    {
        //Arrange
        JSInterop.Setup<AntDesign.JsInterop.DomRect>(JSInteropConstants.GetBoundingClientRect, _ => true)
            .SetResult(new AntDesign.JsInterop.DomRect());        

		JSInterop.Setup<AntDesign.JsInterop.Window>(JSInteropConstants.GetWindow)
			.SetResult(new AntDesign.JsInterop.Window());
		_model.Name = new List<string> { "Lucy", "John" };
		var cut = Render<AntDesign.Form<Persons>>(
			@<Form Model="@_model" ValidateOnChange="@true">       
				<FormItem Label="Allowed Email Domains">
						<Select TItem="string" TItemValue="string" Mode="SelectMode.Multiple"
								@bind-Values=@context.Name>
							<SelectOptions>
								@foreach (var item in _datasource)
								{
									<SelectOption TItem="string" TItemValue="string" Value="@item" Label="@item" />
								}
							</SelectOptions>
						</Select>
				</FormItem>
			</Form>
		);
        //Act
		cut.InvokeAsync(() =>  cut.Instance.Validate());

		//Assert		
		cut.Invoking(c => cut.Find("div.ant-form-item-explain-error"))
			.Should().Throw<ElementNotFoundException>();
	}
#endif
}
