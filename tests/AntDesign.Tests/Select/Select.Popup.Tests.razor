    [Fact]
    public async Task Focus_and_blur_callbacks_receive_the_native_focus_events()
    {
        JSInterop.SetupVoid("AntDesign.interop.domManipulationHelper.focus", _ => true);
        FocusEventArgs receivedFocus = null;
        FocusEventArgs receivedBlur = null;
        var cut = Render<Select<string, string>>(@<Select TItemValue="string" TItem="string"
            OnFocus="@(args => receivedFocus = args)" OnBlur="@(args => receivedBlur = args)">
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value='@("one")' Label="One" />
            </SelectOptions>
        </Select>);
        var content = cut.FindComponent<AntDesign.Select.Internal.SelectContent<string, string>>().Instance;
        var focusEvent = new FocusEventArgs();
        var blurEvent = new FocusEventArgs();

        await cut.InvokeAsync(async () =>
        {
            await content.OnFocus.InvokeAsync(focusEvent);
            await content.OnBlur.InvokeAsync(blurEvent);
        });

        Assert.Same(focusEvent, receivedFocus);
        Assert.Same(blurEvent, receivedBlur);
    }

    [Fact]
    public async Task ShowSearch_config_invokes_its_on_search_callback()
    {
        var searchValues = new List<string>();
        var showSearch = new SelectShowSearchOptions { OnSearch = value => searchValues.Add(value) };
        var cut = Render<Select<string, string>>(@<Select TItemValue="string" TItem="string"
            ShowSearch="showSearch" SearchDebounceMilliseconds="0">
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value='@("lucy")' Label="Lucy" />
            </SelectOptions>
        </Select>);

        await cut.Find("input.ant-select-input").InputAsync(new ChangeEventArgs { Value = "lu" });

        Assert.Contains("lu", searchValues);
    }

    [Fact]
    public async Task ShowSearch_filter_option_receives_search_value_and_option()
    {
        var filterCalls = new List<string>();
        var showSearch = new SelectShowSearchOptions<string, string>
        {
            FilterOption = (searchValue, option) =>
            {
                filterCalls.Add($"{searchValue}:{option.Label}:{option.Item}");
                return option.Label.Contains(searchValue, StringComparison.OrdinalIgnoreCase);
            }
        };
        var cut = Render<Select<string, string>>(@<Select TItemValue="string" TItem="string"
            ShowSearch="showSearch" SearchDebounceMilliseconds="0">
            <SelectOptions>
                <SelectOption TItemValue="string" TItem="string" Value='@("lucy")' Label="Lucy" />
                <SelectOption TItemValue="string" TItem="string" Value='@("jack")' Label="Jack" />
            </SelectOptions>
        </Select>);

        await cut.Find("input.ant-select-input").InputAsync(new ChangeEventArgs { Value = "lu" });

        Assert.Contains("lu:Lucy:lucy", filterCalls);
        Assert.Contains("lu:Jack:jack", filterCalls);
    }
