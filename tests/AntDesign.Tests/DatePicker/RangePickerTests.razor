@code {
    [Fact]
    public void Time_range_picker_only_shows_the_panel_for_the_focused_input()
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        var cut = Render<RangePicker<DateTime[]>>(
            @<RangePicker TValue="DateTime[]" Picker="DatePickerType.Time" />);
        var inputStartField = typeof(DatePickerBase<DateTime[]>)
            .GetField("_inputStart", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!;
        var inputEndField = typeof(DatePickerBase<DateTime[]>)
            .GetField("_inputEnd", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!;
        var inputStart = (AntDesign.Internal.DatePickerInput)inputStartField.GetValue(cut.Instance)!;
        var inputEnd = (AntDesign.Internal.DatePickerInput)inputEndField.GetValue(cut.Instance)!;

        inputStart.IsOnFocused = true;
        inputEnd.IsOnFocused = false;
        cut.Instance.ShouldHideRangePanel(0, true).Should().BeFalse();
        cut.Instance.ShouldHideRangePanel(1, false).Should().BeTrue();

        inputStart.IsOnFocused = false;
        inputEnd.IsOnFocused = true;
        cut.Instance.ShouldHideRangePanel(0, true).Should().BeTrue();
        cut.Instance.ShouldHideRangePanel(1, false).Should().BeFalse();
    }

    [Fact]
    public async Task Focusing_end_time_immediately_moves_the_active_bar_and_panel()
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        JSInterop.Setup<HtmlElement>(JSInteropConstants.GetDomInfo, _ => true)
            .SetResult(new HtmlElement { ClientWidth = 120 });

        var cut = Render<RangePicker<DateTime?[]>>(
            @<RangePicker TValue="DateTime?[]" Picker="DatePickerType.Time" />);

        await cut.FindAll("input")[1].TriggerEventAsync("onfocus", new FocusEventArgs());

        cut.Instance.ShouldHideRangePanel(0, true).Should().BeTrue();
        cut.Instance.ShouldHideRangePanel(1, false).Should().BeFalse();
        cut.WaitForAssertion(() => cut.Find(".ant-picker-active-bar").GetAttribute("style")
            .Should().Contain("translate3d(136px, 0px, 0px)"));
    }

