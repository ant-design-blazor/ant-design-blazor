    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        DatePickerDisabledDateInfo? receivedInfo = null;
        var cut = Render<RangePicker<DateTime?[]>>(
            @<RangePicker TValue="DateTime?[]"
