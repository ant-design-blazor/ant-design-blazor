    [Theory]
    [InlineData(DatePickerType.Month, "2026-06-01", false)]
    [InlineData(DatePickerType.Month, "2026-05-01", true)]
    [InlineData(DatePickerType.Month, "2027-04-01", false)]
    [InlineData(DatePickerType.Month, "2027-05-01", true)]
    [InlineData(DatePickerType.Year, "2024-01-01", true)]
    [InlineData(DatePickerType.Year, "2025-01-01", false)]
    [InlineData(DatePickerType.Year, "2026-01-01", false)]
    [InlineData(DatePickerType.Year, "2027-01-01", true)]
    public void DisabledDateWithInfo_can_limit_a_six_month_range_by_picker_type(
        DatePickerType picker, string date, bool expectedDisabled)
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        var start = new DateTime(2026, 11, 7);
        Func<DateTime, DatePickerDisabledDateInfo, bool> disabledDate = (current, info) =>
        {
            if (info.From is not DateTime from)
            {
                return false;
            }

            var minDate = from.AddMonths(-5);
            var maxDate = from.AddMonths(5);
            return info.Type == DatePickerType.Year
                ? current.Year < minDate.Year || current.Year > maxDate.Year
                : current.Year * 12 + current.Month < minDate.Year * 12 + minDate.Month
                    || current.Year * 12 + current.Month > maxDate.Year * 12 + maxDate.Month;
        };
        var cut = Render<RangePicker<DateTime?[]>>(
            @<RangePicker TValue="DateTime?[]" Picker="@picker" DisabledDateWithInfo="@disabledDate" />);

        var changeValue = typeof(RangePicker<DateTime?[]>).GetMethod("ChangeValue", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!;
        changeValue.Invoke(cut.Instance, new object[] { start, 0, false });

        cut.Instance.DisabledDate(DateTime.Parse(date, CultureInfo.InvariantCulture)).Should().Be(expectedDisabled);
    }

    [Fact]
    public async Task Reopening_range_picker_does_not_reuse_the_completed_range_start()
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        var start = new DateTime(2026, 11, 7);
        DatePickerDisabledDateInfo? receivedInfo = null;
        var cut = Render<RangePicker<DateTime?[]>>(
            @<RangePicker TValue="DateTime?[]"
                          Value="@(new DateTime?[] { start, start.AddDays(2) })"
                          DisabledDateWithInfo="@((date, info) => { receivedInfo = info; return false; })" />);

        var previewValues = (string?[])typeof(DatePickerBase<DateTime?[]>)
            .GetField("_previewValues", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!
            .GetValue(cut.Instance)!;
        previewValues[1] = "10/11/2026";

        ((IDatePicker)cut.Instance).HoverDateTime = start.AddDays(10);
        cut.Instance._pickerStatus[0].SelectedValue = start;
        cut.Instance._pickerStatus[1].SelectedValue = start.AddDays(2);
        cut.Instance._pickerStatus[0].IsValueSelected = true;
        cut.Instance._pickerStatus[1].IsValueSelected = true;

        await cut.InvokeAsync(() => cut.Instance.ResetRangeSelectionContext());
        cut.Instance.DisabledDate(start.AddDays(20));

        ((IDatePicker)cut.Instance).IsRangeSelectionActive.Should().BeFalse();
        cut.Instance._pickerStatus.Should().OnlyContain(status => status.SelectedValue == null && !status.IsValueSelected);
        previewValues[1].Should().BeNull();
        ((IDatePicker)cut.Instance).HoverDateTime.Should().BeNull();
        receivedInfo!.From.Should().BeNull();
    }

