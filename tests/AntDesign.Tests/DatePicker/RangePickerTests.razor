    [Fact]
    public void DisabledDateWithInfo_receives_range_start_and_limits_selection_to_seven_days()
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        var start = new DateTime(2026, 11, 24);
        DatePickerDisabledDateInfo? receivedInfo = null;

        var cut = Render<RangePicker<DateTime?[]>>(
            @<RangePicker TValue="DateTime?[]"
                          DisabledDateWithInfo="@((date, info) =>
                          {
                              receivedInfo = info;
                              return info.From is DateTime from && Math.Abs((date.Date - from.Date).TotalDays) >= 7;
                          })" />);

        var changeValue = typeof(RangePicker<DateTime?[]>).GetMethod("ChangeValue", System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic)!;
        changeValue.Invoke(cut.Instance, new object[] { start, 0, false });

        cut.Instance.DisabledDate(start.AddDays(6)).Should().BeFalse();
        receivedInfo!.From.Should().Be(start);
        receivedInfo.Type.Should().Be(DatePickerType.Date);
        cut.Instance.DisabledDate(start.AddDays(7)).Should().BeTrue();
        cut.Instance.DisabledDate(start.AddDays(-7)).Should().BeTrue();
    }

