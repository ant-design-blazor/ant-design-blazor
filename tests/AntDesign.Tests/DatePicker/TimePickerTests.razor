@using AntDesign.Core.JsInterop.Modules.Components
@inherits AntDesignTestBase

@code {

    [Theory]
    [MemberData(nameof(DatePickerTestData.TimePickerData), MemberType = typeof(DatePickerTestData))]
    public void DefaultValue_applied_to_value<T>(T defaultValue)
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);

        var cut = Render<AntDesign.TimePicker<T>>(
			@<TimePicker TValue="T" DefaultValue="@defaultValue" />);

        cut.Instance.Value.Should().Be(defaultValue);
    }

    [Fact]
    public void Time_range_uses_the_v6_picker_semantic_structure()
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);
        JSInterop.Setup<OverlayPosition>(JSInteropConstants.OverlayComponentHelper.AddOverlayToContainer, _ => true)
            .SetResult(new OverlayPosition());

        var cut = Render<AntDesign.RangePicker<DateTime?[]>>(@<RangePicker TValue="DateTime?[]"
            Picker="DatePickerType.Time" Open="true" Placeholder="@(new[] { "Start time", "End time" })" />);

        var root = cut.Find(".ant-picker.ant-picker-range");
        root.ClassList.Should().Contain("ant-picker-outlined");
        root.ClassList.Should().Contain("ant-picker-css-var");
        cut.FindAll(".ant-picker-input input").Should().HaveCount(2);

        var popup = cut.WaitForElement(".ant-picker-dropdown");
        popup.ClassList.Should().Contain("ant-picker-css-var");
        var container = popup.QuerySelector(".ant-picker-range-wrapper.ant-picker-time-range-wrapper > .ant-picker-panel-container");
        container.Should().NotBeNull();
        container!.QuerySelector(".ant-picker-panel-layout").Should().NotBeNull();
        container.QuerySelectorAll(".ant-picker-time-panel-column").Should().NotBeEmpty();
    }

#if NET6_0_OR_GREATER
    [Theory]
    [MemberData(nameof(DatePickerTestData.TimePickerData), MemberType = typeof(DatePickerTestData))]
    public async Task Nullable_TimePicker_Accepts_Input<T>(T inputValue)
    {
        JSInterop.SetupVoid(JSInteropConstants.AddPreventKeys, _ => true);

        var cut = Render<AntDesign.TimePicker<TimeOnly?>>(
			@<TimePicker TValue="TimeOnly?" />);

        var input = cut.Find("input");
        var inputAsString = $"{inputValue:HH:mm:ss}";
        await input.InputAsync(new ChangeEventArgs() { Value = inputAsString });
        await input.KeyDownAsync(new KeyboardEventArgs() { Key = "Enter" });

        $"{cut.Instance.Value:HH:mm:ss}".Should().Be(inputAsString);
    }
#endif
}
