@layout BlankLayout
@using AntDesign.Docs.Components

@page "/"
@page "/zh-CN/"
@page "/en-US/"

<PageTitle>Ant Design of Blazor</PageTitle>

<div id="react-content">
    <MainHeader IsHome />
    <div class="home-container @_styles["root"]">
        <div class="home-banner @_styles["banner"]">
            <HomeBannerBackground />
            <div class="home-banner-holder">
                <div class="home-banner-content">
                    <div>
                        <div class="home-card-logo">
                            <h1 class="home-banner-mini">Ant Design Blazor</h1>
                            <h1 class="home-banner-normal @_styles["bannerTitle"]">Ant Design Blazor</h1>
                        </div>
                    </div>
                    <p>@Localizer["app.home.introduce"]</p>
                    <div class="home-banner-content-operations">
                        <a href="/@Language.CurrentCulture.Name/docs">
                            <Button Type="ButtonType.Primary" Size="ButtonSize.Large">@Localizer["app.home.getting-started"]</Button>
                        </a>
                        <a href="https://github.com/ant-design-blazor/ant-design-blazor/stargazers">
                            <Button Size="ButtonSize.Large" Icon="@IconType.Outline.Github">@Localizer["app.home.star-on-github"]</Button>
                        </a>
                    </div>
                </div>
            </div>
        </div>
            <HomeThemePreview />
            <HomeRichComponents />
            <section class="home-framework">
                <div class="home-framework-decoration" aria-hidden="true"><img draggable="false" alt="" src="https://gw.alipayobjects.com/zos/bmw-prod/ba37a413-28e6-4be4-b1c5-01be1a0ebb1c.svg" /></div>
                <div class="home-framework-content">
                    @if (_recommends.Any())
                    {
                        <div class="home-block-content">
                            <h2 class="ant-typography @_styles["sectionTitle"]" direction="ltr">@Localizer["app.home.recommend"]</h2>
                            <Row Class="@_styles["recommendRow"]">
                                <AntDesign.Col Xs="24" Sm="14" Class="@_styles["recommendColumn"]">
                                    <Recommend Data="_recommends[0]" Main />
                                </AntDesign.Col>
                                <AntDesign.Col Xs="24" Sm="10" Class="@_styles["recommendColumn"]">
                                    <Row Class="@_styles["nestedRecommendRow"]">
                                        <AntDesign.Col Span="24" Class="@_styles["recommendColumn"]">
                                            <Recommend Data="_recommends[1]" />
                                        </AntDesign.Col>
                                        <AntDesign.Col Span="24" Class="@_styles["recommendColumn"]">
                                            <Recommend Data="_recommends[2]" />
                                        </AntDesign.Col>
                                    </Row>
                                </AntDesign.Col>
                            </Row>
                        </div>
                    }

                    @if (_products.Any())
                    {
                        <div class="home-block-content">
                            <h2 class="ant-typography @_styles["sectionTitle"]" direction="ltr">@Localizer["app.home.products"]</h2>
                            <div class="@_styles["productsContent"]">
                                <Row Class="@($"design-mini-panels {_styles["miniPanels"]}")">
                                    @foreach (var item in _products)
                                    {
                                        <AntDesign.Col Xs="24" Sm="8" Class="@_styles["productColumn"]">
                                            <a href="@item.Href" target="_blank" rel="noopener noreferrer">
                                                <Card Class="@($"design-mini-panel {_styles["miniPanel"]}")" Hoverable>
                                                    <Cover>
                                                        <img alt="@item.Title" src="@item.Img">
                                                    </Cover>
                                                    <Body>
                                                        <CardMeta Title="@item.Title" Description="@Localizer[item.Description]" />
                                                    </Body>
                                                </Card>
                                            </a>
                                        </AntDesign.Col>
                                    }
                                </Row>
                            </div>
                        </div>
                    }

                </div>
            </section>

        <div class="@_styles["contentWidth"]">
            @if (_sponsors.Any())
            {
                <div class="home-block-content">
                    <h2 class="ant-typography @_styles["sectionTitle"]" direction="ltr">
                        @Localizer["app.home.sponsors"]
                        <div class="home-block-content-extra"><a href="@(Localizer["app.home.sponsor-us-href"])" target="_blank">@Localizer["app.home.sponsor-us"]</a></div>
                    </h2>
                    <div class="ant-row @_styles["sponsorRow"]">
                        @foreach (var item in _sponsors)
                        {
                            <div class="ant-col ant-col-xs-24 ant-col-sm-12 @_styles["sponsorColumn"]">
                                <a href="@item.Href" target="_blank" rel="noopener noreferrer">
                                  @*   <Card Class="more-card" Hoverable>
                                        <Cover>
                                            <img alt="@item.Title" src="@item.Img">
                                        </Cover>
                                        <Body>
                                            <CardMeta Title="@item.Title" Description="@item.Description" />
                                            <div>
                                                @item.Date
                                                <span class="more-card-source">
                                                    <img src="https://gw.alipayobjects.com/zos/basement_prod/5f4e1fd0-d255-4309-b181-a3715a720ebe.svg" alt="zhihu">
                                                </span>
                                            </div>
                                        </Body>
                                    </Card> *@
                                    <Card Class="@_styles["sponsorCard"]">
                                        <CardMeta Avatar="@item.Logo"
                                                    Title="@item.Name"
                                                    Description="@item.Comment" />
                                    </Card>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

        </div>

    <MainFooter />
    <FixedWidgets />
    </div>
</div>

<style>@((MarkupString)_styles.CssText)</style>
<style>
    .home-framework{width:100%;position:relative;display:flow-root;background:#f5f8ff}
    .home-framework-decoration{position:absolute;inset:0;overflow:hidden;pointer-events:none}
    .home-framework-decoration img{position:absolute;inset-inline-start:0;top:-50px;height:160px}
    .home-framework-content{position:relative;z-index:1;max-width:1256px;margin-inline:auto;display:flow-root}
    [data-theme=dark] .home-framework{background:#393f4a}
</style>
