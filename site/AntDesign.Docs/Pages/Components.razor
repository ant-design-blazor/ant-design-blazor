@page "/components/{name}"
@using AntDesign.Docs.Services
@page "/components"
@page "/charts/{name}"
@page "/charts"
@page "/experimental/{name}"
@page "/experimental"

@page "/{locale}/components"
@page "/{locale}/components/{name}"
@page "/{locale}/charts/{name}"
@page "/{locale}/charts"
@page "/{locale}/experimental/{name}"
@page "/{locale}/experimental"
@using AntDesign.Docs.Components
<section class="main-container main-container-component @_styles["root"]">
    <article>

        @if (_demoComponent != null)
        {
            var title = $"{(CurrentLanguage == "zh-CN" ? _demoComponent.SubTitle + " " : "")}{_demoComponent.Title} - Ant Design Blazor".Trim();
            <PageTitle>@title</PageTitle>
            var componentTokenCount = ComponentTokenCatalog.Get(SemanticComponentKey).Count;
            var docDemos = _demoComponent.DemoList?.Where(x => x.Docs.HasValue && x.Docs.Value) ?? Enumerable.Empty<DemoItem>();

            if (_anchors.Any())
            {
                <div class="toc-affix">
                    <Affix OffsetTop="16">
                        <Anchor Key="@_demoComponent.Title">
                            @foreach (var demo in _anchors)
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#components-{_demoComponent.Title.ToLower()}-demo-{demo.Name.ToLower()}")" Title="@demo.Title" />
                            }
                            @if (!string.IsNullOrEmpty(_demoComponent.ApiDoc))
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#API")" Title="API" />
                            }
                            @if (!string.IsNullOrEmpty(_demoComponent.Faq))
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#Faq")" Title="@Localizer["app.footer.faq"]" />
                            }
                            @if (_demoComponent.Category == "Components")
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#design-token")" Title="Design Token" />
                            }
                        </Anchor>
                    </Affix>
                </div>
            }

            <section class="markdown">
                <h1>
                    @_demoComponent.Title
                    @if (CurrentLanguage == "zh-CN")
                    {
                        <span class="subtitle">@_demoComponent.SubTitle</span>
                    }
                    <span class="widget"></span>
                    <Tooltip Title="@Localizer["app.content.edit-demo"]">
                        <Unbound>
                            <a @ref="context.Current" href="@EditUrl" class="edit-button" rel="noopener noreferrer" target="_blank">
                                <Icon Type="@IconType.Outline.Edit" />
                            </a>
                        </Unbound>
                    </Tooltip>
                    <Tooltip Title="@Localizer["app.content.component-source"]">
                        <Unbound>
                            <a href="@ComponentSourceUrl" class="edit-button component-source-button" aria-label="@Localizer["app.content.component-source"]" rel="noopener noreferrer" target="_blank">
                                <Icon Type="@IconType.Outline.Github" />
                            </a>
                        </Unbound>
                    </Tooltip>
                    <div class="@_styles["carbonAd"]">
                        <script async type="text/javascript" src="//cdn.carbonads.com/carbon.js?serve=CW7I6K7I&placement=antblazorcom&format=cover" id="_carbonads_js"></script>
                    </div>
                </h1>
                <section class="markdown">
                    @((MarkupString)_demoComponent.Desc)
                </section>

                @foreach (var docDemo in docDemos)
                {
                    <DocDemoView Demo="@docDemo" @key="@($"{_demoComponent.Title}-{docDemo.Type}")" />
                }

                @if (_demos.Any())
                {
                    <h2 data-scrollama-index="1">
                        @Localizer["app.component.examples"]
                        <span class="all-code-box-controls">
                            @if (_demoComponent.Cols != 1)
                            {
                                @if (_expanded)
                                {
                                    <Icon Type="@IconType.Outline.Compress" Class="code-box-expand-trigger" OnClick="() => _expanded = false " />
                                }
                                else
                                {
                                    <Icon Type="@IconType.Outline.Expand" Class="code-box-expand-trigger" OnClick="() => _expanded = true " />
                                }
                            }
                            <Icon Type="@IconType.Outline.Code" Theme="@(_expandAllCode ? IconThemeType.Fill : IconThemeType.Outline)" Class="code-box-expand-trigger" OnClick="()=>_expandAllCode=!_expandAllCode" />
                            @*<Icon Type="@IconType.Outline.Bug" Class="code-box-expand-trigger" />*@
                        </span>
                    </h2>
                }
            </section>

            @if (_demos.Any())
            {
                <Row Class="@_styles["demoGridRow"]">
                    @if (_demoComponent.Cols == 1 || _expanded)
                    {
                        foreach (var demo in _demos)
                        {
                            <AntDesign.Col Span="24" Class="@($"code-boxes-col-1-1 {_styles["demoGridColumn"]}")">
                                <CodeBox CodeExpand="_expandAllCode" Demo="demo" @key="demo.Type" ComponentName="@_demoComponent.Title"></CodeBox>
                            </AntDesign.Col>
                        }
                    }
                    else
                    {
                        var leftList = _demos.Where((_, i) => i % 2 == 0);
                        var rightList = _demos.Where((_, i) => i % 2 != 0);

                        <AntDesign.Col Lg="12" Md="24" Sm="24" Class="@($"code-boxes-col-2-1 {_styles["demoGridColumn"]}")">
                            @foreach (var demo in leftList)
                            {
                                <CodeBox CodeExpand="_expandAllCode" Demo="demo" @key="demo.Type" ComponentName="@_demoComponent.Title"></CodeBox>
                            }
                        </AntDesign.Col>
                        <AntDesign.Col Lg="12" Md="24" Sm="24" Class="@($"code-boxes-col-2-1 {_styles["demoGridColumn"]}")">
                            @foreach (var demo in rightList)
                            {
                                <CodeBox CodeExpand="_expandAllCode" Demo="demo" @key="demo.Type" ComponentName="@_demoComponent.Title"></CodeBox>
                            }
                        </AntDesign.Col>
                    }
                </Row>
            }
           
            <section class="markdown api-container">
                @((MarkupString)_demoComponent.ApiDoc)
            </section>

            <section class="markdown api-container">
                @((MarkupString)_demoComponent.Faq)
            </section>

            @if (_demoComponent.Category == "Components")
            {
                <ComponentTokenDocumentation Component="@SemanticComponentKey" Language="@CurrentLanguage" />
            }

            @if (SemanticDomCatalog.Get(SemanticComponentKey).Count > 0)
            {
                <section class="markdown api-container semantic-dom-preview">
                    <h2>@(CurrentLanguage == "zh-CN" ? "语义 DOM" : "Semantic DOM")</h2>
                    <SemanticDomPreview Component="@SemanticComponentKey">
                        @if (SemanticComponentKey == "message")
                        {
                            <MessageSemanticPreview />
                        }
                        else if (SemanticComponentKey == "cascader")
                        {
                            <CascaderSemanticPreview />
                        }
                        else if (SemanticComponentKey == "notification")
                        {
                            <NotificationSemanticPreview />
                        }
                        else if (SemanticComponentKey == "select")
                        {
                            <SelectSemanticPreview />
                        }
                        else if (SemanticComponentKey == "image")
                        {
                            <ImageSemanticPreview />
                        }
                        else if (SemanticComponentKey == "menu")
                        {
                            <MenuSemanticPreview />
                        }
                        else if (SemanticComponentKey == "tag")
                        {
                            <TagSemanticPreview />
                        }
                        else if (SemanticComponentKey == "splitter")
                        {
                            <SplitterSemanticPreview />
                        }
                        else if (SemanticPreviewType is { } previewType)
                        {
                            <DynamicComponent Type="previewType" />
                        }
                    </SemanticDomPreview>
                    @if (SemanticComponentKey == "float-button")
                    {
                        <SemanticDomPreview Component="float-button-group">
                            <div style="min-height:220px;display:grid;place-items:center">
                                <FloatButtonGroup Trigger="FloatButtonGroupTrigger.Hover" Open="true"
                                                  Style="position:relative;inset:auto;padding:12px">
                                    <FloatButton Icon="alert" />
                                    <FloatButton Icon="bug" />
                                    <FloatButton Icon="bulb" />
                                </FloatButtonGroup>
                            </div>
                        </SemanticDomPreview>
                    }
                    @if (SemanticComponentKey == "card")
                    {
                        <SemanticDomPreview Component="card-meta">
                            <div style="min-height:220px;display:grid;place-items:center">
                                <Card Style="width:300px">
                                    <CardMeta Avatar="https://api.dicebear.com/10.x/lorelei/svg?seed=8"
                                              Title="Card Meta title"
                                              Description="This is the description" />
                                </Card>
                            </div>
                        </SemanticDomPreview>
                    }
                </section>
            }
        }
        else
        {
            <Skeleton ParagraphRows="3" Active></Skeleton>
        }
    </article>
    <ContributorsList FilePaths="_filePaths" />
</section>

<style>
    html {
        scroll-behavior: smooth;
    }
</style>

<style>@((MarkupString)_styles.CssText)</style>

