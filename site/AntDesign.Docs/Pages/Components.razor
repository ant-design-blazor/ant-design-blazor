@using AntDesign.Docs.Services
@using AntDesign.Docs.Components
<section class="main-container main-container-component @_styles["root"]">
    <article>

        @if (_demoComponent != null)
        {
            var title = $"{(CurrentLanguage == "zh-CN" ? _demoComponent.SubTitle + " " : "")}{_demoComponent.Title} - Ant Design Blazor".Trim();
            <PageTitle>@title</PageTitle>
            var componentTokenCount = ComponentTokenCatalog.Get(SemanticComponentKey).Count;
            var semanticPreviews = GetSemanticPreviews(SemanticComponentKey);
            var hasSemanticDom = semanticPreviews.Count > 0;
            var docDemos = _demoComponent.DemoList?.Where(x => x.Docs.HasValue && x.Docs.Value) ?? Enumerable.Empty<DemoItem>();
            var isIconPage = SemanticComponentKey == "icon";
            var iconGalleryDemo = isIconPage
                ? _demoComponent.DemoList?.FirstOrDefault(demo => string.Equals(demo.Name, "List", StringComparison.OrdinalIgnoreCase))
                : null;
            var renderDemos = _demos.Where(demo => !(SemanticComponentKey == "select" &&
                string.Equals(demo.Name, "_semantic", StringComparison.OrdinalIgnoreCase)) &&
                !(isIconPage && string.Equals(demo.Name, "List", StringComparison.OrdinalIgnoreCase))).ToList();

            if (_anchors.Any())
            {
                <div class="toc-affix">
                    <Anchor Key="@_demoComponent.Title" Affix="false" TargetOffset="80" Style="max-height: calc(100vh - 120px); overflow-x: hidden; overflow-y: auto;">
                            @if (SemanticComponentKey == "icon")
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/icon#how-to-use")" Title="@(CurrentLanguage == "zh-CN" ? "使用方法" : "How to use")" />
                                @if (CurrentLanguage == "zh-CN")
                                {
                                    <AnchorLink Href="@($"/{CurrentLanguage}/components/icon#designers-exclusive")" Title="设计师专属" />
                                }
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/icon#list-of-icons")" Title="@(CurrentLanguage == "zh-CN" ? "图标列表" : "List of icons")" />
                            }
                            @if (_anchors.Length > 0)
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#Examples")" Title="@Localizer["app.component.examples"]">
                                    @foreach (var demo in _anchors)
                                    {
                                        <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#{CodeBox.GetDemoId(_demoComponent.Title, demo.Name)}")" Title="@demo.Title" />
                                    }
                                </AnchorLink>
                            }
                            @if (!string.IsNullOrEmpty(_demoComponent.ApiDoc))
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#API")" Title="API" />
                            }
                            @if (hasSemanticDom)
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#semantic-dom")" Title="@(CurrentLanguage == "zh-CN" ? "语义 DOM" : "Semantic DOM")" />
                            }
                            @if (_demoComponent.Category == "Components")
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#design-token")" Title="Design Token" />
                            }
                            @if (!string.IsNullOrEmpty(_demoComponent.Faq))
                            {
                                <AnchorLink Href="@($"/{CurrentLanguage}/components/{_demoComponent.Title}#Faq")" Title="@Localizer["app.footer.faq"]" />
                            }
                    </Anchor>
                </div>
            }

            <section class="markdown">
                <ComponentOverview ShowDivider="@HasComponentMetadata">
                <h1>
                    @_demoComponent.Title
                    @if (CurrentLanguage == "zh-CN")
                    {
                        <span class="subtitle">@_demoComponent.SubTitle</span>
                    }
                    <span class="widget"></span>
                    @if (!HasComponentMetadata)
                    {
                        <Tooltip Title="@Localizer["app.content.edit-demo"]">
                            <Unbound>
                                <a @ref="context.Current" href="@EditUrl" class="edit-button" rel="noopener noreferrer" target="_blank">
                                    <Icon Type="@IconType.Outline.Edit" />
                                </a>
                            </Unbound>
                        </Tooltip>
                        <Tooltip Title="@Localizer["app.content.component-source"]">
                            <Unbound>
                                <a href="@ComponentSourceUrl" class="edit-button component-source-button" aria-label="@Localizer["app.content.component-source"]" rel="noopener noreferrer" target="_blank">
                                    <Icon Type="@IconType.Outline.Github" />
                                </a>
                            </Unbound>
                        </Tooltip>
                    }
                </h1>
                <section class="markdown">
                    @if (HasComponentMetadata)
                    {
                        var description = ComponentMetadata.SplitDescription(_demoComponent.Desc);
                        @((MarkupString)description.Introduction)
                        <ComponentMetadata ComponentName="@_demoComponent.Title" ComponentKey="@SemanticComponentKey"
                                           Language="@CurrentLanguage" FilePath="@_filePath" ShowDivider="false" @key="_demoComponent.Title" />
                    }
                    else
                    {
                        @((MarkupString)_demoComponent.Desc)
                    }
                </section>
                </ComponentOverview>
                @if (HasComponentMetadata)
                {
                    @((MarkupString)ComponentMetadata.SplitDescription(_demoComponent.Desc).Remainder)
                }

                @foreach (var docDemo in docDemos.Where(demo => !ReferenceEquals(demo, iconGalleryDemo)))
                {
                    <DocDemoView Demo="@docDemo" @key="@docDemo.ComponentId" />
                }

                @if (isIconPage)
                {
                    <AntDesign.Docs.Demos.Components.Icon.demo.List />
                }

                @if (renderDemos.Any())
                {
                    <h2 id="Examples" data-scrollama-index="1">
                        @Localizer["app.component.examples"]
                        <span class="all-code-box-controls">
                            @if (_demoComponent.Cols != 1)
                            {
                                @if (_expanded)
                                {
                                    <Icon Type="@IconType.Outline.Compress" Class="code-box-expand-trigger" OnClick="() => _expanded = false " />
                                }
                                else
                                {
                                    <Icon Type="@IconType.Outline.Expand" Class="code-box-expand-trigger" OnClick="() => _expanded = true " />
                                }
                            }
                            <Icon Type="@IconType.Outline.Code" Theme="@(_expandAllCode ? IconThemeType.Fill : IconThemeType.Outline)" Class="code-box-expand-trigger" OnClick="()=>_expandAllCode=!_expandAllCode" />
                            @if (_demoComponent.DemoList.Any(x => x.Debug))
                            {
                                <Button Type="ButtonType.Text" Size="ButtonSize.Small" Icon="@IconType.Outline.Bug"
                                        Class="docs-debug-toggle" AriaPressed="_showDebugDemos" OnClick="ToggleDebugDemos">Debug</Button>
                            }
                        </span>
                    </h2>
                }
            </section>

            @if (renderDemos.Any())
            {
                <Row Class="@_styles["demoGridRow"]">
                    @if (_demoComponent.Cols == 1 || _expanded)
                    {
                        foreach (var demo in renderDemos)
                        {
                            <AntDesign.Col Span="24" Class="@($"code-boxes-col-1-1 {_styles["demoGridColumn"]}")">
                                <CodeBox CodeExpand="_expandAllCode" Demo="demo" @key="demo.ComponentId" ComponentName="@_demoComponent.Title"></CodeBox>
                            </AntDesign.Col>
                        }
                    }
                    else
                    {
                        @foreach (var demo in renderDemos)
                        {
                            <AntDesign.Col Lg="12" Md="24" Sm="24" Class="@($"code-boxes-col-2-1 {_styles["demoGridColumn"]}")">
                                <CodeBox CodeExpand="_expandAllCode" Demo="demo" @key="demo.ComponentId" ComponentName="@_demoComponent.Title"></CodeBox>
                            </AntDesign.Col>
                        }
                    }
                </Row>
            }
           
            <section class="markdown api-container">
                @((MarkupString)_demoComponent.ApiDoc)
            </section>

            @if (hasSemanticDom)
            {
                <section class="markdown api-container semantic-dom-preview">
                    <h2 id="semantic-dom">@(CurrentLanguage == "zh-CN" ? "语义 DOM" : "Semantic DOM")</h2>
                    @foreach (var preview in semanticPreviews)
                    {
                        @if (preview.WrapInSemanticDom)
                        {
                            <SemanticDomPreview Component="@preview.Component" Language="@CurrentLanguage" @key="preview.Component">
                                <DynamicComponent Type="@preview.ComponentType" />
                            </SemanticDomPreview>
                        }
                        else
                        {
                            <DynamicComponent Type="@preview.ComponentType" @key="preview.Component" />
                        }
                    }
                </section>
            }

            @if (_demoComponent.Category == "Components")
            {
                <ComponentTokenDocumentation Component="@SemanticComponentKey" Language="@CurrentLanguage" />
            }

            <section class="markdown api-container">
                @((MarkupString)_demoComponent.Faq)
            </section>

        }
        else
        {
            <Skeleton ParagraphRows="3" Active></Skeleton>
        }
    </article>
    <ContributorsList FilePaths="_filePaths" />
</section>

<style>
    html {
        scroll-behavior: smooth;
    }
    .main-container-component [id] {
        scroll-margin-top: 80px;
    }
</style>

<style>@((MarkupString)_styles.CssText)</style>

@code {
