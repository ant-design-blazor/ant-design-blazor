@page "/semantic-dom-preview"
@using AntDesign.Docs.Components

<div class="semantic-dom-preview-page">
    <Title level="2">Semantic DOM Preview</Title>

    <SemanticDomPreview Component="button">
        <Button Type="ButtonType.Primary" Icon="search">Search</Button>
    </SemanticDomPreview>

    <SemanticDomPreview Component="alert">
        <Alert Message="Migration preview" Description="Hover a Semantic DOM item to highlight the real node." ShowIcon="true" />
    </SemanticDomPreview>
</div>
