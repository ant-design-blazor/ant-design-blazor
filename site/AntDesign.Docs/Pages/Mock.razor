@layout BlankLayout;
@page "/mock"
@page "/zh-CN/mock"
@page "/en-US/mock"

@using AntDesign.Docs.Services

<div id="@DemoId">
    @if (_demo?.Component is { } component)
    {
        @component
    }
</div>

@inject DemoService demoService

@code
{
    [SupplyParameterFromQuery]
    public string DemoId { get; set; }

    private DemoItem _demo;

    protected override void OnInitialized()
    {
        _demo = demoService.GetDemo(DemoId);
        base.OnInitialized();
    }
}
