<Space Direction="SpaceDirection.Vertical">
    <Title Level="5">7 days range</Title>
    <RangePicker TValue="DateTime?[]" DisabledDateWithInfo="DisableWithinSevenDays" />

    <Title Level="5">6 months range</Title>
    <RangePicker TValue="DateTime?[]"
                 Picker="DatePickerType.Month"
                 DisabledDateWithInfo="DisableWithinSixMonths" />
</Space>

@code {
    private static bool DisableWithinSevenDays(DateTime current, DatePickerDisabledDateInfo info)
    {
        if (info.From is not DateTime start)
        {
            return false;
        }

        var minDate = start.AddDays(-6);
        var maxDate = start.AddDays(6);

        return info.Type switch
        {
            DatePickerType.Year => current.Year < minDate.Year || current.Year > maxDate.Year,
            DatePickerType.Month => GetYearMonth(current) < GetYearMonth(minDate)
                || GetYearMonth(current) > GetYearMonth(maxDate),
            _ => Math.Abs((current.Date - start.Date).TotalDays) >= 7
        };
    }

    private static bool DisableWithinSixMonths(DateTime current, DatePickerDisabledDateInfo info)
    {
        if (info.From is not DateTime start)
        {
            return false;
        }

        var minDate = start.AddMonths(-5);
        var maxDate = start.AddMonths(5);

        return info.Type == DatePickerType.Year
            ? current.Year < minDate.Year || current.Year > maxDate.Year
            : GetYearMonth(current) < GetYearMonth(minDate)
                || GetYearMonth(current) > GetYearMonth(maxDate);
    }

    private static int GetYearMonth(DateTime date) => date.Year * 12 + date.Month;
}
