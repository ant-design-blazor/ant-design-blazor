<Space Direction="SpaceDirection.Vertical">
    <DatePicker TValue="DateTime?"
                Placeholder="@("Object style")"
                ClassName="date-picker-custom"
                Style="width: 200px; border-color: var(--ant-color-primary);">
        <SuffixIcon>
            <Icon Type="@IconType.Outline.Calendar" />
        </SuffixIcon>
    </DatePicker>
    <DatePicker TValue="DateTime?"
                Placeholder="@("Large picker")"
                Size="InputSize.Large"
                ClassName="date-picker-custom-large"
                Style="width: 240px; border-color: #722ed1;" />
</Space>
