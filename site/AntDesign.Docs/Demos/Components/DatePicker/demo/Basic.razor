@inject ILocalizationService LocalizationService

<Flex Gap="FlexGap.Small" Justify="FlexJustify.FlexStart" Align="FlexAlign.FlexStart" Vertical>
    <DatePicker TValue="DateOnly?" Picker="DatePickerType.Date" CultureInfo="@LocalizationService.CurrentCulture" />
    <DatePicker TValue="DateTime?" Picker="DatePickerType.Week" CultureInfo="@LocalizationService.CurrentCulture" />
    <DatePicker TValue="DateTime?" Picker="DatePickerType.Month" CultureInfo="@LocalizationService.CurrentCulture" />
    <DatePicker TValue="DateTime?" Picker="DatePickerType.Quarter" CultureInfo="@LocalizationService.CurrentCulture" />
    <DatePicker TValue="DateTime?" Picker="DatePickerType.Year" CultureInfo="@LocalizationService.CurrentCulture" />
</Flex>
