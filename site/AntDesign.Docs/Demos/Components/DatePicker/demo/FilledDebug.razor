<Space Direction="SpaceDirection.Vertical" Size=@("12px")>
    <DatePicker TValue="DateTime?" Variant="InputVariant.Filled" DefaultValue="@JuneSix2015" Disabled="true" />
    <DatePicker TValue="DateTime?" Variant="InputVariant.Filled" Picker="DatePickerType.Month" DefaultValue="@June2015" Disabled="true" />
    <RangePicker TValue="DateTime?[]" Variant="InputVariant.Filled" DefaultValue="@SameDayRange" Disabled="true" />
    <RangePicker TValue="DateTime?[]" Variant="InputVariant.Filled" DefaultValue="@DateRange" Disabled="@RangeDisabled" />
    <DatePicker TValue="DateTime?" Variant="InputVariant.Filled" Status="error" Style="width: 100%;" />
    <DatePicker TValue="DateTime?" Variant="InputVariant.Filled" Status="warning" Style="width: 100%;" />
    <RangePicker TValue="DateTime?[]" Variant="InputVariant.Filled" Status="error" Style="width: 100%;" />
    <RangePicker TValue="DateTime?[]" Variant="InputVariant.Filled" Status="warning" Style="width: 100%;" />
</Space>

@code {
    private static readonly DateTime JuneSix2015 = new(2015, 6, 6);
    private static readonly DateTime June2015 = new(2015, 6, 1);
    private static readonly DateTime?[] SameDayRange = [new DateTime(2015, 6, 6), new DateTime(2015, 6, 6)];
    private static readonly DateTime?[] DateRange = [new DateTime(2019, 9, 3), new DateTime(2019, 11, 22)];
    private static readonly bool[] RangeDisabled = [false, true];
}
