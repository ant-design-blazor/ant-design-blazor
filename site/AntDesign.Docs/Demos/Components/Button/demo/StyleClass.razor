@{
    var semanticClasses = new Dictionary<string, string>
    {
        ["root"] = "acss-blazor-root",
        ["content"] = "acss-blazor-content"
    };
    var rootStyles = new Dictionary<string, string>
    {
        ["root"] = "box-shadow: rgba(0, 0, 0, 0.05) 0px 1px 2px 0px;"
    };
    var primaryStyles = new Dictionary<string, string>
    {
        ["root"] = "background-color: rgb(23, 23, 23);",
        ["content"] = "color: rgb(255, 255, 255);"
    };
    Func<Button, IReadOnlyDictionary<string, string>> primaryStylesFunc = button =>
        button.Type == ButtonType.Primary ? primaryStyles : new Dictionary<string, string>();
}

<style>
    .acss-blazor-root {
        border: 1px solid var(--ant-color-border);
        border-radius: var(--ant-border-radius);
        padding: var(--ant-padding-xs) var(--ant-padding);
        height: auto;
    }
    .acss-blazor-content { color: var(--ant-color-text); }
</style>

<Flex Gap="FlexGap.Small">
    <Button Type="ButtonType.Default" ClassNames="semanticClasses" Styles="rootStyles">Object</Button>
    <Button Type="ButtonType.Primary" ClassNames="semanticClasses" StylesFunc="primaryStylesFunc">Function</Button>
</Flex>
