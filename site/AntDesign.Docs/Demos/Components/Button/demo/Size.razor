<RadioGroup TValue="string" @bind-Value="_sizeValue">
    <Radio Value='@("large")' RadioButton>Large</Radio>
    <Radio Value='@("medium")' RadioButton>Medium</Radio>
    <Radio Value='@("small")' RadioButton>Small</Radio>
</RadioGroup>

<Divider Text="Preview" Orientation="DividerOrientation.Left" Plain="true" />

    <Flex Gap="FlexGap.Small" Align="FlexAlign.FlexStart" Vertical="true">
    <Flex Gap="FlexGap.Small" Wrap="FlexWrap.Wrap">
        <Button Type="ButtonType.Primary" Size="@CurrentSize">Primary</Button>
        <Button Size="@CurrentSize">Default</Button>
        <Button Type="ButtonType.Dashed" Size="@CurrentSize">Dashed</Button>
    </Flex>

    <Button Type="ButtonType.Link" Size="@CurrentSize">Link</Button>

    <Flex Gap="FlexGap.Small" Wrap="FlexWrap.Wrap">
        <Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download" Size="@CurrentSize" />
        <Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download" Size="@CurrentSize" Shape="ButtonShape.Circle" />
        <Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download" Size="@CurrentSize" Shape="ButtonShape.Round" />
        <Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download" Size="@CurrentSize" Shape="ButtonShape.Round">Download</Button>
        <Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download" Size="@CurrentSize">Download</Button>
    </Flex>
</Flex>

@code
{
    private string _sizeValue = "large";

    private ButtonSize CurrentSize => _sizeValue switch
    {
        "large" => ButtonSize.Large,
        "medium" => ButtonSize.Default,
        _ => ButtonSize.Small,
    };
}
