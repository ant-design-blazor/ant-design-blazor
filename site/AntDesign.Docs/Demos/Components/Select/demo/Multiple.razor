<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
    <SpaceItem>
    <Select Mode="SelectMode.Multiple"
            Placeholder="Please select"
            @bind-Values="@_selectedValues1"
            TItemValue="string"
            TItem="string"
            OnSelectedItemsChanged="OnSelectedItemsChangedHandler"
            Style="width: 100%;"
            EnableSearch
            AllowClear>
        <SelectOptions>
            @foreach (var item in _items)
            {
                <SelectOption TItemValue="string" TItem="string" Value="@item" Label="@item" />
            }
        </SelectOptions>
    </Select>
    </SpaceItem>
    <SpaceItem>
    <Select Mode="SelectMode.Multiple"
            Placeholder="Please select"
            @bind-Values="@_selectedValues2"
            TItemValue="string"
            TItem="string"
            Disabled
            Style="width: 100%;">
        <SelectOptions>
            @foreach (var item in _items)
            {
                <SelectOption TItemValue="string" TItem="string" Value="@item" Label="@item" />
            }
        </SelectOptions>
    </Select>
    </SpaceItem>
</Space>

@code
{
    private readonly List<string> _items = Enumerable.Range(10, 26).Select(ToBase36Value).ToList();
    private IEnumerable<string> _selectedValues1 = new[] { "a10", "c12" };
    private IEnumerable<string> _selectedValues2 = new[] { "a10", "c12" };

    private static string ToBase36Value(int value)
    {
        var decimalValue = value;
        const string digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        var buffer = new char[8];
        var index = buffer.Length;
        do
        {
            buffer[--index] = digits[value % 36];
            value /= 36;
        } while (value > 0);

        var radix = new string(buffer, index, buffer.Length - index);
        return radix + decimalValue; // React concatenates the base-36 value and the decimal value.
    }

    private static void OnSelectedItemsChangedHandler(IEnumerable<string> values)
    {
        Console.WriteLine($"selected: {string.Join(",", values ?? Array.Empty<string>())}");
    }
}
