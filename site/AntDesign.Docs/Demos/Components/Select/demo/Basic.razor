<Space Wrap>
  <SpaceItem>
    <Select TItemValue="string" TItem="Option" DefaultValue='@("lucy")' DataSource="@_options"
            ItemValue="option => option.Value" ItemLabel="option => option.Label"
            DisabledName="@nameof(Option.Disabled)" EnableVirtualization Style="width: 120px;" />
  </SpaceItem>
  <SpaceItem>
    <Select TItemValue="string" TItem="Option" DefaultValue='@("lucy")' DataSource="@_singleOption"
            ItemValue="option => option.Value" ItemLabel="option => option.Label"
            DisabledName="@nameof(Option.Disabled)" EnableVirtualization Style="width: 120px;" Disabled />
  </SpaceItem>
  <SpaceItem>
    <Select TItemValue="string" TItem="Option" DefaultValue='@("lucy")' DataSource="@_singleOption"
            ItemValue="option => option.Value" ItemLabel="option => option.Label"
            DisabledName="@nameof(Option.Disabled)" EnableVirtualization Style="width: 120px;" Loading />
  </SpaceItem>
  <SpaceItem>
    <Select TItemValue="string" TItem="Option" DefaultValue='@("lucy")' DataSource="@_singleOption"
            ItemValue="option => option.Value" ItemLabel="option => option.Label"
            DisabledName="@nameof(Option.Disabled)" EnableVirtualization Style="width: 120px;" AllowClear Placeholder="select it" />
  </SpaceItem>
</Space>

@code {
    private sealed record Option(string Value, string Label, bool Disabled = false);

    private readonly Option[] _options =
    {
        new("jack", "Jack"),
        new("lucy", "Lucy"),
        new("Yiminghe", "yiminghe"),
        new("disabled", "Disabled", true)
    };

    private readonly Option[] _singleOption = { new("lucy", "Lucy") };
}
