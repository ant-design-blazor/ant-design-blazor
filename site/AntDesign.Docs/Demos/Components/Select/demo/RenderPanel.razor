<Flex Vertical Gap="FlexGap.Small" Align="FlexAlign.Start">
    <Switch @bind-Value="_open" />
    <Select TItemValue="string"
            TItem="PanelOption"
            DataSource="@_options"
            ValueName="@nameof(PanelOption.Value)"
            LabelName="@nameof(PanelOption.Label)"
            DefaultValue="@("lucy")"
            Style="width: 120px;"
            @bind-Open="_open" />
</Flex>

@code {
    private sealed record PanelOption(string Value, string Label);

    private readonly PanelOption[] _options =
    [
        new("jack", "Jack"),
        new("lucy", "Lucy"),
        new("disabled", "Disabled"),
        new("bamboo", "Bamboo")
    ];

    private bool _open = true;
}
