<Space Wrap>
    <SpaceItem>
        <Select TItem="Province"
                TItemValue="string"
                DataSource="@_provinces"
                @bind-Value="@_selectedProvince"
                ValueName="@nameof(Province.Name)"
                LabelName="@nameof(Province.Name)"
                Style="width: 120px"
                OnSelectedItemChanged="OnSelectedItemChangedHandler">
        </Select>
    </SpaceItem>

    <SpaceItem>
        <Select TItem="City"
                TItemValue="string"
                DataSource="@_cities"
                @bind-Value="@_selectedCity"
                ValueName="@nameof(City.Name)"
                LabelName="@nameof(City.Name)"
                Style="width: 120px">
        </Select>
    </SpaceItem>
</Space>

@code
{
    class Province
    {
        public string Name { get; set; }
        public List<City> Cities { get; set; } = new List<City>();
    }

    class City
    {
        public string Name { get; set; }
    }

    List<Province> _provinces;
    List<City> _cities = new List<City>();

    string _selectedProvince;
    string _selectedCity;

    protected override void OnInitialized()
    {
        _provinces = new List<Province>()
        {
            new Province()
            {
                Name = "Zhejiang",
                Cities = new List<City>()
                {
                    new City { Name = "Hangzhou" },
                    new City { Name = "Ningbo" },
                    new City { Name = "Wenzhou" }
                }
            },
            new Province()
            {
                Name = "Jiangsu",
                Cities = new List<City>()
                {
                    new City { Name = "Nanjing" },
                    new City { Name = "Suzhou" },
                    new City { Name = "Zhenjiang" }
                }
            },
        };
        _selectedProvince = "Zhejiang";
        _selectedCity = "Hangzhou";
    }

    private void OnSelectedItemChangedHandler(Province value)
    {
        _cities = value?.Cities;
        if (_cities?.Any(x => x.Name == _selectedCity) != true)
        {
            _selectedCity = _cities?.FirstOrDefault()?.Name;
        }
    }
}
