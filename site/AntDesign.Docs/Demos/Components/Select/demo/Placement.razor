<RadioGroup @bind-Value="placement" ButtonStyle="RadioButtonStyle.Outline" TValue="string">
    <Radio RadioButton Value="@("topLeft")">topLeft</Radio>
    <Radio RadioButton Value="@("topRight")">topRight</Radio>
    <Radio RadioButton Value="@("bottomLeft")">bottomLeft</Radio>
    <Radio RadioButton Value="@("bottomRight")">bottomRight</Radio>
</RadioGroup>
<br />
<br />
<Select TItem="string" TItemValue="string" Value="@("HangZhou")" Style="width: 120px"
        Placement="@SelectedPlacement" DropdownMatchSelectWidth="false">
    <SelectOptions>
        <SelectOption TItem="string" TItemValue="string" Value="@("HangZhou")" Label="HangZhou #310000" />
        <SelectOption TItem="string" TItemValue="string" Value="@("NingBo")" Label="NingBo #315000" />
        <SelectOption TItem="string" TItemValue="string" Value="@("WenZhou")" Label="WenZhou #325000" />
    </SelectOptions>
</Select>

@code {
    private string placement = "topLeft";
    private AntDesign.Placement SelectedPlacement => Enum.Parse<AntDesign.Placement>(placement, ignoreCase: true);
}
