<RadioGroup @bind-Value="placement" ButtonStyle="RadioButtonStyle.Outline" TValue="AntDesign.Placement">
    <Radio RadioButton Value="AntDesign.Placement.TopLeft">topLeft</Radio>
    <Radio RadioButton Value="AntDesign.Placement.TopRight">topRight</Radio>
    <Radio RadioButton Value="AntDesign.Placement.BottomLeft">bottomLeft</Radio>
    <Radio RadioButton Value="AntDesign.Placement.BottomRight">bottomRight</Radio>
</RadioGroup>
<br />
<br />
<Select TItem="string" TItemValue="string" Value="@("HangZhou")" Style="width: 180px"
        Placement="@placement" DropdownMatchSelectWidth="false">
    <SelectOptions>
        <SelectOption TItem="string" TItemValue="string" Value="@("HangZhou")" Label="HangZhou #310000" />
        <SelectOption TItem="string" TItemValue="string" Value="@("NingBo")" Label="NingBo #315000" />
        <SelectOption TItem="string" TItemValue="string" Value="@("WenZhou")" Label="WenZhou #325000" />
    </SelectOptions>
</Select>

@code {
    private AntDesign.Placement placement = AntDesign.Placement.BottomLeft;
}
