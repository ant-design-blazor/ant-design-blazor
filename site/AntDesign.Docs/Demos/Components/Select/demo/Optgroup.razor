<Select TItem="Person"
        TItemValue="string"
        DataSource="@_persons" 
        Value="@("lucy")"
        ValueName="@nameof(Person.Value)" 
        LabelName="@nameof(Person.Name)" 
        GroupName="@nameof(Person.Role)"
		Style="width: 200px;">
</Select>
@code
{
    class Person
    {
        public string Value { get; set; }
        public string Name { get; set; }
        public string Role { get; set; }
    }

    List<Person> _persons;
    protected override void OnInitialized()
    {
        _persons = new List<Person>
        {
            new Person {Value = "Jack", Name = "Jack", Role = "manager"},
            new Person {Value = "Lucy", Name = "Lucy", Role = "manager"},
            new Person {Value = "Chloe", Name = "Chloe", Role = "engineer"},
            new Person {Value = "Lucas", Name = "Lucas", Role = "engineer"}
        };
    }
}
