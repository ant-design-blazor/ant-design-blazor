@using AntDesign.Select

<Space Direction="SpaceDirection.Vertical" Style="width: 100%;">
    <Select TItemValue="string" TItem="string" Mode="SelectMode.Multiple"
            Style="width: 100%;" Placeholder="Select Item..." MaxTagCount="ResponsiveTag.Responsive"
            DataSource="@_options" ItemValue="value => value" ItemLabel="value => FormatLabel(value)"
            @bind-Values="@_selectedValues">
    </Select>
    <Select TItemValue="string" TItem="string" Mode="SelectMode.Multiple"
            Style="width: 100%;" Placeholder="Select Item..." MaxTagCount="ResponsiveTag.Responsive"
            DataSource="@_options" ItemValue="value => value" ItemLabel="value => FormatLabel(value)"
            Disabled>
    </Select>
    <Select TItemValue="string" TItem="string" Mode="SelectMode.Multiple"
            Style="width: 100%;" Placeholder="Select Item..." MaxTagCount="ResponsiveTag.Responsive"
            DataSource="@_options" ItemValue="value => value" ItemLabel="value => FormatLabel(value)"
            MaxTagPlaceholder="@RenderMaxTagPlaceholder"
            @bind-Values="@_selectedValues">
    </Select>
</Space>

@code {
    private List<string> _options = new();
    private IEnumerable<string> _selectedValues;

    private static string FormatLabel(string value) => $"Long Label: {value}";

    private RenderFragment<IEnumerable<string>> RenderMaxTagPlaceholder => omittedValues => builder =>
    {
        builder.OpenComponent<Tooltip>(0);
        builder.AddAttribute(1, "Title", string.Join(", ", omittedValues.Select(FormatLabel)));
        builder.AddAttribute(2, "ChildContent", (RenderFragment)(childBuilder =>
        {
            childBuilder.OpenElement(0, "span");
            childBuilder.AddContent(1, "Hover Me");
            childBuilder.CloseElement();
        }));
        builder.CloseComponent();
    };

    protected override void OnInitialized()
    {
        for (var i = 10; i < 36; i++)
        {
            _options.Add(ToBase36(i) + i);
        }

        _selectedValues = new[] { "a10", "c12", "h17", "j19", "k20" };
    }

    private static string ToBase36(int value)
    {
        const string digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        var buffer = new char[8];
        var index = buffer.Length;
        do
        {
            buffer[--index] = digits[value % 36];
            value /= 36;
        } while (value > 0);

        return new string(buffer, index, buffer.Length - index);
    }
}
