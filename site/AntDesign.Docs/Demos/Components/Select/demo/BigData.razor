<Title Level="4">100000 Items</Title>

<Select Mode="SelectMode.Multiple"
        Placeholder="Please select"
        Style="width: 100%;"
        DataSource="@_options"
        DefaultValues="@_selectedValues"
        LabelName="@nameof(LabeledValue.Label)"
        ValueName="@nameof(LabeledValue.Value)"
        DisabledName="@nameof(LabeledValue.Disabled)"
        TItemValue="string"
        TItem="LabeledValue"
        EnableSearch
        EnableVirtualization>
</Select>

@code {
    private sealed class LabeledValue
    {
        public string Value { get; init; }
        public string Label { get; init; }
        public bool Disabled { get; init; }
    }

    private List<LabeledValue> _options = new();
    private IEnumerable<string> _selectedValues = new[] { "a10", "c12" };

    protected override void OnInitialized()
    {
        for (var i = 0; i < 100000; i++)
        {
            var value = ToBase36(i) + i;
            _options.Add(new LabeledValue { Value = value, Label = value, Disabled = i == 10 });
        }
    }

    private static string ToBase36(int value)
    {
        const string digits = "0123456789abcdefghijklmnopqrstuvwxyz";
        var buffer = new char[8];
        var index = buffer.Length;
        do
        {
            buffer[--index] = digits[value % 36];
            value /= 36;
        } while (value > 0);

        return new string(buffer, index, buffer.Length - index);
    }
}
