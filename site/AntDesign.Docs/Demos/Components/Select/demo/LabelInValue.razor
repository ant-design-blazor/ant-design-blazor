<Select @bind-Value="@_selectedValue"
		DefaultValue="@("lucy")"
		TItemValue="string"
        TItem="string"
        LabelInValue="true"
		Style="width: 120px;">
		<SelectOptions>
			<SelectOption TItemValue="string" TItem="string" Value="@("jack")" Label="Jack (100)" />
			<SelectOption TItemValue="string" TItem="string" Value="@("lucy")" Label="Lucy (101)" />
		</SelectOptions>
</Select>

@code
{
	string _selectedValue;
}
