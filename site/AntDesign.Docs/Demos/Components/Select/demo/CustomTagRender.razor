<Select TItemValue="string"
        TItem="MyColor"
        Mode="SelectMode.Multiple"
        DataSource="@_colors"
        ValueName="@nameof(MyColor.Value)"
        LabelName="@nameof(MyColor.Label)"
        @bind-Values="_selectedColors"
        Style="width: 100%;"
        ShowArrowIcon>
    <TagRender Context="tag"><Tag Color="@tag.Value" Closable="@tag.Closable" OnClose="@tag.OnClose" Style="margin-inline-end: 4px;" PreventMouseDownDefault="true" StopMouseDownPropagation="true"><ChildContent>@tag.Label</ChildContent></Tag></TagRender>
</Select>

@code {
    private readonly MyColor[] _colors =
    [
        new("gold", "gold"),
        new("lime", "lime"),
        new("green", "green"),
        new("cyan", "cyan")
    ];

    private IEnumerable<string> _selectedColors = ["gold", "cyan"];

    private sealed record MyColor(string Value, string Label);
}
