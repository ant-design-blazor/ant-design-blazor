<Select TItemValue="string"
        TItem="string"
        Mode="SelectMode.Tags"
        EnableSearch
        Tokenize="@TokenizeInput"
        Placeholder='Try paste: "San Francisco, CA", New York'
        Style="width: 100%;">
</Select>

@code {
    private static IEnumerable<string> TokenizeInput(string input)
    {
        return System.Text.RegularExpressions.Regex.Matches(input ?? string.Empty, @"""([^""]*)""|([^,\r\n]+)")
            .Select(match => (match.Groups[1].Success ? match.Groups[1].Value : match.Groups[2].Value).Trim())
            .Where(token => token.Length > 0)
            .ToArray();
    }
}
