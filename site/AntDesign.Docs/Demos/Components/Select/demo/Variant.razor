<Flex Gap="@("12px")" Vertical>
    <Flex Gap="@("8px")">
        <Select TItemValue="string" TItem="OptionItem" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" Placeholder="Outlined" Style="flex: 1 1 0%;" />
        <Select TItemValue="string" TItem="OptionItem" Mode="SelectMode.Multiple" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" DefaultValues="@_selectedValues" Placeholder="Outlined" Style="flex: 1 1 0%;" />
    </Flex>
    <Flex Gap="@("8px")">
        <Select TItemValue="string" TItem="OptionItem" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" Placeholder="Filled" Variant="InputVariant.Filled" Style="flex: 1 1 0%;" />
        <Select TItemValue="string" TItem="OptionItem" Mode="SelectMode.Multiple" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" DefaultValues="@_selectedValues" Placeholder="Filled" Variant="InputVariant.Filled" Style="flex: 1 1 0%;" />
    </Flex>
    <Flex Gap="@("8px")">
        <Select TItemValue="string" TItem="OptionItem" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" Placeholder="Borderless" Variant="InputVariant.Borderless" Style="flex: 1 1 0%;" />
        <Select TItemValue="string" TItem="OptionItem" Mode="SelectMode.Multiple" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" DefaultValues="@_selectedValues" Placeholder="Borderless" Variant="InputVariant.Borderless" Style="flex: 1 1 0%;" />
    </Flex>
    <Flex Gap="@("8px")">
        <Select TItemValue="string" TItem="OptionItem" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" Placeholder="Underlined" Variant="InputVariant.Underlined" Style="flex: 1 1 0%;" />
        <Select TItemValue="string" TItem="OptionItem" Mode="SelectMode.Multiple" DataSource="@_options" ItemValue="item => item.Value" ItemLabel="item => item.Label" DefaultValues="@_selectedValues" Placeholder="Underlined" Variant="InputVariant.Underlined" Style="flex: 1 1 0%;" />
    </Flex>
</Flex>

@code {
    private sealed record OptionItem(string Value, string Label);

    private readonly OptionItem[] _options =
    [
        new("jack", "Jack"),
        new("lucy", "Lucy"),
        new("Yiminghe", "yiminghe")
    ];

    private readonly string[] _selectedValues = ["lucy"];
}
