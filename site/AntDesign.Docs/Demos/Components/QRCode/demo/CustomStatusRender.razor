<Flex Gap="FlexGap.Medium" Wrap="FlexWrap.Wrap">
    <QRCode Value="https://ant.design" Status="loading">
        <StatusTemplate>
            <Space Direction="SpaceDirection.Vertical">
                <SpaceItem><Spin /></SpaceItem>
                <SpaceItem><p>Loading...</p></SpaceItem>
            </Space>
        </StatusTemplate>
    </QRCode>
    <QRCode Value="https://ant.design" Status="expired" OnRefresh="Refresh">
        <StatusTemplate Context="info">
            <div style="text-align:center">
                <AntDesign.Icon Type="close-circle" Theme="IconThemeType.Fill" Style="color:red" /> @info.Locale.Expired
                <p><Button Type="ButtonType.Link" Icon="reload" OnClick="@(() => info.OnRefresh())">@info.Locale.Refresh</Button></p>
            </div>
        </StatusTemplate>
    </QRCode>
    <QRCode Value="https://ant.design" Status="scanned">
        <StatusTemplate Context="info">
            <div><AntDesign.Icon Type="check-circle" Theme="IconThemeType.Fill" Style="color:green" /> @info.Locale.Scanned</div>
        </StatusTemplate>
    </QRCode>
</Flex>

@code {
    private void Refresh() => Console.WriteLine("refresh");
}
