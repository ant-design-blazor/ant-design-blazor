<Upload Action="https://660d2bd96ddfa2943b33731c.mockapi.io/api/upload"
        Name="file"
        ListType="UploadListType.Picture"
        DefaultFileList="_fileList">
    <Button Type="ButtonType.Primary" Icon="@IconType.Outline.Upload">Upload</Button>
</Upload>

@code {
    private static readonly List<UploadFileItem> _fileList = new()
    {
        new() { Id = "0", FileName = "xxx.png", State = UploadState.Uploading, Percent = 33 },
        new() { Id = "-1", FileName = "yyy.png", State = UploadState.Success, Url = "https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png" },
        new() { Id = "-2", FileName = "zzz.png", State = UploadState.Fail }
    };
}
