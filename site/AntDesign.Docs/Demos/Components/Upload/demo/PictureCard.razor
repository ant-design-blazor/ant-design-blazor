<Upload Action="https://660d2bd96ddfa2943b33731c.mockapi.io/api/upload"
        Name="file"
        @bind-FileList="fileList"
        ShowButton="fileList?.Count < 8"
        ListType="UploadListType.PictureCard"
        OnPreview="HandlePreview"
        OnChange="HandleChange">
    <button type="button" style="border: 0px; background: none;">
        <Icon Type="@IconType.Outline.Plus" />
        <div style="margin-top: 8px;">Upload</div>
    </button>

</Upload>
@if (!string.IsNullOrEmpty(previewImage))
{
    <Image Src="@previewImage" PreviewVisible="previewVisible" PreviewVisibleChanged="HandlePreviewVisibleChanged" Style="display:none" />
}

@code
{
    bool previewVisible;
    bool openPreviewOnRender;
    string previewImage = string.Empty;
    List<UploadFileItem> fileList = new List<UploadFileItem>
    {
        new UploadFileItem
        {
            Id = "1",
            FileName = "image.png",
            State = UploadState.Success,
            Url = "https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png"
        },
        new UploadFileItem
        {
            Id = "2",
            FileName = "image.png",
            State = UploadState.Success,
            Url = "https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png"
        },
        new UploadFileItem
        {
            Id = "3",
            FileName = "image.png",
            State = UploadState.Success,
            Url = "https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png"
        },
        new UploadFileItem
        {
            Id = "4",
            FileName = "image.png",
            State = UploadState.Success,
            Url = "https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png"
        },
        new UploadFileItem
        {
            Id = "xxx",
            FileName = "image.png",
            State = UploadState.Uploading,
            Percent = 50,
            Url = "https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png"
        },
         new UploadFileItem
        {
            Id = "5",
            FileName = "image.png",
            State = UploadState.Fail
        },
    };

    void HandleChange(UploadInfo fileinfo)
    {
        if (fileinfo.File.State == UploadState.Success)
        {
            fileinfo.File.Url = fileinfo.File.ObjectURL;
        }
    }

    void HandlePreview(UploadFileItem file)
    {
        previewImage = string.IsNullOrEmpty(file.Url) ? file.ObjectURL : file.Url;
        previewVisible = false;
        openPreviewOnRender = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (openPreviewOnRender)
        {
            openPreviewOnRender = false;
            previewVisible = true;
            StateHasChanged();
        }
    }

    void HandlePreviewVisibleChanged(bool visible)
    {
        previewVisible = visible;
        if (!visible)
        {
            previewImage = string.Empty;
        }
    }

}
