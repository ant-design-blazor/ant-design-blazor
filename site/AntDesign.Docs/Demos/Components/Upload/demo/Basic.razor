@inject IMessageService Message

<Upload Action="https://660d2bd96ddfa2943b33731c.mockapi.io/api/upload"
        Name="file"
        Headers="UploadHeaders"
        OnChange="HandleChange">
    <Button Icon="upload">Click to Upload</Button>
</Upload>

@code {
    private static readonly Dictionary<string, string> UploadHeaders = new()
    {
        ["authorization"] = "authorization-text"
    };

    private void HandleChange(UploadInfo info)
    {
        if (info.File.State == UploadState.Success)
        {
            Message.Success($"{info.File.FileName} file uploaded successfully");
        }
        else if (info.File.State == UploadState.Fail)
        {
            Message.Error($"{info.File.FileName} file upload failed.");
        }
    }
}
