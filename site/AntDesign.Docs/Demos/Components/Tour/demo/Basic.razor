<Button Type="ButtonType.Primary" OnClick="StartTour">Begin Tour</Button>
<Divider />
<Space>
    <span @ref="_firstTarget"><Button>Upload</Button></span>
    <span @ref="_secondTarget"><Button Type="ButtonType.Primary">Save</Button></span>
    <span @ref="_thirdTarget"><Button>⋯</Button></span>
</Space>

<Tour Open="@_open" OpenChanged="OnOpenChanged" Steps="@_steps" />

@code {
    private bool _open;
    private ElementReference _firstTarget;
    private ElementReference _secondTarget;
    private ElementReference _thirdTarget;
    private RenderFragment _cover = @<img draggable="false" alt="tour.png" src="https://user-images.githubusercontent.com/5378891/197385811-55df8480-7ff4-44bd-9d43-a7dade598d70.png" />;

    private IReadOnlyList<TourStep> _steps => new[]
    {
        new TourStep
        {
            Target = _firstTarget,
            Title = Text("Upload File"),
            Description = Text("Put your files here."),
            Cover = _cover,
            Placement = AntDesign.Placement.Bottom
        },
        new TourStep
        {
            Target = _secondTarget,
            Title = Text("Save"),
            Description = Text("Save your changes."),
            Placement = AntDesign.Placement.Bottom
        },
        new TourStep
        {
            Target = _thirdTarget,
            Title = Text("Other Actions"),
            Description = Text("Click to see other actions."),
            Placement = AntDesign.Placement.Bottom
        }
    };

    private void StartTour() => _open = true;

    private Task OnOpenChanged(bool value)
    {
        _open = value;
        return Task.CompletedTask;
    }

    private static RenderFragment Text(string value) => builder => builder.AddContent(0, value);
}
