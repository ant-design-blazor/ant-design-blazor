@using AntDesign.TableModels
@using System.Net.Http.Json
@inject HttpClient Http

<Table TItem="Data" DataSource="_data" Total="100" Loading="_loading"
       RemoteDataSource="true" OnChange="HandleTableChange" RowKey="record => record.Id">
    <PropertyColumn Property="record => record.Name" Sortable Width="20%" />
    <PropertyColumn Property="record => record.Gender" Filters="_genderFilters" Width="20%" />
    <PropertyColumn Property="record => record.Email" />
</Table>

@code {
    private const string ApiUrl = "https://660d2bd96ddfa2943b33731c.mockapi.io/api/users";

    private bool _loading = true;
    private Data[] _data = Array.Empty<Data>();

    private readonly TableFilter<string>[] _genderFilters =
    [
        new() { Text = "Male", Value = "male" },
        new() { Text = "Female", Value = "female" }
    ];

    private async Task HandleTableChange(QueryModel<Data> queryModel)
    {
        _loading = true;
        try
        {
            var query = new List<string>
            {
                $"limit={queryModel.PageSize}",
                $"page={queryModel.PageIndex}"
            };

            foreach (var filter in queryModel.FilterModel)
            {
                foreach (var value in filter.SelectedValues)
                {
                    query.Add($"{Uri.EscapeDataString(filter.FieldName.ToLowerInvariant())}={Uri.EscapeDataString(value)}");
                }
            }

            var sorter = queryModel.SortModel.FirstOrDefault(model => model.SortDirection is SortDirection.Ascending or SortDirection.Descending);
            if (sorter != null)
            {
                query.Add($"orderby={Uri.EscapeDataString(sorter.FieldName.ToLowerInvariant())}");
                query.Add($"order={(sorter.SortDirection == SortDirection.Ascending ? "asc" : "desc")}");
            }

            _data = await Http.GetFromJsonAsync<Data[]>($"{ApiUrl}?{string.Join('&', query)}") ?? Array.Empty<Data>();
        }
        catch (HttpRequestException)
        {
            _data = Array.Empty<Data>();
        }
        finally
        {
            _loading = false;
        }
    }

    public sealed class Data
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Gender { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
    }
}
