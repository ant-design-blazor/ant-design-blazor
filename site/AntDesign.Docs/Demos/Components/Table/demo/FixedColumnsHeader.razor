<Table TItem="Row" DataSource="_rows" RowKey="row => row.Key" ScrollX="max-content" ScrollY="275" TableLayout="auto">
    <ColumnDefinitions>
        <PropertyColumn Property="row => row.Name" Title="Full Name" Width="100" Fixed="ColumnFixPlacement.Left" />
        <PropertyColumn Property="row => row.Age" Width="100" Fixed="ColumnFixPlacement.Left" />
        @for (var index = 1; index <= 7; index++)
        {
            <PropertyColumn @key="index" Property="row => row.Address" Title="@($"Column {index}")" Width="150" />
        }
        @for (var index = 8; index <= 20; index++)
        {
            <PropertyColumn @key="index" Property="row => row.Address" Title="@($"Column {index}")" />
        }
        <ActionColumn Title="Action" Width="100" Fixed="ColumnFixPlacement.Right">
            <a>action</a>
        </ActionColumn>
    </ColumnDefinitions>
</Table>

<style>
    #components-table-demo-fixed-columns-header .ant-table-container .ant-table-body,
    #components-table-demo-fixed-columns-header .ant-table-container .ant-table-content {
        scrollbar-width: thin;
        scrollbar-color: #eaeaea transparent;
    }
</style>

@code {
    private readonly Row[] _rows = Enumerable.Range(0, 100)
        .Select(index => new Row(index.ToString(), $"Edward King {index}", 32, $"London, Park Lane no. {index}"))
        .ToArray();

    private sealed record Row(string Key, string Name, int Age, string Address);
}
