<Table TItem="Column" DataSource="data" RowKey="c => c.Key">
    <PropertyColumn Property="c=>c.Name" Width="150">
        <a>@context.Name</a>
    </PropertyColumn>
    <PropertyColumn Property="c=>c.Age" Width="80" />
    <PropertyColumn Property="c=>c.Address" Title="Address" Ellipsis />
    <PropertyColumn Property="c=>c.Address" Title="Long Column Long Column Long Column" Ellipsis />
    <PropertyColumn Property="c=>c.Address" Title="Long Column Long Column" Ellipsis />
    <PropertyColumn Property="c=>c.Address" Title="Long Column" Ellipsis />
</Table>

@code {
    Column[] data = new Column[] {
        new()
        {
            Key = "1",
            Name = "John Brown",
            Age = 32,
            Address = "New York No. 1 Lake Park, New York No. 1 Lake Park"
        },
        new()
        {
            Key = "2",
            Name = "Jim Green",
            Age = 42,
            Address = "London No. 2 Lake Park, London No. 2 Lake Park"
        },
        new()
        {
            Key = "3",
            Name = "Joe Black",
            Age = 32,
            Address = "Sydney No. 1 Lake Park, Sydney No. 1 Lake Park"
        },
    };

    class Column
    {
        public string Key { get; set; }

        public string Name { get; set; }

        public int Age { get; set; }

        public string Address { get; set; }
    }

}
