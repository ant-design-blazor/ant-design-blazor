@using System.ComponentModel
@using AntDesign.TableModels

Dynamic columns:
<Checkbox @bind-Checked="showAge">Age</Checkbox>
<Checkbox @bind-Checked="showAddress">Address</Checkbox>
<br />
<Table TItem="Data" DataSource="@data">
    <PropertyColumn Property="c=>c.Name">
        <CellRender Context="cell">
        <a>@(((dynamic)cell.RowData).Data.Name)</a>
    
        </CellRender>
    </PropertyColumn>
    <Column TData="object" DataIndex="Age" Hidden="@(!showAge)"></Column>
    <Column TData="object" DataIndex="Address" Hidden="@(!showAddress)"></Column>
    <PropertyColumn Property="c=>c.Tags">
        <CellRender Context="cell">
        @foreach (var tag in ((dynamic)cell.RowData).Data.Tags)
        {
            var color = tag.Length > 5 ? TagColor.GeekBlue : TagColor.Green;
            if (tag == "loser")
            {
                color = TagColor.Volcano;
            }
            <Tag Color="@color">@tag</Tag>
        }
    
        </CellRender>
    </PropertyColumn>
  <ActionColumn Title="Action">
      <CellRender Context="cell">
    <Space Size="SpaceSize.Middle">
      <SpaceItem>
        <a>Invite @(((dynamic)cell.RowData).Data.Name)</a>
      </SpaceItem>
      <SpaceItem>
        <a>Delete</a>
      </SpaceItem>
    </Space>
  
      </CellRender>
  </ActionColumn>
</Table>

@code {
    bool showAge = true;

    bool showAddress = true;

    Data[] data = new Data[]
    {
        new()
        {
            Key = "1",
            Name = "John Brown",
            Age = 32,
            Address = "New York No. 1 Lake Park",
            Tags = new[] {"nice", "developer"}
        },
        new()
        {
            Key = "2",
            Name = "Jim Green",
            Age = 42,
            Address = "London No. 1 Lake Park",
            Tags = new[] { "loser"}
        },
        new()
        {
            Key = "3",
            Name = "Joe Black",
            Age = 32,
            Address = "Sidney No. 1 Lake Park",
            Tags = new[] { "cool", "teacher" }
        }
    };

    public class Data
    {
        [DisplayName("Key")]
        public string Key { get; set; }

        [DisplayName("Name")]
        public string Name { get; set; }

        [DisplayName("Age")]
        public int Age { get; set; }

        [DisplayName("Address")]
        public string Address { get; set; }

        [DisplayName("Tags")]
        public string[] Tags { get; set; }
    }
}
