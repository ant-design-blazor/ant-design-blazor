@using AntDesign.TableModels

<Table TItem="Data" DataSource="@data" RowKey="item => item.Key">
    <PropertyColumn Property="c => c.Name" Title="Name">
        <a>@context.Name</a>
    </PropertyColumn>
    <PropertyColumn Property="c => c.Age" Title="Age" />
    <PropertyColumn Property="c => c.Address" Title="Address" />
    <PropertyColumn Property="c => c.Tags" Title="Tags">
        <Flex Gap="FlexGap.Small" Align="FlexAlign.Center" Wrap="FlexWrap.Wrap">
            @foreach (var tag in context.Tags)
            {
                var color = tag.Length > 5 ? TagColor.GeekBlue : TagColor.Green;
                if (tag == "kawaii")
                {
                    color = TagColor.Volcano;
                }
                <Tag Color="@color">@tag.ToUpperInvariant()</Tag>
            }
        </Flex>
    </PropertyColumn>
    <ActionColumn Title="Action">
        <Space Size="SpaceSize.Middle">
            <SpaceItem>
                <a>Invite @context.Name</a>
            </SpaceItem>
            <SpaceItem>
                <a>Delete</a>
            </SpaceItem>
        </Space>
    </ActionColumn>
</Table>

