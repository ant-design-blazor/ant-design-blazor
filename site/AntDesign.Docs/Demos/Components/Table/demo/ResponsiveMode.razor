@using System.ComponentModel
@using AntDesign.TableModels

<Table TItem="Data" DataSource="@data" Responsive>
  <PropertyColumn Property="c=>c.Name">
      <CellRender Context="cell">
    <a>@(((dynamic)cell.RowData).Data.Name)</a>
  
      </CellRender>
  </PropertyColumn>
  <PropertyColumn Property="c=>c.Age"></PropertyColumn>
  <PropertyColumn Property="c=>c.Address">
    <TitleTemplate>
      <span> <Icon Type="@IconType.Outline.Environment" /> Address </span>
    </TitleTemplate>
  </PropertyColumn>
  <PropertyColumn Property="c=>c.Tags">
      <CellRender Context="cell">
    @foreach (var tag in ((dynamic)cell.RowData).Data.Tags)
    {
      var color = tag.Length > 5 ? TagColor.GeekBlue : TagColor.Green;
      if (tag == "loser")
      {
        color = TagColor.Volcano;
      }
      <Tag Color="@color">@tag</Tag>
    }
  
      </CellRender>
  </PropertyColumn>
  <ActionColumn Title="Action">
      <CellRender Context="cell">
    <Space Size="SpaceSize.Middle">
      <SpaceItem>
        <a>Invite @(((dynamic)cell.RowData).Data.Name)</a>
      </SpaceItem>
      <SpaceItem>
        <a>Delete</a>
      </SpaceItem>
    </Space>
  
      </CellRender>
  </ActionColumn>
</Table>

@code{
    Data[] data = new Data[]
    {
        new()
        {
            Key = "1",
            Name = "John Brown",
            Age = 32,
            Address = "New York No. 1 Lake Park",
            Tags = new[] {"nice", "developer"}
        },
        new()
        {
            Key = "2",
            Name = "Jim Green",
            Age = 42,
            Address = "London No. 1 Lake Park",
            Tags = new[] { "loser"}
        },
        new()
        {
            Key = "3",
            Name = "Joe Black",
            Age = 32,
            Address = "Sidney No. 1 Lake Park",
            Tags = new[] { "cool", "teacher" }
        }
    };

    public record Data
    {
        public string Key { get; set; }

        public string Name { get; set; }

        public int Age { get; set; }

        public string Address { get; set; }

        public string[] Tags { get; set; }
    }
}