@using System.ComponentModel

<Divider>Medium size table</Divider>
<Table DataSource="@data" RowKey="item => item.Key" Size="TableSize.Medium">
    <PropertyColumn Property="c => c.Name" Title="Name" />
    <PropertyColumn Property="c => c.Age" Title="Age" />
    <PropertyColumn Property="c => c.Address" Title="Address" />
</Table>

<Divider>Small size table</Divider>
<Table DataSource="@data" RowKey="item => item.Key" Size="TableSize.Small">
    <PropertyColumn Property="c => c.Name" Title="Name" />
    <PropertyColumn Property="c => c.Age" Title="Age" />
    <PropertyColumn Property="c => c.Address" Title="Address" />
</Table>

@code{
    Data[] data =
    {
        new Data()
        {
            Key = "1",
            Name = "John Brown",
            Age = 32,
            Address = "New York No. 1 Lake Park",
        },
        new Data()
        {
            Key = "2",
            Name = "Jim Green",
            Age = 42,
            Address = "London No. 1 Lake Park",
        },
        new Data()
        {
            Key = "3",
            Name = "Joe Black",
            Age = 32,
            Address = "Sydney No. 1 Lake Park",
        }
    };

    public class Data
    {
        [DisplayName("Key")]
        public string Key { get; set; }

        [DisplayName("Name")]
        public string Name { get; set; }

        [DisplayName("Age")]
        public int Age { get; set; }

        [DisplayName("Address")]
        public string Address { get; set; }
    }
}
