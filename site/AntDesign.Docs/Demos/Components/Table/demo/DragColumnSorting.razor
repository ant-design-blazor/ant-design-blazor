@implements IAsyncDisposable
@using AntDesign.TableModels
@inject IJSRuntime JS

<div class="table-column-drag-demo">
    <div id="DndDescribedBy-1" class="table-column-drag-instructions">
        To pick up a draggable column, press the space bar. While dragging, use the left and right arrow keys to move the column. Press space again to drop it, or press escape to cancel.
    </div>
    <Table RefBack="@_tableRef" TItem="Row" DataSource="_rows" RowKey="row => row.Key" Class="table-column-drag-table">
        <ColumnDefinitions>
            @foreach (var column in _columnOrder)
            {
                @switch (column)
                {
                    case nameof(Row.Name):
                        <PropertyColumn @key="column" Property="row => row.Name" Title="Name"
                                        OnHeaderCell="@(() => HeaderAttributes(column))"
                                        OnCell="@(_ => CellAttributes(column))" />
                        break;
                    case nameof(Row.Gender):
                        <PropertyColumn @key="column" Property="row => row.Gender" Title="Gender"
                                        OnHeaderCell="@(() => HeaderAttributes(column))"
                                        OnCell="@(_ => CellAttributes(column))" />
                        break;
                    case nameof(Row.Age):
                        <PropertyColumn @key="column" Property="row => row.Age" Title="Age"
                                        OnHeaderCell="@(() => HeaderAttributes(column))"
                                        OnCell="@(_ => CellAttributes(column))" />
                        break;
                    case nameof(Row.Email):
                        <PropertyColumn @key="column" Property="row => row.Email" Title="Email"
                                        OnHeaderCell="@(() => HeaderAttributes(column))"
                                        OnCell="@(_ => CellAttributes(column))" />
                        break;
                    case nameof(Row.Address):
                        <PropertyColumn @key="column" Property="row => row.Address" Title="Address"
                                        OnHeaderCell="@(() => HeaderAttributes(column))"
                                        OnCell="@(_ => CellAttributes(column))" />
                        break;
                }
            }
        </ColumnDefinitions>
    </Table>
</div>

<style>
    .table-column-drag-instructions {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    .table-column-drag-demo .table-column-drag-table thead th[id] {
        cursor: move;
    }

    .table-column-drag-overlay {
        position: fixed;
        z-index: 1000;
        pointer-events: none;
        inset: 0 auto auto 0;
        will-change: transform;
    }

    .table-column-drag-overlay table {
        border-collapse: separate;
        border-spacing: 0;
    }

    .table-column-drag-overlay th {
        padding: 16px;
        background: gray;
        white-space: nowrap;
    }
</style>

@code {
    private const string InstructionsId = "DndDescribedBy-1";
    private static readonly string[] ColumnIds =
    [
        nameof(Row.Name),
        nameof(Row.Gender),
        nameof(Row.Age),
        nameof(Row.Email),
        nameof(Row.Address)
    ];

    private readonly List<string> _columnOrder = ColumnIds.ToList();
    private readonly Row[] _rows =
    [
        new("1", "John Brown", "male", 32, "John Brown@example.com", "London No. 1 Lake Park"),
        new("2", "Jim Green", "female", 42, "jimGreen@example.com", "London No. 1 Lake Park"),
        new("3", "Joe Black", "female", 32, "JoeBlack@example.com", "Sidney No. 1 Lake Park"),
        new("4", "George Hcc", "male", 20, "george@example.com", "Sidney No. 1 Lake Park")
    ];

    private readonly ForwardRef _tableRef = new();
    private IJSObjectReference _sortableModule;
    private DotNetObjectReference<DragColumnSorting>? _dotNetReference;
    private bool _sortableInitialized;

    private static Dictionary<string, object> HeaderAttributes(string column) => new()
    {
        ["id"] = ColumnIds.IndexOf(column).ToString(),
        ["tabindex"] = 0,
        ["role"] = "button",
        ["aria-disabled"] = "false",
        ["aria-roledescription"] = "sortable",
        ["aria-describedby"] = InstructionsId
    };

    private static Dictionary<string, object> CellAttributes(string column) => new()
    {
        ["id"] = ColumnIds.IndexOf(column).ToString()
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _sortableModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AntDesign.Docs/js/table-column-sortable.js?v=20261115.1");
        _dotNetReference = DotNetObjectReference.Create(this);
        await _sortableModule.InvokeVoidAsync("initializeTableColumnSortable", _tableRef.Current, _dotNetReference);
        _sortableInitialized = true;
    }

    [JSInvokable]
    public Task OnColumnSortDrop(string activeColumn, string overColumn)
    {
        if (!int.TryParse(activeColumn, out var activeIndex)
            || !int.TryParse(overColumn, out var overIndex)
            || activeIndex < 0 || activeIndex >= ColumnIds.Length
            || overIndex < 0 || overIndex >= ColumnIds.Length)
        {
            return Task.CompletedTask;
        }

        var activeName = ColumnIds[activeIndex];
        var targetName = ColumnIds[overIndex];
        var from = _columnOrder.IndexOf(activeName);
        var to = _columnOrder.IndexOf(targetName);
        if (from < 0 || to < 0 || from == to)
            return Task.CompletedTask;

        _columnOrder.RemoveAt(from);
        _columnOrder.Insert(to, activeName);
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_sortableModule is not null)
        {
            try
            {
                if (_sortableInitialized)
                    await _sortableModule.InvokeVoidAsync("disposeTableColumnSortable", _tableRef.Current);
                await _sortableModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disposed the Blazor circuit.
            }
        }

        _dotNetReference?.Dispose();
    }

    private sealed record Row(string Key, string Name, string Gender, int Age, string Email, string Address);
}
