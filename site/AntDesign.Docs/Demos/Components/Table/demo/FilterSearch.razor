@using AntDesign.Filters
@using AntDesign.TableModels

<Table TItem="FilterRow" DataSource="VisibleRows" RowKey="row=>row.Key" OnChange="OnTableChange">
    <ColumnDefinitions>
        <PropertyColumn Property="row=>row.Name" Title="Name" Width="30%" Filterable Filtered="@(_selectedNames.Count > 0)">
            <FilterDropdown Context="dropdown">
                @{ dropdown.PreventClose(); }
                <div style="padding:8px 8px 0;min-width:220px">
                    <input class="ant-input-css-var ant-input ant-input-outlined" placeholder="Search in filters" @bind="_nameSearch" @bind:event="oninput" />
                    @foreach (var name in _nameOptions.Where(MatchesName))
                    {
                        <div style="padding:6px 8px"><Checkbox Checked="@_selectedNames.Contains(name)" CheckedChanged="@(value => Toggle(_selectedNames, name, value))">@name</Checkbox></div>
                    }
                    <div style="display:flex;justify-content:space-between;padding:8px">
                        <Button Size="ButtonSize.Small" OnClick="ClearNames">Reset</Button>
                        <Button Type="ButtonType.Primary" Size="ButtonSize.Small" OnClick="()=>Apply(dropdown)">OK</Button>
                    </div>
                </div>
            </FilterDropdown>
        </PropertyColumn>
        <PropertyColumn Property="row=>row.Age" Title="Age" Sortable SorterCompare="(left,right)=>left-right" />
        <PropertyColumn Property="row=>row.Address" Title="Address" Width="40%" Filterable Filtered="@(_selectedAddresses.Count > 0)">
            <FilterDropdown Context="dropdown">
                @{ dropdown.PreventClose(); }
                <div style="padding:8px 8px 0;min-width:220px">
                    <input class="ant-input-css-var ant-input ant-input-outlined" placeholder="Search in filters" @bind="_addressSearch" @bind:event="oninput" />
                    @foreach (var address in _addressOptions.Where(MatchesAddress))
                    {
                        <div style="padding:6px 8px"><Checkbox Checked="@_selectedAddresses.Contains(address)" CheckedChanged="@(value => Toggle(_selectedAddresses, address, value))">@address</Checkbox></div>
                    }
                    <div style="display:flex;justify-content:space-between;padding:8px">
                        <Button Size="ButtonSize.Small" OnClick="ClearAddresses">Reset</Button>
                        <Button Type="ButtonType.Primary" Size="ButtonSize.Small" OnClick="()=>Apply(dropdown)">OK</Button>
                    </div>
                </div>
            </FilterDropdown>
        </PropertyColumn>
    </ColumnDefinitions>
</Table>

@code {
    private readonly FilterRow[] _data =
    [
        new("1", "John Brown", 32, "New York No. 1 Lake Park"),
        new("2", "Jim Green", 42, "London No. 1 Lake Park"),
        new("3", "Joe Black", 32, "Sydney No. 1 Lake Park"),
        new("4", "Jim Red", 32, "London No. 2 Lake Park")
    ];
    private readonly string[] _nameOptions = ["Joe", "Jim", "John"];
    private readonly string[] _addressOptions = ["London", "New York"];
    private readonly HashSet<string> _selectedNames = new(StringComparer.Ordinal);
    private readonly HashSet<string> _selectedAddresses = new(StringComparer.Ordinal);
    private string _nameSearch = "";
    private string _addressSearch = "";
    private List<FilterRow> _visibleRows;
    private IEnumerable<FilterRow> VisibleRows => _visibleRows is null ? _data : _visibleRows;

    private bool MatchesName(string value) => string.IsNullOrWhiteSpace(_nameSearch) || value.Contains(_nameSearch, StringComparison.OrdinalIgnoreCase);
    private bool MatchesAddress(string value) => string.IsNullOrWhiteSpace(_addressSearch) || value.Contains(_addressSearch, StringComparison.OrdinalIgnoreCase);
    private static void Toggle(HashSet<string> selected, string value, bool isSelected)
    {
        if (isSelected) selected.Add(value);
        else selected.Remove(value);
    }
    private void ClearNames() => _selectedNames.Clear();
    private void ClearAddresses() => _selectedAddresses.Clear();
    private void Apply(TableFilterDropdownContext dropdown)
    {
        UpdateRows();
        dropdown.FilterClose();
    }
    private void UpdateRows()
    {
        var rows = _data.AsEnumerable();
        if (_selectedNames.Count > 0)
            rows = rows.Where(row => _selectedNames.Any(name => row.Name.StartsWith(name, StringComparison.OrdinalIgnoreCase)));
        if (_selectedAddresses.Count > 0)
            rows = rows.Where(row => _selectedAddresses.Any(address => row.Address.StartsWith(address, StringComparison.OrdinalIgnoreCase)));
        _visibleRows = rows.ToList();
    }
    private void OnTableChange(QueryModel<FilterRow> query)
    {
        var rows = _visibleRows?.AsQueryable() ?? _data.AsQueryable();
        _visibleRows = query.ExecuteQuery(rows).ToList();
    }

    private sealed record FilterRow(string Key, string Name, int Age, string Address);
}
