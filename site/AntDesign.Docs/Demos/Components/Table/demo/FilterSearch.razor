@using AntDesign.Filters

<Table TItem="FilterRow" DataSource="_data" RowKey="row => row.Key">
    <ColumnDefinitions>
        <PropertyColumn Property="row => row.Name" Title="Name" Width="30%" FilterMode="TableFilterMode.Tree" FilterSearch="true" Filters="_nameFilters" OnFilter="(value, name) => name.StartsWith(value, StringComparison.OrdinalIgnoreCase)" />
        <PropertyColumn Property="row => row.Age" Title="Age" Sortable SorterCompare="(left, right) => left - right" />
        <PropertyColumn Property="row => row.Address" Title="Address" Width="40%" FilterSearch="true" Filters="_addressFilters" OnFilter="(value, address) => address.StartsWith(value, StringComparison.OrdinalIgnoreCase)" />
    </ColumnDefinitions>
</Table>

@code {
    private readonly FilterRow[] _data =
    [
        new("1", "John Brown", 32, "New York No. 1 Lake Park"),
        new("2", "Jim Green", 42, "London No. 1 Lake Park"),
        new("3", "Joe Black", 32, "Sydney No. 1 Lake Park"),
        new("4", "Jim Red", 32, "London No. 2 Lake Park")
    ];

    private readonly TableFilter<string>[] _nameFilters =
    [
        new() { Text = "Joe", Value = "Joe" },
        new() { Text = "Category 1", Value = "Category 1" },
        new() { Text = "Category 2", Value = "Category 2" }
    ];

    private readonly TableFilter<string>[] _addressFilters =
    [
        new() { Text = "London", Value = "London" },
        new() { Text = "New York", Value = "New York" }
    ];

    private sealed record FilterRow(string Key, string Name, int Age, string Address);
}
