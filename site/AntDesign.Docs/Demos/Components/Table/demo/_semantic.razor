<SemanticDomPreview Component="table">
    <Table TItem="SemanticTableRow" DataSource="_data" RowKey="row => row.Key"
           Bordered="true" Size="TableSize.Medium" PageSize="3" Total="6"
           Title="table title" Footer="table footer"
           ClassNames="_classNames" Styles="_styles">
        <HeaderTemplate Context="row">
            <TableRow>
                <SimpleTableHeader ColSpan="2">Personal Info</SimpleTableHeader>
                <TableHeader @bind-Field="row.Address" />
            </TableRow>
            <TableRow>
                <TableHeader @bind-Field="row.Name" />
                <TableHeader @bind-Field="row.Age" />
            </TableRow>
        </HeaderTemplate>
        <ColumnDefinitions Context="row">
            <PropertyColumn Property="row => row.Name" Title="Name" />
            <PropertyColumn Property="row => row.Age" Title="Age" />
            <PropertyColumn Property="row => row.Address" Title="Address" />
        </ColumnDefinitions>
    </Table>
</SemanticDomPreview>

@code {
    private static readonly SemanticTableRow[] _data =
    [
        new() { Key = "1", Name = "thinkasany", Age = 24, Address = "New York No. 1 Lake Park" },
