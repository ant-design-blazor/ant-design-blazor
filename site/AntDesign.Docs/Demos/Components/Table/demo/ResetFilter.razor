@using AntDesign.Filters

<Space Style="margin-bottom:16px">
    <SpaceItem><Button OnClick="SortAge">Sort age</Button></SpaceItem>
    <SpaceItem><Button OnClick="ClearFilters">Clear filters</Button></SpaceItem>
    <SpaceItem><Button OnClick="ClearAll">Clear filters and sorters</Button></SpaceItem>
</Space>

<Table @key="_tableInstance" TItem="ResetFilterRow" DataSource="_data" RowKey="row=>row.Key">
    <ColumnDefinitions>
        <PropertyColumn Property="row=>row.Name" Title="Name" Filters="_nameFilters"
                        OnFilter="(value, name) => name.Contains(value, StringComparison.Ordinal)"
                        Sortable SorterCompare="(left,right)=>left.Length-right.Length" Ellipsis />
        <PropertyColumn Property="row=>row.Age" Title="Age" Sortable
                        SorterCompare="(left,right)=>left-right"
                        DefaultSortOrder="@(_sortAge ? SortDirection.Descending : null)" Ellipsis />
        <PropertyColumn Property="row=>row.Address" Title="Address" Filters="_addressFilters"
                        OnFilter="(value, address) => address.Contains(value, StringComparison.Ordinal)"
                        Sortable SorterCompare="(left,right)=>left.Length-right.Length" Ellipsis />
    </ColumnDefinitions>
</Table>

@code {
    private readonly ResetFilterRow[] _data =
    [
        new("1", "John Brown", 32, "New York No. 1 Lake Park"),
        new("2", "Jim Green", 42, "London No. 1 Lake Park"),
        new("3", "Joe Black", 32, "Sydney No. 1 Lake Park"),
        new("4", "Jim Red", 32, "London No. 2 Lake Park")
    ];
    private readonly TableFilter<string>[] _nameFilters =
    [
        new() { Text = "Joe", Value = "Joe" },
        new() { Text = "Jim", Value = "Jim" }
    ];
    private readonly TableFilter<string>[] _addressFilters =
    [
        new() { Text = "London", Value = "London" },
        new() { Text = "New York", Value = "New York" }
    ];
    private int _tableInstance;
    private bool _sortAge;
    private void SortAge()
    {
        _sortAge = true;
        _tableInstance++;
    }

    private void ClearFilters()
    {
        ClearSelected(_nameFilters);
        ClearSelected(_addressFilters);
        _tableInstance++;
    }

    private void ClearAll()
    {
        ClearFilters();
        _sortAge = false;
        _tableInstance++;
    }

    private static void ClearSelected(IEnumerable<TableFilter<string>> filters)
    {
        foreach (var filter in filters)
        {
            filter.Selected = false;
        }
    }

    private sealed record ResetFilterRow(string Key, string Name, int Age, string Address);
}
