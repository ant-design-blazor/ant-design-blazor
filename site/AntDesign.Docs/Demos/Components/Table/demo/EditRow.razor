<Table TItem="ItemData" DataSource="_data" RowKey="row => row.Key" RowClassName="@(_ => "editable-row")" Bordered
       OnPageIndexChange="OnPageIndexChange">
    <PropertyColumn Property="row => row.Name" Title="name" Width="25%">
        @if (IsEditing(context))
        {
            <Input TValue="string" @bind-Value="_editing.Name" />
            @if (_validationMessage == "Please Input name!")
            {
                <div class="ant-form-item-explain-error">@_validationMessage</div>
            }
        }
        else
        {
            @context.Name
        }
    </PropertyColumn>
    <PropertyColumn Property="row => row.Age" Title="age" Width="15%">
        @if (IsEditing(context))
        {
            <InputNumber TValue="int" DefaultValue="_editing.Age" OnChange="AgeChanged" />
            @if (_validationMessage == "Please Input age!")
            {
                <div class="ant-form-item-explain-error">@_validationMessage</div>
            }
        }
        else
        {
            @context.Age
        }
    </PropertyColumn>
    <PropertyColumn Property="row => row.Address" Title="address" Width="40%">
        @if (IsEditing(context))
        {
            <Input TValue="string" @bind-Value="_editing.Address" />
            @if (_validationMessage == "Please Input address!")
            {
                <div class="ant-form-item-explain-error">@_validationMessage</div>
            }
        }
        else
        {
            @context.Address
        }
    </PropertyColumn>
    <ActionColumn Title="operation">
        @if (IsEditing(context))
        {
            <a @onclick="Save">Save</a>
            <span style="margin-inline-end: 8px;"></span>
            <Popconfirm Title="Sure to cancel?" OnConfirm="Cancel" OkText="Yes" CancelText="No">
                <a>Cancel</a>
            </Popconfirm>
        }
        else
        {
            <a aria-disabled="@(_editingKey is not null)" class="@(_editingKey is not null ? "ant-typography-disabled" : null)"
               @onclick="() => StartEdit(context)">Edit</a>
        }
    </ActionColumn>
</Table>

<style>
    .editable-row { position: relative; }
    .ant-form-item-explain-error { position: absolute; top: 100%; font-size: var(--ant-font-size-sm, 12px); }
</style>

@code {
    private readonly List<ItemData> _data = Enumerable.Range(0, 100)
        .Select(index => new ItemData(index.ToString(), $"Edward {index}", 32, $"London Park no. {index}"))
        .ToList();
    private string _editingKey;
    private ItemData _editing;
    private string _validationMessage;

    private bool IsEditing(ItemData row) => row.Key == _editingKey;

    private void StartEdit(ItemData row)
    {
        if (_editingKey is not null) return;
        _editingKey = row.Key;
        _editing = new ItemData(row.Key, row.Name, row.Age, row.Address);
        _validationMessage = null;
    }

    private void Save()
    {
        if (_editing is null) return;
        if (string.IsNullOrWhiteSpace(_editing.Name))
        {
            _validationMessage = "Please Input name!";
            return;
        }
        if (_editing.Age <= 0)
        {
            _validationMessage = "Please Input age!";
            return;
        }
        if (string.IsNullOrWhiteSpace(_editing.Address))
        {
            _validationMessage = "Please Input address!";
            return;
        }

        var index = _data.FindIndex(item => item.Key == _editingKey);
        if (index >= 0) _data[index] = _editing;
        _editingKey = null;
        _editing = null;
        _validationMessage = null;
    }

    private void AgeChanged(int value) => _editing.Age = value;

    private void Cancel()
    {
        _editingKey = null;
        _editing = null;
        _validationMessage = null;
    }

    private void OnPageIndexChange(PaginationEventArgs _) => Cancel();

    private sealed class ItemData
    {
        public ItemData(string key, string name, int age, string address)
        {
            Key = key;
            Name = name;
            Age = age;
            Address = address;
        }

        public string Key { get; }
        public string Name { get; set; }
        public int Age { get; set; }
        public string Address { get; set; }
    }
}
