<Table TItem="Row" DataSource="_rows" RowKey="row => row.Key" ScrollX="max-content" HidePagination TableLayout="auto">
    <ColumnDefinitions>
        <PropertyColumn Property="row => row.Name" Title="Full Name" Width="100" Fixed="ColumnFixPlacement.Left" />
        <PropertyColumn Property="row => row.Age" Width="100" Fixed="ColumnFixPlacement.Left" Sortable />
        @for (var index = 1; index <= 20; index++)
        {
            <PropertyColumn @key="index" Property="row => row.Address" Title="@($"Column {index}")" />
        }
        <ActionColumn Title="Action" Width="100" Fixed="ColumnFixPlacement.Right">
            <a>action</a>
        </ActionColumn>
    </ColumnDefinitions>
</Table>

@code {
    private readonly Row[] _rows =
    [
        new("1", "Olivia", 32, "New York Park"),
        new("2", "Ethan", 40, "London Park")
    ];

    private sealed record Row(string Key, string Name, int Age, string Address);
}
