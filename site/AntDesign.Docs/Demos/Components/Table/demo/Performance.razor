<Space Wrap="true">
    <SpaceItem>
        <Button OnClick="AddColumn">Add column</Button>
    </SpaceItem>
    <SpaceItem>
        <Button OnClick="AddRow">Add row</Button>
    </SpaceItem>
    <SpaceItem>
        <span>@_rows.Count rows × @_columns.Count columns (@(_rows.Count * _columns.Count) data cells)</span>
    </SpaceItem>
</Space>

<Table TItem="Dictionary<string, string>"
       DataSource="@_rows"
       Bordered
       Size="TableSize.Small"
       ScrollX="@_scrollX"
       ScrollY="400px"
       EnableVirtualization
       PageSize="@_rows.Count">
    <Selection Fixed="left" />
    @for (var index = 0; index < _columns.Count; index++)
    {
        var column = _columns[index];
        <Column @key="column"
                TData="string"
                DataIndex="@($"['{column}']")"
                Title="@column"
                Width="120"
                Fixed="@(index < FixedColumnCount ? "left" : null)" />
    }
    <ActionColumn Fixed="right">
        <Button>Action</Button>
    </ActionColumn>
</Table>

@code {
    private const int InitialColumnCount = 80;
    private const int InitialRowCount = 20;
    private const int FixedColumnCount = 2;
    private const int ColumnWidth = 120;

    private readonly List<string> _columns = new();
    private readonly List<Dictionary<string, string>> _rows = new();
    private string _scrollX;

    protected override void OnInitialized()
    {
        for (var index = 0; index < InitialColumnCount; index++)
        {
            _columns.Add($"c{index}");
        }

        for (var index = 0; index < InitialRowCount; index++)
        {
            _rows.Add(CreateRow(index));
        }

        UpdateScrollWidth();
    }

    private void AddColumn()
    {
        var column = $"c{_columns.Count}";
        _columns.Add(column);

        for (var rowIndex = 0; rowIndex < _rows.Count; rowIndex++)
        {
            _rows[rowIndex][column] = GetCellValue(rowIndex, column);
        }

        UpdateScrollWidth();
    }

    private void AddRow()
    {
        _rows.Add(CreateRow(_rows.Count));
    }

    private Dictionary<string, string> CreateRow(int rowIndex)
    {
        var row = new Dictionary<string, string>();
        foreach (var column in _columns)
        {
            row[column] = GetCellValue(rowIndex, column);
        }

        return row;
    }

    private static string GetCellValue(int rowIndex, string column)
    {
        return $"r{rowIndex}-{column}";
    }

    private void UpdateScrollWidth()
    {
        _scrollX = $"{_columns.Count * ColumnWidth}px";
    }
}
