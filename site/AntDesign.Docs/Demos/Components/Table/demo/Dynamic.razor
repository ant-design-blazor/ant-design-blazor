@using AntDesign.Core
@using System.Text.Json.Serialization

<Table TItem="Dictionary<string, object>" DataSource="@data" Loading="loading" ScrollX="1500"
    PageSize="5" Size="TableSize.Small">
    @foreach (var key in data?.FirstOrDefault()?.Keys.Take(10) ?? new string[0])
    {
        <PropertyColumn Filterable Sortable Property=@(c=>c[key]) Title="@key" />
    }
</Table>

@if (loadError != null)
{
    <p class="ant-typography ant-typography-danger">@loadError</p>
}

@inject HttpClient httpClient
@code {
    private const string DataUrl = "data/table-contributors.json";

    private List<Dictionary<string, object>> data;
    private bool loading = true;
    private string loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = new JsonSerializerOptions();
            options.Converters.Add(new DictionaryConverter());
            data = await httpClient.GetFromJsonAsync<List<Dictionary<string, object>>>(DataUrl, options);
            data ??= new List<Dictionary<string, object>>();
        }
        catch (Exception exception)
        {
            loadError = $"Unable to load table data: {exception.Message}";
            data = new List<Dictionary<string, object>>();
        }
        finally
        {
            loading = false;
        }
    }
}
