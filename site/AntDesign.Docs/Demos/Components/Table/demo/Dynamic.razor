@using AntDesign.Core

<Table TItem="Dictionary<string, object>" DataSource="@data" Loading="data==null" ScrollX="1500"
    PageSize="5" Size="TableSize.Small">
    @foreach (var key in data?.FirstOrDefault()?.Keys.Take(10) ?? new string[0])
    {
        <PropertyColumn Filterable Sortable Property=@(c=>c[key]) Title="@key" />
    }
</Table>

@code {

    private const string JsonData = """
        [
          { "id": 1001, "login": "jamesyeung", "contributions": 128, "type": "User", "site_admin": true, "html_url": "https://github.com/jamesyeung" },
          { "id": 1002, "login": "alice-dev", "contributions": 86, "type": "User", "site_admin": false, "html_url": "https://github.com/alice-dev" },
          { "id": 1003, "login": "blazor-fan", "contributions": 52, "type": "User", "site_admin": false, "html_url": "https://github.com/blazor-fan" },
          { "id": 1004, "login": "design-system", "contributions": 41, "type": "Organization", "site_admin": false, "html_url": "https://github.com/design-system" },
          { "id": 1005, "login": "table-expert", "contributions": 27, "type": "User", "site_admin": false, "html_url": "https://github.com/table-expert" },
          { "id": 1006, "login": "community-member", "contributions": 13, "type": "User", "site_admin": false, "html_url": "https://github.com/community-member" }
        ]
        """;

    List<Dictionary<string, object>> data;

    protected override void OnInitialized()
    {
        var options = new JsonSerializerOptions();
        options.Converters.Add(new DictionaryConverter());
        data = JsonSerializer.Deserialize<List<Dictionary<string, object>>>(JsonData, options);
    }
}
