@using AntDesign.TableModels

<Table TItem="Data" DataSource="@data" RowKey="@(row => row.Key)" Bordered>
  <ColumnDefinitions>
    <PropertyColumn Property="row => row.Key" Title="RowHead" RowScope="row" />
    <PropertyColumn Property="row => row.Name" Title="Name" CellRender="RenderName" OnCell="OnNameCell" />
    <PropertyColumn Property="row => row.Age" Title="Age" OnCell="OnAgeCell" />
    <PropertyColumn Property="row => row.Tel" Title="Home phone" HeaderColSpan="2" OnCell="OnTelCell" />
    <PropertyColumn Property="row => row.Phone" Title="Phone" HeaderColSpan="0" OnCell="OnPhoneCell" />
    <PropertyColumn Property="row => row.Address" Title="Address" OnCell="OnAddressCell" />
  </ColumnDefinitions>
</Table>

@code {
  private static RenderFragment<CellData<string>> RenderName => cell => builder =>
  {
    builder.OpenElement(0, "a");
    builder.AddContent(1, cell.FieldValue);
    builder.CloseElement();
  };

  private readonly Data[] data =
  [
    new() { Key = "1", Name = "John Brown", Age = 32, Tel = "0571-22098909", Phone = 18889898989, Address = "New York No. 1 Lake Park" },
    new() { Key = "2", Name = "Jim Green", Age = 42, Tel = "0571-22098333", Phone = 18889898888, Address = "London No. 1 Lake Park" },
    new() { Key = "3", Name = "Joe Black", Age = 32, Tel = "0575-22098909", Phone = 18900010002, Address = "Sydney No. 1 Lake Park" },
    new() { Key = "4", Name = "Jim Red", Age = 18, Tel = "0575-22098909", Phone = 18900010002, Address = "London No. 2 Lake Park" },
    new() { Key = "5", Name = "Jake White", Age = 18, Tel = "0575-22098909", Phone = 18900010002, Address = "Dublin No. 2 Lake Park" }
  ];

  private static Dictionary<string, object> OnNameCell(CellData cell) =>
    cell.RowData.DataKey == "2" ? new() { ["colspan"] = 5 } : null;

  private static Dictionary<string, object> OnAgeCell(CellData cell) =>
    cell.RowData.DataKey == "2" ? new() { ["colspan"] = 0 } : null;

  private static Dictionary<string, object> OnTelCell(CellData cell)
  {
    if (cell.RowData.DataKey == "2") return new() { ["colspan"] = 0 };
    if (cell.RowData.DataKey == "4") return new() { ["rowspan"] = 2 };
    if (cell.RowData.DataKey == "5") return new() { ["rowspan"] = 0 };
    return null;
  }

  private static Dictionary<string, object> OnPhoneCell(CellData cell) =>
    cell.RowData.DataKey == "2" ? new() { ["colspan"] = 0 } : null;

  private static Dictionary<string, object> OnAddressCell(CellData cell) =>
    cell.RowData.DataKey == "2" ? new() { ["colspan"] = 0 } : null;

  public sealed class Data
  {
    public string Key { get; set; }
    public string Name { get; set; }
    public int Age { get; set; }
    public string Tel { get; set; }
    public long Phone { get; set; }
    public string Address { get; set; }
  }
}
