@using System.ComponentModel

<Table DataSource="@data" RowKey="item => item.Key" Bordered="true" Title="@title" Footer="@footer">
  <PropertyColumn Property="c=>c.Name" Title="Name">
    <a>@context.Name</a>
  </PropertyColumn>
  <PropertyColumn Property="c=>c.Money" Title="Cash Assets" ClassName="column-money" Align="ColumnAlign.Right" />
  <PropertyColumn Property="c=>c.Address" Title="Address" />
</Table>

@code {

  string title = "Header";
  string footer = "Footer";

  Data[] data =
  {
        new Data()
        {
            Key = "1",
            Name = "John Brown",
            Money = "￥300,000.00",
            Address = "New York No. 1 Lake Park",
        },
        new Data()
        {
            Key = "2",
            Name = "Jim Green",
            Money = "￥1,256,000.00",
            Address = "London No. 1 Lake Park",
        },
        new Data()
        {
            Key = "3",
            Name = "Joe Black",
            Money = "￥120,000.00",
            Address = "Sydney No. 1 Lake Park",
        }
  };

  public class Data
  {
    [DisplayName("Key")]
    public string Key { get; set; }

    [DisplayName("Name")]
    public string Name { get; set; }

    [DisplayName("Money")]
    public string Money { get; set; }

    [DisplayName("Address")]
    public string Address { get; set; }
  }
}
