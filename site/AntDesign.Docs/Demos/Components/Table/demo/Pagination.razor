<div>
    <RadioGroup Options="@_topOptions" @bind-Value="_topPlacement" Style="margin-bottom:10px;" />
    <RadioGroup Options="@_bottomOptions" @bind-Value="_bottomPlacement" Style="margin-bottom:10px;" />
    <Table TItem="PaginationRow" DataSource="@_rows" RowKey="x => x.Key" PaginationPlacement="@_paginationPlacement">
        <PropertyColumn Property="x => x.Name" Title="Name"><a>@context.Name</a></PropertyColumn>
        <PropertyColumn Property="x => x.Age" Title="Age" />
        <PropertyColumn Property="x => x.Address" Title="Address" />
        <PropertyColumn Property="x => x.Tags" Title="Tags">
            <Flex Gap="FlexGap.Small" Align="FlexAlign.Center" Wrap="FlexWrap.Wrap">
                @foreach (var tag in context.Tags)
                {
                    var color = tag.Length > 5 ? TagColor.GeekBlue : TagColor.Green;
                    if (tag == "kawaii")
                    {
                        color = TagColor.Volcano;
                    }
                    <Tag Color="@color">@tag.ToUpperInvariant()</Tag>
                }
            </Flex>
        </PropertyColumn>
        <ActionColumn Title="Action">
            <Space Size="SpaceSize.Middle">
                <SpaceItem><a>Invite @context.Name</a></SpaceItem>
                <SpaceItem><a>Delete</a></SpaceItem>
            </Space>
        </ActionColumn>
    </Table>
</div>

@code {
    private readonly string[] _topOptions = ["topStart", "topCenter", "topEnd", "none"];
    private readonly string[] _bottomOptions = ["bottomStart", "bottomCenter", "bottomEnd", "none"];
    private string _topPlacement = "topStart";
    private string _bottomPlacement = "bottomEnd";
    private string[] _paginationPlacement => [_topPlacement, _bottomPlacement];

    private readonly PaginationRow[] _rows =
    [
        new("1", "John Brown", 32, "New York No. 1 Lake Park", ["nice", "developer"]),
        new("2", "Jim Green", 42, "London No. 1 Lake Park", ["kawaii"]),
        new("3", "Joe Black", 32, "Sydney No. 1 Lake Park", ["cool", "teacher"])
    ];

    private sealed record PaginationRow(string Key, string Name, int Age, string Address, string[] Tags);
}
