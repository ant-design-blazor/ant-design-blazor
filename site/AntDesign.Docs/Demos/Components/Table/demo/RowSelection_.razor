<div>
    <RadioGroup @bind-Value="_selectionType">
        <Radio Value="SelectionType.Checkbox">Checkbox</Radio>
        <Radio Value="SelectionType.Radio">radio</Radio>
    </RadioGroup>
    <Divider />
    <Table TItem="Row" DataSource="_rows" RowKey="x => x.Key" @bind-SelectedRows="_selectedRows">
        <Selection Type="_selectionType" Disabled="@(context.Name == "Disabled User")" />
        <PropertyColumn Property="x => x.Name" Title="Name"><a>@context.Name</a></PropertyColumn>
        <PropertyColumn Property="x => x.Age" Title="Age" />
        <PropertyColumn Property="x => x.Address" Title="Address" />
    </Table>
</div>

@code {
    private SelectionType _selectionType = SelectionType.Checkbox;
    private IEnumerable<Row> _selectedRows = [];
    private readonly Row[] _rows =
    [
        new("1", "John Brown", 32, "New York No. 1 Lake Park"),
        new("2", "Jim Green", 42, "London No. 1 Lake Park"),
        new("3", "Joe Black", 32, "Sydney No. 1 Lake Park"),
        new("4", "Disabled User", 99, "Sydney No. 1 Lake Park")
    ];

    private sealed record Row(string Key, string Name, int Age, string Address);
}
