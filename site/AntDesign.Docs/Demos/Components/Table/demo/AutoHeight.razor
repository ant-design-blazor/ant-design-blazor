@implements IAsyncDisposable
@inject IJSRuntime JS

<Flex Vertical Gap="FlexGap.Middle" Align="FlexAlign.Start">
    <Switch Checked="_hasData"
            CheckedChanged="value => _hasData = value"
            CheckedChildren="More Data"
            UnCheckedChildren="More Data" />
    <div @ref="_container" style="height:400px; box-sizing:border-box; background:rgba(140, 140, 140, 0.03); padding:16px; align-self:stretch;">
        <Table TItem="AutoHeightRow" DataSource="CurrentData" RowKey="row => row.Key" ScrollY="0px" Style="height:100%;" ClassNames="TableClassNames">
            <PropertyColumn Property="row => row.Name" Title="Name" Width="20%" />
            <PropertyColumn Property="row => row.Age" Title="Age" Width="20%" />
            <PropertyColumn Property="row => row.Address" Title="Address" Width="60%" />
        </Table>
    </div>
</Flex>

@code {
    private static readonly IReadOnlyDictionary<string, string> TableClassNames = new Dictionary<string, string>
    {
        ["header.wrapper"] = "measure-header",
        ["pagination.root"] = "measure-pagination"
    };

    private bool _hasData = true;
    private ElementReference _container;
    private IJSObjectReference _module;

    private IEnumerable<AutoHeightRow> CurrentData => Enumerable.Range(0, _hasData ? 30 : 2)
        .Select(index => new AutoHeightRow(index, $"Edward King {index}", 32 + index, $"London, Park Lane no. {index}"));

    private sealed record AutoHeightRow(int Key, string Name, int Age, string Address);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AntDesign.Docs/js/table-auto-height.js?v=20261117");
        await _module.InvokeVoidAsync("observeAutoHeight", _container);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is null)
        {
            return;
        }

        await _module.InvokeVoidAsync("unobserveAutoHeight", _container);
        await _module.DisposeAsync();
    }
}
