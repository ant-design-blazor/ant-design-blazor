<Alert Message="Success Tips" Type="AlertType.Success" ShowIcon Closable>
    <Action>
        <Button Size="ButtonSize.Small" Type="ButtonType.Text">UNDO</Button>
    </Action>
</Alert>
<br />
<Alert Message="Error Text" Type="AlertType.Error" Description="Error Description Error Description Error Description Error Description" ShowIcon>
    <Action>
        <Button Size="ButtonSize.Small" Danger>Detail</Button>
    </Action>
</Alert>
<br />
<Alert Message="Warning Text" Type="AlertType.Warning" ShowIcon Closable>
    <Action>
        <Button Size="ButtonSize.Small" Type="ButtonType.Text">Done</Button>
    </Action>
</Alert>
<br />
<Alert Message="Info Text" Type="AlertType.Info" Description="Info Description Info Description Info Description Info Description" ShowIcon Closable>
    <Action>
        <Flex Vertical Gap="FlexGap.Small" Style="min-width: 80px">
            <Button Size="ButtonSize.Small" Type="ButtonType.Primary" Block>Accept</Button>
            <Button Size="ButtonSize.Small" Danger Ghost Block>Decline</Button>
        </Flex>
    </Action>
</Alert>
