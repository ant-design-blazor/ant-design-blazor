<AntList DataSource="@ListData"
         ItemLayout="ListItemLayout.Vertical"
         Size="ListSize.Large"
         Pagination="@_pagination">
    <ChildContent Context="item">
        <ListItem Extra="@Extra" Actions="@Actions">
            <ListItemMeta Description="@item.Description">
                <AvatarTemplate>
                    <Avatar Src="@item.Avatar" />
                </AvatarTemplate>
                <TitleTemplate>
                    <a href="@item.Href">@item.Title</a>
                </TitleTemplate>
            </ListItemMeta>
            @item.Content
        </ListItem>
    </ChildContent>
    <Footer>
        <div>
            <b>ant design</b> footer part
        </div>
    </Footer>
</AntList>

@code {
    private readonly PaginationOptions _pagination = new() { PageSize = 3 };

    private readonly IReadOnlyList<DataModel> ListData = Enumerable.Range(0, 23)
        .Select(index => new DataModel(
            "https://ant.design",
            $"ant design part {index}",
            $"https://api.dicebear.com/10.x/lorelei/svg?seed={index}",
            "Ant Design, a design language for background applications, is refined by Ant UED Team.",
            "We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently."))
        .ToArray();

    private static readonly RenderFragment Extra = @<img draggable="false" width="272" alt="logo" src="https://gw.alipayobjects.com/zos/rmsportal/mqaQswcyDLcXyDKnZfES.png" />;

    private static readonly RenderFragment[] Actions =
    [
        Action(IconType.Outline.Star, "156"),
        Action(IconType.Outline.Like, "156"),
        Action(IconType.Outline.Message, "2")
    ];

    private static RenderFragment Action(string icon, string text) => @<Space>
        <SpaceItem><Icon Type="@icon" /></SpaceItem>
        <SpaceItem>@text</SpaceItem>
    </Space>;

    private sealed record DataModel(string Href, string Title, string Avatar, string Description, string Content);
}
