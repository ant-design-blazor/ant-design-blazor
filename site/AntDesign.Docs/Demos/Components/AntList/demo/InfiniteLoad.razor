@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="scrollableDiv" class="demo-infinite-scroll" @ref="_scrollContainer">
    <AntList TItem="UserItem" DataSource="_users" ItemLayout="ListItemLayout.Horizontal">
        <ChildContent Context="item">
            <ListItem>
                <ListItemMeta AvatarTemplate="@item.Avatar" Description="@item.Email">
                    <TitleTemplate>
                        <a href="https://ant.design">@item.Name</a>
                    </TitleTemplate>
                </ListItemMeta>
                <div>Content</div>
            </ListItem>
        </ChildContent>
        <LoadMore>
            @if (_loading)
            {
                <div class="demo-infinite-scroll-loader">
                    <Skeleton Active Avatar ParagraphRows="1" />
                </div>
            }
            else if (!_hasMore)
            {
                <Divider Plain>It is all, nothing more 🤐</Divider>
            }
        </LoadMore>
    </AntList>
    @if (_hasMore)
    {
        <div class="demo-infinite-scroll-sentinel" @ref="_sentinel" aria-hidden="true"></div>
    }
</div>

<style>
    .demo-infinite-scroll {
        height: 400px;
        overflow: auto;
        padding: 0 16px;
        border: 1px solid rgba(140, 140, 140, 0.35);
    }

    .demo-infinite-scroll-loader {
        padding: 16px 0;
    }

    .demo-infinite-scroll-sentinel {
        height: 1px;
    }
</style>

@code {
    private const int PageSize = 10;
    private const int MaximumItems = 50;
    private readonly List<UserItem> _users = [];
    private ElementReference _scrollContainer;
    private ElementReference _sentinel;
    private IJSObjectReference _module;
    private DotNetObjectReference<InfiniteLoad> _dotNetReference;
    private bool _loading;

    private bool _hasMore => _users.Count < MaximumItems;

    protected override async Task OnInitializedAsync()
    {
        await LoadNextPageAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AntDesign.Docs/js/list-infinite-scroll.js?v=20261113");
            _dotNetReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observeInfiniteScroll", _scrollContainer, _sentinel, _dotNetReference);
        }
    }

    [JSInvokable]
    public async Task LoadNextPageAsync()
    {
        if (_loading || !_hasMore)
        {
            return;
        }

        _loading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(250);

        var start = _users.Count;
        for (var index = start; index < Math.Min(start + PageSize, MaximumItems); index++)
        {
            var number = index + 1;
            var name = $"User {number}";
            var avatar = (RenderFragment)(builder => builder.AddContent(0, $"U{number:00}"));
            _users.Add(new UserItem(name, $"user{number:00}@example.com", avatar));
        }

        _loading = false;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnectInfiniteScroll", _sentinel);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disposed the page circuit.
            }
        }

        _dotNetReference?.Dispose();
    }

    private sealed record UserItem(string Name, string Email, RenderFragment Avatar);
}
