@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IMessageService MessageService

<div class="demo-infinite-virtual-list" @ref="_container">
    <div aria-hidden="true" style="height: @(_topSpacerHeight)px"></div>
    <AntList TItem="UserItem" DataSource="_visibleUsers">
        <ChildContent Context="item">
            <ListItem>
                <ListItemMeta AvatarTemplate="@item.Avatar" Description="@item.Email">
                    <TitleTemplate>
                        <a href="https://ant.design">@item.Name</a>
                    </TitleTemplate>
                </ListItemMeta>
                <div>Content</div>
            </ListItem>
        </ChildContent>
    </AntList>
    <div aria-hidden="true" style="height: @(_bottomSpacerHeight)px"></div>
</div>

<style>
    .demo-infinite-virtual-list {
        height: 400px;
        overflow-y: auto;
    }

    .demo-infinite-virtual-list .ant-list-item {
        box-sizing: border-box;
        height: 47px;
        overflow: hidden;
    }
</style>

@code {
    private const int ContainerHeight = 400;
    private const int ItemHeight = 47;
    private const int PageSize = 20;
    private const int OverscanCount = 5;
    private readonly List<UserItem> _users = [];
    private ElementReference _container;
    private IJSObjectReference _module;
    private DotNetObjectReference<InfiniteVirtualizedLoad> _dotNetReference;
    private int _firstVisibleIndex;
    private int _visibleCount => Math.Min(
        (int)Math.Ceiling((double)ContainerHeight / ItemHeight) + OverscanCount * 2,
        Math.Max(0, _users.Count - _firstVisibleIndex));
    private IReadOnlyList<UserItem> _visibleUsers => _users.Skip(_firstVisibleIndex).Take(_visibleCount).ToArray();
    private int _topSpacerHeight => _firstVisibleIndex * ItemHeight;
    private int _bottomSpacerHeight => Math.Max(0, (_users.Count - _firstVisibleIndex - _visibleCount) * ItemHeight);
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await AppendPageAsync(showMessage: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AntDesign.Docs/js/list-infinite-scroll.js?v=20261113");
            _dotNetReference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("observeVirtualList", _container, _dotNetReference);
        }
    }

    [JSInvokable]
    public async Task OnVirtualScroll(double scrollTop, bool loadMore)
    {
        var firstVisibleIndex = Math.Max(0, (int)Math.Floor(scrollTop / ItemHeight) - OverscanCount);
        if (_firstVisibleIndex != firstVisibleIndex)
        {
            _firstVisibleIndex = firstVisibleIndex;
            await InvokeAsync(StateHasChanged);
        }

        if (loadMore && !_loading)
        {
            await AppendPageAsync(showMessage: true);
        }
    }

    private async Task AppendPageAsync(bool showMessage)
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        await Task.Delay(200);

        var start = _users.Count;
        for (var index = 0; index < PageSize; index++)
        {
            var number = start + index + 1;
            var avatar = (RenderFragment)(builder => builder.AddContent(0, $"U{number:00}"));
            _users.Add(new UserItem($"User {number}", $"user{number:00}@example.com", avatar));
        }

        _loading = false;
        if (showMessage)
        {
            MessageService.Success($"{PageSize} more items loaded!");
        }

        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("disconnectScrollToEnd", _container);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has already disposed the page circuit.
            }
        }

        _dotNetReference?.Dispose();
    }

    private sealed record UserItem(string Name, string Email, RenderFragment Avatar);
}
