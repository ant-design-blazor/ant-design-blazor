<div>
    <Divider ClassNames="@_classNamesObject">classNames Object</Divider>
    <Divider Orientation="DividerOrientation.Left" ClassNamesFunc="@_classNamesFactory">classNames Function</Divider>
    <Divider Styles="@_stylesObject">styles Object</Divider>
    <Divider Size="small" StylesFunc="@_stylesFactory">styles Function</Divider>
</div>

@code {
    private static readonly IReadOnlyDictionary<string, string> _classNamesObject = new Dictionary<string, string>
    {
        ["root"] = "demo-divider-root",
        ["content"] = "demo-divider-content",
        ["rail"] = "demo-divider-rail"
    };

    private static readonly Func<Divider, IReadOnlyDictionary<string, string>> _classNamesFactory = divider =>
        new Dictionary<string, string>
        {
            ["root"] = divider.Orientation == DividerOrientation.Left
                ? "demo-divider-root--start"
                : "demo-divider-root--default"
        };

    private static readonly IReadOnlyDictionary<string, string> _stylesObject = new Dictionary<string, string>
    {
        ["root"] = "border-width: 2px; border-style: dashed;",
        ["content"] = "font-style: italic;",
        ["rail"] = "opacity: 0.85;"
    };

    private static readonly Func<Divider, IReadOnlyDictionary<string, string>> _stylesFactory = divider =>
        string.Equals(divider.Size, "small", StringComparison.OrdinalIgnoreCase)
            ? new Dictionary<string, string> { ["root"] = "opacity: 0.6; cursor: default;" }
            : new Dictionary<string, string> { ["root"] = "background-color: #fafafa; border-color: #d9d9d9;" };
}
