@{
    var classes = new Dictionary<string, string>
    {
        ["root"] = "divider-semantic-root",
        ["content"] = "divider-semantic-content",
        ["rail"] = "divider-semantic-rail"
    };
}

<div>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    <Divider ClassNames="classes" />
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    <Divider ClassNames="classes">Solid</Divider>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    <Divider ClassNames="classes" Orientation="DividerOrientation.Left" Variant="dotted">Dotted</Divider>
    <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    <Divider ClassNames="classes" Orientation="DividerOrientation.Right" Variant="dashed">Dashed</Divider>
