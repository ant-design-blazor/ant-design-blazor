@using AntDesign.Theming

<ConfigProvider ThemeConfig="@_theme">
    <div>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <Divider>Text</Divider>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <Divider Orientation="DividerOrientation.Left">Left Text</Divider>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <Divider Orientation="DividerOrientation.Right">Right Text</Divider>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <Divider Orientation="DividerOrientation.Left" Styles="@_marginZeroStyles">Left Text margin with 0</Divider>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <Divider Orientation="DividerOrientation.Right" Styles="@_marginEdgeStyles">Right Text margin with 50px</Divider>
        <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    </div>
</ConfigProvider>

@code {
    private static readonly ThemeConfig _theme = new()
    {
        Token = new ThemeToken(new Dictionary<string, string>
        {
            ["margin"] = "24",
            ["marginLG"] = "48",
            ["lineWidth"] = "5",
            ["colorSplit"] = "#1677ff"
        }),
        Components =
        {
            ["Divider"] = new Dictionary<string, string>
            {
                ["textPaddingInline"] = "16px",
                ["orientationMargin"] = "0.2",
                ["verticalMarginInline"] = "16px"
            }
        }
    };

    private static readonly IReadOnlyDictionary<string, string> _marginZeroStyles = new Dictionary<string, string>
    {
        ["content"] = "margin: 0px;"
    };

    private static readonly IReadOnlyDictionary<string, string> _marginEdgeStyles = new Dictionary<string, string>
    {
        ["content"] = "margin: 0px 50px;"
    };
}
