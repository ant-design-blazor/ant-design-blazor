<Menu Mode=MenuMode.Horizontal SelectedKeys="@_selectedKeys" SelectedKeysChanged="OnSelectedKeysChanged">
    <MenuItem Key="mail" Icon="@IconType.Outline.Mail">Navigation One</MenuItem>
    <MenuItem Key="app" Icon="@IconType.Outline.Appstore" Disabled>Navigation Two</MenuItem>
    <SubMenu Key="SubMenu" Title="Navigation Three - Submenu" Icon="@IconType.Outline.Setting">
        <MenuItemGroup Title="Item 1">
            <MenuItem Key="setting:1">Option 1</MenuItem>
            <MenuItem Key="setting:2">Option 2</MenuItem>
        </MenuItemGroup>
        <MenuDivider />
        <MenuItemGroup Title="Item 2">
            <MenuItem Key="setting:3">Option 3</MenuItem>
            <SubMenu Title="Option 4">
                <MenuItem Key="setting4:1">Option 1</MenuItem>
                <MenuItem Key="setting4:2">Option 2</MenuItem>
            </SubMenu>
        </MenuItemGroup>
    </SubMenu>
    <MenuItem Key="alipay">
        <MenuLink Href="https://ant.design" Target="@MenuTarget.Blank" rel="noopener noreferrer">
            Navigation Four - Link
        </MenuLink>
    </MenuItem>
</Menu>

@code
{
    private string[] _selectedKeys = ["mail"];

    private Task OnSelectedKeysChanged(string[] keys)
    {
        _selectedKeys = keys;
        return Task.CompletedTask;
    }
}
