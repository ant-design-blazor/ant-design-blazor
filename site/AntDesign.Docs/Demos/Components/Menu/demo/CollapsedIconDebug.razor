@using AntDesign.Theming
<ConfigProvider ThemeConfig="_theme">
    <Menu Class="menu-collapsed-icon-debug" Mode="MenuMode.Inline" InlineCollapsed><MenuExampleItems /></Menu>
</ConfigProvider>
<style>
    .menu-collapsed-icon-debug .ant-menu-item,.menu-collapsed-icon-debug .ant-menu-submenu-title { background:rgba(22,119,255,.06); }
    .menu-collapsed-icon-debug .ant-menu-item-icon { outline:1px solid #ff4d4f;background:rgba(255,77,79,.12); }
    .menu-collapsed-icon-debug .ant-menu-item-icon svg { outline:1px solid #1677ff;background:rgba(22,119,255,.16); }
    .menu-collapsed-icon-debug .ant-menu-title-content { outline:1px dashed #52c41a; }
</style>
@code { private readonly ThemeConfig _theme = new() { Components = new Dictionary<string, IDictionary<string, string>> { ["Menu"] = new Dictionary<string, string> { ["collapsedIconSize"] = "30" } } }; }
