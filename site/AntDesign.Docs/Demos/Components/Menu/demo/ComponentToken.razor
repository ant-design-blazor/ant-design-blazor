@using AntDesign.Theming
<Space Direction="SpaceDirection.Vertical" Style="width:100%">
    <ConfigProvider ThemeConfig="_popupTheme">
        <HorizontalDark />
        <Menu Mode="MenuMode.Inline" Theme="MenuTheme.Dark" InlineCollapsed Style="width:56px" DefaultSelectedKeys="@(new[] { "1" })"><MenuExampleItems /></Menu>
    </ConfigProvider>
    <ConfigProvider ThemeConfig="_horizontalTheme"><Horizontal /></ConfigProvider>
    <ConfigProvider ThemeConfig="_darkTheme">
        <Menu Mode="MenuMode.Inline" Theme="MenuTheme.Dark" Style="width:256px;max-width:100%" DefaultSelectedKeys="@(new[] { "1" })" DefaultOpenKeys="@(new[] { "sub1" })"><MenuExampleItems /></Menu>
    </ConfigProvider>
</Space>
@code {
    private static ThemeConfig Tokens(params (string Key, string Value)[] values) => new() { Components = new Dictionary<string, IDictionary<string, string>> { ["Menu"] = values.ToDictionary(x => x.Key, x => x.Value) } };
    private readonly ThemeConfig _popupTheme = Tokens(("popupBg", "yellow"), ("darkPopupBg", "red"));
    private readonly ThemeConfig _horizontalTheme = Tokens(("horizontalItemBorderRadius", "6"), ("popupBg", "red"), ("horizontalItemHoverBg", "#f5f5f5"));
    private readonly ThemeConfig _darkTheme = Tokens(("darkItemColor", "#91daff"), ("darkItemBg", "#d48806"), ("darkSubMenuItemBg", "#faad14"), ("darkItemSelectedColor", "#ffccc7"), ("darkItemSelectedBg", "#52c41a"));
}
