@using AntDesign.Docs.Shared

<div class="ant-transfer ant-transfer-one-way">
    <TransferSidePanel TItem="TransferOneWayItem" DataSource="_sourceItems" Direction="TransferDirection.Left"
                       Title="Source" KeySelector="item => item.Key" IsItemDisabled="item => item.Disabled"
                       SelectedKeys="_sourceSelectedKeys" Disabled="_disabled" OnItemSelect="OnItemSelect">
        <ItemTemplate Context="item"><span>@item.Title</span></ItemTemplate>
    </TransferSidePanel>
    <div class="ant-transfer-actions">
        <Button Type="ButtonType.Primary" Size="ButtonSize.Small" Disabled="@(_disabled || _sourceSelectedKeys.Count == 0)" OnClick="MoveRight">
            <IconContent><RightOutlined /></IconContent>
        </Button>
    </div>
    <TransferSidePanel TItem="TransferOneWayItem" DataSource="_targetItems" Direction="TransferDirection.Right"
                       Title="Target" KeySelector="item => item.Key" SelectedKeys="_targetSelectedKeys" Selectable="false"
                       Disabled="_disabled" OnItemSelect="OnItemSelect">
        <ItemTemplate Context="item"><span>@item.Title</span></ItemTemplate>
    </TransferSidePanel>
</div>
<br />
<Switch Checked="_disabled" CheckedChanged="value => _disabled = value" UnCheckedChildren="disabled" CheckedChildren="disabled" />

@code {
    private readonly List<TransferOneWayItem> _allItems = Enumerable.Range(0, 20)
        .Select(i => new TransferOneWayItem(i.ToString(), $"content{i + 1}", i % 3 == 0)).ToList();
    private List<string> _targetKeys = Enumerable.Range(0, 20).Where(i => i % 3 == 2).Select(i => i.ToString()).ToList();
    private List<string> _sourceSelectedKeys = [];
    private List<string> _targetSelectedKeys = [];
    private bool _disabled;
    private IReadOnlyList<TransferOneWayItem> _sourceItems => _allItems.Where(item => !_targetKeys.Contains(item.Key)).ToArray();
    private IReadOnlyList<TransferOneWayItem> _targetItems => _allItems.Where(item => _targetKeys.Contains(item.Key)).ToArray();

    private Task OnItemSelect(TransferSideSelection selection)
    {
        if (selection.Direction != TransferDirection.Left) return Task.CompletedTask;
        if (selection.Selected && !_sourceSelectedKeys.Contains(selection.Key)) _sourceSelectedKeys.Add(selection.Key);
        if (!selection.Selected) _sourceSelectedKeys.Remove(selection.Key);
        return Task.CompletedTask;
    }

    private void MoveRight()
    {
        _targetKeys.AddRange(_sourceSelectedKeys.Where(key => !_targetKeys.Contains(key)));
        _sourceSelectedKeys.Clear();
    }

    private sealed record TransferOneWayItem(string Key, string Title, bool Disabled);
}
