<Flex Gap="FlexGap.Large" Vertical Style="width: 100%;">
    <Transfer DataSource="_dataSource"
              TargetKeys="_targetKeys"
              SelectedKeys="_selectedKeys"
              Status="error"
              ClassNames="_classNames"
              Styles="_errorStyles" />
    <Transfer DataSource="_dataSource"
              TargetKeys="_targetKeys"
              SelectedKeys="_selectedKeys"
              Status="warning"
              ClassNames="_classNames"
              Styles="_warningStyles" />
</Flex>

@code {
    private readonly List<TransferItem> _dataSource = Enumerable.Range(1, 8)
        .Select(index => new TransferItem { Key = index.ToString(), Title = $"Content {index}" })
        .ToList();
    private readonly string[] _targetKeys = { "5", "6", "7", "8" };
    private readonly string[] _selectedKeys = Array.Empty<string>();
    private readonly Dictionary<string, string> _classNames = new()
    {
        ["section"] = "transfer-custom-section",
        ["header"] = "transfer-custom-header",
        ["actions"] = "transfer-custom-actions"
    };
    private readonly Dictionary<string, string> _errorStyles = new()
    {
        ["section"] = "background-color: rgba(250, 250, 250, 0.5);",
        ["header"] = "font-weight: bold;"
    };
    private readonly Dictionary<string, string> _warningStyles = new()
    {
        ["section"] = "background-color: rgba(246, 255, 237, 0.6); border-color: #b7eb8f;",
        ["header"] = "color: #8DBCC7; font-weight: normal;"
    };
}
