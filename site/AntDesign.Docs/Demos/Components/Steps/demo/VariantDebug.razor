<Flex Vertical="true" Gap="FlexGap.Middle">
    <Steps Current="@_current" OnChange="SetCurrent">
        <Step Title="Finished" Description="This is a content." />
        <Step Title="In Progress" Description="This is a content." Status="StepsStatus.Error" />
        <Step Title="Waiting" Description="This is a content." />
    </Steps>
    <Steps Current="@_current" OnChange="SetCurrent" Outlined="true">
        <Step Title="Finished" Description="This is a content." />
        <Step Title="In Progress" Description="This is a content." Status="StepsStatus.Error" />
        <Step Title="Waiting" Description="This is a content." />
    </Steps>
    <Steps Current="@_current" Percent="60" Size="StepsSize.Small" Outlined="true">
        <Step Title="Finished" Description="This is a content." />
        <Step Title="In Progress" Description="This is a content." />
        <Step Title="Waiting" Description="This is a content." />
    </Steps>
    <Flex Gap="FlexGap.Middle">
        <Steps Current="@_current" Percent="60" Direction="StepsDirection.Vertical" Outlined="true">
            <Step Title="Finished" Description="This is a content." />
            <Step Title="In Progress" Description="This is a content." />
            <Step Title="Waiting" Description="This is a content." />
        </Steps>
        <Steps Current="@_current" Percent="60" Direction="StepsDirection.Vertical" Size="StepsSize.Small" Outlined="true">
            <Step Title="Finished" Description="This is a content." />
            <Step Title="In Progress" Description="This is a content." />
            <Step Title="Waiting" Description="This is a content." />
        </Steps>
    </Flex>
    <Steps Current="@_current" ShowProgressDot="true" Size="StepsSize.Small" Outlined="true">
        <Step Title="Finished" Description="This is a content." />
        <Step Title="In Progress" Description="This is a content." />
        <Step Title="Waiting" Description="This is a content." />
    </Steps>
</Flex>

@code {
    private int _current = 1;

    private Task SetCurrent(int current)
    {
        _current = current;
        return Task.CompletedTask;
    }
}
