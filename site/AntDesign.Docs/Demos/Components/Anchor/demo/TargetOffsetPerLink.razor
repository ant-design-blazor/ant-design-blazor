        <div style="position:sticky;top:0;height:20px;background:rgba(0,0,0,.85);color:white;z-index:1;">Fixed top block</div>
        <div id="anchor-per-offset-1" style="height:180px;background:rgba(255,0,0,.08)"></div>
        <div id="anchor-per-offset-2" style="height:180px;background:rgba(0,255,0,.08)"></div>
        <div id="anchor-per-offset-3" style="height:180px;background:rgba(0,0,255,.08)"></div>
