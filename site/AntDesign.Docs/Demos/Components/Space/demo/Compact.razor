<div class="site-space-compact-wrapper">
    <SpaceCompact Block>
        <SpaceItem><Input Style=" width: 20%;" DefaultValue="0571" /></SpaceItem>
        <SpaceItem><Input Style="width: 30%" DefaultValue="26888888" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block Size="small">
        <SpaceItem><Input TValue="string" Style="width: calc(100% - 200px);" /></SpaceItem>
        <SpaceItem><Button Type="ButtonType.Primary">Submit</Button></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><Input TValue="string" Style="width: calc(100% - 200px);" /></SpaceItem>
        <SpaceItem><Button Type="ButtonType.Primary">Submit</Button></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><Input TValue="string"
               Style="width: calc(100% - 200px);" /></SpaceItem>
        <SpaceItem><Tooltip Title="copy git url">
            <Button Icon="copy" />
        </Tooltip></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><SimpleSelect DefaultValue="Zhejiang">
            <SimpleSelectOption Value="Zhejiang">Zhejiang</SimpleSelectOption>
            <SimpleSelectOption Value="Jiangsu">Jiangsu</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
        <SpaceItem><Input TValue="string" Style="width: 50%;" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><SimpleSelect Mode="SelectMode.Multiple" DefaultValue="Zhejianggggg" Style=" width: 50%;">
            <SimpleSelectOption Value="Zhejianggggg">Zhejianggggg</SimpleSelectOption>
            <SimpleSelectOption Value="Jiangsu">Jiangsu</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
        <SpaceItem><Input TValue="string" Style=" width: 50%;" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><Search Style="width: 30%;" DefaultValue="0571" /></SpaceItem>
        <SpaceItem><Search AllowClear Style="width: 50%;" DefaultValue="26888888" /></SpaceItem>
        <SpaceItem><Search Style="width: 20%;" DefaultValue="+1" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><SimpleSelect DefaultValue="Option1">
            <SimpleSelectOption Value="Option1">Option1</SimpleSelectOption>
            <SimpleSelectOption Value="Option2">Option2</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
        <SpaceItem><Input TValue="string" Style="width: 50%;" /></SpaceItem>
        <SpaceItem><AntDesign.InputNumber TValue="int" DefaultValue="12" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><Input TValue="string" Style="width: 50%;" /></SpaceItem>
        <SpaceItem><DatePicker TValue="DateTime?" Style="width: 50%;" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><RangePicker TValue="DateTime?[]" Style="width: 70%;" /></SpaceItem>
        <SpaceItem><Input TValue="string" Style="width: 30%;" /></SpaceItem>
        <SpaceItem><Button Type="ButtonType.Primary">查询</Button></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><Input TValue="string" Style=" width: 30%" /></SpaceItem>
        <SpaceItem><RangePicker TValue="DateTime?[]" Style="width: 70%;" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><SimpleSelect TItem="string" TItemValue="string" DefaultValue="Option1-1">
            <SimpleSelectOption Value="Option1-1">Option1-1</SimpleSelectOption>
            <SimpleSelectOption Value="Option1-2">Option1-2</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
        <SpaceItem><SimpleSelect DefaultValue="Option2-2">
            <SimpleSelectOption Value="Option2-1">Option2-1</SimpleSelectOption>
            <SimpleSelectOption Value="Option2-2">Option2-2</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><SimpleSelect TItem="string" TItemValue="string" DefaultValue="1">
            <SimpleSelectOption Value="1">Between</SimpleSelectOption>
            <SimpleSelectOption Value="2">Except</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
        <SpaceItem><Input TValue="string" Style=" width: 100px; text-align: center;" Placeholder="Minimum" /></SpaceItem>
        <SpaceItem><Input TValue="string"
               Class="site-input-split"
               Style=" width: 30px;borderLeft: 0;border-right: 0;pointer-events: none;"
               Placeholder="~"
               Disabled /></SpaceItem>
        <SpaceItem><Input TValue="string"
               Class="site-input-right"
               Style=" width: 100px; text-align: center;"
               Placeholder="Maximum" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><SimpleSelect TItem="string" TItemValue="string" DefaultValue="Sign Up" Style="width: 30%;">
            <SimpleSelectOption Value="Sign Up">Sign Up</SimpleSelectOption>
            <SimpleSelectOption Value="Sign In">Sign In</SimpleSelectOption>
        </SimpleSelect></SpaceItem>
        <SpaceItem><AutoComplete Style="width: 70%;"
                      Placeholder="Email"
                      Options="@(new[]{"text 1","text 2"})" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><TimePicker TValue="DateTime?" Style="width: 70%;" /></SpaceItem>
        <SpaceItem><Cascader Style="width: 70%;"
                  Options="options"
                  Placeholder="SimpleSelect Address" /></SpaceItem>
    </SpaceCompact>
    <br />
    <SpaceCompact Block>
        <SpaceItem><RangePicker TValue="DateTime?[]" /></SpaceItem>
        <SpaceItem><TreeSelect TItem="string" TItemValue="string"
                    Style="width: 60%;"
                    Value="@("leaf1")"
                    DropdownStyle="max-height: 400px; overflow: auto; "
                    Placeholder="Please SimpleSelect"
                        AllowClear
                        TreeDefaultExpandAll>
            <TreeNode TItem="string" Key="parent 1" Title="parent 1">
                <TreeNode TItem="string" Key="parent 1-0" Title="parent 1-0">
                    <TreeNode TItem="string" Key="leaf1" Title="leaf1" />
                    <TreeNode TItem="string" Key="leaf2" Title="leaf2" />
                </TreeNode>
                <TreeNode TItem="string" Key="parent 1-1" Title="parent 1-1">
                    <TreeNode TItem="string" Key="leaf3">
                        <TitleTemplate><b style="color: #08c;">leaf3</b></TitleTemplate>
                    </TreeNode>
                </TreeNode>
            </TreeNode>
        </TreeSelect></SpaceItem>
        <SpaceItem><Button Type="ButtonType.Primary">Submit</Button></SpaceItem>
    </SpaceCompact>
    <br />
</div>

@code {
    List<CascaderNode> options = new List<CascaderNode>()
        {
            new() {
                Value= "zhejiang",
                Label= "Zhejiang",
                Children= new CascaderNode[] {
                 new() {
                    Value= "hangzhou",
                    Label= "Hangzhou",
                    Children= new CascaderNode[]{
                        new() {
                            Value= "xihu",
                            Label= "West Lake",
                        },
        },
                }   ,
    },
            },
            new() {
                Value= "jiangsu",
                Label= "Jiangsu",
                Children=new  CascaderNode[]{

                new() {
                    Value= "nanjing",
                    Label= "Nanjing",
                    Children=new CascaderNode[]{

                      new()   {
                        Value= "zhonghuamen",
                        Label= "Zhong Hua Men",
                        },
            },
                },
     },
          },
    };
}