                    <SpaceCompactItem Position="SpaceCompactItemPosition.First"><Input TValue="string" DefaultValue="@("mysite")" /></SpaceCompactItem>
                    <SpaceCompactItem Position="SpaceCompactItemPosition.Last"><Button Icon="@IconType.Outline.Copy" /></SpaceCompactItem>
                </SpaceCompact>
            </SpaceCompactItem>
