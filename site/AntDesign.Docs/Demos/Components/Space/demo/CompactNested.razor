    </SpaceItem>
    <SpaceItem>
        <SpaceCompact>
            <SpaceCompactItem Position="SpaceCompactItemPosition.First"><Button Type="ButtonType.Primary">Button 1</Button></SpaceCompactItem>
            <SpaceCompactItem Position="SpaceCompactItemPosition.Middle"><Button Type="ButtonType.Primary">Button 2</Button></SpaceCompactItem>
            <SpaceCompactItem Position="SpaceCompactItemPosition.Last"><Button Danger>Button 3</Button></SpaceCompactItem>
        </SpaceCompact>
