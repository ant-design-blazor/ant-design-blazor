<div style="width:360px">
    <Card Title="Activity stream" Style="border-radius:20px 20px 0 0; overflow:hidden; --ant-border-beam-border-radius:20px 20px 0 0">
        <Decoration><BorderBeam Outset="0px" LineWidth="2px" Size="140px" Duration="6" /></Decoration>
        <ChildContent><div style="display:flex; flex-direction:column; gap:16px">
            <span style="color:#8c8c8c">Use a multi-value border radius to keep the beam aligned with non-uniform corners.</span>
            <div style="display:flex; align-items:center; justify-content:space-between">
                <strong>12 running jobs</strong>
                <Button Type="ButtonType.Primary">View queue</Button>
            </div>
        </div></ChildContent>
    </Card>
</div>
