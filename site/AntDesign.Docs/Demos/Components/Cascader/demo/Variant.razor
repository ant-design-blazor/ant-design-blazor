    <Cascader Options="@_options" Placeholder="Please select" Variant="InputVariant.Filled" />
    <Cascader Options="@_options" Placeholder="Please select" Variant="InputVariant.Outlined" />
    <Cascader Options="@_options" Placeholder="Please select" Variant="InputVariant.Underlined" />
</Space>

