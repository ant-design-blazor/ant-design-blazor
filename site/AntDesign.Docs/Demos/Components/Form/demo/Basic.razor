@using System.Text.Json;
@using System.ComponentModel

    <Form Id="basic"
          Model="@model"
          OnFinish="OnFinish"
          OnFinishFailed="OnFinishFailed"
          LabelColSpan="8"
          WrapperColSpan="16"
          Style="max-width: 600px;"
          AutoComplete="off">
        <FormItem Name="Username" Label="Username" Rules="_usernameRules">
            <Input name="@((string)null)" @bind-Value="@context.Username" />
        </FormItem>
        <FormItem Name="Password" Label="Password" Rules="_passwordRules">
            <InputPassword name="@((string)null)" @bind-Value="@context.Password" />
        </FormItem>
        <FormItem Name="RememberMe" Label="" WrapperColOffset="8" WrapperColSpan="16">
            <Checkbox name="@((string)null)" @bind-Value="context.RememberMe">Remember me</Checkbox>
        </FormItem>
        <FormItem WrapperColOffset="8" WrapperColSpan="16">
            <Button Type="ButtonType.Primary" HtmlType="submit">
                Submit
            </Button>
        </FormItem>
    </Form>
@code
{
    public class Model
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; } = true;
    }

    private Model model = new Model();
    private static readonly FormValidationRule[] _usernameRules = [new() { Required = true, Message = "Please input your username!" }];
    private static readonly FormValidationRule[] _passwordRules = [new() { Required = true, Message = "Please input your password!" }];

    private void OnFinish(EditContext editContext)
    {
        Console.WriteLine($"Success:{JsonSerializer.Serialize(model)}");
    }

    private void OnFinishFailed(EditContext editContext)
    {
        Console.WriteLine($"Failed:{JsonSerializer.Serialize(model)}");
    }
}
