@using System.Text.Json

<Form Model="@model" OnFinish="OnFinish" Style="max-width: 600px;" Autocomplete="off">
    @for (var i = 0; i < model.Users.Count; i++)
    {
        var index = i;
        var user = model.Users[index];
        <Space @key="user.Id" Align="SpaceAlign.Baseline" Style="display: flex; margin-bottom: 8px;">
            <SpaceItem>
                <FormItem Required="true">
                    <Input name="@((string)null)" @bind-Value="user.First" Placeholder="First Name" />
                </FormItem>
            </SpaceItem>
            <SpaceItem>
                <FormItem Required="true">
                    <Input name="@((string)null)" @bind-Value="user.Last" Placeholder="Last Name" />
                </FormItem>
            </SpaceItem>
            <SpaceItem>
                <Icon Type="@IconType.Outline.MinusCircle" @onclick="@(() => Remove(index))" />
            </SpaceItem>
        </Space>
    }
    <FormItem>
        <Button Type="ButtonType.Dashed" OnClick="Add" Block Icon="@IconType.Outline.Plus">Add field</Button>
    </FormItem>
    <FormItem>
        <Button Type="ButtonType.Primary" HtmlType="submit">Submit</Button>
    </FormItem>
</Form>

@code {
    private readonly UsersForm model = new();

    private void Add() => model.Users.Add(new User());

    private void Remove(int index) => model.Users.RemoveAt(index);

    private void OnFinish(EditContext editContext)
    {
        if (model.Users.Any(user => string.IsNullOrWhiteSpace(user.First) || string.IsNullOrWhiteSpace(user.Last)))
        {
            return;
        }

        Console.WriteLine($"Received values of form: {JsonSerializer.Serialize(model.Users.Select(user => new { first = user.First, last = user.Last }))}");
    }

    private sealed class UsersForm
    {
        public List<User> Users { get; } = [];
    }

    private sealed class User
    {
        public Guid Id { get; } = Guid.NewGuid();
        public string First { get; set; }
        public string Last { get; set; }
    }
}
