@using System.ComponentModel.DataAnnotations

<Form Model="@model" Id="dynamic_form_item" Autocomplete="@((string)null)" OnFinish="OnFinish" RequiredMark="FormRequiredMark.None" Style="max-width: 600px;">
    @for (var i = 0; i < model.Passengers.Count; i++)
    {
        var index = i;
        var passenger = model.Passengers[index];
        <FormItem @key="passenger.Id"
                  Label="@(index == 0 ? "Passengers" : null)"
                  Required="false"
                  LabelCol="@GetLabelCol(index)"
                  WrapperCol="@GetWrapperCol(index)">
            <Input name="@((string)null)" @bind-Value="passenger.Name" Placeholder="passenger name" Style="width: 60%;" />
            @if (model.Passengers.Count > 1)
            {
                <Icon Type="@IconType.Outline.MinusCircle" Class="dynamic-delete-button" Style="position: relative; top: 4px; margin: 0 8px; color: #999; font-size: 24px; cursor: pointer; transition: all 0.3s;" @onclick="@(() => Remove(index))" />
            }
        </FormItem>
    }
    <FormItem WrapperCol="@GetWrapperCol(null)">
        <Button Type="ButtonType.Dashed" OnClick="@(() => Add())" Style="width: 60%;" Icon="@IconType.Outline.Plus">Add field</Button>
        <Button Type="ButtonType.Dashed" OnClick="@(() => AddAtHead())" Style="width: 60%; margin-top: 20px;" Icon="@IconType.Outline.Plus">Add field at head</Button>
        @if (!string.IsNullOrEmpty(_listError))
        {
            <div class="ant-form-css-var ant-form-item-explain"><div class="ant-form-item-explain-error">@_listError</div></div>
        }
    </FormItem>
    <FormItem WrapperCol="@GetWrapperCol(null)">
        <Button Type="ButtonType.Primary" HtmlType="submit">Submit</Button>
    </FormItem>
</Form>

@code {
    private readonly PassengerForm model = new();
    private string _listError;

    private static ColLayoutParam GetLabelCol(int index) => index == 0
        ? new ColLayoutParam { Xs = new EmbeddedProperty { Span = 24 }, Sm = new EmbeddedProperty { Span = 4 } }
        : null;

    private static ColLayoutParam GetWrapperCol(int? index) => index == 0
        ? new ColLayoutParam { Xs = new EmbeddedProperty { Span = 24 }, Sm = new EmbeddedProperty { Span = 20 } }
        : new ColLayoutParam { Xs = new EmbeddedProperty { Span = 24, Offset = 0 }, Sm = new EmbeddedProperty { Span = 20, Offset = 4 } };

    private void Add(string name = "")
    {
        model.Passengers.Add(new Passenger { Id = Guid.NewGuid(), Name = name });
        UpdateListError();
    }

    private void AddAtHead()
    {
        model.Passengers.Insert(0, new Passenger { Id = Guid.NewGuid(), Name = "The head item" });
        UpdateListError();
    }

    private void Remove(int index)
    {
        model.Passengers.RemoveAt(index);
        UpdateListError();
    }

    private void UpdateListError() => _listError = model.Passengers.Count < 2 ? "At least 2 passengers" : null;

    private void OnFinish(EditContext editContext) { }

    private sealed class PassengerForm
    {
        public List<Passenger> Passengers { get; } = [];
    }

    private sealed class Passenger
    {
        public Guid Id { get; init; }
        [Required(ErrorMessage = "Please input passenger's name or delete this field.")]
        public string Name { get; set; }
    }
}
