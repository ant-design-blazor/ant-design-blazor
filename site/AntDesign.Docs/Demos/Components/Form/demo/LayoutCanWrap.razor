@using System.ComponentModel.DataAnnotations

<Form Model="@_model" LabelColSpan="6" WrapperColSpan="18" LabelAlign="AntLabelAlignType.Left"
      Style="max-width:600px;" AutoComplete="off">
    <FormItem Label="Normal label" Name="Username" Rules="@_required">
        <Input @bind-Value="context.Username" />
    </FormItem>
    <FormItem Label="A super long label text that should wrap within the label column" Name="Password" Rules="@_required"
              LabelStyle="white-space:normal; overflow-wrap:anywhere; line-height:1.5;">
        <InputPassword @bind-Value="context.Password" />
    </FormItem>
    <FormItem Label="A super long label text that can wrap over multiple lines" Name="Optional"
              LabelStyle="white-space:normal; overflow-wrap:anywhere; line-height:1.5;">
        <Input @bind-Value="context.Optional" />
    </FormItem>
    <FormItem WrapperColOffset="6" WrapperColSpan="18">
        <Button Type="ButtonType.Primary" HtmlType="submit">Submit</Button>
    </FormItem>
</Form>

@code {
    private readonly WrapFormModel _model = new();
    private readonly FormValidationRule[] _required = [new() { Required = true }];
    private sealed class WrapFormModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Optional { get; set; } = string.Empty;
    }
}
