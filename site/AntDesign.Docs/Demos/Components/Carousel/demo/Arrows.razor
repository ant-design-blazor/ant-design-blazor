<Carousel Arrows Infinite="false">
    @for (var slide = 1; slide <= 4; slide++)
    {
        <CarouselSlick>
            <h3 style="margin:0;height:160px;color:#fff;line-height:160px;text-align:center;background:#364d79;">@slide</h3>
        </CarouselSlick>
    }
</Carousel>
<br />
<Carousel Arrows DotPlacement="CarouselDotPosition.Start" Infinite="false">
    @for (var slide = 1; slide <= 4; slide++)
    {
        <CarouselSlick>
            <h3 style="margin:0;height:160px;color:#fff;line-height:160px;text-align:center;background:#364d79;">@slide</h3>
        </CarouselSlick>
    }
</Carousel>
