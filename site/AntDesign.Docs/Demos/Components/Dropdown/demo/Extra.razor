<Dropdown>
    <Overlay>
        <Menu>
            <MenuItem Key="1" Disabled>My Account</MenuItem>
            <MenuDivider />
            <MenuItem Key="2">
                <ChildContent>Profile</ChildContent>
                <Extra>⌘P</Extra>
            </MenuItem>
            <MenuItem Key="3">
                <ChildContent>Billing</ChildContent>
                <Extra>⌘B</Extra>
            </MenuItem>
            <MenuItem Key="4" Icon="@IconType.Outline.Setting">
                <ChildContent>Settings</ChildContent>
                <Extra>⌘S</Extra>
            </MenuItem>
        </Menu>
    </Overlay>
    <ChildContent>
        <a class="ant-dropdown-link" @onclick:preventDefault>
            Hover me <Icon Type="@IconType.Outline.Down" />
        </a>
    </ChildContent>
</Dropdown>
