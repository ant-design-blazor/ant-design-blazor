<Dropdown Menu="@_menu">
    <ChildContent>
        <a @onclick:preventDefault>
            <Space>
                <SpaceItem>Hover me</SpaceItem>
                <SpaceItem><Icon Type="@IconType.Outline.Down" /></SpaceItem>
            </Space>
        </a>
    </ChildContent>
</Dropdown>
@code {
    private DropdownMenuOptions _menu;

    protected override void OnInitialized()
    {
        _menu = new DropdownMenuOptions
        {
            Items = new[]
            {
                new DropdownMenuItem { Key = "1", LabelTemplate = FirstLabel },
                new DropdownMenuItem { Key = "2", LabelTemplate = SecondLabel, Icon = "smile", Disabled = true },
                new DropdownMenuItem { Key = "3", LabelTemplate = ThirdLabel, Disabled = true },
                new DropdownMenuItem { Key = "4", Label = "a danger item", Danger = true },
            },
        };
    }

    private RenderFragment FirstLabel => @<a target="_blank" rel="noopener noreferrer" href="https://www.antgroup.com">1st menu item</a>;
    private RenderFragment SecondLabel => @<a target="_blank" rel="noopener noreferrer" href="https://www.aliyun.com">2nd menu item (disabled)</a>;
    private RenderFragment ThirdLabel => @<a target="_blank" rel="noopener noreferrer" href="https://www.luohanacademy.com">3rd menu item (disabled)</a>;
}
