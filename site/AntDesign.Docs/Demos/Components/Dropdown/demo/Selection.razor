@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IMessageService MessageService

<div @ref="_positionContainer" style="position: relative">
    <Dropdown Menu="_menu" Trigger="_noTrigger" Open="IsOpen" OpenChanged="OnOpenChanged"
              Placement="Placement.Bottom" PopupWidthMode="content"
              BoundaryAdjustMode="TriggerBoundaryAdjustMode.InScroll">
        <Unbound Context="trigger">
            <span class="dropdown-selection-trigger" aria-hidden="true" @ref="trigger.Current"
                  style="@TriggerStyle"></span>
        </Unbound>
    </Dropdown>

    <div @ref="_textContainer" @onmousedown="HandleMouseDown" @onmouseup="HandleMouseUp"
         style="padding: var(--ant-padding-lg); user-select: text; color: var(--ant-color-text); background: var(--ant-color-bg-layout); border-radius: var(--ant-border-radius-lg)">
        Select any text in this paragraph to open a Dropdown menu near the selection. This is useful for actions such as masking sensitive words, marking entities, or searching the selected keyword. Example data: Alice, phone 13800138000, ID 110101199001011234.
    </div>
</div>

@code {
    private readonly Trigger[] _noTrigger = [];
    private ElementReference _positionContainer;
    private ElementReference _textContainer;
    private IJSObjectReference _selectionModule;
    private SelectionInfo _selection;
    private DropdownMenuOptions _menu;
    private decimal _triggerLeft = -9999;
    private decimal _triggerTop = -9999;
    private bool IsOpen => _selection is not null;
    private string TriggerStyle => FormattableString.Invariant($"position: absolute; display: block; width: 1px; height: 1px; margin: 0; padding: 0; pointer-events: none; left: {_triggerLeft}px; top: {_triggerTop}px");

    protected override void OnInitialized()
    {
        _menu = new DropdownMenuOptions
        {
            Selectable = false,
            Items = new[]
            {
                new DropdownMenuItem { Key = "mask", Label = "Mask keyword" },
                new DropdownMenuItem { Key = "mark", Label = "Mark keyword" },
                new DropdownMenuItem { Key = "search", Label = "Search keyword" },
            },
            OnClick = EventCallback.Factory.Create<DropdownMenuClickInfo>(this, HandleMenuClick),
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // React has the Selection API handler ready before the first
            // gesture. Warm the module during render so the first mouse-up
            // only reads the browser's finalized range.
            _selectionModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/AntDesign.Docs/js/dropdown-selection.js?v=20261102");
        }
    }

    private async Task HandleMouseUp()
    {
        _selection = await _selectionModule.InvokeAsync<SelectionInfo>("getSelection", _textContainer, _positionContainer);

        if (_selection is not null)
        {
            await _selectionModule.InvokeVoidAsync("startTrackingSelection", _textContainer, _positionContainer);
            _triggerLeft = _selection.X;
            _triggerTop = _selection.Y;
        }
    }

    // Match the React demo: dismiss the previous menu as soon as a new
    // selection gesture starts, then read the finalized range on mouse-up.
    private async Task HandleMouseDown()
    {
        if (_selectionModule is not null)
        {
            await _selectionModule.InvokeVoidAsync("stopTrackingSelection", _positionContainer);
        }
        _selection = null;
    }

    private async Task HandleMenuClick(DropdownMenuClickInfo item)
    {
        if (_selection is null)
        {
            return;
        }

        var label = item.Key switch
        {
            "mask" => "Mask keyword",
            "mark" => "Mark keyword",
            _ => "Search keyword",
        };
        var selectedText = _selection.Text;
        MessageService.Info($"{label}: {selectedText}");
        await _selectionModule.InvokeVoidAsync("stopTrackingSelection", _positionContainer);
        await _selectionModule.InvokeVoidAsync("clearSelection");
        _selection = null;
    }

    private async Task OnOpenChanged(bool open)
    {
        if (!open)
        {
            if (_selectionModule is not null)
            {
                await _selectionModule.InvokeVoidAsync("stopTrackingSelection", _positionContainer);
            }
            _selection = null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_selectionModule is not null)
        {
            await _selectionModule.InvokeVoidAsync("stopTrackingSelection", _positionContainer);
            await _selectionModule.DisposeAsync();
        }
    }

    private sealed class SelectionInfo
    {
        public string Text { get; set; }
        public decimal X { get; set; }
        public decimal Y { get; set; }
    }
}
