<Dropdown>
    <Overlay>
        <div style="background: var(--ant-color-bg-elevated); border-radius: var(--ant-border-radius-lg); box-shadow: var(--ant-box-shadow-secondary);">
            <Menu Style="box-shadow: none">
                <MenuItem Key="1">
                    <a target="_blank" rel="noopener noreferrer" href="https://www.antgroup.com">1st menu item</a>
                </MenuItem>
                <MenuItem Key="2" Disabled>2nd menu item (disabled)</MenuItem>
                <MenuItem Key="3" Disabled>3rd menu item (disabled)</MenuItem>
            </Menu>
            <Divider Style="margin: 0" />
            <Space Style="padding: 8px">
                <Button Type="ButtonType.Primary">Click me!</Button>
            </Space>
        </div>
    </Overlay>
    <ChildContent>
        <a class="ant-dropdown-link" @onclick:preventDefault>
            Hover me <Icon Type="@IconType.Outline.Down" />
        </a>
    </ChildContent>
</Dropdown>
