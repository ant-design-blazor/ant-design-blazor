    private string GetText(string key, string english, string chinese)
    {
        var value = Localizer[key];
        if (!value.ResourceNotFound)
        {
            return value.Value;
        }

        return LocalizationService.CurrentCulture.Name == "zh-CN" ? chinese : english;
    }

    private string GetSearchPlaceholder()
    {
        var value = Localizer["app.docs.components.icon.search.placeholder"];
        var fallback = LocalizationService.CurrentCulture.Name == "zh-CN"
            ? $"在此搜索 {TotalIconCount} 个图标，点击图标可复制代码"
            : $"Search {TotalIconCount} icons here, click icon to copy code";
        return (value.ResourceNotFound ? fallback : value.Value).Replace("{total}", TotalIconCount.ToString(System.Globalization.CultureInfo.InvariantCulture), StringComparison.Ordinal);
    }

    private string GetCategoryTitle(string category)
    {
        var titles = category switch
        {
            "direction" => ("Directional Icons", "方向性图标"),
            "suggestion" => ("Suggested Icons", "提示建议性图标"),
            "editor" => ("Editor Icons", "编辑类图标"),
            "data" => ("Data Icons", "数据类图标"),
            "logo" => ("Brand and Logos", "品牌和标识"),
            _ => ("Application Icons", "网站通用图标")
        };
        return GetText($"app.docs.components.icon.category.{category}", titles.Item1, titles.Item2);
    }

    private static readonly string[] NewIconNames =
    [
        "AnthropicFilled", "ClaudeFilled", "GeminiFilled", "MistralFilled", "DeepSeekFilled",
        "QwenFilled", "PerplexityFilled", "HuggingFaceFilled", "OllamaFilled", "ReplicateFilled",
        "ElevenLabsFilled", "TelegramFilled", "MastodonFilled", "ThreadsFilled", "SnapchatFilled"
    ];

    private static RenderFragment GetThemeIcon(string theme) => builder => builder.AddMarkupContent(0, theme switch
    {
        "outlined" => "<svg width=\"1em\" height=\"1em\" fill=\"currentColor\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 1024 1024\"><title>Outlined Icon</title><path d=\"M864 64H160C107 64 64 107 64 160v704c0 53 43 96 96 96h704c53 0 96-43 96-96V160c0-53-43-96-96-96z m-12 800H172c-6.6 0-12-5.4-12-12V172c0-6.6 5.4-12 12-12h680c6.6 0 12 5.4 12 12v680c0 6.6-5.4 12-12 12z\"></path></svg>",
        "filled" => "<svg width=\"1em\" height=\"1em\" fill=\"currentColor\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 1024 1024\"><title>Filled Icon</title><path d=\"M864 64H160C107 64 64 107 64 160v704c0 53 43 96 96 96h704c53 0 96-43 96-96V160c0-53-43-96-96-96z\"></path></svg>",
        _ => "<svg width=\"1em\" height=\"1em\" fill=\"currentColor\" aria-hidden=\"true\" focusable=\"false\" viewBox=\"0 0 1024 1024\"><title>TwoTone Icon</title><path d=\"M16 512c0 273.932 222.066 496 496 496s496-222.068 496-496S785.932 16 512 16 16 238.066 16 512z m496 368V144c203.41 0 368 164.622 368 368 0 203.41-164.622 368-368 368z\"></path></svg>"
    });

    private static string GetIconThemeClass(AntDesign.Icons.IconCatalogItem icon) => icon.Theme switch
    {
        "filled" => "Filled",
        "twotone" => "TwoTone",
        _ => "Outlined"
    };

    private static IDictionary<string, object> GetIconParameters(AntDesign.Icons.IconCatalogItem icon)
        => icon.Theme == "twotone"
            ? new Dictionary<string, object> { ["TwoToneColor"] = new[] { "#1677ff" } }
            : null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        LocalizationService.LanguageChanged += async (_, _) => await InvokeAsync(StateHasChanged);
        UpdateDisplayIcons();
    }

    private Task OnSearching(string word)
    {
        searchValue = NormalizeSearch(word);
        UpdateDisplayIcons();
        return InvokeAsync(StateHasChanged);
    }

    private Task OnThemeChanged(IconGalleryTheme newTheme)
    {
        currentTheme = newTheme;
        UpdateDisplayIcons();
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnCopyClick(AntDesign.Icons.IconCatalogItem icon)
    {
        var htmlIcon = $"<{icon.ComponentType.Name} />";
        await JsRuntime.InvokeAsync<object>(JSInteropConstants.Copy, htmlIcon);
        messageService.Success(htmlIcon + "  copied 🎉!");
        copiedIconName = icon.ComponentType.Name;
        await InvokeAsync(StateHasChanged);
        _ = ClearCopiedStateAsync(icon.ComponentType.Name);
    }

    private async Task ClearCopiedStateAsync(string iconName)
    {
        await Task.Delay(TimeSpan.FromSeconds(2));
        if (copiedIconName == iconName)
        {
            copiedIconName = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateDisplayIcons()
    {
        var themes = currentTheme switch
        {
            IconGalleryTheme.Outlined => new[] { "outlined" },
            IconGalleryTheme.Filled => new[] { "filled" },
            IconGalleryTheme.TwoTone => new[] { "twotone" },
            _ => new[] { "outlined", "filled", "twotone" }
        };
        var categories = iconCatalog
            .Where(icon => themes.Contains(icon.Theme, StringComparer.Ordinal))
            .Where(icon => icon.Name is not "copyright-circle" and not "dollar-circle")
            .Where(icon => string.IsNullOrEmpty(searchValue)
                || icon.Name.Contains(searchValue, StringComparison.OrdinalIgnoreCase)
                || icon.ComponentType.Name.Contains(searchValue, StringComparison.OrdinalIgnoreCase)
                || IconSearchMetadata.Matches(icon.ComponentType.Name, searchValue))
            .GroupBy(icon => IconSearchCategories.GetCategory(icon.ComponentType.Name), StringComparer.Ordinal)
            .OrderBy(group => Array.IndexOf(IconSearchCategories.Categories.ToArray(), group.Key))
            .ToDictionary(group => group.Key, group => (IReadOnlyList<AntDesign.Icons.IconCatalogItem>)group
                .OrderBy(icon => IconSearchCategories.GetOrder(icon.ComponentType.Name))
                .ThenBy(icon => IconSearchCategories.GetThemeOrder(icon.ComponentType.Name))
                .ThenBy(icon => icon.Name, StringComparer.Ordinal)
                .ToArray(), StringComparer.Ordinal);

        displayIcons = IconSearchCategories.Categories
            .Where(categories.ContainsKey)
            .Select(category => new IconDisplayCategory(category, categories[category]))
            .ToArray();
    }

    private static string NormalizeSearch(string value)
    {
        var query = value?.Trim() ?? string.Empty;
        if (query.StartsWith('<') && query.EndsWith(" />", StringComparison.Ordinal))
        {
            query = query[1..^3].Trim();
        }
        foreach (var suffix in new[] { "Outlined", "Filled", "TwoTone" })
        {
            if (query.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
            {
                query = query[..^suffix.Length];
                break;
            }
        }
        return query;
    }
}
