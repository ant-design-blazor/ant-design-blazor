
<style>@((MarkupString)galleryStyles.CssText)</style>
<div class="@galleryStyles["toolbar"]">
    <RadioGroup @bind-Value="currentTheme" ButtonStyle="RadioButtonStyle.Solid" Size="InputSize.Large" TValue="IconGalleryTheme" OnChange="OnThemeChanged">
        <Radio RadioButton Value="IconGalleryTheme.All">
            <DynamicComponent Type="@GetThemeIconType("outlined")" />@Localizer["app.docs.components.icon.all"]
        </Radio>
        <Radio RadioButton Value="IconGalleryTheme.Outlined">
            <DynamicComponent Type="@GetThemeIconType("outlined")" />@Localizer["app.docs.components.icon.outlined"]
        </Radio>
        <Radio RadioButton Value="IconGalleryTheme.Filled">
            <DynamicComponent Type="@GetThemeIconType("filled")" />@Localizer["app.docs.components.icon.filled"]
        </Radio>
        <Radio RadioButton Value="IconGalleryTheme.TwoTone">
            <DynamicComponent Type="@GetThemeIconType("twotone")" />@Localizer["app.docs.components.icon.two-tone"]
        </Radio>
    </RadioGroup>
    <Search Size="InputSize.Large"
    ClassicSearchIcon
    AllowClear
    AutoFocus
    DebounceMilliseconds="300"
    Class="ant-input-filled"
    Placeholder="@Localizer["app.docs.components.icon.search.placeholder"]"
    OnInput="@(args => OnSearching(args.Value?.ToString()))" />
</div>

@if (displayIcons == null || displayIcons.Count == 0)
{
    <Empty />
}
else
{
    foreach (var item in displayIcons)
    {
        <h3>@Localizer["app.docs.components.icon.category." + @item.Category]</h3>

        <ul class="@galleryStyles["iconList"]">
            @foreach (var icon in item.Icons)
            {
                <li class="@($"{galleryStyles["iconItem"]} {GetIconThemeClass(icon)} {(copiedIconName == icon.ComponentType.Name ? "copied" : string.Empty)}")" @onclick="(() => OnCopyClick(icon))">
                    @if (NewIconNames.Contains(icon.ComponentType.Name, StringComparer.Ordinal))
                    {
                        <span class="@galleryStyles["newIconVersion"]">6.5.0</span>
                    }
                    <DynamicComponent Type="@icon.ComponentType" Parameters="@iconParameters" @key="@icon.ComponentType.Name" />
                    <span class="@galleryStyles["iconName"]">@icon.ComponentType.Name</span>
                </li>
            }
        </ul>
    }
}


@inject ILocalizationService LocalizationService
@inject IStringLocalizer Localizer;
@inject IMessageService messageService
@inject IJSRuntime JsRuntime

@code{
    private enum IconGalleryTheme { All, Outlined, Filled, TwoTone }

    private sealed record IconDisplayCategory(string Category, IReadOnlyList<AntDesign.Icons.IconCatalogItem> Icons);

    private IconGalleryTheme currentTheme = IconGalleryTheme.All;
    private string searchValue = string.Empty;
    private string? copiedIconName;
    private IReadOnlyList<IconDisplayCategory> displayIcons = Array.Empty<IconDisplayCategory>();
    private readonly IReadOnlyList<AntDesign.Icons.IconCatalogItem> iconCatalog = AntDesign.Icons.IconCatalog.Items;
    private readonly IDictionary<string, object> iconParameters = new Dictionary<string, object>
    {
        ["Style"] = "font-size:36px"
    };
    private static readonly CssStyleSheet galleryStyles = CssInJs.CreateStyles("docs-icon-gallery", new Dictionary<string, object>
    {
        ["toolbar"] = new Dictionary<string, object>
        {
            ["display"] = "flex",
            ["gap"] = "16px",
            ["justifyContent"] = "space-between",
            ["& > *:first-child"] = new Dictionary<string, object> { ["flex"] = "0 0 380px", ["whiteSpace"] = "nowrap" },
            ["& > *:last-child"] = new Dictionary<string, object> { ["flex"] = "1" }
        },
        ["iconList"] = new Dictionary<string, object>
        {
            ["display"] = "grid",
            ["gridGap"] = "var(--ant-margin, 16px)",
            ["gridTemplateColumns"] = "repeat(6, minmax(0, 1fr))",
            ["margin"] = "var(--ant-margin, 16px) 0",
            ["padding"] = 0,
            ["direction"] = "ltr",
            ["listStyle"] = "none"
        },
        ["iconItem"] = new Dictionary<string, object>
        {
            ["position"] = "relative",
            ["display"] = "inline-flex",
            ["flexDirection"] = "column",
            ["justifyContent"] = "center",
            ["alignItems"] = "center",
            ["marginInlineStart"] = "0 !important",
            ["marginInlineEnd"] = "0 !important",
            ["paddingInlineStart"] = "0 !important",
            ["paddingInlineEnd"] = "0 !important",
            ["width"] = "100%",
            ["height"] = 100,
            ["overflow"] = "hidden",
            ["color"] = "#555",
            ["textAlign"] = "center",
            ["listStyle"] = "none",
            ["backgroundColor"] = "inherit",
            ["borderRadius"] = "var(--ant-border-radius-sm, 4px)",
            ["cursor"] = "pointer",
            ["transition"] = "all var(--ant-motion-duration-slow, 0.3s) ease-in-out",
            ["& .anticon"] = new Dictionary<string, object>
            {
                ["margin"] = "8px 0",
                ["fontSize"] = 36,
                ["transition"] = "transform var(--ant-motion-duration-slow, 0.3s) ease-in-out",
                ["willChange"] = "transform"
            },
            ["&:hover"] = new Dictionary<string, object>
            {
                ["color"] = "var(--ant-color-white, #fff)",
                ["backgroundColor"] = "var(--ant-color-primary, #1677ff)"
            },
            ["&:hover .anticon"] = new Dictionary<string, object> { ["transform"] = "scale(1.3)" },
            ["&.TwoTone:hover"] = new Dictionary<string, object> { ["backgroundColor"] = "#8ecafe" },
            ["&.copied:hover"] = new Dictionary<string, object> { ["color"] = "rgba(255, 255, 255, 0.2)" },
            ["&::after"] = new Dictionary<string, object>
            {
                ["position"] = "absolute",
                ["top"] = 0,
                ["insetInlineStart"] = 0,
                ["width"] = "100%",
                ["height"] = "100%",
                ["lineHeight"] = "100px",
                ["color"] = "var(--ant-color-text-light-solid, #fff)",
                ["content"] = "'Copied!'",
                ["textAlign"] = "center",
                ["backgroundColor"] = "var(--ant-color-primary, #1677ff)",
                ["opacity"] = 0,
                ["transition"] = "all var(--ant-motion-duration-slow, 0.3s) cubic-bezier(0.18, 0.89, 0.32, 1.28)"
            },
            ["&.copied::after"] = new Dictionary<string, object> { ["opacity"] = 1 }
        },
        ["iconName"] = new Dictionary<string, object>
        {
            ["display"] = "block",
            ["fontFamily"] = "'Lucida Console', Consolas, Monaco, 'Andale Mono', 'Ubuntu Mono', monospace",
            ["whiteSpace"] = "nowrap",
            ["textAlign"] = "center",
            ["transform"] = "scale(0.8)"
        },
        ["newIconVersion"] = new Dictionary<string, object>
        {
            ["position"] = "absolute",
            ["insetBlockStart"] = 0,
            ["insetInlineEnd"] = 0,
            ["zIndex"] = 1,
            ["padding"] = "0 var(--ant-padding-xxs, 4px)",
            ["color"] = "var(--ant-color-white, #fff)",
            ["fontSize"] = "var(--ant-font-size-sm, 12px)",
            ["lineHeight"] = "var(--ant-line-height-sm, 1.5)",
            ["backgroundColor"] = "var(--ant-color-success, #52c41a)",
            ["borderStartEndRadius"] = "var(--ant-border-radius-sm, 4px)",
            ["borderEndStartRadius"] = "var(--ant-border-radius-sm, 4px)"
        }
    });

    private static readonly string[] NewIconNames =
    [
        "AnthropicFilled", "ClaudeFilled", "GeminiFilled", "MistralFilled", "DeepSeekFilled",
        "QwenFilled", "PerplexityFilled", "HuggingFaceFilled", "OllamaFilled", "ReplicateFilled",
        "ElevenLabsFilled", "TelegramFilled", "MastodonFilled", "ThreadsFilled", "SnapchatFilled"
    ];

    private static Type GetThemeIconType(string theme) => AntDesign.Icons.IconCatalog.Items
        .First(item => item.Name == "appstore" && item.Theme == theme)
        .ComponentType;

    private static string GetIconThemeClass(AntDesign.Icons.IconCatalogItem icon) => icon.Theme switch
    {
        "filled" => "Filled",
        "twotone" => "TwoTone",
        _ => "Outlined"
    };

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        LocalizationService.LanguageChanged += async (_, _) => await InvokeAsync(StateHasChanged);
        UpdateDisplayIcons();
    }

    private Task OnSearching(string word)
    {
        searchValue = NormalizeSearch(word);
        UpdateDisplayIcons();
        return InvokeAsync(StateHasChanged);
    }

    private Task OnThemeChanged(IconGalleryTheme newTheme)
    {
        currentTheme = newTheme;
        UpdateDisplayIcons();
        return InvokeAsync(StateHasChanged);
    }

    private async Task OnCopyClick(AntDesign.Icons.IconCatalogItem icon)
    {
        var htmlIcon = $"<{icon.ComponentType.Name} />";
        await JsRuntime.InvokeAsync<object>(JSInteropConstants.Copy, htmlIcon);
        messageService.Success(htmlIcon + "  copied 🎉!");
        copiedIconName = icon.ComponentType.Name;
        await InvokeAsync(StateHasChanged);
        _ = ClearCopiedStateAsync(icon.ComponentType.Name);
    }

    private async Task ClearCopiedStateAsync(string iconName)
    {
        await Task.Delay(TimeSpan.FromSeconds(2));
        if (copiedIconName == iconName)
        {
            copiedIconName = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void UpdateDisplayIcons()
    {
        var themes = currentTheme switch
        {
            IconGalleryTheme.Outlined => new[] { "outlined" },
            IconGalleryTheme.Filled => new[] { "filled" },
            IconGalleryTheme.TwoTone => new[] { "twotone" },
            _ => new[] { "outlined", "filled", "twotone" }
        };
        var categories = iconCatalog
            .Where(icon => themes.Contains(icon.Theme, StringComparer.Ordinal))
            .Where(icon => icon.Name is not "copyright-circle" and not "dollar-circle")
            .Where(icon => string.IsNullOrEmpty(searchValue)
                || icon.Name.Contains(searchValue, StringComparison.OrdinalIgnoreCase)
                || icon.ComponentType.Name.Contains(searchValue, StringComparison.OrdinalIgnoreCase)
                || IconSearchMetadata.Matches(icon.ComponentType.Name, searchValue))
            .GroupBy(icon => icon.Category, StringComparer.Ordinal)
            .ToDictionary(group => group.Key, group => (IReadOnlyList<AntDesign.Icons.IconCatalogItem>)group.ToArray(), StringComparer.Ordinal);

        displayIcons = AntDesign.Icons.IconCatalog.Categories
            .Where(categories.ContainsKey)
            .Select(category => new IconDisplayCategory(category, categories[category]))
            .ToArray();
    }

    private static string NormalizeSearch(string value)
    {
        var query = value?.Trim() ?? string.Empty;
        if (query.StartsWith('<') && query.EndsWith(" />", StringComparison.Ordinal))
        {
            query = query[1..^3].Trim();
        }
        foreach (var suffix in new[] { "Outlined", "Filled", "TwoTone" })
        {
            if (query.EndsWith(suffix, StringComparison.OrdinalIgnoreCase))
            {
                query = query[..^suffix.Length];
                break;
            }
        }
        return query;
    }
}
