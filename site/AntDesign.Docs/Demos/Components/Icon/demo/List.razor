
<h2 id="list-of-icons">@(LocalizationService.CurrentCulture.Name == "zh-CN" ? "图标列表" : "List of icons")</h2>
<style>@((MarkupString)galleryStyles.CssText)</style>
<Affix OffsetTop="80" OnChange="OnToolbarAffixChanged">
    <div class="@galleryStyles["toolbar"]" style="@ToolbarStyle">
        <Segmented TValue="IconGalleryTheme" Value="@currentTheme" ValueChanged="OnThemeChanged" Size="SegmentedSize.Large" AriaLabel="segmented control" AriaOrientation="horizontal" Role="radiogroup" TabIndex="0">
            <SegmentedItem TValue="IconGalleryTheme" Value="@IconGalleryTheme.All">
                <span class="ant-segmented-item-icon"><Icon Type="@IconType.Outline.Appstore" /></span><span>@GetText("app.docs.components.icon.all", "All", "全部")</span>
            </SegmentedItem>
            <SegmentedItem TValue="IconGalleryTheme" Value="@IconGalleryTheme.Outlined">
                <span class="ant-segmented-item-icon"><Icon Component="@GetThemeIcon("outlined")" Role="img" /></span><span>@GetText("app.docs.components.icon.outlined", "Outlined", "线框风格")</span>
            </SegmentedItem>
            <SegmentedItem TValue="IconGalleryTheme" Value="@IconGalleryTheme.Filled">
                <span class="ant-segmented-item-icon"><Icon Component="@GetThemeIcon("filled")" Role="img" /></span><span>@GetText("app.docs.components.icon.filled", "Filled", "实底风格")</span>
            </SegmentedItem>
            <SegmentedItem TValue="IconGalleryTheme" Value="@IconGalleryTheme.TwoTone">
                <span class="ant-segmented-item-icon"><Icon Component="@GetThemeIcon("twotone")" Role="img" /></span><span>@GetText("app.docs.components.icon.two-tone", "Two Tone", "双色风格")</span>
            </SegmentedItem>
        </Segmented>
        <Search Size="InputSize.Large"
        AllowClear
        AutoFocus
        DebounceMilliseconds="300"
        Class="ant-input-filled"
        Placeholder="@GetSearchPlaceholder()"
        OnInput="@(args => OnSearching(args.Value?.ToString()))" />
    </div>
</Affix>

@if (displayIcons == null || displayIcons.Count == 0)
{
    <Empty />
}
else
{
    foreach (var item in displayIcons)
    {
        <h3>@GetCategoryTitle(item.Category)</h3>

        <ul class="@galleryStyles["iconList"]">
            @foreach (var icon in item.Icons)
            {
                <li class="@($"{galleryStyles["iconItem"]} {GetIconThemeClass(icon)} {(copiedIconName == icon.ComponentType.Name ? "copied" : string.Empty)}")" style="cursor: pointer;" @onclick="(() => OnCopyClick(icon))">
                    @if (NewIconNames.Contains(icon.ComponentType.Name, StringComparer.Ordinal))
                    {
                        <span class="@galleryStyles["newIconVersion"]">6.5.0</span>
                    }
                    <DynamicComponent Type="@icon.ComponentType" Parameters="@GetIconParameters(icon)" @key="@icon.ComponentType.Name" />
                    <span class="@galleryStyles["iconName"]">@icon.ComponentType.Name</span>
                </li>
            }
        </ul>
    }
}


@inject ILocalizationService LocalizationService
@inject IStringLocalizer<AntDesign.Docs.Services.IconListService> Localizer
@inject IMessageService messageService
@inject IJSRuntime JsRuntime

@code{
    private enum IconGalleryTheme { All, Outlined, Filled, TwoTone }

    private sealed record IconDisplayCategory(string Category, IReadOnlyList<AntDesign.Icons.IconCatalogItem> Icons);

    private IconGalleryTheme currentTheme = IconGalleryTheme.All;
    private bool toolbarAffixed;
    private string searchValue = string.Empty;
    private int TotalIconCount => iconCatalog
        .Select(icon => System.Text.RegularExpressions.Regex.Replace(icon.ComponentType.Name, "(Outlined|Filled|TwoTone)$", string.Empty))
        .Distinct(StringComparer.Ordinal)
        .Count();
    private string? copiedIconName;
    private IReadOnlyList<IconDisplayCategory> displayIcons = Array.Empty<IconDisplayCategory>();
    private readonly IReadOnlyList<AntDesign.Icons.IconCatalogItem> iconCatalog = AntDesign.Icons.IconCatalog.Items;
    private string ToolbarStyle => toolbarAffixed
        ? "box-shadow:rgba(50, 50, 93, 0.25) 0 6px 12px -2px, rgba(0, 0, 0, 0.3) 0 3px 7px -3px;padding:8px;margin:-8px;border-radius:var(--ant-border-radius, 6px);background-color:var(--ant-color-bg-container, #fff)"
        : null;

    private Task OnToolbarAffixChanged(bool affixed)
    {
        if (toolbarAffixed == affixed)
        {
            return Task.CompletedTask;
        }

        toolbarAffixed = affixed;
        return InvokeAsync(StateHasChanged);
    }

