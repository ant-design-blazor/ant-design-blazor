<AutoComplete TOption="string" Style="width: 200px" Placeholder="input here" Options="@options" OnInput="OnUncontrolledSearch" />
<br />
<br />
<AutoComplete TOption="string" @bind-Value="value" Style="width: 200px" Placeholder="control mode" Options="@anotherOptions" OnInput="OnControlledSearch" OnSelectionChange="OnSelect" />

@code {
    private string value = string.Empty;
    private List<string> options = [];
    private List<string> anotherOptions = [];

    private static string MockValue(string text, int repeat) => string.Concat(Enumerable.Repeat(text, repeat));

    private void OnUncontrolledSearch(ChangeEventArgs args)
    {
        options = GetPanelValue(args.Value?.ToString());
    }

    private void OnControlledSearch(ChangeEventArgs args)
    {
        anotherOptions = GetPanelValue(args.Value?.ToString());
    }

    private static List<string> GetPanelValue(string searchText) => string.IsNullOrEmpty(searchText)
        ? []
        : [MockValue(searchText, 1), MockValue(searchText, 2), MockValue(searchText, 3)];

    private void OnSelect(AutoCompleteOption item)
    {
        // The React example logs the selected option; the controlled value is
        // updated through @bind-Value, while this callback preserves onSelect.
    }
}
