@using AntDesign
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<FloatButton RefBack="@_buttonRef" Style="cursor:grab;touch-action:none;transition:transform 0.2s" />

@code {
    private readonly ForwardRef _buttonRef = new();
    private bool _dragHandlerBound;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Element references are available in OnAfterRender; their Id is an
        // implementation detail and can be empty even when the DOM node is valid.
        if (!_dragHandlerBound)
        {
            await JS.InvokeVoidAsync(JSInteropConstants.FloatButtonHelper.BindDraggable, _buttonRef.Current);
            _dragHandlerBound = true;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_dragHandlerBound)
        {
            await JS.InvokeVoidAsync(JSInteropConstants.FloatButtonHelper.UnbindDraggable, _buttonRef.Current);
        }
    }
}
