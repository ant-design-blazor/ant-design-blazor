@namespace AntDesign.Docs.Demos.Experimental.ComponentPropsProvider.demo.Shared
@inherits AntComponentBase

<div class="status-card @(Highlighted ? "status-card-highlighted" : null)">
    <strong>@Title</strong>
    <div>@Description</div>
</div>

<style>
    .status-card {
        min-width: 180px;
        padding: 12px 16px;
        border: 1px solid #d9d9d9;
        border-radius: 6px;
    }

    .status-card-highlighted {
        color: #1677ff;
        background: #e6f4ff;
        border-color: #91caff;
    }
</style>
