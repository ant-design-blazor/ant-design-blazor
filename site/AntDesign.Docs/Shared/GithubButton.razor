@using AntDesign.Docs.Services

<span id="github-btn" class="@_styles["root"]">
    <a class="gh-btn" href="@($"//github.com/{_org}/{_repo}")" target="_blank">
        <svg class="gh-ico" aria-hidden="true" viewBox="0 0 24 24"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.1c-3.1.68-3.76-1.32-3.76-1.32-.5-1.3-1.24-1.65-1.24-1.65-1.01-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 .1.77 2.5 3.66 1.78.1-.73.39-1.22.7-1.5-2.48-.28-5.09-1.24-5.09-5.53 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.05 1.15a10.6 10.6 0 0 1 5.56 0c2.12-1.44 3.05-1.15 3.05-1.15.61 1.54.23 2.68.11 2.96.72.78 1.15 1.78 1.15 3 0 4.3-2.61 5.25-5.1 5.53.4.34.75 1 .75 2.02v3c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" /></svg>
        <span class="gh-text">Star</span>
    </a>
    @if (_starCount > 0)
    {
        <a class="gh-count" target="_blank" href="@($"//github.com/{_org}/{_repo}/stargazers")">@_starCount</a>
    }
</span>

<style>@((MarkupString)_styles.CssText)</style>

@code {
    private static readonly CssStyleSheet _styles = CssInJs.CreateStyles("docs-github-button", new System.Collections.Generic.Dictionary<string, object>
    {
        ["root"] = new System.Collections.Generic.Dictionary<string, object>
        {
            ["font"] = "bold 11px/14px 'Helvetica Neue', Helvetica, Arial, sans-serif", ["height"] = 20, ["overflow"] = "hidden",
            ["& .gh-btn, & .gh-count, & .gh-ico"] = new System.Collections.Generic.Dictionary<string, object> { ["float"] = "left" },
            ["& .gh-btn, & .gh-count"] = new System.Collections.Generic.Dictionary<string, object> { ["padding"] = "2px 5px 2px 4px", ["color"] = "#333", ["textDecoration"] = "none", ["whiteSpace"] = "nowrap", ["cursor"] = "pointer", ["borderRadius"] = 3 },
            ["& .gh-btn"] = new System.Collections.Generic.Dictionary<string, object> { ["background"] = "linear-gradient(to bottom, #fcfcfc 0, #eee 100%) no-repeat", ["border"] = "1px solid #d5d5d5" },
            ["& .gh-btn:hover, & .gh-btn:focus"] = new System.Collections.Generic.Dictionary<string, object> { ["textDecoration"] = "none", ["background"] = "linear-gradient(to bottom, #eee 0, #ddd 100%) no-repeat", ["borderColor"] = "#ccc" },
            ["& .gh-btn:active"] = new System.Collections.Generic.Dictionary<string, object> { ["background"] = "#dcdcdc", ["borderColor"] = "#b5b5b5", ["boxShadow"] = "inset 0 2px 4px rgba(0, 0, 0, 0.15)" },
            ["& .gh-ico"] = new System.Collections.Generic.Dictionary<string, object> { ["display"] = "block", ["width"] = 14, ["height"] = 14, ["marginRight"] = 4, ["backgroundImage"] = "none", ["fill"] = "currentColor" },
            ["& .gh-count"] = new System.Collections.Generic.Dictionary<string, object> { ["position"] = "relative", ["display"] = "none", ["marginLeft"] = 4, ["backgroundColor"] = "#fafafa", ["border"] = "1px solid #d4d4d4" },
            ["& .gh-count:hover, & .gh-count:focus"] = new System.Collections.Generic.Dictionary<string, object> { ["color"] = "#4183c4" },
            ["& .gh-count::before, & .gh-count::after"] = new System.Collections.Generic.Dictionary<string, object> { ["content"] = "''", ["position"] = "absolute", ["display"] = "inline-block", ["width"] = 0, ["height"] = 0, ["borderColor"] = "transparent", ["borderStyle"] = "solid" },
            ["& .gh-count::before"] = new System.Collections.Generic.Dictionary<string, object> { ["top"] = "50%", ["left"] = -3, ["marginTop"] = -4, ["borderWidth"] = "4px 4px 4px 0", ["borderRightColor"] = "#fafafa" },
            ["& .gh-count::after"] = new System.Collections.Generic.Dictionary<string, object> { ["top"] = "50%", ["left"] = -4, ["zIndex"] = -1, ["marginTop"] = -5, ["borderWidth"] = "5px 5px 5px 0", ["borderRightColor"] = "#d4d4d4" },
            ["[data-theme='dark'] & .gh-ico"] = new System.Collections.Generic.Dictionary<string, object> { ["color"] = "#fff" },
            ["@media (prefers-color-scheme: dark)"] = new System.Collections.Generic.Dictionary<string, object> { ["& .gh-ico"] = new System.Collections.Generic.Dictionary<string, object> { ["fill"] = "currentColor" } }
        }
    });
}
