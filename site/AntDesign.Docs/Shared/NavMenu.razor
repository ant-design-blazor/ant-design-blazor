        {
            ["minHeight"] = "100%", ["paddingBottom"] = 48, ["transition"] = "all 0.3s cubic-bezier(0.78, 0.14, 0.15, 0.86)",
            ["fontFamily"] = "Avenir, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji', sans-serif",
            ["&.ant-menu-inline .ant-menu-submenu-title h4, &.ant-menu-inline > .ant-menu-item, &.ant-menu-inline .ant-menu-item a"] = new System.Collections.Generic.Dictionary<string, object> { ["overflow"] = "hidden", ["fontSize"] = 14, ["textOverflow"] = "ellipsis" },
            ["&.ant-menu-inline > .ant-menu-item-group > .ant-menu-item-group-title"] = new System.Collections.Generic.Dictionary<string, object>
