            [".ant-row-rtl &.ant-menu-inline > .ant-menu-item, .ant-row-rtl &.ant-menu-inline > .ant-menu-submenu > .ant-menu-submenu-title, .ant-row-rtl &.ant-menu-inline > .ant-menu-item-group > .ant-menu-item-group-title, .ant-row-rtl &.ant-menu-inline > .ant-menu-item-group > .ant-menu-item-group-list > .ant-menu-item, .ant-row-rtl &.ant-menu-inline.ant-menu-inline > .ant-menu-item-group > .ant-menu-item-group-list > .ant-menu-item"] = new System.Collections.Generic.Dictionary<string, object> { ["paddingRight"] = "40px !important", ["paddingLeft"] = "16px !important" },
