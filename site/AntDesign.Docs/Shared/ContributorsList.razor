@using AntDesign.Docs.Services

<ul class="@_styles["root"]">
    @if (_avatarList?.Any() == true)
    {
        @foreach (var item in _avatarList)
        {
            <Tooltip Title="@($"{Localizer["app.content.contributors"]}:{item.Username}")">
                <Unbound>
                    <a @ref="context.Current" target="_blank" href="@item.ProfileUrl">
                        <Avatar Text="@item.Username" Src="@item.Url" />
                    </a>
                </Unbound>
            </Tooltip>
        }
    }
    else
    {
        for (var i = 0; i < 3; i++)
        {
            <SkeletonElement Class="@_styles["placeholder"]" Type="SkeletonElementType.Avatar"
                             Active Size="SkeletonElementSize.Default" Shape="SkeletonElementShape.Circle" />
        }
    }
</ul>

<style>@((MarkupString)_styles.CssText)</style>

@code {
    private static readonly CssStyleSheet _styles = CssInJs.CreateStyles("docs-contributors", new System.Collections.Generic.Dictionary<string, object>
    {
        ["root"] = new System.Collections.Generic.Dictionary<string, object>
        {
            ["display"] = "flex", ["flexWrap"] = "wrap", ["listStyle"] = "none", ["margin"] = "120px 0 0 !important", ["padding"] = 0,
            ["& > a, & .ant-avatar + .ant-avatar"] = new System.Collections.Generic.Dictionary<string, object> { ["marginRight"] = 8, ["marginBottom"] = 8 }
        },
        ["placeholder"] = new System.Collections.Generic.Dictionary<string, object> { ["marginRight"] = 8, ["marginBottom"] = 8 }
    });
}
