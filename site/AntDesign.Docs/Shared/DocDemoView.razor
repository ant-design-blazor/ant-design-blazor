@using AntDesign.Docs.Services
@inherits ComponentBase

@if (_render)
{
    @Demo.Component
}

@code {

    [Parameter]
    public DemoItem Demo { get; set; }

    private bool _render;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _render = true;
            StateHasChanged();
            return;
        }
        base.OnAfterRender(firstRender);

    }
}
