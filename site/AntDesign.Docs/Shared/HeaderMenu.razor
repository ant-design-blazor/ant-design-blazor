@using AntDesign.Docs.Services

@if (!IsMobile || ShowSearch)
{
    <div id="search-box"><div id="docsearch"></div></div>
}
@if (ShowNavigation)
{
<div class="header-navigation">
    <Menu Mode="@(IsMobile ? MenuMode.Inline : MenuMode.Horizontal)" DisabledOverflow="IsMobile" Id="nav" Class="menu-site">
        @foreach (var item in NavigationItems)
        {
            @RenderNavigationItem(item)
        }
        @AdditionalMenuItems
    </Menu>
</div>
}
@if (!IsMobile && ShowNavigation)
{
    <div class="header-desktop-utilities">
        <div class="header-sponsors" aria-label="Sponsors">
            <a href="https://youmind.com?utm_source=ant-design" target="_blank" rel="noopener noreferrer" aria-label="YouMind"><img src="https://mdn.alipayobjects.com/huamei_vmgq1x/afts/img/A*SXcuQYBZ6oQAAAAAQJAAAAgAeh6VAQ/original" alt="" /></a>
            <a href="https://tractian.com?utm_source=ant-design" target="_blank" rel="noopener noreferrer" aria-label="TRACTIAN"><img src="https://mdn.alipayobjects.com/huamei_vmgq1x/afts/img/A*Z4-4Q67SG5UAAAAAQLAAAAgAeh6VAQ/original" alt="" /></a>
            <a href="https://lobehub.com?utm_source=ant-design" target="_blank" rel="noopener noreferrer" aria-label="LobeHub"><img src="https://unpkg.com/%40lobehub/icons-static-svg@1.79.0/icons/lobehub-color.svg" alt="" /></a>
            <a href="https://coderabbit.ai?utm_source=ant-design" target="_blank" rel="noopener noreferrer" aria-label="CodeRabbit"><img src="https://mdn.alipayobjects.com/huamei_vmgq1x/afts/img/A*yHnhRL4x1DEAAAAAQBAAAAgAeh6VAQ/original" alt="" /></a>
        </div>
        <Button Class="header-button header-version-button" Size="ButtonSize.Small">@VersionLabel</Button>
        <Button Class="header-button header-lang-button" Size="ButtonSize.Small" OnClick="@(_ => ChangeLanguage(CurrentLanguage == "en-US" ? "zh-CN" : "en-US"))">@(CurrentLanguage == "en-US" ? "中" : "En")</Button>
        <Button Class="header-button header-direction-button" Size="ButtonSize.Small" OnClick="@(() => ConfigProvider?.ChangeDirection(Direction?.ToUpperInvariant() == "RTL" ? "ltr" : "rtl"))">@(Direction?.ToUpperInvariant() == "RTL" ? "LTR" : "RTL")</Button>
        <DocsThemeSwitch PopupContainerSelector=".header-desktop-utilities" />
        <GithubButton />
    </div>
}


<style>@((MarkupString)_searchStyles.CssText)</style>
<style>
    #header .header-desktop-utilities { position: relative; }
    #header .header-sponsors{display:flex;align-items:center;margin-inline:8px 12px}
    #header .header-sponsors a{display:block;width:26px;height:26px;margin-inline-start:-6px;border:2px solid var(--ant-color-bg-layout,#f5f5f5);border-radius:50%;position:relative;z-index:0}
    #header .header-sponsors a:first-child{margin-inline-start:0}
    #header .header-sponsors a:hover{z-index:1}
    #header .header-sponsors img{display:block;width:22px;height:22px;object-fit:contain;border-radius:50%;background:var(--ant-color-bg-container,#fff);opacity:.7;transition:transform .15s,opacity .2s}
    #header .header-sponsors a:hover img{transform:translateY(-2px);opacity:1}
    @@media (min-width:1120px){#header .header-navigation .header-additional-item{display:none}}
    [data-theme="dark"] #header .header-sponsors a{border-color:var(--ant-color-bg-layout,#000)}
    [data-theme="dark"] #header .header-sponsors img{background:var(--ant-color-bg-container,#141414);opacity:.9}
    #header .header-version-button{width:88px;min-width:88px;margin-inline-end:6px}
    #header .header-lang-button,#header .header-direction-button{width:32px;min-width:32px;padding-inline:0}
    #header .header-direction-button{font-size:11px}
    #header .docs-theme-switch-trigger{width:32px;height:32px;margin:0}
    #header #github-btn{width:32px;height:32px}
    #header #github-btn .gh-btn{display:flex;align-items:center;justify-content:center;width:32px;height:32px;padding:0;background:transparent;border:0}
    #header #github-btn .gh-ico{width:20px;height:20px;margin:0}
    #header #github-btn .gh-count{display:none!important}
</style>

@code {
    [Parameter] public bool ShowSearch { get; set; }
    [Parameter] public bool ShowNavigation { get; set; } = true;

    private RenderFragment RenderNavigationItem(HeaderNavigationItem item) => @<MenuItem Class="ant-menu-item-only-child" Key="@item.Key" RouterLink="@item.Url" RouterMatch="NavLinkMatch.Prefix"><span>@item.Title</span></MenuItem>;

    private RenderFragment AdditionalMenuItems => @<text>
        <MenuItem Class="header-additional-item"><a href="https://github.com/ant-design-blazor/ant-design-blazor">Github</a></MenuItem>

        @if (CurrentLanguage != "en-US")
        {
            <MenuItem Class="header-additional-item" OnClick="@(_ => ChangeLanguage("en-US"))">English</MenuItem>
        }
        else
        {
            <MenuItem Class="header-additional-item" OnClick="@(_ => ChangeLanguage("zh-CN"))">简体中文</MenuItem>
        }
        @if (Direction?.ToUpperInvariant() != "RTL")
        {
            <MenuItem Class="header-additional-item" OnClick="@(()=>ConfigProvider?.ChangeDirection("rtl"))">RTL</MenuItem>
        }
        else
        {
            <MenuItem Class="header-additional-item" OnClick="@(()=>ConfigProvider?.ChangeDirection("ltr"))">LTR</MenuItem>
        }
    </text>;

    private static readonly CssStyleSheet _searchStyles = CssInJs.CreateStyles("docs-search", new System.Collections.Generic.Dictionary<string, object>
    {
        ["portal"] = new System.Collections.Generic.Dictionary<string, object>
        {
            ["&#antd_algolia_search_modal .DocSearch-Hit-content-wrapper"] = new System.Collections.Generic.Dictionary<string, object> { ["overflow"] = "hidden" },
            ["&#antd_algolia_search_modal .DocSearch"] = new System.Collections.Generic.Dictionary<string, object>
            {
                ["fontFamily"] = "Avenir, AlibabaSans, -apple-system, 'system-ui', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif"
            },
            ["&#antd_algolia_search_modal .DocSearch-Hit-title"] = new System.Collections.Generic.Dictionary<string, object> { ["overflowY"] = "hidden" },
            ["&#antd_algolia_search_modal .DocSearch-Hit-title mark"] = new System.Collections.Generic.Dictionary<string, object> { ["padding"] = 0 },
            ["&#antd_algolia_search_modal .DocSearch-Footer"] = new System.Collections.Generic.Dictionary<string, object> { ["boxShadow"] = "none" },
            ["[data-theme='dark'] &#antd_algolia_search_modal"] = new System.Collections.Generic.Dictionary<string, object> { ["--docsearch-key-gradient"] = "#fafafa", ["--docsearch-logo-color"] = "#fff" },
            ["[data-theme='dark'] &#antd_algolia_search_modal .DocSearch"] = new System.Collections.Generic.Dictionary<string, object>
            {
                ["--docsearch-primary-color"] = "var(--ant-primary-color)", ["--docsearch-text-color"] = "rgba(0, 0, 0, 0.85)",
                ["--docsearch-muted-color"] = "rgba(0, 0, 0, 0.45)", ["--docsearch-container-background"] = "rgba(0, 0, 0, 0.45)",
                ["--docsearch-searchbox-shadow"] = "inset 0 0 0 2px var(--ant-primary-color)", ["--docsearch-modal-background"] = "#fff",
                ["--docsearch-searchbox-background"] = "#fff", ["--docsearch-searchbox-focus-background"] = "#fff",
                ["--docsearch-footer-background"] = "#fff", ["--docsearch-hit-background"] = "#fff",
                ["--docsearch-hit-color"] = "var(--ant-primary-color)", ["--docsearch-hit-active-color"] = "#fff",
                ["--docsearch-highlight-color"] = "var(--ant-primary-color)"
            },
            ["[data-theme='dark'] &#antd_algolia_search_modal .DocSearch .DocSearch-Footer"] = new System.Collections.Generic.Dictionary<string, object> { ["borderTop"] = "1px solid rgba(0, 0, 0, 0.06)" },
            ["[data-theme='dark'] &#antd_algolia_search_modal .DocSearch-Modal, [data-theme='dark'] &#antd_algolia_search_modal .DocSearch-Commands-Key"] = new System.Collections.Generic.Dictionary<string, object> { ["boxShadow"] = "none" },
            ["[data-theme='dark'] &#antd_algolia_search_modal .DocSearch-Hit a"] = new System.Collections.Generic.Dictionary<string, object> { ["boxShadow"] = "none" }
        }
    });
}
