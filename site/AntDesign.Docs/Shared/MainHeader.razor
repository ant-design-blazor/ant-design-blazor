@using AntDesign.Docs.Services
<header id="header" class="clearfix @(IsHome?"home-header":"") @_styles["root"]">
    <Row Style="display: flex; flex-flow: nowrap; height: 64px;" OnBreakpoint="OnBreakpoint">
        <GridCol Class="docs-header-logo" Flex="@(IsHome ? "none" : null)" Xs="24" Sm="24" Md="6" Lg="6" Xl="5" Xxl="4">
            <h1>
                <a id="logo" href="/">
                    <img alt="logo" src="_content/AntDesign.Docs/docs/assets/logo.svg"><span class="docs-brand-name">Ant Design<sup class="docs-blazor-brand-accent">Blazor</sup></span>
                </a>
            </h1>
        </GridCol>
        @if (_isMobile)
        {
            <Popover @bind-Visible="_mobileNavigationOpen" @bind-Visible:after="ResetMobileMenuAfterClose" Class="docs-header-mobile-trigger" Placement="Placement.BottomRight" BoundaryAdjustMode="TriggerBoundaryAdjustMode.InView" ArrowPointAtCenter PopupWidthMode="custom" PopupWidth="min(300px, calc(100vw - 32px))" PopupMaxWidth="calc(100vw - 32px)" Trigger="new[] { Trigger.Click }" OverlayClassName="docs-header-mobile-popup">
                <ContentTemplate>
                    <HeaderMenu @ref="_mobileHeaderMenu" IsMobile />
                </ContentTemplate>
                <ChildContent><Button Type="ButtonType.Text" Icon="@IconType.Outline.UnorderedList" Class="nav-phone-icon" AriaLabel="Open navigation" /></ChildContent>
            </Popover>
        }
        @if (!_isMobile || IsHome)
        {
            <GridCol Class="menu-row" Flex="@(IsHome ? "auto" : null)" Xs="@(IsHome ? 24 : 0)" Sm="@(IsHome ? 24 : 0)" Md="18" Lg="18" Xl="19" Xxl="20">
            <HeaderMenu IsMobile="_isMobile" ShowSearch="true" ShowNavigation="@(!_isMobile)" />
            </GridCol>
        }
    </Row>
</header>

<style>@((MarkupString)_styles.CssText)</style>
<style>
    #header #logo{gap:12px;flex:none;overflow:visible!important}
    #header #logo img{flex:none;width:32px;height:32px;margin:0}
    #header #logo .docs-brand-name{display:inline-flex;align-items:flex-start;flex:none;white-space:nowrap;font-size:18px;line-height:1;font-weight:700}
    #header #logo .docs-brand-name sup{position:relative;top:-.2em;margin-inline-start:3px;font-size:.55em;line-height:1}
    .docs-header-mobile-popup .ant-popover-inner,.docs-header-mobile-popup .ant-popover-inner-content{padding:0;width:100%;box-sizing:border-box}
    .docs-header-mobile-popup .ant-popover-container,.docs-header-mobile-popup .ant-popover-content{width:100%;box-sizing:border-box}
    .docs-header-mobile-popup .ant-popover-inner{background:var(--ant-color-bg-elevated,#fff);border-radius:var(--ant-border-radius-lg,8px);box-shadow:var(--ant-box-shadow-secondary,0 6px 16px rgba(0,0,0,.12))}
    .docs-header-mobile-popup .header-navigation{width:100%}
    .docs-header-mobile-popup .ant-menu{width:100%;border-inline-end:0}
    .docs-header-mobile-popup.ant-popover-arrow-point-at-center:is(.ant-popover-placement-top,.ant-popover-placement-topLeft,.ant-popover-placement-topRight,.ant-popover-placement-bottom,.ant-popover-placement-bottomLeft,.ant-popover-placement-bottomRight) .ant-popover-arrow{left:var(--ant-overlay-arrow-left);right:auto}
    .docs-header-mobile-popup.ant-popover-arrow-point-at-center:is(.ant-popover-placement-left,.ant-popover-placement-leftTop,.ant-popover-placement-leftBottom,.ant-popover-placement-right,.ant-popover-placement-rightTop,.ant-popover-placement-rightBottom) .ant-popover-arrow{top:var(--ant-overlay-arrow-top);bottom:auto}
    /* Let Overlay own arrow placement. Its final placement can flip at the
       viewport boundary, so a fixed right offset would desynchronize the arrow. */
    #header .docs-header-mobile-trigger{position:absolute;inset-inline-end:22px;top:20px;width:32px;height:32px;margin:0}
    #header .docs-header-mobile-trigger .nav-phone-icon{display:inline-flex;align-items:center;justify-content:center;vertical-align:top;line-height:1}
    @@media (min-width:768px){#header .docs-header-mobile-trigger{display:none!important}}
    @@media (max-width:767.99px){#header.home-header>.ant-row>.ant-col.menu-row{display:flex!important;flex:1 1 auto!important;width:auto!important;max-width:none!important;min-width:0;margin:0!important}#header.home-header .menu-row #search-box{max-width:220px;margin-inline:0 8px!important}#header.home-header .docs-header-logo{flex:0 0 auto!important;width:auto!important;max-width:none!important}}
    [data-theme="dark"] #header #nav .ant-menu-item>a,[data-theme="dark"] #header #nav .ant-menu-submenu-title{color:var(--ant-color-text,rgba(255,255,255,.85))}
    [data-theme="dark"] #header #nav .ant-menu-item-selected>a,[data-theme="dark"] #header #nav .ant-menu-item>a:hover{color:var(--ant-color-primary,#1677ff)}
    [data-theme="dark"] #header .header-button{color:var(--ant-color-text,rgba(255,255,255,.85));border-color:var(--ant-color-border,#434343)}
</style>

