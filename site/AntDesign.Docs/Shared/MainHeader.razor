@using AntDesign.Docs.Services
<header id="header" class="clearfix @(IsHome?"home-header":"") @_styles["root"]">
    <Row Style="flex-flow: nowrap; height: 64px;" OnBreakpoint="OnBreakpoint">
        <GridCol Class="docs-header-logo" Xs="24" Sm="24" Md="6" Lg="6" Xl="5" Xxl="4">
            <h1>
                <a id="logo" href="/">
                    <img alt="logo" src="/docs/assets/logo.svg">Ant Design Blazor
                </a>
            </h1>
        </GridCol>
        @if (_isMobile)
        {
            <Popover Class="docs-header-mobile-trigger" Placement="Placement.BottomRight" Trigger="new[] { Trigger.Click }" ArrowPointAtCenter OverlayClassName="docs-header-mobile-popup" OverlayStyle="width:300px;max-width:calc(100vw - 16px);inset-inline-start:auto!important;inset-inline-end:8px!important;">
                <ContentTemplate>
                    <HeaderMenu IsMobile />
                </ContentTemplate>
                <ChildContent><Button Type="ButtonType.Text" Icon="@IconType.Outline.UnorderedList" Class="nav-phone-icon" AriaLabel="Open navigation" /></ChildContent>
            </Popover>
        }
        @if (!_isMobile)
        {
            <GridCol Class="menu-row" Xs="0" Sm="0" Md="18" Lg="18" Xl="19" Xxl="20">
                <HeaderMenu IsMobile="false" />
            </GridCol>
        }
    </Row>
</header>

<style>@((MarkupString)_styles.CssText)</style>
<style>
    .docs-header-mobile-popup .ant-popover-inner,.docs-header-mobile-popup .ant-popover-inner-content{padding:0;width:100%;box-sizing:border-box}
    .docs-header-mobile-popup .ant-popover-content{width:100%}
    .docs-header-mobile-popup .ant-popover-inner{background:var(--ant-color-bg-elevated,#fff);border-radius:var(--ant-border-radius-lg,8px);box-shadow:var(--ant-box-shadow-secondary,0 6px 16px rgba(0,0,0,.12))}
    .docs-header-mobile-popup .header-navigation{width:100%}
    .docs-header-mobile-popup .ant-menu{width:100%;border-inline-end:0}
    .docs-header-mobile-popup .ant-popover-arrow{inset-inline-start:auto!important;inset-inline-end:16px!important}
</style>

