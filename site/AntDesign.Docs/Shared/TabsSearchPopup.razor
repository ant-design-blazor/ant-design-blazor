@using AntDesign

<div class="tabs-search-popup">
    <div class="tabs-search-popup-search">
        <Input Placeholder="Search tabs..." @bind-Value="_searchTerm" AllowClear />
    </div>
    <div class="tabs-search-popup-menu" tabindex="0">
        @foreach (var tab in FilteredTabs)
        {
            <button type="button"
                    class="tabs-search-popup-item @(tab.Disabled ? "tabs-search-popup-item-disabled" : null) @(tab.Key == Context.ActiveKey ? "tabs-search-popup-item-selected" : null)"
                    disabled="@tab.Disabled"
                    @onclick="() => SelectAsync(tab.Key)">
                @tab.Tab
            </button>
        }
        @if (!FilteredTabs.Any())
        {
            <div class="tabs-search-popup-empty">No matching tabs</div>
        }
    </div>
</div>

<style>
    .tabs-search-popup { width: 200px; overflow: hidden; background: var(--ant-color-bg-container, #fff); border-radius: var(--ant-border-radius-lg, 8px); box-shadow: var(--ant-box-shadow, 0 6px 16px rgba(0,0,0,.08), 0 3px 6px -4px rgba(0,0,0,.12), 0 9px 28px 8px rgba(0,0,0,.05)); }
    .tabs-search-popup-search { padding: 8px 12px; border-bottom: 1px solid var(--ant-color-border, #d9d9d9); }
    .tabs-search-popup-menu { max-height: 300px; overflow-y: auto; padding: 4px; }
    .tabs-search-popup-item { display: block; width: 100%; padding: 5px 12px; text-align: left; border: 0; border-radius: 4px; background: transparent; color: inherit; cursor: pointer; }
    .tabs-search-popup-item:hover, .tabs-search-popup-item-selected { background: var(--ant-control-item-bg-hover, #f5f5f5); }
    .tabs-search-popup-item-disabled { color: var(--ant-color-text-disabled, rgba(0,0,0,.25)); cursor: not-allowed; }
    .tabs-search-popup-empty { padding: 8px 12px; color: var(--ant-color-text-disabled, rgba(0,0,0,.25)); text-align: center; }
</style>

@code {
    [Parameter] public TabsMoreContext Context { get; set; }
    private string _searchTerm = string.Empty;
    private IEnumerable<TabPane> FilteredTabs => Context.RestTabs.Where(tab => string.IsNullOrWhiteSpace(_searchTerm) || tab.Tab.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private async Task SelectAsync(string key)
    {
        await Context.OnChange(key);
        _searchTerm = string.Empty;
        await Context.OnClose();
    }
}
