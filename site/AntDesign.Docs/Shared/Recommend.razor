@using AntDesign.Docs.Services

<a class="recommend-block @(_styles["root"]) @(Main?_styles["main"]:"")" href="@Data.Href" target="_blank" rel="noopener noreferrer">
    <img src="@Data.Img" alt="@Data.Title">
    @if (Data.Popularize)
    {
        <span class="recommend-popularize">推广</span>
    }
    <div class="recommend-content">
        <h4 class="ant-typography" direction="ltr">@Data.Title</h4>
        <div class="ant-typography recommend-description @_styles["description"]" direction="ltr">@Data.Description</div>
    </div>
</a>

<style>@((MarkupString)_styles.CssText)</style>

@code
{
    private static readonly CssStyleSheet _styles = CssInJs.CreateStyles("docs-recommend", new System.Collections.Generic.Dictionary<string, object>
    {
        ["root"] = new System.Collections.Generic.Dictionary<string, object>
        {
            ["position"] = "relative", ["display"] = "block", ["height"] = 192, ["overflow"] = "hidden", ["borderRadius"] = 2,
            ["& img"] = new System.Collections.Generic.Dictionary<string, object> { ["position"] = "relative", ["zIndex"] = -1, ["width"] = "100%", ["height"] = "100%", ["verticalAlign"] = "top", ["backgroundClip"] = "cover", ["transition"] = "all 0.36s ease-out" },
            ["&:hover img"] = new System.Collections.Generic.Dictionary<string, object> { ["transform"] = "scale(1.04)" },
            ["&::before"] = new System.Collections.Generic.Dictionary<string, object> { ["position"] = "absolute", ["top"] = 0, ["right"] = 0, ["bottom"] = 0, ["left"] = 0, ["background"] = "linear-gradient(rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.25) 40%, rgba(0, 0, 0, 0.65) 100%)", ["opacity"] = 0.3, ["transition"] = "all 0.5s", ["content"] = "''", ["pointerEvents"] = "none" },
            ["& .recommend-popularize"] = new System.Collections.Generic.Dictionary<string, object> { ["position"] = "absolute", ["top"] = 0, ["left"] = 0, ["padding"] = "0 8px", ["color"] = "#314659", ["lineHeight"] = "28px", ["background"] = "#ffd75a", ["borderRadius"] = "0 0 4px 0" },
            ["& .recommend-content"] = new System.Collections.Generic.Dictionary<string, object> { ["position"] = "absolute", ["right"] = 0, ["bottom"] = 0, ["left"] = 0, ["padding"] = "0 16px 16px", ["transform"] = "translateY(100%)", ["transition"] = "transform 0.3s" },
            ["& .recommend-content .ant-typography"] = new System.Collections.Generic.Dictionary<string, object> { ["margin"] = 0, ["color"] = "#fff" },
            ["& .recommend-content h4"] = new System.Collections.Generic.Dictionary<string, object> { ["position"] = "absolute", ["top"] = 0, ["right"] = 0, ["left"] = 0, ["padding"] = "0 16px 16px", ["transform"] = "translateY(-100%)", ["transition"] = "padding 0.3s" },
            ["& .recommend-content .recommend-description"] = new System.Collections.Generic.Dictionary<string, object> { ["color"] = "rgba(255, 255, 255, 0.85)", ["opacity"] = 0, ["transition"] = "opacity 0.3s, margin 0.3s" },
            ["@media (max-width: 576px)"] = new System.Collections.Generic.Dictionary<string, object> { ["& h4.ant-typography"] = new System.Collections.Generic.Dictionary<string, object> { ["padding"] = "0 16px 16px", ["fontSize"] = 18 } },
            ["@media (min-width: 576px)"] = new System.Collections.Generic.Dictionary<string, object>
            {
                ["&:hover::before"] = new System.Collections.Generic.Dictionary<string, object> { ["opacity"] = 1 },
                ["&:hover .recommend-content"] = new System.Collections.Generic.Dictionary<string, object> { ["transform"] = "translateY(0)" },
                ["&:hover .recommend-content h4"] = new System.Collections.Generic.Dictionary<string, object> { ["paddingBottom"] = 8 },
                ["&:hover .recommend-content .recommend-description"] = new System.Collections.Generic.Dictionary<string, object> { ["opacity"] = 1 }
            }
        },
        ["main"] = new System.Collections.Generic.Dictionary<string, object>
        {
            ["@media (min-width: 576px)"] = new System.Collections.Generic.Dictionary<string, object>
            {
                ["height"] = 408,
                ["&::before"] = new System.Collections.Generic.Dictionary<string, object> { ["background"] = "linear-gradient(rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.25) 70%, rgba(0, 0, 0, 0.65) 100%)" }
            }
        },
        ["description"] = new System.Collections.Generic.Dictionary<string, object> { ["fontSize"] = 13 }
    });

    [Parameter] public Services.Recommend Data { get; set; }

    [Parameter]public bool Main { get; set; }
}
