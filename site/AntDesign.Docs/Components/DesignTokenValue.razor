@using System.Globalization

@if (IsColor && !string.IsNullOrWhiteSpace(Value))
{
    <span class="design-token-color-value">
        <span class="design-token-color-swatch" style="background-color:@Value" aria-hidden="true"></span>
        <code>@Value</code>
    </span>
}
else if (TryGetBezier(out var x1, out var y1, out var x2, out var y2))
{
    <span class="design-token-motion-value">
        <svg class="design-token-motion-curve" width="180" height="180" viewBox="0 0 180 180" role="img" aria-label="Cubic bezier motion curve @Value">
            <title>Cubic Bezier Visualizer</title>
            <rect width="100%" height="100%" fill="var(--ant-color-bg-container, #fff)" />
            <defs>
                <pattern id="@_patternId" width="36" height="36" patternUnits="userSpaceOnUse">
                    <path d="M 0 0 H 36 M 0 0 V 36 M 36 0 V 36 M 0 36 H 36" stroke="var(--ant-color-border-secondary, #f0f0f0)" stroke-width="2" shape-rendering="crispEdges" />
                </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#@_patternId)" />
            <path class="design-token-motion-path" d="@CurvePath(x1, y1, x2, y2)" />
            <path class="design-token-motion-control" d="@ControlPath(x1, y1, x2, y2)" />
            <circle class="design-token-motion-point-end" cx="@SvgNumber(x1 * 180)" cy="@SvgNumber(180 - y1 * 180)" r="5" />
            <circle class="design-token-motion-point-start" cx="@SvgNumber(x2 * 180)" cy="@SvgNumber(180 - y2 * 180)" r="5" />
        </svg>
        <code>@Value</code>
    </span>
}
else
{
    <code>@Value</code>
}

@code {
    [Parameter] public string TokenName { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public bool IsColor { get; set; }

    private readonly string _patternId = $"design-token-motion-grid-{Guid.NewGuid():N}";

    private static string ControlPath(double x1, double y1, double x2, double y2) =>
        $"M 0 180 L {SvgNumber(x1 * 180)} {SvgNumber(180 - y1 * 180)} L {SvgNumber(x2 * 180)} {SvgNumber(180 - y2 * 180)} L 180 0";

    private static string CurvePath(double x1, double y1, double x2, double y2) =>
        $"M 0 180 C {SvgNumber(x1 * 180)} {SvgNumber(180 - y1 * 180)}, {SvgNumber(x2 * 180)} {SvgNumber(180 - y2 * 180)}, 180 0";

    private static string SvgNumber(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);

    private bool TryGetBezier(out double x1, out double y1, out double x2, out double y2)
    {
        x1 = y1 = x2 = y2 = 0;
        if (!TokenName.StartsWith("motionEase", StringComparison.OrdinalIgnoreCase)) return false;

        var match = System.Text.RegularExpressions.Regex.Match(Value ?? string.Empty,
            @"cubic-bezier\(\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*,\s*(-?[\d.]+)\s*\)",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (!match.Success || !double.TryParse(match.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out x1)
            || !double.TryParse(match.Groups[2].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out y1)
            || !double.TryParse(match.Groups[3].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out x2)
            || !double.TryParse(match.Groups[4].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out y2)) return false;

        return true;
    }
}
