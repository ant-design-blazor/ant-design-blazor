@namespace AntDesign.Docs.Components

@if (WrapInSemanticDom)
{
    <SemanticDomPreview Component="@Component" Language="@Language">
        <DynamicComponent Type="@PreviewType" />
    </SemanticDomPreview>
}
else
{
    <DynamicComponent Type="@PreviewType" />
}

@code {
    [Parameter, EditorRequired]
    public string Component { get; set; } = string.Empty;

    [Parameter]
    public string Language { get; set; } = "zh-CN";

    [Parameter, EditorRequired]
    public Type PreviewType { get; set; } = default!;

    [Parameter]
    public bool WrapInSemanticDom { get; set; }
}
