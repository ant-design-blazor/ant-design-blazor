@using AntDesign.Theming
@using AntDesign.Docs.Services

@{
    var tokens = ComponentTokenCatalog.Get(Component);
    var globalTokens = ComponentTokenCatalog.GetGlobal(Component);
}

<section class="markdown api-container component-token-documentation" id="design-token">
    <h2>@(IsChinese ? "Design Token" : "Design Token")</h2>
    @if (tokens.Count == 0 && globalTokens.Count == 0
        && !string.Equals(Component, "icon", StringComparison.OrdinalIgnoreCase))
    {
        <p>
            @if (IsChinese)
            {
                <text>React v6 未为此组件定义专属 Design Token。组件仍使用 Ant Design 的共享全局主题；可在<a href="/@Language/docs/customize-theme#global-token-reference">定制主题</a>中查看和自定义全局 Token。</text>
            }
            else
            {
                <text>React v6 does not define component-specific Design Tokens for this component. It still uses the shared Ant Design theme; see <a href="/@Language/docs/customize-theme#global-token-reference">Customize Theme</a> to review and customize global tokens.</text>
            }
        </p>
    }
    @if (tokens.Count > 0)
    {
        <h3>@(IsChinese ? "组件 Token" : "Component Token")</h3>
        <p>
            @if (IsChinese)
            {
                <text>以下组件级 Design Token 与 React v6 同步。可通过 <code>ConfigProvider</code> 的 <code>ThemeConfig.Components</code> 自定义；CSS 变量可用于样式覆盖。完整全局 token 列表见<a href="/@Language/docs/customize-theme#global-token-reference">定制主题</a>。</text>
            }
            else
            {
                <text>Component-level Design Tokens are synchronized with React v6. Customize them through <code>ConfigProvider</code> <code>ThemeConfig.Components</code>; CSS variables are available for style overrides. See <a href="/@Language/docs/customize-theme#global-token-reference">Customize Theme</a> for the complete global token reference.</text>
            }
        </p>
        <table class="api properties-api">
            <thead>
                <tr>
                    <th>@(IsChinese ? "Token" : "Token")</th>
                    <th>@(IsChinese ? "说明" : "Description")</th>
                    <th>@(IsChinese ? "CSS 变量" : "CSS Variable")</th>
                    <th>@(IsChinese ? "C# 类型" : "C# Type")</th>
                    <th>@(IsChinese ? "默认值" : "Default Value")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in tokens)
                {
                    <tr>
                        <td class="api-code-identifier">@token.Name</td>
                        <td class="api-description">
                            @if (IsChinese)
                            {
                                @token.Description
                            }
                            else
                            {
                                @token.DescriptionEn
                            }
                            @if (token.Deprecated)
                            {
                                <span class="ant-tag">@(IsChinese ? "已弃用" : "Deprecated")</span>
                            }
                        </td>
                        <td><code>@token.CssVariable</code></td>
                        <td><code>@token.CSharpType</code></td>
                        <td><DesignTokenValue TokenName="@token.Name" Value="@token.DefaultValue" IsColor="@IsColorToken(token.Name, token.Type, token.DefaultValue)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (globalTokens.Count > 0)
    {
        <h3>@(IsChinese ? "全局 Token" : "Global Token")</h3>
        <p>
            @(IsChinese ? "以下为 React v6 记录的此组件使用的全局 Token。通过 ConfigProvider 的 ThemeConfig.Token 修改，默认值与 Blazor 默认算法一致。" : "These global tokens are used by this component in React v6. Customize them through ConfigProvider ThemeConfig.Token. Defaults are resolved by the Blazor default algorithm.")
            <a href="/@Language/docs/customize-theme#global-token-reference">@(IsChinese ? "定制主题" : "Customize Theme")</a>
        </p>
        <table class="api properties-api global-token-table">
            <thead>
                <tr>
                    <th>Token</th>
                    <th>@(IsChinese ? "说明" : "Description")</th>
                    <th>@(IsChinese ? "CSS 变量" : "CSS Variable")</th>
                    <th>@(IsChinese ? "类型" : "Type")</th>
                    <th>@(IsChinese ? "默认值" : "Default Value")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var token in globalTokens)
                {
                    <tr>
                        <td class="api-code-identifier">@token.Name</td>
                        <td class="api-description">@(IsChinese ? token.Description : token.DescriptionEn)</td>
                        <td><code>@token.CssVariable</code></td>
                        <td><code>@token.Type</code></td>
                        <td><DesignTokenValue TokenName="@token.Name" Value="@(DefaultGlobalTokens.TryGetValue(token.Name, out var value) ? value : "—")" IsColor="@IsColorToken(token.Name, token.Type, DefaultGlobalTokens.TryGetValue(token.Name, out var globalValue) ? globalValue : "—")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <style>
        .design-token-color-value, .design-token-motion-value { display: inline-flex; align-items: center; gap: 8px; max-width: 100%; }
        .design-token-color-swatch { display: inline-block; flex: 0 0 10px; width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 0 1px rgb(0 0 0 / 10%); }
        .design-token-motion-value { align-items: flex-start; flex-direction: column; }
        .design-token-motion-curve { display: block; flex: 0 0 180px; width: 180px; height: 180px; overflow: visible; }
        .design-token-motion-control { fill: none; stroke: var(--ant-color-primary-active, #0958d9); stroke-width: 2; stroke-dasharray: 4 2; }
        .design-token-motion-path { fill: none; stroke: var(--ant-color-primary, #1677ff); stroke-width: 4; }
        .design-token-motion-point-start { fill: var(--ant-green-6, #52c41a); }
        .design-token-motion-point-end { fill: var(--ant-red-6, #f5222d); }
    </style>
</section>

@code {
    [Parameter] public string Component { get; set; } = string.Empty;
    [Parameter] public string Language { get; set; } = "en-US";

    private bool IsChinese => string.Equals(Language, "zh-CN", StringComparison.OrdinalIgnoreCase);
    private static bool IsColorToken(string name, string type, string value)
    {
        if (name?.Contains("shadow", StringComparison.OrdinalIgnoreCase) == true
            || name?.Contains("gradient", StringComparison.OrdinalIgnoreCase) == true)
        {
            return false;
        }

        if (string.Equals(type, "color", StringComparison.OrdinalIgnoreCase)
            || (name?.StartsWith("color", StringComparison.OrdinalIgnoreCase) ?? false)
            || (name?.EndsWith("color", StringComparison.OrdinalIgnoreCase) ?? false)
            || (name?.EndsWith("bg", StringComparison.OrdinalIgnoreCase) ?? false)
            || (name?.EndsWith("border", StringComparison.OrdinalIgnoreCase) ?? false)
            || (name?.EndsWith("outline", StringComparison.OrdinalIgnoreCase) ?? false))
        {
            return true;
        }

        var cssValue = value?.Trim();
        return !string.IsNullOrEmpty(cssValue)
            && (cssValue.StartsWith('#')
                || cssValue.StartsWith("rgb(", StringComparison.OrdinalIgnoreCase)
                || cssValue.StartsWith("rgba(", StringComparison.OrdinalIgnoreCase)
                || cssValue.StartsWith("hsl(", StringComparison.OrdinalIgnoreCase)
                || cssValue.StartsWith("hsla(", StringComparison.OrdinalIgnoreCase));
    }
    private static readonly IReadOnlyDictionary<string, string> DefaultGlobalTokens = new ThemeConfig().GetResolvedTokenValues();
}
