@using AntDesign
@using AntDesign.Docs.Services
@using AntDesign.Theming
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@inject HttpClient HttpClient

<style id="home-theme-preview-style">@((MarkupString)_styles.CssText)</style>
<div class="@GetClass("home-theme-preview", "root")">
    <div class="@_styles["groupContainer"]"></div>
    <div class="@_styles["groupMask"]">
      <div class="@_styles["typographyWrapper"]">
        <div class="@GetClass("home-theme-heading", "heading", SelectedTheme.DarkBackground ? "headingDark" : string.Empty)">
            <div class="@_styles["headingTitle"]"><h1 class="ant-typography" style="font-weight:900">@Localizer["app.home.theme-title"]</h1></div>
            <p>@Localizer["app.home.theme-description"]</p>
        </div>
      </div>
      <div class="@_styles["groupChildren"]">
       <div class="@_styles["themeContainer"]">
        <div class="@_styles["wrapper"]">
        <div class="@GetClass("home-theme-controls", "controls")">
            <Segmented TValue="string" Class="@GetClass("home-theme-tabs", "previewTabs", SelectedTheme.DarkBackground ? "tabsDark" : string.Empty)" @bind-Value="PreviewMode">
                <SegmentedItem Value="@("components")" Label="Components" Class="@GetTabItemClass()" />
                <SegmentedItem Value="@("dashboard")" Label="Dashboard" Class="@GetTabItemClass()" />
            </Segmented>
            <div class="@GetClass("home-theme-swatches", "swatches")" role="tablist" aria-label="Theme">
                @foreach (var theme in Themes)
                {
                    <button class="@GetSwatchClass(theme.Key)"
                            title="@theme.Name" aria-label="@theme.Name" role="tab"
                            data-theme-key="@theme.Key" tabindex="@(theme.Key == _selected ? 0 : -1)"
                            aria-selected="@((_selected == theme.Key).ToString().ToLowerInvariant())"
                            @ref="_themeButtons[theme.Key]"
                            @onkeydown="args => ChangeThemeFromKeyboard(args)"
                            @onclick="() => SelectTheme(theme.Key)">
                        @if (theme.Icon == "SereneIcon")
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="1em" height="1em" fill="none" role="img" focusable="false"><title>Serene Icon</title><circle cx="32" cy="32" r="31" fill="#f8f6f2" stroke="#e2dcd5" stroke-width="1" /><circle cx="32" cy="30" r="14" stroke="#312721" stroke-width="2" /><circle cx="32" cy="46" r="3" fill="#c7a56b" /></svg>
                        }
                        else
                        {
                            <img src="@theme.Icon" alt="@theme.Name" draggable="false" />
                        }
                    </button>
                }
                <div class="@GetClass("home-theme-actions", "actions")">
                <button title="@Localizer["app.home.theme-copy"]" @onclick="CopyThemeAsync">▣</button>
                <a title="@Localizer["app.home.theme-edit"]" href="/theme-migration-preview" target="_blank" rel="noopener noreferrer">✎</a>
                @if (_copied)
                {
                    <span role="status">@Localizer["app.home.theme-copied"]</span>
                }
                </div>
            </div>
        </div>

    <ConfigProvider ThemeConfig="@_themeConfig" @key="_selected">
    @if (!_dashboard)
    {
        <div class="ant-app" style="width:100%">
        <Card Class="@_styles["mainCard"]" Styles="@_mainCardStyles">
        <Decoration><BorderBeam LineWidth="2px" /></Decoration>
        <ChildContent>
        <div class="@GetClass("home-theme-components", "components")">
            <div class="@GetClass("home-theme-preview-column", "previewColumn")">
                <div class="@_styles["leftContent"]">
                    <div class="@GetClass("home-theme-control-grid", "controlGrid")">
                        <div class="@_styles["controlRow"]">
                            <Input TValue="string" @bind-Value="_previewEmail" Placeholder="hi@example.com" />
                            <Select Mode="SelectMode.Multiple" MaxTagCount="AntDesign.Select.ResponsiveTag.Responsive" TItemValue="string" TItem="string" @bind-Values="_selectedFoods" Placeholder="Select one">
                                <SelectOptions>
                                    <SelectOption TItemValue="string" TItem="string" Value="@("apple")" Label="Apple" />
                                    <SelectOption TItemValue="string" TItem="string" Value="@("banana")" Label="Banana" />
                                    <SelectOption TItemValue="string" TItem="string" Value="@("orange")" Label="Orange" />
                                    <SelectOption TItemValue="string" TItem="string" Value="@("watermelon")" Label="Watermelon" />
                                </SelectOptions>
                            </Select>
                        </div>
                        <div class="@_styles["controlRowSecond"]">
                            <ColorPicker Value="@_previewColor" ValueChanged="OnPreviewColorChanged" ShowText />
                            <div class="@GetClass("home-theme-compact", "compact")"><SpaceCompact><SpaceCompactItem Position="SpaceCompactItemPosition.First"><Button>Dropdown</Button></SpaceCompactItem><SpaceCompactItem Position="SpaceCompactItemPosition.Last"><Dropdown><Unbound Context="trigger"><Button RefBack="@trigger" Icon="down" AriaLabel="Open dropdown" /></Unbound><Overlay><Menu>@for (var index = 0; index < 5; index++) { var itemIndex = index; <MenuItem Key="@($"opt{itemIndex}")">Option @itemIndex</MenuItem> }</Menu></Overlay></Dropdown></SpaceCompactItem></SpaceCompact></div>
                            <DatePicker TValue="DateTime?" @bind-Value="_previewDate" Placeholder="@("Select Date")" />
                        </div>
                    </div>
                    <div class="@GetClass("home-theme-options", "options")">
                        <CheckboxGroup TValue="string" Options="@(new[] { "Apple", "Pear" })" @bind-Value="_checkedFruits" />
                        <RadioGroup TValue="string" Options="@(new[] { "Apple", "Pear" })" @bind-Value="_selectedFruit" />
                        <Switch @bind-Checked="_notifications" />
                        <Progress Type="ProgressType.Circle" Percent="25" Width="20" ShowInfo="false" />
                    </div>
                    <div class="@GetClass("home-theme-steps", "steps")"><Steps Current="1" Status="StepsStatus.Error"><Step Title="Finished" /><Step Title="In Process" /><Step Title="Waiting" /></Steps></div>
                </div>
                <div class="@GetClass("home-theme-progress-list", "progressList")">
                    <Progress Percent="50" Status="ProgressStatus.Active" />
                    <Progress Percent="70" Status="ProgressStatus.Exception" />
                </div>
                <div class="@GetClass("home-theme-statuses", "statuses")"><Badge Status="BadgeStatus.Success" Text="Success" /><Badge Status="BadgeStatus.Error" Text="Error" /><Badge Status="BadgeStatus.Default" Text="Default" /><Badge Status="BadgeStatus.Processing" Text="Processing" /><Badge Status="BadgeStatus.Warning" Text="Warning" /></div>
                <div class="@GetClass("home-theme-lower-grid", "lowerGrid")">
                    <Card Variant="CardVariant.Borderless" Class="@GetClass("home-theme-qr", "qr")" BodyStyle="padding:6px"><QRCode Value="https://ant.design/" ErrorLevel="H" Icon="https://gw.alipayobjects.com/zos/rmsportal/KDpgvguMpGfqaHPjicRK.svg" /></Card>
                    <div class="@GetClass("home-theme-lower-controls", "lowerControls")">
                        <div class="@GetClass("home-theme-mini-icons", "miniIcons")"><Spin><Indicator><Icon Type="loading" Spin /></Indicator></Spin><Spin /><Rate @bind-Value="_rating" Style="margin-block-end:20px" /></div>
                        <Card Variant="CardVariant.Borderless" Class="@_styles["tagsCard"]" BodyStyle="padding:6px"><div class="@GetClass("home-theme-tags", "tags")"><Tag Color="@("#55acee")" Icon="x">Twitter</Tag><Tag Color="@("#cd201f")" Icon="youtube">Youtube</Tag><Tag Color="@("#3b5999")" Icon="facebook">Facebook</Tag></div></Card>
                        <PopconfirmPanel Title="@(_confirmMessage ?? "Are you OK?")" Placement="Placement.TopRight" Style="width:100%;margin:0" OnCancel="CancelConfirm" OnConfirm="AcceptConfirm" />
                    </div>
                </div>
                <Card Variant="CardVariant.Borderless" Class="@GetClass("home-theme-segments", "segments")" BodyStyle="padding:8px"><Segmented TValue="string" Block Labels="@(new[] { "1D", "7D", "1M", "1Y", "All" })" @bind-Value="_activePeriod" /><Segmented TValue="string" Block Style="margin-block-start:8px" @bind-Value="_activeChannel"><SegmentedItem Value="@("Chats")" Label="Chats" Icon="@IconType.Outline.Message" /><SegmentedItem Value="@("Emails")" Label="Emails" Icon="@IconType.Outline.Mail" /></Segmented></Card>
            </div>
            <div class="@GetClass("home-theme-preview-column", "previewColumn")">
                <div class="@GetClass("home-theme-verify", "verify")">
                    <AvatarGroup Class="@GetClass("home-theme-contributors", "contributors")">
                        @if (_contributorsLoading)
                        {
                            @for (var index = 0; index < 6; index++)
                            {
                                <SkeletonElement Type="SkeletonElementType.Avatar" Active Size="SkeletonElementSize.Large" Style="width:46px;height:46px" />
                            }
                        }
                        else
                        {
                            @foreach (var contributor in _contributors)
                            {
                                <Avatar AdditionalAttributes="@GetContributorAvatarAttributes(contributor.Login)" Size="@("46px")" Src="@contributor.AvatarUrl" Alt="@($"Contributor: {contributor.Login}")" />
                            }
                        }
                        <Avatar AdditionalAttributes="@NonDraggableAvatarAttributes" Size="@("46px")"><span style="display:flex;width:100%;height:100%;align-items:center;justify-content:center">+5</span></Avatar>
                    </AvatarGroup>
                    <strong>Verify account</strong><small>We've sent a code to a****@@gmail.com</small>
                    <div class="@GetClass("home-theme-otp", "otp")"><InputOTP Size="InputSize.Large" Length="6" DefaultValue="4320" Variant="InputVariant.Filled" /></div>
                    <small>@_verificationMessage <a href="#" @onclick="ResendVerification" @onclick:preventDefault="true">Resend</a></small>
                </div>
                <Flex Direction="FlexDirection.Vertical" Gap="FlexGap.Large">
                    <Flex Justify="FlexJustify.Center" Gap="FlexGap.Middle"><Button Type="ButtonType.Primary" OnClick="PrimaryButtonClicked">Primary button</Button><Button Danger OnClick="DangerButtonClicked">Danger button</Button></Flex>
                    <Flex Justify="FlexJustify.Center" Gap="FlexGap.Middle"><Button Type="ButtonType.Dashed" Shape="ButtonShape.Round" OnClick="OutlinedButtonClicked">Outlined button</Button><Button Danger Shape="ButtonShape.Round" OnClick="RoundButtonClicked">Round button</Button></Flex>
                </Flex>
                @if (_buttonFeedback is not null) { <Alert Type="AlertType.Info" Message="@_buttonFeedback" ShowIcon Closable OnClose="() => _buttonFeedback = null" /> }
                <Card Variant="CardVariant.Borderless" Class="@_styles["profile"]"><Avatar Shape="AvatarShape.Square" Size="@("60px")" Src="https://gw.alipayobjects.com/zos/rmsportal/KDpgvguMpGfqaHPjicRK.svg" /><div><Title Level="5">Ant Design</Title><Text Type="TextElementType.Secondary">@@ant-design</Text><p>Building the future of UI for web &amp; mobile.</p></div></Card>
                @if (_notificationVisible) { <div class="ant-notification-notice-pure-panel" style="width:100%"><NotificationItem Config="@PreviewNotification" PurePanel OnClose="CloseNotification" /></div> }
            </div>
            <div class="@GetClass("home-theme-preview-column", "previewColumn", "rightColumn")">
                <Card Variant="CardVariant.Borderless" Class="@_styles["signup"]"><Avatar Src="https://github.com/ant-design.png?size=50" Size="AvatarSize.Large" /><Title Level="4">Create an account</Title><p>Start your free 7-day trial. No credit card required.</p><Button Type="ButtonType.Primary" Block Size="ButtonSize.Large" OnClick="StartAccountCreation">Get Started</Button><Divider>OR</Divider><Button Block Size="ButtonSize.Large" Icon="google" OnClick="SelectGoogleSignIn">Continue with Google</Button><Button Block Size="ButtonSize.Large" Icon="apple" OnClick="SelectAppleSignIn">Continue with Apple</Button></Card>
                @if (_signupFeedback is not null) { <Alert Type="AlertType.Success" Message="@_signupFeedback" ShowIcon Closable OnClose="() => _signupFeedback = null" /> }
                @if (_dialogVisible)
                {
                    <Dialog PurePanel Visible Config="@PreviewDialog"><div>Ant Design use CSS-in-JS technology to provide dynamic &amp; mix theme ability.</div></Dialog>
                }
                else
                {
                    <Button OnClick="OpenDialog">Open message</Button>
                }
            </div>
        </div>
        </ChildContent>
        </Card>
        </div>
    }
    else
    {
        <Layout Class="@GetClass("home-theme-dashboard", "dashboard", GetDashboardMenuTheme() == MenuTheme.Dark ? "dashboardDark" : string.Empty)">
            <Header Class="@GetClass("home-theme-dashboard-header", "dashboardHeader", GetDashboardMenuTheme() == MenuTheme.Dark ? "dashboardHeaderDark" : string.Empty)">
                <div class="@_styles["dashboardLogo"]"><span><img src="https://gw.alipayobjects.com/zos/rmsportal/KDpgvguMpGfqaHPjicRK.svg" alt="Ant Design logo" draggable="false" /></span><h1>Ant Design</h1></div>
                <Space Size="SpaceSize.Middle" Class="@_styles["dashboardMenu"]"><Icon Type="@IconType.Outline.Bell" /><Icon Type="@IconType.Outline.QuestionCircle" /><img class="@_styles["dashboardAvatar"]" src="@SelectedTheme.Icon" alt="@SelectedTheme.Name" title="@SelectedTheme.Name" draggable="false" /></Space>
            </Header>
            <Layout>
                <Sider Width="200" Theme="@GetDashboardSiderTheme()">
                    <Menu Mode="MenuMode.Inline" Theme="@GetDashboardMenuTheme()" DefaultSelectedKeys="@(new[] { "Themes" })" DefaultOpenKeys="@(new[] { "Design" })" Style="height:100%;border-inline-end:0">
                        <SubMenu Key="Design" Title="Design" Icon="@IconType.Outline.Folder">
                            <MenuItem Key="Design Values">Design Values</MenuItem><MenuItem Key="Global Styles">Global Styles</MenuItem><MenuItem Key="Themes">Themes</MenuItem><MenuItem Key="DesignPatterns">Design Patterns</MenuItem>
                        </SubMenu>
                        <MenuItem Key="Development" Icon="@IconType.Outline.Folder">Development</MenuItem>
                    </Menu>
                </Sider>
                <Layout Class="@_styles["dashboardMain"]">
                    <Breadcrumb Class="@_styles["dashboardBreadcrumb"]">
                        <BreadcrumbItem><ChildContent><Icon Type="@IconType.Outline.Home" /></ChildContent></BreadcrumbItem>
                        <BreadcrumbItem><ChildContent>Design</ChildContent><Overlay><Menu><MenuItem Key="Design Values">Design Values</MenuItem><MenuItem Key="Global Styles">Global Styles</MenuItem><MenuItem Key="Themes">Themes</MenuItem><MenuItem Key="DesignPatterns">Design Patterns</MenuItem></Menu></Overlay></BreadcrumbItem>
                        <BreadcrumbItem><ChildContent>Themes</ChildContent></BreadcrumbItem>
                    </Breadcrumb>
                    <Content>
                        <div class="@_styles["dashboardShell"]">
                        <Flex Class="@_styles["dashboardToolbar"]" Justify="FlexJustify.SpaceBetween" Align="FlexAlign.Center" Wrap="FlexWrap.Wrap" Gap="FlexGap.Middle">
                            <Segmented TValue="string" Class="@_styles["dashboardTabs"]" Labels="@(new[] { "Overview", "Sales", "Expenses" })" @bind-Value="_dashboardSection" />
                            <Space><Button Shape="ButtonShape.Circle" Icon="@IconType.Outline.Reload" /><Select TItemValue="string" TItem="string" Value="@("monthly")" Style="width: 144px"><SelectOptions><SelectOption TItemValue="string" TItem="string" Value="@("monthly")" Label="Monthly" /></SelectOptions></Select><Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download">Download</Button></Space>
                        </Flex>
                        <Row Gutter="(16,16)" Class="@_styles["dashboardKpis"]">
                            @foreach (var metric in DashboardMetrics)
                            {
                                <GridCol Xs="24" Sm="12" Lg="6"><Card><Text Type="TextElementType.Secondary">@metric.Title</Text><div class="@_styles["dashboardStatValue"]"><Statistic TValue="string" Value="@metric.Value" /><Tag Class="@_styles["dashboardStatTrend"]" Color="@(metric.IsDown ? TagColor.Red : TagColor.Green)" Icon="@(metric.IsDown ? IconType.Outline.ArrowDown : IconType.Outline.ArrowUp)">@metric.Trend%</Tag></div></Card></GridCol>
                            }
                        </Row>
                        <Card Class="@_styles["dashboardTableCard"]" TitleTemplate="@DashboardTableTitle">
                            <Extra><Input TValue="string" Prefix="@SearchPrefix" Placeholder="Search..." /></Extra>
                            <ChildContent>
                            <Flex Class="@_styles["dashboardTableActions"]" Justify="FlexJustify.SpaceBetween" Align="FlexAlign.Center" Wrap="FlexWrap.Wrap" Gap="FlexGap.Middle"><Space Wrap><Button Icon="@IconType.Outline.Filter">Filter</Button><Button Icon="@IconType.Outline.SortAscending">Sort</Button><Button Icon="@IconType.Outline.ColumnHeight">Columns</Button></Space></Flex>
                            <Table TItem="DashboardEmployee" DataSource="DashboardEmployees" HidePagination ScrollX="900px" ScrollY="220px" Size="TableSize.Medium">
                                <PropertyColumn Property="employee => employee.Id" Title="Worker ID" Width="150px"><Text Strong>@context.Id</Text></PropertyColumn>
                                <PropertyColumn Property="employee => employee.Member" Title="Member">
                                    <Flex Align="FlexAlign.Center" Gap="FlexGap.Middle" Class="@DashboardEmployeeClass">
                                        <Avatar Size="AvatarSize.Large" Style="@($"background:{context.Avatar}")" />
                                        <div class="@DashboardEmployeeMetaClass">
                                            <Text Strong>@context.Member</Text><br />
                                            <Text Type="TextElementType.Secondary">@context.Email</Text>
                                        </div>
                                    </Flex>
                                </PropertyColumn>
                                <PropertyColumn Property="employee => employee.Role" Title="Role" />
                                <PropertyColumn Property="employee => employee.Type" Title="Worker Type" Width="160px" />
                                <Column Title="Actions" TData="string" Width="148px" Align="ColumnAlign.Right"><Space Size="SpaceSize.Small"><Button Shape="ButtonShape.Circle" Icon="@IconType.Outline.Eye" /><Button Shape="ButtonShape.Circle" Icon="@IconType.Outline.Edit" /><Button Danger Shape="ButtonShape.Circle" Icon="@IconType.Outline.Delete" /></Space></Column>
                            </Table>
                            </ChildContent>
                        </Card>
                        </div>
                    </Content>
                </Layout>
            </Layout>
        </Layout>
    }
    </ConfigProvider>
        </div>
       </div>
      </div>
    </div>
</div>

@code {
    [Inject] private Microsoft.Extensions.Localization.IStringLocalizer Localizer { get; set; } = default!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    [CascadingParameter] private DocsThemeProvider SiteTheme { get; set; }
    private string _siteAppearance;
    private string _selected = "light";
    private ThemeConfig _themeConfig = CreateThemeConfig("light");
    private readonly Dictionary<string, ElementReference> _themeButtons = new();
    private bool _dashboard;
    private string PreviewMode { get => _dashboard ? "dashboard" : "components"; set => _dashboard = value == "dashboard"; }
    private bool _copied;
    private bool _themeModeInitialized;
    private string _selectedFruit = "Apple";
    private bool _notifications = true;
    private string _activePeriod = "1D";
    private string _activeChannel = "Chats";
    private string _dashboardSection = "Overview";
    private string _previewEmail = string.Empty;
    private IEnumerable<string> _selectedFoods = new[] { "apple", "banana" };
    private string[] _checkedFruits = { "Apple" };
    private string _previewColor = "#1677ff";
    private DateTime? _previewDate;
    private decimal _rating = 3M;
    private string _verificationMessage = "Didn't receive a code?";
    private bool _contributorsLoading = true;
    private IReadOnlyList<ContributorAvatar> _contributors = Array.Empty<ContributorAvatar>();
    private static readonly string[] FallbackContributorAvatars =
    {
        "https://avatars.githubusercontent.com/u/507615?v=4",
        "https://avatars.githubusercontent.com/u/5378891?v=4",
        "https://avatars.githubusercontent.com/u/49217418?v=4",
        "https://avatars.githubusercontent.com/u/117748716?v=4",
        "https://avatars.githubusercontent.com/u/59312002?v=4",
        "https://avatars.githubusercontent.com/u/82765353?v=4"
    };
    private static readonly string[] ContributorBotExcludes =
    {
        "ant-design-bot", "github-actions", "copilot", "renovate", "dependabot",
        "gemini-code-assist", "dependabot-preview", "depfu"
    };
    private static readonly IReadOnlyDictionary<string, object> NonDraggableAvatarAttributes = new Dictionary<string, object>
    {
        ["draggable"] = "false"
    };
    private string? _confirmMessage, _buttonFeedback, _signupFeedback;
    private bool _dialogVisible = true;
    private bool _notificationVisible = true;
    private IReadOnlyDictionary<string, string> _mainCardStyles => new Dictionary<string, string> { ["root"] = $"background-color:{(SelectedTheme.DarkBackground ? "lab(14% 0 0)" : "transparent")};backdrop-filter:blur(12px);box-shadow:0 4px 12px rgba(0,0,0,.08),0 12px 32px rgba(0,0,0,.08)", ["body"] = "padding:0" };
    private NotificationConfig PreviewNotification => new()
    {
        Message = "Ant Design", Description = "An enterprise-class design system for building modern, intelligent, and delightful user experiences.",
        NotificationType = NotificationType.Success, Duration = 0, Style = _notificationVisible ? "width:100%" : "display:none"
    };
    private Task CloseNotification(NotificationConfig config) { _notificationVisible = false; return Task.CompletedTask; }
    private DialogOptions PreviewDialog => new()
    {
        Title = "Ant Design", Footer = ModalPreviewFooter,
        OnOk = args => { ConfirmDialog(); return Task.CompletedTask; },
        OnCancel = args => { CloseDialog(); return Task.CompletedTask; }
    };
    private RenderFragment ModalPreviewFooter => @<Template><Button OnClick="CloseDialog">Cancel</Button><Button Type="ButtonType.Primary" OnClick="ConfirmDialog">OK</Button></Template>;

    private Task OnPreviewColorChanged(string value)
    {
        _previewColor = value;
        return Task.CompletedTask;
    }

    private void ResendVerification() => _verificationMessage = "A new verification code was sent.";
    private void ConfirmDialog() { _dialogVisible = false; _signupFeedback = "Theme settings confirmed"; }
    private void OpenDialog() => _dialogVisible = true;
    private void CloseDialog() => _dialogVisible = false;
    private void CancelConfirm() => _confirmMessage = "Cancelled";
    private void AcceptConfirm() => _confirmMessage = "Confirmed";
    private void PrimaryButtonClicked() => _buttonFeedback = "Primary action clicked";
    private void DangerButtonClicked() => _buttonFeedback = "Danger action clicked";
    private void OutlinedButtonClicked() => _buttonFeedback = "Outlined action clicked";
    private void RoundButtonClicked() => _buttonFeedback = "Round action clicked";
    private void StartAccountCreation() => _signupFeedback = "Account creation started";
    private void SelectGoogleSignIn() => _signupFeedback = "Google sign-in selected";
    private void SelectAppleSignIn() => _signupFeedback = "Apple sign-in selected";
    private MenuTheme GetDashboardMenuTheme() => _selected is "dark" or "geek" ? MenuTheme.Dark : MenuTheme.Light;
    private SiderTheme GetDashboardSiderTheme() => _selected is "dark" or "geek" ? SiderTheme.Dark : SiderTheme.Light;

    private static readonly DashboardMetric[] DashboardMetrics =
    {
        new("Revenue", "US$228,441", "3.3", false),
        new("Expenses", "US$25,108", "3.3", true),
        new("Sales", "458", "3.3", false),
        new("Profit", "US$203,133", "4.1", false)
    };

    private static readonly DashboardEmployee[] DashboardEmployees =
    {
        new("#4586936", "linear-gradient(135deg, #69c0ff, #9254de)", "alex@acme.com", "Alex Turner", "Product Manager", "Employee"),
        new("#4586937", "linear-gradient(135deg, #ffadd2, #eb2f96)", "emma@acme.com", "Emma Davis", "Senior Designer", "Employee"),
        new("#4586933", "linear-gradient(135deg, #b5f5ec, #1677ff)", "john@acme.com", "John Smith", "Chief Technology Officer", "Employee"),
        new("#4586932", "linear-gradient(135deg, #d3f261, #5cdbd3)", "kate@acme.com", "Kate Moore", "Chief Executive Officer", "Employee")
    };

    private sealed record DashboardMetric(string Title, string Value, string Trend, bool IsDown);
    private sealed record DashboardEmployee(string Id, string Avatar, string Email, string Member, string Role, string Type);
    private string DashboardEmployeeClass => _styles["dashboardEmployee"];
    private string DashboardEmployeeMetaClass => _styles["dashboardEmployeeMeta"];
    private RenderFragment DashboardTableTitle => @<Space><Title Level="4" Class="@_styles["dashboardPanelTitle"]">All Employees</Title><Tag>32</Tag></Space>;
    private RenderFragment SearchPrefix => @<Icon Type="@IconType.Outline.Search" />;
    private CssStyleSheet _styles = CreatePreviewStyles(CreateThemeShell(CreateThemeConfig("light"), Themes[0]));
    private PreviewThemeDefinition SelectedTheme => Themes.First(item => item.Key == _selected);

    private string GetClass(string existing, params string[] generated) => $"{existing} {string.Join(" ", generated.Where(name => !string.IsNullOrWhiteSpace(name)).Select(name => _styles[name]))}";
    private string GetTabClass(bool selected) => $"{(selected ? "selected" : string.Empty)} {_styles["tab"]}";
    private string GetTabItemClass() => $"{_styles["tab"]} {(SelectedTheme.DarkBackground ? _styles["tabsItemDark"] : string.Empty)}";
    private string GetSwatchClass(string key) => $"home-theme-swatch {_styles["themeBlock"]} {_styles[$"swatch-{key}"]} {(key == _selected ? _styles["active"] : string.Empty)}";

    private void SelectTheme(string key)
    {
        _selected = key;
        _themeConfig = CreateThemeConfig(key);
        _styles = CreatePreviewStyles(CreateThemeShell(_themeConfig, SelectedTheme));
        _previewEmail = string.Empty;
        _selectedFoods = new[] { "apple", "banana" };
        _checkedFruits = new[] { "Apple" };
        _selectedFruit = "Apple";
        _notifications = true;
        _previewColor = "#1677ff";
        _previewDate = null;
        _rating = 3;
        _dialogVisible = true;
        _notificationVisible = true;
    }

    protected override void OnParametersSet()
    {
        if (SiteTheme != null && _siteAppearance != SiteTheme.Appearance)
        {
            _siteAppearance = SiteTheme.Appearance;
            SelectTheme(_siteAppearance == "dark" ? "dark" : "light");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadContributorsAsync();
        }

        if (!_themeModeInitialized)
        {
            _themeModeInitialized = true;
            var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "ant-design-blazor-doc-theme");
            if (savedTheme?.StartsWith("dark", System.StringComparison.Ordinal) == true)
            {
                SelectTheme("dark");
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task LoadContributorsAsync()
    {
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Get,
                "https://api.github.com/repos/ant-design/ant-design/contributors?per_page=100");
            request.Headers.UserAgent.ParseAdd("ant-design-blazor-docs");
            request.Headers.Accept.ParseAdd("application/vnd.github+json");
            using var response = await HttpClient.SendAsync(request);
            response.EnsureSuccessStatusCode();
            var contributors = await response.Content.ReadFromJsonAsync<GitHubContributor[]>();
            var eligible = (contributors ?? Array.Empty<GitHubContributor>())
                .Where(contributor => !string.Equals(contributor.Type, "Bot", System.StringComparison.OrdinalIgnoreCase)
                    && !ContributorBotExcludes.Any(excluded => contributor.Login.Contains(excluded, System.StringComparison.OrdinalIgnoreCase)))
                .OrderBy(_ => Random.Shared.Next())
                .Take(6)
                .Select(contributor => new ContributorAvatar(contributor.AvatarUrl, contributor.Login))
                .ToArray();

            _contributors = eligible.Length > 0 ? eligible : GetFallbackContributors();
        }
        catch
        {
            _contributors = GetFallbackContributors();
        }
        finally
        {
            _contributorsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static IReadOnlyList<ContributorAvatar> GetFallbackContributors() => FallbackContributorAvatars
        .Select(avatarUrl => new ContributorAvatar(avatarUrl, "Ant Design contributor"))
        .ToArray();

    private static IReadOnlyDictionary<string, object> GetContributorAvatarAttributes(string login) =>
        new Dictionary<string, object>
        {
            ["aria-label"] = $"Contributor: {login}",
            ["draggable"] = "false"
        };

    private sealed record ContributorAvatar(string AvatarUrl, string Login);

    private sealed class GitHubContributor
    {
        [JsonPropertyName("avatar_url")]
        public string AvatarUrl { get; set; }

        [JsonPropertyName("login")]
        public string Login { get; set; }

        [JsonPropertyName("type")]
        public string Type { get; set; }
    }

    private async Task ChangeThemeFromKeyboard(KeyboardEventArgs args)
    {
        if (args.Key is not ("ArrowLeft" or "ArrowRight")) return;
        var keys = Themes.Select(theme => theme.Key).ToArray();
        var index = Array.IndexOf(keys, _selected);
        var next = keys[(index + (args.Key == "ArrowRight" ? 1 : -1) + keys.Length) % keys.Length];
        SelectTheme(next);
        if (_themeButtons.TryGetValue(next, out var button)) await button.FocusAsync();
    }

    private static ThemeConfig CreateThemeConfig(string key)
    {
        var theme = PreviewThemeConfigFactory.Create(key);
        theme.Inherit = false;
        return theme;
    }

    private static ThemeShell CreateThemeShell(ThemeConfig config, PreviewThemeDefinition definition)
    {
        var values = config.GetResolvedTokenValues();
        return new ThemeShell(values["colorPrimary"], values["colorBgLayout"], values["colorText"],
            values["colorBorder"], values["colorTextSecondary"], definition.Background);
    }

