    private static System.Collections.Generic.Dictionary<string, object> Css(params (string Key, object Value)[] declarations)
    {
        var result = new System.Collections.Generic.Dictionary<string, object>(declarations.Length);
        foreach (var (key, value) in declarations) result[key] = value;
        return result;
    }

    private async Task CopyThemeAsync()
    {
        var code = $"// {SelectedTheme.Label} preview theme\nconst theme = {{ token: {{ colorPrimary: '{SelectedTheme.Primary}' }} }};";
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
        _copied = true;
    }

