            ["dashboardTableHeader"] = Css(("display", "flex"), ("alignItems", "center"), ("gap", 8), ("marginBottom", 12),
                ("& h4", Css(("margin", 0), ("fontSize", 16))), ("& .ant-input", Css(("width", 170), ("marginLeft", "auto"))),
                ("@media(max-width:700px)", Css(("flexWrap", "wrap"), ("& .ant-input", Css(("width", "100%"), ("marginLeft", 0)))))),
            ["dashboardTableActions"] = Css(("marginBlock", "20px")),
            ["chart"] = Css(("display", "flex"), ("alignItems", "flex-end"), ("gap", 10), ("height", 110), ("marginTop", 18), ("padding", "10px 20px"), ("border", "1px solid var(--preview-border)"), ("borderRadius", 8),
                ("& span", Css(("height", "45%"), ("flex", 1), ("borderRadius", "4px 4px 0 0"), ("background", "color-mix(in srgb,var(--home-theme-primary) 65%,var(--home-theme-bg))"))),
                ("& span:nth-child(3n)", Css(("height", "78%"))), ("& span:nth-child(3n + 1)", Css(("height", "60%"))), ("& span:nth-child(3n + 2)", Css(("height", "90%"))),
                ("@media(max-width:600px)", Css(("height", 90))))
        };
        foreach (var swatch in Themes)
            rules[$"swatch-{swatch.Key}"] = Css(("--swatch-color", "var(--ant-color-bg-layout)"));
        return CssInJs.CreateStyles("home-theme-preview", rules);
    }

    private static System.Collections.Generic.Dictionary<string, object> Css(params (string Key, object Value)[] declarations)
    {
        var result = new System.Collections.Generic.Dictionary<string, object>(declarations.Length);
        foreach (var (key, value) in declarations) result[key] = value;
        return result;
    }

    private async Task CopyThemeAsync()
    {
        var code = PreviewThemeCodeFormatter.Format(_themeConfig);
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", code);
        _copied = true;
    }

    private static readonly IReadOnlyList<PreviewThemeDefinition> Themes = GeneratedPreviewThemes.All;
    private sealed record ThemeShell(string Primary, string Background, string Text, string Border, string Muted, string BackgroundImage);
}
