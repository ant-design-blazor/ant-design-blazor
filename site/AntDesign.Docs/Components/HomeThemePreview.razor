@using AntDesign
@using AntDesign.Docs.Services

<style>@((MarkupString)_styles.CssText)</style>
<section class="@GetClass("home-theme-preview", "root")">
    <div class="@GetClass("home-theme-heading", "heading")">
        <div>
            <span class="@GetClass("home-theme-eyebrow", "eyebrow")">Ant Design v6</span>
            <h2>@Localizer["app.home.theme-title"]</h2>
            <p>@Localizer["app.home.theme-description"]</p>
        </div>
        <div class="@GetClass("home-theme-controls", "controls")">
            <div class="@GetClass("home-theme-tabs", "previewTabs")" role="tablist" aria-label="Preview mode">
                <button class="@GetTabClass(!_dashboard)" @onclick="() => _dashboard = false">Components</button>
                <button class="@GetTabClass(_dashboard)" @onclick="() => _dashboard = true">Dashboard</button>
            </div>
            <div class="@GetClass("home-theme-swatches", "swatches")" role="tablist" aria-label="Theme">
                @foreach (var theme in Themes)
                {
                    <button class="@GetSwatchClass(theme.Key)"
                            title="@theme.Label" aria-label="@theme.Label"
                            aria-selected="@((_selected == theme.Key).ToString().ToLowerInvariant())"
                            @onclick="() => SelectTheme(theme.Key)"><img src="@theme.Icon" alt="" /></button>
                }
            </div>
            <div class="@GetClass("home-theme-actions", "actions")">
                <button title="@Localizer["app.home.theme-copy"]" @onclick="CopyThemeAsync">▣</button>
                <a title="@Localizer["app.home.theme-edit"]" href="/theme-migration-preview" target="_blank" rel="noopener noreferrer">✎</a>
                @if (_copied)
                {
                    <span role="status">@Localizer["app.home.theme-copied"]</span>
                }
            </div>
        </div>
    </div>

    @if (!_dashboard)
    {
        <div class="@GetClass("home-theme-components", "components")">
            <div class="@GetClass("home-theme-preview-column", "previewColumn")">
                <div class="@GetClass("home-theme-control-grid", "controlGrid")">
                    <div class="@_styles["controlRow"]">
                        <Input TValue="string" @bind-Value="_previewEmail" Placeholder="hi@example.com" />
                        <Select Mode="SelectMode.Multiple" MaxTagCount="AntDesign.Select.ResponsiveTag.Responsive" TItemValue="string" TItem="string" @bind-Values="_selectedFoods" Placeholder="Select one">
                            <SelectOptions>
                                <SelectOption TItemValue="string" TItem="string" Value="@("apple")" Label="Apple" />
                                <SelectOption TItemValue="string" TItem="string" Value="@("banana")" Label="Banana" />
                                <SelectOption TItemValue="string" TItem="string" Value="@("orange")" Label="Orange" />
                            </SelectOptions>
                        </Select>
                    </div>
                    <div class="@_styles["controlRowSecond"]">
                        <ColorPicker Value="@_previewColor" ValueChanged="OnPreviewColorChanged" ShowText />
                        <div class="@GetClass("home-theme-compact", "compact")"><Dropdown><Unbound Context="trigger"><Button RefBack="@trigger">Dropdown <Icon Type="@IconType.Outline.Down" /></Button></Unbound><Overlay><Menu><MenuItem Key="option-1">Option 1</MenuItem><MenuItem Key="option-2">Option 2</MenuItem></Menu></Overlay></Dropdown></div>
                        <DatePicker TValue="DateTime?" @bind-Value="_previewDate" Placeholder="@("Select Date")" />
                    </div>
                </div>
                <div class="@GetClass("home-theme-options", "options")">
                    <CheckboxGroup TValue="string" Options="@(new[] { "Apple", "Pear" })" @bind-Value="_checkedFruits" />
                    <RadioGroup TValue="string" Options="@(new[] { "Apple", "Pear" })" @bind-Value="_selectedFruit" />
                    <Switch @bind-Checked="_notifications" />
                    <Spin Size="SpinSize.Small" />
                </div>
                <div class="@GetClass("home-theme-steps", "steps")"><Steps Current="1" Status="StepsStatus.Error" Size="StepsSize.Small"><Step Title="Finished" /><Step Title="In Process" /><Step Title="Waiting" /></Steps></div>
                <div class="@GetClass("home-theme-progress-list", "progressList")">
                    <div class="@_styles["progressRow"]"><Progress Percent="50" Status="ProgressStatus.Active" ShowInfo="false" /><span>50%</span></div>
                    <div class="@_styles["progressRow"]"><Progress Percent="70" Status="ProgressStatus.Exception" ShowInfo="false" /><span class="@_styles["progressError"]">×</span></div>
                </div>
                <div class="@GetClass("home-theme-statuses", "statuses")"><Badge Status="BadgeStatus.Success" Text="Success" /><Badge Status="BadgeStatus.Error" Text="Error" /><Badge Status="BadgeStatus.Default" Text="Default" /><Badge Status="BadgeStatus.Processing" Text="Processing" /><Badge Status="BadgeStatus.Warning" Text="Warning" /></div>
                <div class="@GetClass("home-theme-lower-grid", "lowerGrid")">
                    <div class="@GetClass("home-theme-qr", "qr")"><QRCode Value="https://ant.design" Size="128" Bordered="false" /></div>
                    <div class="@GetClass("home-theme-lower-controls", "lowerControls")">
                        <div class="@GetClass("home-theme-mini-icons", "miniIcons")"><Spin Size="SpinSize.Small" /><Spin Size="SpinSize.Small" /><Rate @bind-Value="_rating" /></div>
                        <div class="@GetClass("home-theme-tags", "tags")"><Tag Color="TagColor.Blue">Twitter</Tag><Tag Color="TagColor.Red">Youtube</Tag><Tag Color="TagColor.Blue">Facebook</Tag></div>
                        <Alert Class="@GetClass("home-theme-confirm", "confirm")" Type="AlertType.Warning" Message="@(_confirmMessage ?? "Are you OK?")" ShowIcon>
                            <Action>
                                <div class="@_styles["confirmActions"]">
                                    <Button OnClick="CancelConfirm">Cancel</Button>
                                    <Button Type="ButtonType.Primary" OnClick="AcceptConfirm">OK</Button>
                                </div>
                            </Action>
                        </Alert>
                    </div>
                </div>
                <div class="@GetClass("home-theme-segments", "segments")"><Segmented TValue="string" Labels="@(new[] { "1D", "7D", "1M", "1Y", "All" })" @bind-Value="_activePeriod" /><Segmented TValue="string" Labels="@(new[] { "Chats", "Emails" })" @bind-Value="_activeChannel" /></div>
            </div>
            <div class="@GetClass("home-theme-preview-column", "previewColumn", "centerColumn")">
                <div class="@GetClass("home-theme-verify", "verify")">
                    <div class="@GetClass("home-theme-contributors", "contributors")"><AvatarGroup><Avatar Src="https://github.com/ant-design.png?size=48" /><Avatar Src="https://github.com/afc163.png?size=48" /><Avatar Src="https://github.com/benjycui.png?size=48" /><Avatar Src="https://github.com/yesmeck.png?size=48" /><Avatar Src="https://github.com/zombieJ.png?size=48" /><Avatar>+5</Avatar></AvatarGroup></div>
                    <strong>Verify account</strong><small>We've sent a code to a***@@gmail.com</small>
                    <div class="@GetClass("home-theme-otp", "otp")"><Input TValue="string" @bind-Value="_otp1" /><Input TValue="string" @bind-Value="_otp2" /><Input TValue="string" @bind-Value="_otp3" /><Input TValue="string" @bind-Value="_otp4" /><Input TValue="string" @bind-Value="_otp5" /><Input TValue="string" @bind-Value="_otp6" /></div>
                    <small>@_verificationMessage <Button Type="ButtonType.Link" OnClick="ResendVerification">Resend</Button></small>
                </div>
                <div class="@GetClass("home-theme-button-pairs", "buttonPairs")"><Button Type="ButtonType.Primary" OnClick="PrimaryButtonClicked">Primary button</Button><Button Danger Type="ButtonType.Primary" OnClick="DangerButtonClicked">Danger button</Button><Button Type="ButtonType.Dashed" OnClick="OutlinedButtonClicked">Outlined button</Button><Button Shape="ButtonShape.Round" OnClick="RoundButtonClicked">Round button</Button></div>
                @if (_buttonFeedback is not null) { <Alert Type="AlertType.Info" Message="@_buttonFeedback" ShowIcon Closable OnClose="() => _buttonFeedback = null" /> }
                <Card Class="@_styles["profile"]"><Avatar Shape="AvatarShape.Square" Size="@("60px")" Src="https://gw.alipayobjects.com/zos/rmsportal/KDpgvguMpGfqaHPjicRK.svg" /><div><strong>Ant Design</strong><small>@@ant-design</small><p>Building the future of UI for web &amp; mobile.</p></div></Card>
                <Alert Class="@_styles["previewAlert"]" Type="AlertType.Success" Message="Ant Design" Description="An enterprise-class design system for building modern, intelligent, and delightful user experiences." ShowIcon />
            </div>
            <div class="@GetClass("home-theme-preview-column", "previewColumn", "rightColumn")">
                <Card Class="@_styles["signup"]"><Avatar Src="https://github.com/ant-design.png?size=50" Size="AvatarSize.Large" /><Title Level="4">Create an account</Title><p>Start your free 7-day trial. No credit card required.</p><Button Type="ButtonType.Primary" Block Size="ButtonSize.Large" OnClick="StartAccountCreation">Get Started</Button><Divider>OR</Divider><Button Block Size="ButtonSize.Large" OnClick="SelectGoogleSignIn">Continue with Google</Button><Button Block Size="ButtonSize.Large" OnClick="SelectAppleSignIn">Continue with Apple</Button></Card>
                @if (_signupFeedback is not null) { <Alert Type="AlertType.Success" Message="@_signupFeedback" ShowIcon Closable OnClose="() => _signupFeedback = null" /> }
                @if (_dialogVisible)
                {
                    <Card Class="@_styles["dialog"]"><div class="@_styles["dialogCopy"]"><strong>Ant Design</strong><p>Ant Design use CSS-in-JS technology to provide dynamic &amp; mix theme ability.</p></div><div class="@_styles["dialogActions"]"><Button OnClick="CloseDialog">Cancel</Button><Button Type="ButtonType.Primary" OnClick="ConfirmDialog">OK</Button></div></Card>
                }
                else
                {
                    <Button OnClick="OpenDialog">Open message</Button>
                }
            </div>
        </div>
    }
    else
    {
        <Layout Class="@GetClass("home-theme-dashboard", "dashboard")">
            <Header Class="@_styles["dashboardHeader"]">
                <div class="@_styles["dashboardLogo"]"><img src="https://gw.alipayobjects.com/zos/rmsportal/KDpgvguMpGfqaHPjicRK.svg" alt="Ant Design" /><strong>Ant Design</strong></div>
                <div>♧　?　<Avatar Icon="@IconType.Outline.User" Size="AvatarSize.Small" /></div>
            </Header>
            <Layout>
                <Sider Width="176" Theme="@GetDashboardSiderTheme()">
                    <Menu Mode="MenuMode.Inline" Theme="@GetDashboardMenuTheme()" DefaultSelectedKeys="@(new[] { "Themes" })" DefaultOpenKeys="@(new[] { "Design" })">
                        <MenuItem Key="Overview">Overview</MenuItem>
                        <SubMenu Key="Design" Title="Design"><MenuItem Key="Themes">Themes</MenuItem><MenuItem Key="Tokens">Tokens</MenuItem></SubMenu>
                        <MenuItem Key="Employees">Employees</MenuItem><MenuItem Key="Reports">Reports</MenuItem>
                    </Menu>
                </Sider>
                <Layout Class="@_styles["dashboardMain"]">
                    <Breadcrumb Class="@_styles["dashboardBreadcrumb"]"><BreadcrumbItem>⌂</BreadcrumbItem><BreadcrumbItem>Design</BreadcrumbItem><BreadcrumbItem>Themes</BreadcrumbItem></Breadcrumb>
                    <Content>
                        <div class="@_styles["dashboardToolbar"]">
                            <Segmented TValue="string" Labels="@(new[] { "Overview", "Sales", "Expenses" })" @bind-Value="_dashboardSection" />
                            <div><Button Shape="ButtonShape.Circle" Icon="@IconType.Outline.Reload" OnClick="ResetDashboard" /><Select TItemValue="string" TItem="string" @bind-Value="_dashboardRange" Style="width: 130px"><SelectOptions><SelectOption TItemValue="string" TItem="string" Value="@("monthly")" Label="Monthly" /><SelectOption TItemValue="string" TItem="string" Value="@("quarterly")" Label="Quarterly" /></SelectOptions></Select><Button Type="ButtonType.Primary" Icon="@IconType.Outline.Download" OnClick="DownloadDashboard">Download</Button></div>
                        </div>
                        <Row Gutter="16" Class="@_styles["dashboardKpis"]">
                            <GridCol Xs="24" Sm="12" Lg="6"><Card><Statistic Title="Total Revenue" Value="128450" Prefix="$" /><Tag Color="TagColor.Green">↑ 12.8%</Tag></Card></GridCol>
                            <GridCol Xs="24" Sm="12" Lg="6"><Card><Statistic Title="Active Users" Value="8942" /><Tag Color="TagColor.Green">↑ 8.2%</Tag></Card></GridCol>
                            <GridCol Xs="24" Sm="12" Lg="6"><Card><Statistic Title="New Customers" Value="1268" /><Tag Color="TagColor.Red">↓ 2.4%</Tag></Card></GridCol>
                            <GridCol Xs="24" Sm="12" Lg="6"><Card><Statistic Title="Conversion Rate" Value="6.84" Precision="2" Suffix="%" /><Tag Color="TagColor.Green">↑ 1.6%</Tag></Card></GridCol>
                        </Row>
                        <Card Class="@_styles["dashboardTable"]">
                            <div class="@_styles["dashboardTableHeader"]"><Title Level="4">All Employees</Title><Tag>@FilteredDashboardEmployees.Count()</Tag><Input TValue="string" @bind-Value="_dashboardSearch" BindOnInput Placeholder="Search..." /></div>
                            <div class="@_styles["dashboardTableActions"]"><Button Icon="@IconType.Outline.Filter" OnClick="ShowFilterFeedback">Filter</Button><Button Icon="@IconType.Outline.SortAscending" OnClick="ToggleDashboardSort">Sort</Button><Button Icon="@IconType.Outline.ColumnHeight" OnClick="ShowColumnFeedback">Columns</Button></div>
                            @if (_dashboardFeedback is not null) { <Alert Type="AlertType.Info" Message="@_dashboardFeedback" ShowIcon Closable OnClose="() => _dashboardFeedback = null" /> }
                            <Table TItem="DashboardEmployee" DataSource="FilteredDashboardEmployees" PageSize="5">
                                <PropertyColumn Property="employee => employee.Name" Title="Name" />
                                <PropertyColumn Property="employee => employee.Role" Title="Role" />
                                <PropertyColumn Property="employee => employee.Department" Title="Department" />
                                <PropertyColumn Property="employee => employee.Status" Title="Status" />
                            </Table>
                        </Card>
                    </Content>
                </Layout>
            </Layout>
        </Layout>
    }
</section>

@code {
    [Inject] private Microsoft.Extensions.Localization.IStringLocalizer Localizer { get; set; } = default!;
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    private string _selected = "light";
    private bool _dashboard;
    private bool _copied;
    private bool _themeModeInitialized;
    private string _selectedFruit = "Apple";
    private bool _notifications = true;
    private string _activePeriod = "1D";
    private string _activeChannel = "Chats";
    private string _dashboardSection = "Overview";
    private string _previewEmail = string.Empty;
    private IEnumerable<string> _selectedFoods = new[] { "apple", "banana" };
    private string[] _checkedFruits = { "Apple" };
    private string _previewColor = "#1677ff";
    private DateTime? _previewDate;
    private decimal _rating = 3M;
    private string _otp1 = "4", _otp2 = "3", _otp3 = "2", _otp4 = "0", _otp5 = string.Empty, _otp6 = string.Empty;
    private string _verificationMessage = "Didn't receive a code?";
    private string? _confirmMessage, _buttonFeedback, _signupFeedback, _dashboardFeedback;
    private bool _dialogVisible = true;
    private string _dashboardSearch = string.Empty;
    private string _dashboardRange = "monthly";
    private bool _dashboardSortDescending;
    private IEnumerable<DashboardEmployee> FilteredDashboardEmployees
    {
        get
        {
            var filtered = DashboardEmployees.Where(employee => string.IsNullOrWhiteSpace(_dashboardSearch)
                || employee.Name.Contains(_dashboardSearch, StringComparison.OrdinalIgnoreCase)
                || employee.Role.Contains(_dashboardSearch, StringComparison.OrdinalIgnoreCase)
                || employee.Department.Contains(_dashboardSearch, StringComparison.OrdinalIgnoreCase));
            return _dashboardSortDescending
                ? filtered.OrderByDescending(employee => employee.Name)
                : filtered.OrderBy(employee => employee.Name);
        }
    }

    private Task OnPreviewColorChanged(string value)
    {
        _previewColor = value;
        _styles = CreatePreviewStyles(SelectedTheme with { Primary = value });
        return Task.CompletedTask;
    }

    private void ResendVerification() => _verificationMessage = "A new verification code was sent.";
    private void ConfirmDialog() { _dialogVisible = false; _signupFeedback = "Theme settings confirmed"; }
    private void OpenDialog() => _dialogVisible = true;
    private void CloseDialog() => _dialogVisible = false;
    private void CancelConfirm() => _confirmMessage = "Cancelled";
    private void AcceptConfirm() => _confirmMessage = "Confirmed";
    private void PrimaryButtonClicked() => _buttonFeedback = "Primary action clicked";
    private void DangerButtonClicked() => _buttonFeedback = "Danger action clicked";
    private void OutlinedButtonClicked() => _buttonFeedback = "Outlined action clicked";
    private void RoundButtonClicked() => _buttonFeedback = "Round action clicked";
    private void StartAccountCreation() => _signupFeedback = "Account creation started";
    private void SelectGoogleSignIn() => _signupFeedback = "Google sign-in selected";
    private void SelectAppleSignIn() => _signupFeedback = "Apple sign-in selected";
    private void DownloadDashboard() => _dashboardFeedback = "Download requested";
    private void ShowFilterFeedback() => _dashboardFeedback = "Filter options are ready";
    private void ShowColumnFeedback() => _dashboardFeedback = "Column settings are ready";
    private void ToggleDashboardSort() => _dashboardSortDescending = !_dashboardSortDescending;
    private void ResetDashboard()
    {
        _dashboardSearch = string.Empty;
        _dashboardRange = "monthly";
        _dashboardSortDescending = false;
        _dashboardFeedback = "Dashboard reset";
    }
    private MenuTheme GetDashboardMenuTheme() => _selected is "dark" or "geek" ? MenuTheme.Dark : MenuTheme.Light;
    private SiderTheme GetDashboardSiderTheme() => _selected is "dark" or "geek" ? SiderTheme.Dark : SiderTheme.Light;

    private static readonly DashboardEmployee[] DashboardEmployees =
    {
        new("Olivia Rhye", "Product Designer", "Design", "Active"),
        new("Phoenix Baker", "Engineering Lead", "Engineering", "Active"),
        new("Lana Steiner", "Product Manager", "Product", "On leave"),
        new("Demi Wilkinson", "Frontend Engineer", "Engineering", "Active"),
        new("Candice Wu", "UX Researcher", "Design", "Active")
    };

    private sealed record DashboardEmployee(string Name, string Role, string Department, string Status);
    private CssStyleSheet _styles = CreatePreviewStyles(Themes[0]);
    private ThemeSwatch SelectedTheme => Themes.First(item => item.Key == _selected);

    private string GetClass(string existing, params string[] generated) => $"{existing} {string.Join(" ", generated.Select(name => _styles[name]))}";
    private string GetTabClass(bool selected) => $"{(selected ? "selected" : string.Empty)} {_styles["tab"]}";
    private string GetSwatchClass(string key) => $"home-theme-swatch {_styles["themeBlock"]} {_styles[$"swatch-{key}"]} {(key == _selected ? _styles["active"] : string.Empty)}";

    private void SelectTheme(string key)
    {
        _selected = key;
        _styles = CreatePreviewStyles(SelectedTheme);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_themeModeInitialized) return;
        _themeModeInitialized = true;
        var savedTheme = await JS.InvokeAsync<string>("localStorage.getItem", "ant-design-blazor-doc-theme");
        if (savedTheme?.StartsWith("dark", System.StringComparison.Ordinal) == true)
        {
            _selected = "dark";
            _styles = CreatePreviewStyles(SelectedTheme);
            await InvokeAsync(StateHasChanged);
        }
    }

    private static CssStyleSheet CreatePreviewStyles(ThemeSwatch theme)
    {
        var rules = new System.Collections.Generic.Dictionary<string, object>
        {
            ["root"] = Css(("--home-theme-primary", theme.Primary), ("--home-theme-bg", theme.Background), ("--home-theme-text", theme.Text), ("--home-theme-border", theme.Border), ("--home-theme-muted", theme.Muted),
                ("--ant-color-primary", theme.Primary), ("--ant-color-bg-container", theme.Background), ("--ant-color-text", theme.Text), ("--ant-color-border", theme.Border),
                ("--preview-surface", "var(--home-theme-bg)"), ("--preview-text", "var(--home-theme-text)"), ("--preview-border", "var(--home-theme-border)"),
                ("boxSizing", "border-box"), ("width", "100vw"), ("maxWidth", "none"), ("margin", "52px 0 64px"), ("marginInline", "calc(50% - 50vw)"),
                ("padding", "52px max(32px, calc((100vw - 1320px)/2)) 64px"),
                ("border", 0), ("borderRadius", 0), ("background", "var(--preview-surface)"), ("color", "var(--preview-text)"),
                ("boxShadow", "none"), ("transition", "background .2s, color .2s"),
                ("@media(max-width:900px)", Css(("maxWidth", "none"))),
                ("@media(max-width:600px)", Css(("margin", "36px 0"), ("marginInline", "calc(50% - 50vw)"), ("padding", "36px 16px 48px")))),
            ["heading"] = Css(("display", "flex"), ("width", "100%"), ("alignItems", "center"), ("flexDirection", "column"), ("gap", 0), ("marginBottom", 36), ("textAlign", "center"),
                ("& h2", Css(("margin", "4px 0"), ("fontSize", 38), ("fontWeight", 800), ("lineHeight", 1.15), ("color", "var(--preview-text)"))),
                ("& p", Css(("margin", "8px 0 0"), ("color", "var(--home-theme-muted)"))),
                ("@media(max-width:600px)", Css(("& h2", Css(("fontSize", 26)))))),
            ["eyebrow"] = Css(("display", "none")),
            ["controls"] = Css(("display", "flex"), ("width", "100%"), ("alignItems", "center"), ("justifyContent", "space-between"), ("gap", 20), ("marginTop", 48),
                ("@media(max-width:900px)", Css(("width", "100%"), ("justifyContent", "space-between"))),
                ("@media(max-width:600px)", Css(("alignItems", "flex-start"), ("flexDirection", "column"), ("gap", 15), ("marginTop", 26)))),
            ["actions"] = Css(("display", "flex"), ("alignItems", "center"), ("gap", 8), ("& button, & a", Css(("border", 0), ("background", "transparent"), ("color", "var(--home-theme-primary)"), ("cursor", "pointer")))),
            ["previewTabs"] = Css(("display", "flex"), ("gap", 4), ("padding", 3), ("borderRadius", 100), ("background", "var(--ant-color-fill-quaternary, color-mix(in srgb,var(--home-theme-text) 7%,var(--home-theme-bg)))"),
                ("@media(max-width:768px)", Css(("width", "60%")))),
            ["tab"] = Css(("minWidth", 112), ("border", 0), ("borderRadius", 100), ("padding", "7px 14px"), ("background", "transparent"),
                ("color", "var(--ant-color-text-tertiary, var(--home-theme-muted))"), ("cursor", "pointer"), ("transition", "color .2s, background-color .2s"),
                ("&.selected", Css(("color", "var(--ant-color-text, var(--home-theme-text))"), ("background", "var(--ant-color-bg-elevated, var(--home-theme-bg))"), ("boxShadow", "0 2px 8px rgba(0,0,0,.08)"))),
                ("@media(max-width:768px)", Css(("minWidth", 0), ("flex", 1), ("paddingInline", 12), ("fontSize", 16)))),
            ["swatches"] = Css(("display", "flex"), ("alignItems", "center"), ("gap", 9), ("@media(max-width:600px)", Css(("flexWrap", "wrap"), ("gap", 12)))),
            ["themeBlock"] = Css(("display", "grid"), ("width", 24), ("height", 24), ("padding", 0), ("border", "2px solid rgba(255,255,255,.8)"), ("borderRadius", "50%"),
                ("background", "var(--swatch-color)"), ("boxShadow", "0 0 0 1px rgba(0,0,0,.22)"), ("color", "#fff"), ("cursor", "pointer"),
                ("placeItems", "center"), ("fontSize", 12), ("outline", "2px solid transparent"), ("transition", "background-color .1s, transform .1s, opacity .1s"),
                ("& img", Css(("display", "block"), ("width", "100%"), ("height", "100%"), ("borderRadius", "50%"), ("objectFit", "cover"))),
                ("&:hover, &:focus-visible", Css(("outline", "2px solid var(--ant-color-primary-border, var(--home-theme-primary))"), ("transform", "scale(1.1)")))),
            ["active"] = Css(("outline", "2px solid var(--home-theme-primary)"), ("boxShadow", "0 0 0 4px color-mix(in srgb,var(--home-theme-primary) 26%,transparent)")),
            ["components"] = Css(("display", "grid"), ("width", "100%"), ("gridTemplateColumns", "1.2fr 1fr .8fr"), ("gap", 24), ("alignItems", "stretch"),
                ("@media(max-width:1100px)", Css(("gridTemplateColumns", "1fr 1fr"))), ("@media(max-width:700px)", Css(("gridTemplateColumns", "1fr")))),
            ["previewColumn"] = Css(("minWidth", 0), ("display", "flex"), ("flexDirection", "column"), ("gap", 18), ("padding", 20), ("borderRadius", 10),
                ("background", "color-mix(in srgb, var(--home-theme-bg) 94%, var(--home-theme-text))"),
                ("@media(max-width:700px)", Css(("padding", 14)))),
            ["centerColumn"] = Css(("justifyContent", "space-between")),
            ["rightColumn"] = Css(("gap", 18)),
            ["controlGrid"] = Css(("display", "flex"), ("flexDirection", "column"), ("gap", 12),
                ("& input::placeholder", Css(("color", "var(--home-theme-muted)"))),
                ("@media(max-width:700px)", Css(("gap", 8)))),
            ["controlRow"] = Css(("display", "flex"), ("gap", 12), ("alignItems", "center"),
                ("& > :first-child", Css(("flex", "1 1 auto"), ("minWidth", 0))),
                ("& > .ant-select", Css(("flex", "0 0 300px"), ("width", "300px"), ("maxWidth", "100%"))),
                ("@media(max-width:700px)", Css(
                    ("flexWrap", "wrap"),
                    ("& > .ant-select", Css(("flexBasis", "100%"), ("width", "100%")))))) ,
            ["controlRowSecond"] = Css(("display", "grid"), ("gridTemplateColumns", ".85fr 1fr 1.2fr"), ("gap", 10), ("alignItems", "center"),
