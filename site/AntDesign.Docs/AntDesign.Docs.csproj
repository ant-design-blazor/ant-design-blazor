<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AntDesign.Charts" Version="0.5.5" />
    <PackageReference Include="Cropper.Blazor" Version="1.5.1" />
    <PackageReference Include="System.Net.Http.Json" Version="9.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Razor" Version="6.0.33" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(SolutionDir)docs\**" LinkBase="docs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.json" />
  </ItemGroup>

  <!-- Publish the same Markdown used to build the docs, without copying it into
       the source tree or loading source files/metadata at runtime. -->
  <Target Name="ResolveDocumentationMarkdownAssets" BeforeTargets="ResolveStaticWebAssetsInputs"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration">
    <ItemGroup>
      <_DocumentationMarkdown Include="Demos\Components\**\doc\index.*.md">
        <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      </_DocumentationMarkdown>
    </ItemGroup>
    <DefineStaticWebAssets CandidateAssets="@(_DocumentationMarkdown)"
                           SourceId="$(PackageId)" SourceType="Computed"
                           ContentRoot="$(MSBuildProjectDirectory)\Demos\Components\"
                           BasePath="$(StaticWebAssetBasePath)/markdown"
                           AssetKind="All" AssetMode="All" AssetRole="Primary"
                           CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_DocumentationMarkdownAsset" />
    </DefineStaticWebAssets>
    <!-- Endpoints are available in SDK 9+. Older SDKs use the file-provider manifest. -->
    <DefineStaticWebAssetEndpoints Condition="'$(StaticWebAssetEndpointsBuildManifestPath)' != ''"
                                   CandidateAssets="@(_DocumentationMarkdownAsset)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

  <ItemGroup>
    <Compile Remove="Demos\Components\List\**" />
    <Content Remove="Demos\Components\List\**" />
    <EmbeddedResource Remove="Demos\Components\List\**" />
    <None Remove="Demos\Components\List\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Demos\Components\Modal\faq.en-US.md" />
    <None Remove="Demos\Components\Modal\faq.zh-CN.md" />
    <None Remove="Demos\Components\Upload\faq.en-US.md" />
    <None Remove="Demos\Components\Upload\faq.zh-CN.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\DemoComponent.cs" Link="Services\DemoComponent.cs" />
    <Compile Include="..\Shared\DemoMenuItem.cs" Link="Services\DemoMenuItem.cs" />
    <Compile Include="..\Shared\DocsFile.cs" Link="Services\DocsFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Demos\Components\Modal\faq.zh-CN.md" />
    <Content Include="Demos\Components\Modal\faq.en-US.md" />
    <Content Include="Demos\Components\Upload\faq.zh-CN.md" />
    <Content Include="Demos\Components\Upload\faq.en-US.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\components\AntDesign.csproj" />
    <ProjectReference Include="..\..\src\AntDesign.Extensions.Localization\AntDesign.Extensions.Localization.csproj" />
    <ProjectReference Include="..\..\src\AntDesign.Docs.Generator\AntDesign.Docs.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="..\..\docs\antd-v6\semantic-dom-catalog.json" />
    <AdditionalFiles Include="..\..\docs\antd-v6\llms-tokens.json" />
    <AdditionalFiles Include="..\..\docs\*.en-US.md;..\..\docs\*.zh-CN.md" />
    <AdditionalFiles Include="wwwroot\meta\components.*.json;wwwroot\meta\menu.*.json;wwwroot\meta\demos.*.json;wwwroot\meta\docs.*.json" />
    <AdditionalFiles Include="Demos\Components\**\doc\index.*.md" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\App.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>App.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\App.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>App.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
