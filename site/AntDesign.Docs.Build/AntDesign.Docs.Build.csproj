<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AntDesignBuildNodeVersion Condition="'$(AntDesignBuildNodeVersion)' == ''">18</AntDesignBuildNodeVersion>
    <AntDesignBuildNodeCommand>npm exec --yes --package=node@$(AntDesignBuildNodeVersion) -- node</AntDesignBuildNodeCommand>
  </PropertyGroup>

  <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SolutionDir)node_modules') ">
    <!-- Ensure Node.js is installed -->
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
    <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
    <Exec WorkingDirectory="$(SolutionDir)" Command="npm install" />
  </Target>

  <Target Name="DebugRunGulp" BeforeTargets="DebugEnsureNodeEnv" Condition=" '$(Configuration)' == 'Debug' And Exists('$(SolutionDir)node_modules') ">
    <Exec WorkingDirectory="$(SolutionDir)" Command="$(AntDesignBuildNodeCommand) ./node_modules/gulp/bin/gulp.js build:library" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="$(AntDesignBuildNodeCommand) --max-old-space-size=81920 ./node_modules/gulp/bin/gulp.js build:preview" />
  </Target>

  <Target Name="PublishRunGulp" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SolutionDir)" Command="npm install" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="$(AntDesignBuildNodeCommand) ./node_modules/gulp/bin/gulp.js build:library" />
    <Exec WorkingDirectory="$(SolutionDir)" Command="$(AntDesignBuildNodeCommand) --max-old-space-size=81920 ./node_modules/gulp/bin/gulp.js build:preview" />
  </Target>

  <PropertyGroup>
    <ProjectDir>$(SolutionDir)/site/AntDesign.Docs</ProjectDir>
  </PropertyGroup>

  <ItemGroup>
    <DocFiles Include="$(SolutionDir)docs\**\*.*" />
    <DocFiles Include="$(SolutionDir)\CHANGELOG.*.*" />
  </ItemGroup>

  <Target Name="CopyDocumentationSources" BeforeTargets="Build">
    <Copy SourceFiles="@(DocFiles)" DestinationFolder="$(ProjectDir)\wwwroot\docs\%(RecursiveDir)" ContinueOnError="true" />
  </Target>
</Project>
